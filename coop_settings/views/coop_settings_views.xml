<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Вкладка «Аккаунт» настроек участника.

    Состав взят из макета (`settings.html`, вкладка «Аккаунт»): членство и
    статус, подтверждения. Выгрузка данных и опасная зона — следующим
    заходом: они требуют не экрана, а работы (сборка архива, скрытие
    профиля, удаление), и делать их видимыми раньше, чем работающими,
    значит обещать то, чего нет.

    Полосы теми же классами, что на «Моей странице»: это один и тот же
    человек и один и тот же язык страницы.
  -->
  <record id="view_coop_settings_account_form" model="ir.ui.view">
    <field name="name">coop.settings.account.form</field>
    <field name="model">res.partner</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <form string="Настройки" create="false" edit="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Настройки</h1>
          </div>

          <field name="is_company" invisible="1"/>

          <!--
            Организация не «состоит» — в ней состоят. Поэтому у человека
            здесь его членства, у организации её состав, и это две разные
            полосы, а не одна с переименованным заголовком: в них разные
            столбцы и разный смысл строки.
          -->
          <div class="o_coop_band" invisible="is_company">
            <div class="o_coop_band_head">
              <span>Членство и статус</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="coop_member_since" readonly="1"/>
                <field name="coop_verification_level" readonly="1"/>
              </group>

              <!--
                Действующие членства, а не все: прекращённые и заявления
                здесь только сбивают — «где я состою» и «где состоял»
                разные вопросы. То же поле, что у полки на странице.
              -->
              <field name="coop_active_membership_ids" readonly="1" nolabel="1"
                     invisible="not coop_active_membership_ids">
                <list string="Членства" create="false" delete="false">
                  <field name="organization_id"/>
                  <field name="role_id"/>
                  <field name="job_title" optional="show"/>
                  <field name="joined_on"/>
                  <field name="has_vote" optional="show"/>
                </list>
              </field>
              <div class="text-muted" invisible="coop_active_membership_ids">
                Вы пока нигде не состоите.
              </div>
            </div>
          </div>

          <div class="o_coop_band" invisible="not is_company">
            <div class="o_coop_band_head">
              <span>Сведения и состав</span>
            </div>
            <div class="o_coop_band_body">
              <!--
                Реквизиты только для чтения: правятся они на самой
                карточке организации по месту (решение владельца 332), и
                второе место для тех же полей их бы рассинхронило. Здесь
                они стоят справкой — по ним видно, чем организация
                подтверждена.
              -->
              <group>
                <field name="coop_legal_form_id" readonly="1"/>
                <field name="coop_inn" readonly="1"/>
                <field name="coop_ogrn" readonly="1"/>
                <field name="coop_registered_on" readonly="1"/>
                <field name="coop_member_count" readonly="1"/>
              </group>
              <field name="coop_member_ids" readonly="1" nolabel="1"
                     invisible="not coop_member_ids">
                <list string="Состав" create="false" delete="false">
                  <field name="partner_id"/>
                  <field name="role_id"/>
                  <field name="job_title" optional="show"/>
                  <field name="joined_on"/>
                  <field name="state"/>
                  <field name="has_vote" optional="hide"/>
                </list>
              </field>
              <div class="text-muted" invisible="coop_member_ids">
                В организации пока никто не состоит.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Подтверждения</span>
            </div>
            <div class="o_coop_band_body">
              <!--
                Свои подтверждения участник видит и без настроек — правила
                видимости режут чужое, — но искать их было негде. Владелец
                16 сентября 2026: «наверно в настройки каждому участнику».
              -->
              <field name="coop_verification_ids" readonly="1" nolabel="1"
                     invisible="not coop_verification_ids">
                <list string="Подтверждения" create="false" delete="false">
                  <field name="kind"/>
                  <field name="method"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'confirmed'"
                         decoration-warning="state == 'pending'"
                         decoration-danger="state in ('rejected', 'expired')"/>
                  <field name="confirmed_on" optional="show"/>
                  <field name="expires_on" optional="hide"/>
                  <field name="confirmed_by_id" optional="hide"/>
                </list>
              </field>
              <div class="text-muted" invisible="coop_verification_ids or is_company">
                Подтверждений пока нет. Пока не подтверждён хотя бы контакт,
                на платформе можно только смотреть.
              </div>
              <div class="text-muted" invisible="coop_verification_ids or not is_company">
                Сведения организации ещё не сверены с реестром. Сверку
                проводит правление узла.
              </div>
            </div>
          </div>

          <!--
            Вторая половина вкладки по макету (`settings.html`): выгрузка
            своих данных и опасная зона.
          -->
          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Мои данные</span>
            </div>
            <div class="o_coop_band_body">
              <button name="action_coop_export_archive" type="object"
                      string="Скачать архив" class="btn-secondary"/>
              <div class="text-muted">
                Выгрузка содержит карточку, ваши объявления, членства,
                сделки и извещения — одним файлом JSON. Записи в реестре
                сделок остаются неизменными: убрать их нельзя ни вам, ни
                платформе.
              </div>
            </div>
          </div>

          <div class="o_coop_band o_coop_danger_zone" invisible="is_company">
            <div class="o_coop_band_head">
              <span>Опасная зона</span>
            </div>
            <div class="o_coop_band_body">
              <button name="action_coop_hide_profile" type="object"
                      string="Скрыть профиль" class="btn-secondary"
                      confirm="Скрыть профиль? Вас перестанут находить в каталоге «Люди». Ваши объявления, сделки и переписка останутся на месте, а вернуть показ можно здесь же."/>
              <button name="action_coop_show_profile" type="object"
                      string="Вернуть показ" class="btn-secondary"
                      invisible="not coop_profile_hidden"/>
              <field name="coop_profile_hidden" invisible="1"/>
              <button name="action_coop_request_deletion" type="object"
                      string="Удалить аккаунт" class="btn-danger"
                      confirm="Удаление проходит через правление узла: заявление уйдёт ему, профиль скроется сразу. Сделки, расчёты и отзывы остаются — они касаются не только вас. Подать заявление?"/>
              <div class="text-muted">
                Удаление — заявление правлению узла, а не нажатие кнопки:
                у участника кооператива есть паи, обязательства и
                незакрытые сделки, и стереть его запись, пока они живы,
                значит оборвать чужие расчёты.
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Серверным действием, а не окном с доменом: от чьего имени человек
    действует, того и настройки, и решается это при каждом открытии.
  -->
  <record id="action_coop_settings" model="ir.actions.server">
    <field name="name">Настройки</field>
    <!--
      `settings` занят настройками самой Odoo: короткий адрес уникален на
      всё пространство действий, и его выбирают из свободных, а не
      придумывают. Проверено запросом: занятых 181.
    -->
    <field name="path">my-settings</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_coop_open_settings()</field>
  </record>

  <!--
    Приватность: что из страницы видно посторонним.

    Пять переключателей, а не один «закрытый профиль»: человек охотно
    показывает, что умеет, и неохотно — сколько у него денег. Каждый
    действует сразу: полоса просто не рисуется.

    «Кто видит мою страницу» и «чёрный список» из макета сюда пока не
    входят: первое — правило видимости записи, второе — работа в
    переписке, и то и другое не экран, а поведение. Рисовать их раньше,
    чем они действуют, значит обещать несуществующее.
  -->
  <record id="view_coop_settings_privacy_form" model="ir.ui.view">
    <field name="name">coop.settings.privacy.form</field>
    <field name="model">res.partner</field>
    <field name="priority">101</field>
    <field name="arch" type="xml">
      <form string="Приватность" create="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Приватность</h1>
          </div>
          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Кто видит мою страницу</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="coop_page_audience" nolabel="1" widget="radio"/>
              </group>
              <div class="text-muted">
                Закрытую страницу посторонний не открывает и не находит в
                каталоге «Люди», но по-прежнему видит вас там, где вы
                действуете вместе: в составе организации, в общей сделке,
                в переписке. Публичной витрины для незарегистрированных у
                платформы пока нет — первые два ответа сегодня действуют
                одинаково.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Кто может мне писать</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="coop_message_audience" nolabel="1" widget="radio"/>
              </group>
              <div class="text-muted">
                Тому, кто писать не может, кнопка «Написать» на вашей
                странице отвечает уведомлением, а переписка не заводится.
                Заблокированные не могут написать в любом случае.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Чёрный список</span>
            </div>
            <div class="o_coop_band_body">
              <field name="coop_block_ids" nolabel="1"
                     invisible="not coop_block_ids">
                <list string="Заблокированные" create="false" editable="bottom">
                  <field name="blocked_id" string="Участник" readonly="1"/>
                  <field name="blocked_on" string="Заблокирован" readonly="1"/>
                </list>
              </field>
              <div class="text-muted" invisible="coop_block_ids">
                Список пуст. Заблокировать можно на странице участника.
              </div>
              <div class="text-muted" invisible="not coop_block_ids">
                Заблокированный не напишет вам и не откликнется на ваши
                объявления. Он об этом не извещается и узнаёт, только когда
                попробует написать. Чтобы разблокировать, уберите строку
                крестиком справа.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Что показывать в профиле</span>
            </div>
            <div class="o_coop_band_body">
              <div class="text-muted">
                Скрытое остаётся в вашей карточке — его просто не видит
                посторонний. Сами вы видите свою страницу целиком всегда.
              </div>
              <group string="Контакты">
                <field name="coop_show_phone"/>
                <field name="coop_show_email"/>
                <field name="coop_show_contacts"/>
              </group>
              <group string="Личное">
                <field name="coop_show_city"/>
                <field name="coop_show_birthdate"/>
                <field name="coop_show_orgs"/>
              </group>
              <group string="Репутация и связи">
                <field name="coop_show_trust"/>
                <field name="coop_show_deals"/>
                <field name="coop_show_balance"/>
                <field name="coop_show_friends"/>
                <field name="coop_show_followers"/>
              </group>
              <div class="text-muted">
                Если скрыть уровень доверия и число сделок, откликаться на
                ваши объявления будут заметно реже. Сами операции по счёту
                не видны никому, кроме вас, — и это не настройка, а устройство
                платформы.
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Язык и регион. Вкладка «Профиль» из макета сюда не переносится: имя,
    специализация, контакты правятся на самой карточке по месту (решение
    владельца 332), и второе место для тех же полей их бы рассинхронило.
  -->
  <record id="view_coop_settings_region_form" model="ir.ui.view">
    <field name="name">coop.settings.region.form</field>
    <field name="model">res.users</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <form string="Язык и регион" create="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Язык и регион</h1>
          </div>
          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Язык и часовой пояс</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="lang"/>
                <field name="tz"/>
              </group>
              <div class="text-muted">
                Часовой пояс решает, в котором часу вы видите время торгов,
                сроки заявок и отметки сообщений.
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Безопасность. Всё, кроме ключей кошелька, у движка уже есть: смена
    пароля, двухфакторная и список устройств. Здесь они собраны в одном
    месте и названы теми же словами, что в макете (`settings.html`,
    вкладка «Безопасность»): до этого сменить пароль на платформе было
    негде — штатные кнопки лежат в окне настроек пользователя Odoo, куда
    участник не ходит.

    Даты последней смены пароля в базе нет, и выдумывать её из
    `write_date` значило бы показывать любую правку анкеты как смену
    пароля — лучше не показывать ничего.
  -->
  <record id="view_coop_settings_security_form" model="ir.ui.view">
    <field name="name">coop.settings.security.form</field>
    <field name="model">res.users</field>
    <field name="priority">102</field>
    <field name="arch" type="xml">
      <form string="Безопасность" create="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Безопасность</h1>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Пароль</span>
            </div>
            <div class="o_coop_band_body">
              <button name="preference_change_password" type="object"
                      string="Сменить пароль" class="btn-primary"/>
              <div class="text-muted">
                Потребуется текущий пароль: иначе чужими руками за
                оставленным открытым экраном у вас отобрали бы доступ.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Двухфакторная проверка</span>
            </div>
            <div class="o_coop_band_body">
              <field name="totp_enabled" invisible="1"/>
              <div class="text-muted" invisible="totp_enabled">
                Подключите приложение-аутентификатор: второй фактор
                спрашивается при входе с нового устройства.
              </div>
              <div class="text-muted" invisible="not totp_enabled">
                Двухфакторная проверка включена.
              </div>
              <button name="action_totp_enable_wizard" type="object"
                      string="Подключить" class="btn-primary"
                      invisible="totp_enabled"/>
              <button name="action_totp_disable" type="object"
                      string="Отключить" class="btn-secondary"
                      invisible="not totp_enabled"
                      confirm="Отключить двухфакторную проверку?"/>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Активные сеансы</span>
            </div>
            <div class="o_coop_band_body">
              <field name="device_ids" nolabel="1" readonly="1">
                <list string="Устройства" create="false" delete="false">
                  <field name="display_name" string="Устройство"/>
                  <field name="city" string="Город" optional="show"/>
                  <field name="ip_address" string="Адрес" optional="hide"/>
                  <field name="last_activity" string="Последний раз"/>
                  <field name="is_current" string="Этот"/>
                </list>
              </field>
              <button name="action_revoke_all_devices" type="object"
                      string="Завершить все, кроме текущего"
                      class="btn-secondary"
                      confirm="Завершить все сеансы, кроме текущего?"/>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Ключи кошелька</span>
            </div>
            <div class="o_coop_band_body">
              <div class="text-muted">
                Кошелёк некастодиальный: секретная фраза хранится только
                у вас — платформа её не знает и восстановить не сможет.
                Проверьте, что резервная копия сделана.
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Оформление. Тема и вид каталогов живут в браузере, поэтому здесь не
    поля записи, а виджет: он пишет туда же, куда тумблер в шапке и
    переключатель вида в каталоге, и применяет выбранное сразу.

    «Открывать при входе» — наоборот, настройка учётной записи: это
    свойство человека, а не устройства. Берём штатное поле движка, а не
    заводим своё: оно уже решает, что показать после входа.
  -->
  <record id="view_coop_settings_appearance_form" model="ir.ui.view">
    <field name="name">coop.settings.appearance.form</field>
    <field name="model">res.users</field>
    <field name="priority">103</field>
    <field name="arch" type="xml">
      <form string="Оформление" create="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Оформление</h1>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Тема и каталоги</span>
            </div>
            <div class="o_coop_band_body">
              <widget name="coop_appearance"/>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Начало работы</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="action_id" string="Открывать при входе"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Моя страница"/>
              </group>
              <div class="text-muted">
                Пусто — платформа открывает то, чем вы пользовались в
                прошлый раз.
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Уведомления. Матрица «о чём — куда», как в макете (`settings.html`),
    но столбцов два, а не три: браузерных уведомлений на платформе нет,
    и переключатель push обещал бы несуществующее.

    Виды событий — те же, что у самих извещений: второй перечень
    разошёлся бы с первым при первом же новом разделе.
  -->
  <record id="view_coop_settings_notifications_form" model="ir.ui.view">
    <field name="name">coop.settings.notifications.form</field>
    <field name="model">res.partner</field>
    <field name="priority">104</field>
    <field name="arch" type="xml">
      <form string="Уведомления" create="false" duplicate="false"
            class="o_coop_profile o_coop_settings">
        <sheet>
          <div class="oe_title">
            <h1>Уведомления</h1>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>О чём и куда сообщать</span>
            </div>
            <div class="o_coop_band_body">
              <field name="coop_notification_pref_ids" nolabel="1">
                <list string="События" create="false" delete="false"
                      editable="bottom">
                  <field name="kind" string="О чём" readonly="1"/>
                  <field name="in_app" string="На платформе"/>
                  <field name="by_email" string="Почтой"/>
                </list>
              </field>
              <div class="text-muted">
                «На платформе» — колокольчик в шапке. Письма уходят на
                адрес из вашей карточки; пока он не указан, письма не
                отправляются.
              </div>
            </div>
          </div>

          <div class="o_coop_band">
            <div class="o_coop_band_head">
              <span>Тихие часы</span>
            </div>
            <div class="o_coop_band_body">
              <group>
                <field name="coop_quiet_hours"/>
                <field name="coop_quiet_from" widget="float_time"
                       invisible="not coop_quiet_hours"/>
                <field name="coop_quiet_to" widget="float_time"
                       invisible="not coop_quiet_hours"/>
              </group>
              <div class="text-muted">
                Тихие часы держат письма, а не извещения: колокольчик
                копит их всегда и никого не будит. Время — по вашему
                часовому поясу из вкладки «Язык и регион».
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_settings_privacy" model="ir.actions.server">
    <field name="name">Приватность</field>
    <field name="path">my-privacy</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_coop_open_settings('coop_settings.view_coop_settings_privacy_form', 'Приватность')</field>
  </record>

  <record id="action_coop_settings_region" model="ir.actions.server">
    <field name="name">Язык и регион</field>
    <field name="path">my-region</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env['res.users'].action_coop_open_region_settings()</field>
  </record>

  <menuitem id="menu_coop_settings_root" name="Настройки" sequence="950"/>
  <menuitem id="menu_coop_settings_account" name="Аккаунт"
            parent="menu_coop_settings_root" action="action_coop_settings"
            sequence="10"/>
  <menuitem id="menu_coop_settings_privacy" name="Приватность"
            parent="menu_coop_settings_root" action="action_coop_settings_privacy"
            sequence="20"/>
  <!--
    Действие висит на res.partner, а не на res.users: движок отказывает
    в серверном действии, если у человека нет доступа к его модели, а
    список пользователей участнику недоступен. Открываемая форма — всё
    равно его собственная запись пользователя, и её он читает и правит.
  -->
  <record id="action_coop_settings_security" model="ir.actions.server">
    <field name="name">Безопасность</field>
    <field name="path">my-security</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env['res.users'].action_coop_open_user_settings('coop_settings.view_coop_settings_security_form', 'Безопасность')</field>
  </record>

  <menuitem id="menu_coop_settings_security" name="Безопасность"
            parent="menu_coop_settings_root" action="action_coop_settings_security"
            sequence="40"/>

  <record id="action_coop_settings_appearance" model="ir.actions.server">
    <field name="name">Оформление</field>
    <field name="path">my-appearance</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env['res.users'].action_coop_open_user_settings('coop_settings.view_coop_settings_appearance_form', 'Оформление')</field>
  </record>

  <menuitem id="menu_coop_settings_appearance" name="Оформление"
            parent="menu_coop_settings_root" action="action_coop_settings_appearance"
            sequence="50"/>

  <record id="action_coop_settings_notifications" model="ir.actions.server">
    <field name="name">Уведомления</field>
    <field name="path">my-notifications</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_coop_open_notifications()</field>
  </record>

  <menuitem id="menu_coop_settings_notifications" name="Уведомления"
            parent="menu_coop_settings_root" action="action_coop_settings_notifications"
            sequence="25"/>

  <menuitem id="menu_coop_settings_region" name="Язык и регион"
            parent="menu_coop_settings_root" action="action_coop_settings_region"
            sequence="30"/>

  <!--
    Деньги и реквизиты — вкладка из состава, отобранного владельцем
    22 сентября 2026 (решение 377).

    Цена рядом со способом, а не в справке: решение 387 — «показывать
    всё, но с ценой». Спрятанный способ не исчезает, он уходит наружу,
    где никто не предупредит о шестидесяти процентах.
  -->
  <record id="view_coop_settings_money_form" model="ir.ui.view">
    <field name="name">coop.settings.money.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="Деньги и реквизиты" create="false" duplicate="false">
        <sheet>
          <div class="oe_title">
            <h1>Деньги и реквизиты</h1>
          </div>
          <group>
            <group string="Как принимаете">
              <field name="coop_payout_currency_id"/>
              <field name="coop_tax_regime"/>
            </group>
          </group>
          <separator string="Чем с вами можно рассчитаться"/>
          <field name="coop_settlement_method_ids" nolabel="1"
                 widget="many2many"
                 options="{'no_create': True, 'no_open': True}">
            <list>
              <field name="name"/>
              <field name="cost_hint" string="Во что обходится"/>
              <field name="cost_note" string="Отчего столько"/>
            </list>
          </field>
          <div class="text-muted mt-2">
            Цена сквозная: всё, что уходит в бюджет с обеих сторон вместе.
            Платформа не берёт с вас этих денег — она их называет, чтобы
            выбор был осознанным.
          </div>
          <separator string="Чего на платформе нет и не будет"/>
          <field name="coop_denied_settlement_ids" nolabel="1" readonly="1"
                 options="{'no_open': True}">
            <list create="false" delete="false">
              <field name="name"/>
              <field name="deny_reason" string="Отчего нельзя"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_settings_money" model="ir.actions.server">
    <field name="name">Деньги и реквизиты</field>
    <field name="path">my-money</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env['res.users'].action_coop_open_user_settings('coop_settings.view_coop_settings_money_form', 'Деньги и реквизиты')</field>
  </record>

  <menuitem id="menu_coop_settings_money" name="Деньги и реквизиты"
            parent="menu_coop_settings_root" action="action_coop_settings_money"
            sequence="35"/>

  <!--
    Данные и интеграции. Вывоз своих данных и удаление учётной записи —
    не украшение: это то, что участник вправе потребовать, и место под
    них лучше завести сразу, чем пришивать сбоку.

    Подключённых систем пока нет ни одной, и вкладка говорит об этом
    прямо. Пустой список честнее выдуманного: решение 373 ставит 1С
    первой, но её ещё нет.
  -->
  <record id="view_coop_settings_data_form" model="ir.ui.view">
    <field name="name">coop.settings.data.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="Данные и интеграции" create="false" duplicate="false">
        <sheet>
          <div class="oe_title">
            <h1>Данные и интеграции</h1>
          </div>

          <separator string="Подключённые системы"/>
          <div class="o_coop_empty text-muted">
            Ни одна система учёта пока не подключена. Когда появится связь
            с 1С и другими, здесь будет видно, что именно платформа берёт
            оттуда, и это можно будет выключить по каждому виду данных
            отдельно.
          </div>

          <separator string="Свои данные"/>
          <div>
            <button name="action_coop_export_archive" type="object"
                    string="Выгрузить всё своё одним файлом"
                    class="btn-secondary"/>
            <div class="text-muted mt-2">
              Карточка, членства и извещения — в одном файле, который
              читается и без платформы.
            </div>
          </div>

          <separator string="Удаление учётной записи"/>
          <div class="text-muted">
            Учётная запись участника кооператива не удаляется нажатием
            кнопки: выход из кооператива — решение собрания, а сделки и
            паевые движения остаются в учёте по закону. Напишите в
            рабочую группу платформы, и вас проведут через выход.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_settings_data" model="ir.actions.server">
    <field name="name">Данные и интеграции</field>
    <field name="path">my-data</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env['res.users'].action_coop_open_user_settings('coop_settings.view_coop_settings_data_form', 'Данные и интеграции')</field>
  </record>

  <menuitem id="menu_coop_settings_data" name="Данные и интеграции"
            parent="menu_coop_settings_root" action="action_coop_settings_data"
            sequence="60"/>

</odoo>
