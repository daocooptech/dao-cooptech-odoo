<?xml version="1.0" encoding="utf-8"?>
<!--
  Уведомления людей платформы — во «Входящие», не письмом (владелец
  15.11.2026: «сделай это общим решением»). У людей платформы почты нет:
  доставка «по почте» давала ошибку на каждом уведомлении. Группа
  «Входящие» движка становится частью «Пользователя» — у всех нынешних и
  новых внутренних пользователей `notification_type` = inbox сам собой
  (движок считает его по `all_group_ids`).
-->
<odoo>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('mail.group_mail_notification_type_inbox'))]"/>
    </record>
</odoo>
