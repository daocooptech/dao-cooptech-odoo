<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Страны перечня 430-р (решения 118, 414, 427, 500) — отметкой
       у стран справочника, с датой и основанием. Записи стран у движка
       под noupdate, поэтому отметка ставится функцией при каждом
       обновлении, а не записью в файле. Гражданство — тем, у кого оно
       пусто: по нему, а не по стране проживания, считают указы. -->
  <data noupdate="0">
    <function model="res.country" name="_coop_mark_unfriendly"/>
    <function model="res.partner" name="_coop_fill_citizenship"/>
  </data>
</odoo>
