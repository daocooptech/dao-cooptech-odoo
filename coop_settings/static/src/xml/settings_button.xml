    из движка. Рядом с колоколом и поиском шрифтовая шестерёнка
    читалась жирнее соседей: у платформы свой набор линейных значков
    в 18 точек и обводкой 1.7, и ряд в шапке должен быть набран одним
    почерком.
  -->
  <t t-name="coop_settings.Button">
    <div class="o_coop_settings_btn">
      <button type="button" class="btn" title="Настройки" aria-label="Настройки"
              t-on-click="() => this.open()">
