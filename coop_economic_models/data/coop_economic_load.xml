<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Справочник собирается кодом, а не шестьюдесятью тремя записями XML:
    форма и режим описаны по одному разу каждый, строка складывается из
    них. Через <function>, а не через хук установки: хук выполняется
    только при первой установке, а закон меняется, и правки текста
    должны доезжать при обновлении модуля.
  -->
  <function model="coop.economic.loader" name="load_forms"/>
</odoo>
