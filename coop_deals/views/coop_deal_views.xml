<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coop_deal_kanban" model="ir.ui.view">
    <field name="name">coop.deal.kanban</field>
    <field name="model">coop.deal</field>
    <field name="arch" type="xml">
      <kanban js_class="coop_catalog_kanban" class="o_coop_deals">
        <field name="party_b_id"/>
        <field name="number"/>
        <field name="city"/>
        <field name="subject"/>
        <field name="icon"/>
        <field name="way"/>
        <field name="amount"/>
        <field name="state"/>
        <field name="outcome"/>
        <field name="currency_id"/>
        <field name="image_512"/>
        <templates>
          <t t-name="card">
            <!-- Общая карточка каталога: слева квадрат со значком, справа
                 тело. Так же устроены ЦФА, НМА, уступки и события — и так
                 карточка получает правила ровной плитки из coop_theme.
                 Своим у сделки остаётся номер, стороны, сумма и состояние. -->
            <div class="o_coop_listing o_coop_deal_card">
              <!-- Фотография предмета, если сделка выросла из объявления
                   о ресурсе; иначе значок по предмету сделки. -->
              <!-- Снимок карточки. Свой, если есть; иначе лицо той стороны,
                   с которой придётся иметь дело, — знак организации или
                   аватар человека. Значок остаётся последним средством. -->
              <div class="o_coop_media">
                <field name="image_512" widget="image" t-if="record.image_512.raw_value"/>
                <img class="o_coop_media_logo" t-elif="record.party_b_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.party_b_id.raw_value}/image_512"
                     t-att-alt="record.party_b_id.value"/>
                <span t-else="" class="o_coop_media_sign"><t t-esc="record.icon.value"/></span>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>
              <div class="o_coop_listing_body">
                <div class="o_coop_deal_top">
                  <span class="o_coop_badge_subject"><t t-esc="record.subject.value"/></span>
                  <span class="o_coop_deal_no"><t t-esc="record.number.value"/></span>
                </div>
                <div class="o_coop_listing_title"><field name="name"/></div>
                <div class="o_coop_listing_meta">
                  <t t-esc="record.way.value"/>
                  <t t-if="record.city.raw_value"> · <t t-esc="record.city.value"/></t>
                </div>
                <div class="o_coop_deal_parties">
                  <field name="party_a_id"/> ↔ <field name="party_b_id"/>
                </div>
                <div class="o_coop_listing_foot">
                  <span class="o_coop_deal_amount"><field name="amount" widget="monetary"/></span>
                  <span class="o_coop_deal_state"
                        t-att-class="'o_coop_state_' + record.state.raw_value">
                    <t t-esc="record.state.value"/>
                  </span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_deal_list" model="ir.ui.view">
    <field name="name">coop.deal.list</field>
    <field name="model">coop.deal</field>
    <field name="arch" type="xml">
      <list string="Сделки" decoration-muted="state == 'cancelled'"
            decoration-danger="state == 'disputed'">
        <field name="number"/>
        <field name="name"/>
        <field name="subject"/>
        <field name="way"/>
        <field name="party_a_id"/>
        <field name="party_b_id"/>
        <field name="city" optional="show"/>
        <field name="signed_on"/>
        <field name="amount" sum="Сумма"/>
        <field name="amount_paid" optional="hide" sum="Оплачено"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="outcome" optional="show" widget="badge"
               decoration-success="outcome == 'positive'"
               decoration-danger="outcome == 'negative'"/>
        <field name="state" widget="badge"
               decoration-success="state == 'done'"
               decoration-info="state in ('agreed', 'active', 'acceptance')"
               decoration-danger="state == 'disputed'"/>
      </list>
    </field>
  </record>

  <!--
    Окно отзыва: оценка и пара слов. Кого оценивают, спрашивать незачем —
    в сделке две стороны, и вторая известна.
  -->
  <record id="view_coop_deal_review_wizard_form" model="ir.ui.view">
    <field name="name">coop.deal.review.wizard.form</field>
    <field name="model">coop.deal.review.wizard</field>
    <field name="arch" type="xml">
      <form string="Отзыв">
        <field name="deal_id" invisible="1"/>
        <group>
          <field name="target_id" readonly="1"/>
          <field name="rating" widget="radio"/>
          <field name="body" placeholder="Что получилось и что стоило бы сделать иначе. Необязательно."/>
        </group>
        <div class="alert alert-info" role="status">
          Оба отзыва раскрываются одновременно — когда написаны оба. Пока
          второй не написан, вашу оценку никто не увидит.
        </div>
        <footer>
          <button name="action_send" type="object" string="Оставить отзыв"
                  class="btn-primary"/>
          <button string="Отмена" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_deal_form" model="ir.ui.view">
    <field name="name">coop.deal.form</field>
    <field name="model">coop.deal</field>
    <field name="arch" type="xml">
      <form string="Сделка">
        <header>
          <button name="action_agree" type="object" string="Согласовать"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_start" type="object" string="Начать исполнение"
                  class="btn-primary" invisible="state != 'agreed'"/>
          <button name="action_confirm_act" type="object"
                  string="Подтвердить акт" class="btn-primary"
                  invisible="state not in ('active', 'acceptance')"/>
          <button name="action_review" type="object" string="Оставить отзыв"
                  class="btn-primary" invisible="not can_review"/>
          <button name="action_open_dispute" type="object" string="Открыть спор"
                  invisible="state in ('draft', 'done', 'cancelled', 'disputed')"/>
          <button name="action_resolve_dispute" type="object"
                  string="Закрыть спор" class="btn-primary"
                  invisible="state != 'disputed'"
                  groups="base.group_system"/>
          <button name="action_cancel" type="object" string="Отменить"
                  invisible="state in ('done', 'cancelled')"/>
          <!--
            Печать своими кнопками, а не шестерёнкой движка.

            Обе бумаги были только в штатном «Меню действий» — том самом,
            которое владелец велел убрать со страниц платформы (решение
            349). Убрать его со сделки, не выведя печать наружу, значит
            отнять у сторон договор и акт: другого пути к ним на странице
            нет.

            Договор появляется, как только сделка согласована: до этого
            печатать нечего, идут переговоры. Акт — только когда его
            подтвердили обе стороны: в самой бумаге стоит дата подписания,
            и напечатанный раньше акт — это лист с пустой датой, который
            выглядит как документ.
          -->
          <button name="%(coop_deals.action_report_deal_agreement)d"
                  type="action" string="Договор"
                  invisible="state == 'draft'"/>
          <button name="%(coop_deals.action_report_deal_act)d"
                  type="action" string="Акт"
                  invisible="not act_confirmed_on"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,agreed,active,acceptance,done"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <div class="oe_title">
            <span class="o_form_label">Сделка</span>
            <h1><field name="number" readonly="1"/></h1>
            <field name="name" placeholder="Что передаётся" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/>
          </div>
          <group>
            <group string="Стороны">
              <field name="party_a_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="role_a" placeholder="продавец, арендатор, исполнитель" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/>
              <field name="party_b_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="role_b" placeholder="покупатель, арендодатель, заказчик" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/>
              <field name="author_id" widget="coop_inline" readonly="not coop_can_edit"/>
            </group>
            <group string="Условия">
              <field name="subject" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/>
              <field name="way" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="city" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="signed_on" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="closed_on" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="amount" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <group string="Предмет" col="4">
            <field name="resource_id" invisible="subject != 'resource'" widget="coop_inline" readonly="not coop_can_edit"/>
            <field name="skill_offer_id" invisible="subject != 'service'" widget="coop_inline" readonly="not coop_can_edit"/>
            <field name="vacancy_id" invisible="subject != 'work'" widget="coop_inline" readonly="not coop_can_edit"/>
            <field name="project_id" invisible="subject != 'project'" widget="coop_inline" readonly="not coop_can_edit"/>
          </group>
          <notebook>
            <page string="Спецификация" name="lines">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="quantity"/>
                  <field name="uom_name"/>
                  <field name="price_unit"/>
                  <field name="subtotal" sum="Итого"/>
                  <field name="currency_id" column_invisible="True"/>
                </list>
              </field>
            </page>
            <page string="График платежей" name="payments">
              <div class="alert alert-info" role="status">
                Деньги через платформу не ходят. Здесь записана
                договорённость: стороны согласовали рассрочку, а факт
                получения отмечает получатель — «я заплатил» и «я получил»
                имеют разную доказательную силу.
              </div>
              <field name="payment_ids">
                <list editable="bottom" decoration-danger="state == 'overdue'"
                      decoration-success="state == 'paid'">
                  <field name="name"/>
                  <field name="payer_id"/>
                  <field name="payee_id"/>
                  <field name="due_on"/>
                  <field name="amount" sum="Всего"/>
                  <field name="currency_id" column_invisible="True"/>
                  <field name="state"/>
                  <field name="paid_on" readonly="1"/>
                  <field name="confirmed_by_id" readonly="1" optional="hide"/>
                  <button name="action_mark_paid" type="object"
                          string="Отметить получение" icon="fa-check"
                          invisible="state == 'paid'"/>
                </list>
              </field>
              <group class="oe_subtotal_footer">
                <field name="amount_paid"/>
                <field name="amount_due"/>
              </group>
            </page>
            <page string="Акт приёма-передачи" name="act">
              <group>
                <group>
                  <field name="act_confirmed_a" readonly="1"/>
                  <field name="act_confirmed_b" readonly="1"/>
                  <field name="act_confirmed_on" readonly="1"/>
                </group>
              </group>
              <div class="alert alert-info" role="status">
                Сделка считается исполненной, когда акт подтвердили обе
                стороны. Одностороннее «я всё сдал» ничего не значит:
                приёмка на то и приёмка, что её делает принимающий.
              </div>
            </page>
            <page string="Отзывы" name="reviews">
              <field name="can_review" invisible="1"/>
              <field name="reviews_visible" readonly="1"/>
              <field name="outcome" readonly="1"/>
              <field name="review_ids">
                <list>
                  <field name="author_id"/>
                  <field name="target_id"/>
                  <field name="rating"/>
                  <field name="body"/>
                  <field name="visible" widget="boolean_toggle" readonly="1"/>
                </list>
              </field>
              <div class="alert alert-info" role="status">
                Оба отзыва показываются одновременно — когда написаны оба.
                Если открывать сразу, второй пишется с оглядкой на первый,
                а то и в отместку, и обе оценки перестают значить
                что-либо.
              </div>
            </page>
            <page string="Спор" name="dispute" invisible="state != 'disputed' and not dispute_resolved_on">
              <group>
                <group>
                  <field name="dispute_opened_by_id" readonly="1"/>
                  <field name="dispute_resolved_by_id" readonly="1"/>
                  <field name="dispute_resolved_on" readonly="1"/>
                </group>
              </group>
              <field name="dispute_reason" placeholder="Существо спора" widget="coop_block" readonly="not coop_can_edit"/>
              <field name="dispute_resolution" placeholder="Решение по спору"
                     groups="base.group_system" widget="coop_block" readonly="not coop_can_edit"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_deal_search" model="ir.ui.view">
    <field name="name">coop.deal.search</field>
    <field name="model">coop.deal</field>
    <field name="arch" type="xml">
      <search string="Сделки">
        <field name="number"/>
        <field name="name"/>
        <field name="party_a_id"/>
        <field name="party_b_id"/>
        <field name="city"/>
        <filter name="active_deals" string="В работе"
                domain="[('state', 'in', ('agreed', 'active', 'acceptance'))]"/>
        <filter name="done" string="Завершённые" domain="[('state', '=', 'done')]"/>
        <filter name="disputed" string="Спорные" domain="[('state', '=', 'disputed')]"/>
        <separator/>
        <filter name="awaiting_reviews" string="Ждут отзывов"
                domain="[('outcome', '=', 'pending')]"/>
        <filter name="overdue" string="С просроченным платежом"
                domain="[('payment_ids.state', '=', 'overdue')]"/>
        <group>
          <filter name="by_state" string="По состоянию" context="{'group_by': 'state'}"/>
          <filter name="by_subject" string="По предмету" context="{'group_by': 'subject'}"/>
          <filter name="by_way" string="По способу" context="{'group_by': 'way'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_deals" model="ir.actions.act_window">
    <field name="name">Сделки</field>
    <field name="res_model">coop.deal</field>
    <field name="path">deals</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Начать сделку', 'coop_shelf_field': 'way'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Сделок пока нет</p>
      <p>
        Сделка на платформе — между равноправными сторонами. Продажа, аренда,
        обмен, дар, доля в проекте, взаимный кредит: продавца и покупателя тут
        не всегда двое.
      </p>
    </field>
  </record>

  <record id="action_coop_deal_review" model="ir.actions.act_window">
    <field name="name">Отзывы по сделкам</field>
    <field name="res_model">coop.deal.review</field>
    <field name="view_mode">list,form</field>
      <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Отзывов пока нет</p>
      <p>Отзыв пишется после завершения сделки, обеими сторонами. Оба показываются только когда написаны оба — иначе первый отзыв влиял бы на второй, а не описывал сделку.</p>
    </field>
</record>

  <menuitem id="menu_coop_deals_root" name="Сделки" sequence="19"
            web_icon="coop_deals,static/description/icon.png"/>
  <menuitem id="menu_coop_deals" name="Мои сделки"
            parent="menu_coop_deals_root" action="action_coop_deals" sequence="10"/>
  <menuitem id="menu_coop_deal_review" name="Отзывы"
            parent="menu_coop_deals_root" action="action_coop_deal_review" sequence="20"/>

</odoo>
