<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Карточка навыка: слева фотография работы с аватаром мастера в углу,
    справа заголовок, ставка, мета-строка, описание и чипы умений.

    Уточнение к прежней записи здесь: в макете у каталога **два** вида —
    по умолчанию плиточный, строка включается переключателем, и выбор
    запоминается на все каталоги сразу. Строкой сделан вид по умолчанию
    осознанно: навык выбирают по описанию, а в плитке описание живёт
    двумя словами и многоточием. Плиточный вид и переключатель к нему —
    незакрытый долг переноса, он записан в открытые вопросы.
  -->
  <record id="view_coop_skill_kanban" model="ir.ui.view">
    <field name="name">coop.skill.offer.kanban</field>
    <field name="model">coop.skill.offer</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_skills" quick_create="false" js_class="coop_catalog_kanban">
        <field name="image_512"/>
        <field name="city"/>
        <field name="rate_display"/>
        <field name="experience_display"/>
        <field name="ready_to_travel"/>
        <field name="partner_id"/>
        <field name="partner_trust"/>
        <field name="updated_display"/>
        <field name="partner_offer_count"/>
        <field name="state"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_skill">
              <div class="o_coop_skill_photo o_coop_media">
                <!-- Цепочка одна на все каталоги: свой снимок, иначе лицо той
                     стороны, с которой придётся иметь дело, иначе значок
                     раздела. Штатное поле-картинка так не умеет: при пустом
                     значении оно рисует заглушку «добавить фото», и карточка
                     выглядит незагрузившейся. -->
                <field name="image_512" widget="image" t-if="record.image_512.raw_value"/>
                <img class="o_coop_media_logo" t-elif="record.partner_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/image_512"
                     t-att-alt="record.partner_id.value"/>
                <span t-else="" class="o_coop_media_sign"><field name="id" widget="coop_sign" options="{'icon': 'tools'}"/></span>
                <!-- Аватар владельца адресом изображения: помощника
                     kanban_image в Odoo 19 больше нет. -->
                <img class="o_coop_skill_owner"
                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/avatar_128"
                     t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="oi" data-icon="location_on" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>

              <div class="o_coop_skill_body">
                <div class="o_coop_skill_name"><field name="name"/></div>
                <div class="o_coop_skill_rate"><field name="rate_display"/></div>
                <div class="o_coop_skill_meta">
                  <field name="partner_id"/>
                  <span t-if="record.ready_to_travel.raw_value">, готов к командировкам</span>
                  <span> · </span>
                  <field name="experience_display"/>
                  <!-- Доверие владельца — главный собственный сигнал
                       платформы, и в каталоге, где выбирают исполнителя,
                       прятать его нельзя. У новичка это не «ноль
                       процентов», а «пока не считается»: ноль читался бы
                       как плохая репутация. -->
                  <span t-if="record.partner_trust.raw_value"> · Доверие <field name="partner_trust"/>%</span>
                  <span t-if="!record.partner_trust.raw_value" class="o_coop_skill_muted"> · доверие пока не считается</span>
                </div>
                <div class="o_coop_skill_desc">
                  <field name="description" widget="html"/>
                </div>
                <div class="o_coop_skill_chips">
                  <field name="skill_ids" widget="many2many_tags"/>
                </div>
                <div class="o_coop_skill_foot">
                  <span class="o_coop_skill_updated"><field name="updated_display"/></span>
                  <div class="o_coop_skill_actions">
                    <button name="action_partner_offers" type="object"
                            class="btn o_coop_skill_link"
                            t-if="record.partner_offer_count.raw_value">
                      Ещё <field name="partner_offer_count"/> у автора
                    </button>
                    <button name="action_message_owner" type="object"
                            class="btn o_coop_skill_btn">Написать</button>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_skill_list" model="ir.ui.view">
    <field name="name">coop.skill.offer.list</field>
    <field name="model">coop.skill.offer</field>
    <field name="arch" type="xml">
      <list string="Навыки">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="coop_specialization_id" optional="show"/>
        <field name="city"/>
        <!-- Числа, а не их словесная запись: по вычисляемой строке
             сортировка идёт по алфавиту, и «от 100 000» встаёт выше
             «от 70 000». Словесный вид остаётся карточке. -->
        <field name="experience_months" string="Опыт, мес."/>
        <field name="employment" optional="show"/>
        <field name="work_schedule" optional="show"/>
        <field name="rate" string="Ставка" optional="show"/>
        <field name="rate_kind" string="Уточнение" optional="hide"/>
        <field name="skill_ids" widget="many2many_tags" optional="hide"/>
        <field name="partner_trust" string="Доверие, %"/>
        <field name="write_date" string="Обновлено"/>
        <field name="state" widget="badge"
               decoration-success="state == 'published'"
               decoration-muted="state != 'published'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_skill_form" model="ir.ui.view">
    <field name="name">coop.skill.offer.form</field>
    <field name="model">coop.skill.offer</field>
    <field name="arch" type="xml">
      <form string="Предложение навыка" class="o_coop_show">
        <header>
          <!-- Публикация, пауза и стадии — только разместившему
               (владелец 08.10.2026); остальным — «Написать» и контакты. -->
          <field name="coop_is_mine" invisible="1"/>
          <field name="coop_role_label" invisible="not coop_role_label"/>
          <button name="action_publish" type="object" string="Опубликовать"
                  class="btn-primary" invisible="not coop_is_mine or state != 'draft'"/>
          <button name="action_publish" type="object" string="Возобновить"
                  class="btn-primary" invisible="not coop_is_mine or state != 'paused'"/>
          <button name="action_pause" type="object" string="Приостановить"
                  invisible="not coop_is_mine or state != 'published'"/>
          <!-- «Показать контакты» — как в макете (`skill.html`):
               телефон и почта не выставлены сразу, а открываются
               по нажатию. -->
          <button name="action_show_contacts" type="object"
                  string="Показать контакты" invisible="coop_is_mine"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,published,paused"
                 invisible="not coop_is_mine"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <!--
            Витрина навыка (дизайн-система, `SkillPage`, решение 625):
            те же плоскости, что у страницы ресурса — шапка со снимком
            работы, ставкой и умениями; основная колонка; боковая с
            карточкой человека. Пустое смотрящему не показывается, а
            правка условий — отдельным блоком только хозяину.
          -->
          <section class="coop-show_hero">
            <div class="coop-gallery">
              <!-- Фото и видео — две карусели (`coop_media`, задача 424). -->
              <field name="coop_media_data" widget="coop_media" nolabel="1" readonly="1"/>
            </div>
            <div class="coop-show_info">
              <div class="coop-show_kicker">
                <!-- Плашки над названием нет (владелец 10.11.2026: «везде
                     убери эту таблетку»). -->
                <field name="coop_specialization_id" readonly="1" nolabel="1"
                       options="{'no_open': True}"/>
              </div>
              <div class="oe_title">
                <h1 class="coop-show_title"><field name="name" placeholder="Чем занимаетесь" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/></h1>
              </div>
              <ul class="coop-show_meta">
                <li invisible="not city"><field name="city" readonly="1" nolabel="1"/></li>
                <li invisible="not ready_to_travel">Готов к командировкам</li>
                <li invisible="not experience_display">
                  <field name="experience_display" readonly="1" nolabel="1"/>
                </li>
              </ul>
              <hr class="coop-show_rule"/>
              <div class="coop-price">
                <span class="coop-price_label">Ставка</span>
                <span class="coop-price_value">
                  <field name="rate_display" readonly="1" nolabel="1"/>
                </span>
              </div>
              <div class="coop-show_words" invisible="not skill_ids">
                <h3>Умения</h3>
                <field name="skill_ids" widget="many2many_tags" readonly="1" nolabel="1"
                       options="{'no_open': True}"/>
              </div>
            </div>
          </section>
          <div class="coop-show_grid">
            <div class="coop-show_main">
              <!-- Условия правит только хозяин; остальным те же значения
                   видны в шапке словами. -->
              <section class="coop-show_block" invisible="not coop_can_edit">
                <h2>Условия</h2>
                <!-- Группы друг под другом, а не в две колонки: основная
                     колонка витрины узкая, и метки второй группы
                     наезжали на значения первой (владелец 10.11.2026). -->
                <group col="1">
                  <group string="Кто и где">
                    <field name="partner_id" widget="coop_inline"/>
                    <field name="city" widget="coop_inline"/>
                    <field name="ready_to_travel"/>
                    <field name="coop_specialization_id" options="{'no_create': True}" widget="coop_inline"/>
                    <field name="employment" widget="coop_inline"/>
                    <field name="work_schedule" widget="coop_inline"/>
                  </group>
                  <group string="Ставка и опыт">
                    <field name="rate_kind" widget="coop_inline"/>
                    <label for="rate"/>
                    <div class="o_row">
                      <field name="rate" readonly="rate_kind == 'piece'" widget="coop_inline"/>
                      <field name="rate_period" readonly="rate_kind == 'piece'" widget="coop_inline"/>
                    </div>
                    <field name="experience_months"
                           help="Полных месяцев работы по этому направлению. Ниже видно, как это будет написано в каталоге." widget="coop_inline"/>
                  </group>
                </group>
                <group string="Умения">
                  <!-- Без создания на лету: умение в Odoo обязано
                       принадлежать типу, а из тега на форме тип не
                       задать — получится запись мимо справочника. -->
                  <field name="skill_ids" widget="many2many_tags" nolabel="1"
                         options="{'no_create_edit': True, 'no_create': True}"/>
                </group>
              </section>
              <section class="coop-show_block" invisible="not description and not coop_can_edit">
                <h2>Чем могу помочь</h2>
                <field name="description"
                       placeholder="Что именно готовы делать, с каким оборудованием, какие есть допуски." widget="coop_block" readonly="not coop_can_edit"/>
                <!-- Четыре факта, как в образце `SkillPage`: ставка, опыт,
                     командировки, город — короткими значениями, чтобы
                     плашки не тянулись в три строки. -->
                <dl class="coop-show_facts">
                  <div>
                    <dt>Ставка</dt>
                    <dd><field name="rate_display" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div>
                    <dt>Опыт</dt>
                    <dd><field name="experience_short" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div>
                    <dt>Командировки</dt>
                    <dd><span invisible="not ready_to_travel">готов</span><span invisible="ready_to_travel">нет</span></dd>
                  </div>
                  <div invisible="not city">
                    <dt>Город</dt>
                    <dd><field name="city" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div invisible="not employment">
                    <dt>Занятость</dt>
                    <dd><field name="employment" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div invisible="not work_schedule">
                    <dt>График</dt>
                    <dd><field name="work_schedule" readonly="1" nolabel="1"/></dd>
                  </div>
                </dl>
              </section>
              <notebook class="coop-show_tabs"/>
            </div>
            <aside class="coop-show_aside">
              <div class="coop-owner">
                <span class="coop-owner_title">Кто предлагает</span>
                <div class="coop-owner_who">
                  <field name="partner_avatar" widget="image" readonly="1" nolabel="1"
                         class="coop-owner_pic" options="{'size': [48, 48]}"/>
                  <div class="coop-owner_name">
                    <field name="partner_id" readonly="1" nolabel="1"/>
                    <span invisible="not city"><field name="city" readonly="1" nolabel="1"/></span>
                  </div>
                </div>
                <div class="coop-owner_trust">
                  <div class="coop-owner_trust_head">
                    <span>Уровень доверия</span>
                    <b><field name="partner_trust" readonly="1" nolabel="1"/> %</b>
                  </div>
                  <field name="partner_trust" widget="progressbar" readonly="1" nolabel="1"
                         class="coop-owner_bar"/>
                </div>
                <dl class="coop-owner_stats">
                  <div>
                    <dt>сделок</dt>
                    <dd><field name="partner_deals_done" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div>
                    <dt>отзывов</dt>
                    <dd><field name="partner_deals_reviewed" readonly="1" nolabel="1"/></dd>
                  </div>
                </dl>
                <div class="coop-owner_acts" invisible="coop_is_mine">
                  <button name="action_message_owner" type="object" class="btn-secondary"
                          string="Написать"/>
                </div>
              </div>
            </aside>
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!--
    Страница «Добавить навык» по дизайн-системе (`SkillAddPage`, решение
    625): слева разделы с номерами, справа живая плитка каталога, готовность
    и кнопки — как у страницы добавления ресурса. Выбрана организация в «От
    чьего имени» — это «Добавить услугу» (`ServiceAddPage`): та же запись,
    другие подписи. Черновик заводит `action_new_offer`.
  -->
  <record id="view_coop_skill_add" model="ir.ui.view">
    <field name="name">coop.skill.offer.add</field>
    <field name="model">coop.skill.offer</field>
    <!-- Ниже витрины: при равном приоритете «add» по алфавиту обогнал бы
         «form», и каталог открывал бы предложение формой ввода. -->
    <field name="priority">30</field>
    <field name="arch" type="xml">
      <form string="Добавить навык" class="o_coop_add_form">
        <sheet>
          <field name="state" invisible="1"/>
          <field name="write_date" invisible="1"/>
          <field name="partner_is_company" invisible="1"/>
          <field name="coop_publisher_ids" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <div class="coop-add_header">
            <h1 invisible="partner_is_company">Добавить навык</h1>
            <h1 invisible="not partner_is_company">Добавить услугу</h1>
            <p class="coop-add_intro" invisible="state != 'draft' or partner_is_company">
              Черновик сохраняется сам — можно уйти и вернуться, он будет в
              «Моих предложениях». После публикации навык появится в каталоге
              навыков и на вашей странице.
            </p>
            <p class="coop-add_intro" invisible="state != 'draft' or not partner_is_company">
              Черновик сохраняется сам — можно уйти и вернуться, он будет в
              «Моих предложениях». После публикации услуга появится в каталоге
              навыков и на полке «Услуги» организации.
            </p>
            <p class="coop-add_intro" invisible="state == 'draft'">
              Правки видны в каталоге сразу после сохранения.
            </p>
          </div>
          <div class="coop-add">
            <div class="coop-add_main">

              <section class="coop-add_sec" name="add_who">
                <div class="coop-add_sec_head">
                  <field name="id" widget="coop_add_step" nolabel="1"
                         options="{'num': 1, 'fields': ['partner_id']}"/>
                  <div>
                    <h2>От чьего имени</h2>
                    <p>Своё умение — от себя. Выберите организацию, от имени
                      которой действуете, — и это станет её услугой.</p>
                  </div>
                </div>
                <div class="coop-add_sec_body">
                  <div class="coop-add_field">
                    <field name="partner_id" widget="badges_many2one" nolabel="1"
                           domain="[('id', 'in', coop_publisher_ids)]"/>
                  </div>
                </div>
              </section>

              <section class="coop-add_sec" name="add_what">
                <div class="coop-add_sec_head">
                  <field name="id" widget="coop_add_step" nolabel="1"
                         options="{'num': 2, 'fields': ['name', 'coop_specialization_id'], 'empty': 'Новый навык'}"/>
                  <div>
                    <h2 invisible="partner_is_company">Чем занимаетесь</h2>
                    <h2 invisible="not partner_is_company">Какая услуга</h2>
                    <p>Коротко и так, как называют это заказчики. По специализации
                      навык найдут в каталоге и в подборе людей.</p>
                  </div>
                </div>
                <div class="coop-add_sec_body">
                  <div class="coop-add_top">
                    <div>
                      <div class="coop-photo">
                        <field name="image_1920" widget="image" nolabel="1"/>
                      </div>
                      <div class="coop-photo_hint">Фото работы — первое, на что смотрят в каталоге</div>
                    </div>
                    <div class="d-flex flex-column gap-3">
                      <div class="coop-add_field coop-add_title">
                        <label for="name" string="Чем занимаетесь" invisible="partner_is_company"/>
                        <label for="name" string="Название услуги" invisible="not partner_is_company"/>
                        <field name="name" nolabel="1"
                               placeholder="Например, Электромонтажник"/>
                      </div>
                      <div class="coop-add_row">
                        <div class="coop-add_field">
                          <label for="coop_specialization_id" string="Специализация"/>
                          <field name="coop_specialization_id" nolabel="1"
                                 options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <div class="coop-add_field">
                          <label for="coop_specialization_category_id" string="Сфера деятельности"/>
                          <field name="coop_specialization_category_id" nolabel="1" readonly="1"
                                 options="{'no_open': True}"/>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="coop-add_sec" name="add_skills">
                <div class="coop-add_sec_head">
                  <field name="id" widget="coop_add_step" nolabel="1"
                         options="{'num': 3, 'fields': ['skill_ids']}"/>
                  <div>
                    <h2>Умения</h2>
                    <p>Из чего складывается работа: конкретные операции и допуски.
                      По ним ищут исполнителя.</p>
                  </div>
                </div>
                <div class="coop-add_sec_body">
                  <div class="coop-add_field">
                    <field name="skill_ids" widget="many2many_tags" nolabel="1"
                           placeholder="Например, монтаж щитов"
                           options="{'no_create': True}"/>
                  </div>
                </div>
              </section>

              <section class="coop-add_sec" name="add_rate">
                <div class="coop-add_sec_head">
                  <field name="id" widget="coop_add_step" nolabel="1"
                         options="{'num': 4, 'any': True, 'fields': ['rate', 'experience_months']}"/>
                  <div>
                    <h2>Ставка и опыт</h2>
                    <p>Ставку видно на карточке каталога. Сдельную работу так и
                      отметьте — сумму обсудите с заказчиком.</p>
                  </div>
                </div>
                <div class="coop-add_sec_body">
                  <div class="coop-add_field">
                    <label for="rate_kind" string="Ставка"/>
                    <field name="rate_kind" widget="badges_selection" nolabel="1"/>
                  </div>
                  <div class="coop-add_row" invisible="rate_kind == 'piece'">
                    <div class="coop-add_field">
                      <label for="rate" string="Сумма"/>
                      <field name="rate" nolabel="1"/>
                    </div>
                  </div>
                  <div class="coop-add_field" invisible="rate_kind == 'piece'">
                    <label for="rate_period" string="Период"/>
                    <field name="rate_period" widget="badges_selection" nolabel="1"/>
                  </div>
                  <div class="coop-add_pair">
                    <div class="coop-add_field">
                      <label for="experience_years" string="Опыт, лет"/>
                      <field name="experience_years" nolabel="1"/>
                    </div>
                    <div class="coop-add_field">
                      <label for="experience_rest_months" string="и месяцев"/>
                      <field name="experience_rest_months" nolabel="1"/>
                    </div>
                  </div>
                  <!-- Занятость и график — решение 661 п. 4: по ним отбирают
                       в каталоге, и без них новое предложение в отбор не попадёт. -->
                  <div class="coop-add_row">
                    <div class="coop-add_field">
                      <label for="employment" string="Занятость"/>
                      <field name="employment" widget="badges_selection" nolabel="1"/>
                    </div>
                    <div class="coop-add_field">
                      <label for="work_schedule" string="График"/>
                      <field name="work_schedule" widget="badges_selection" nolabel="1"/>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <field name="ready_to_travel" nolabel="1"/>
                    <label for="ready_to_travel" string="Готов к командировкам"/>
                  </div>
                  <div class="coop-add_help coop-add_incat">
                    <span>В каталоге:</span>
                    <field name="rate_display" readonly="1" nolabel="1"/>
                    <span>·</span>
                    <field name="experience_display" readonly="1" nolabel="1"/>
                  </div>
                </div>
              </section>

              <section class="coop-add_sec" name="add_description">
                <div class="coop-add_sec_head">
                  <field name="id" widget="coop_add_step" nolabel="1"
                         options="{'num': 5, 'fields': ['description', 'city']}"/>
                  <div>
                    <h2>Описание</h2>
                    <p>Город виден на карточке, описание — на странице навыка.</p>
                  </div>
                </div>
                <div class="coop-add_sec_body">
                  <div class="coop-add_field">
                    <field name="description" nolabel="1"
                           placeholder="Что именно готовы делать, с каким оборудованием, какие есть допуски."/>
                  </div>
                  <div class="coop-add_row">
                    <div class="coop-add_field" name="add_city">
                      <label for="city" string="Город"/>
                      <field name="city" widget="coop_city" nolabel="1"
                             placeholder="Начните вводить город"/>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <aside class="coop-add_aside">
              <div class="coop-add_preview">
                <span>Так увидят в каталоге</span>
                <field name="id" widget="coop_skill_preview" nolabel="1"/>
              </div>
              <field name="id" widget="coop_add_ready" nolabel="1"
                     options="{'items': [
                       {'field': 'name', 'label': 'Чем занимаетесь', 'required': True, 'empty': 'Новый навык', 'anchor': 'add_what'},
                       {'field': 'image_1920', 'label': 'Фото работы', 'anchor': 'add_what'},
                       {'field': 'coop_specialization_id', 'label': 'Специализация', 'anchor': 'add_what'},
                       {'field': 'skill_ids', 'label': 'Умения', 'anchor': 'add_skills'},
                       {'fields': ['rate', 'experience_months'], 'label': 'Ставка и опыт', 'anchor': 'add_rate'},
                       {'field': 'city', 'label': 'Город', 'required': True, 'anchor': 'add_description'},
                       {'field': 'description', 'label': 'Описание', 'anchor': 'add_description'}
                     ]}"/>
              <div class="coop-add_acts">
                <button name="action_publish" type="object" string="Опубликовать"
                        class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_save_draft" type="object" string="Сохранить черновик"
                        class="btn-secondary" invisible="state != 'draft'"/>
                <button name="action_done_editing" type="object" string="Готово"
                        class="btn-primary" invisible="state == 'draft'"/>
                <p class="coop-add_note" invisible="state != 'draft'">
                  Опубликовать можно, когда заполнено помеченное «нужно».
                </p>
              </div>
            </aside>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Открывает уже заведённый черновик: номер подставляет `action_new_offer`. -->
  <record id="action_coop_skill_add" model="ir.actions.act_window">
    <field name="name">Добавить навык</field>
    <field name="res_model">coop.skill.offer</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_coop_skill_add"/>
    <field name="target">current</field>
  </record>

  <record id="view_coop_skill_search" model="ir.ui.view">
    <field name="name">coop.skill.offer.search</field>
    <field name="model">coop.skill.offer</field>
    <field name="arch" type="xml">
      <search string="Навыки">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="city"/>
        <field name="coop_specialization_id"/>
        <field name="skill_ids"/>
        <filter name="senior" string="Опыт от трёх лет"
                domain="[('experience_level', '=', 'senior')]"/>
        <filter name="junior" string="Опыт от года"
                domain="[('experience_level', 'in', ('junior', 'senior'))]"/>
        <filter name="no_experience" string="Без опыта"
                domain="[('experience_level', '=', 'none')]"/>
        <filter name="travel" string="Готовы к командировкам"
                domain="[('ready_to_travel', '=', True)]"/>
        <separator/>
        <filter name="mine" string="Мои предложения"
                domain="[('partner_id.user_ids', 'in', [uid])]"/>
        <filter name="paused" string="Приостановленные"
                domain="[('state', '=', 'paused')]"/>
        <separator/>
        <filter name="trusted" string="Доверие владельца от 80%"
                domain="[('partner_trust', '>=', 80)]"/>
        <group>
          <filter name="by_area" string="По сфере деятельности"
                  context="{'group_by': 'coop_specialization_category_id'}"/>
          <filter name="by_specialization" string="По специализации"
                  context="{'group_by': 'coop_specialization_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
          <filter name="by_level" string="По опыту"
                  context="{'group_by': 'experience_level'}"/>
          <filter name="by_employment" string="По занятости"
                  context="{'group_by': 'employment'}"/>
          <filter name="by_schedule" string="По графику"
                  context="{'group_by': 'work_schedule'}"/>
          <filter name="by_state" string="По состоянию"
                  context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_skills" model="ir.actions.act_window">
    <field name="name">Навыки</field>
    <field name="res_model">coop.skill.offer</field>
    <field name="path">skills</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить навык', 'coop_create_method': 'action_new_offer', 'coop_shelf_field': 'coop_specialization_category_id'}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('state', '=', 'published')]</field>
    <field name="search_view_id" ref="view_coop_skill_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Предложений навыка пока нет</p>
      <p>Здесь участники показывают, что умеют делать и на каких условиях.
         У одного человека предложений может быть несколько — по числу
         специализаций.</p>
    </field>
  </record>

  <!--
    Свои предложения — отдельным экраном и без отбора по состоянию.
    Каталог показывает только опубликованное, и без этого экрана владелец,
    нажав «Приостановить», терял бы своё предложение отовсюду: пауза
    означает «занят», а не «удалить».
  -->
  <record id="action_coop_my_skills" model="ir.actions.act_window">
    <field name="name">Мои предложения</field>
    <field name="res_model">coop.skill.offer</field>
    <field name="path">my-skills</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('partner_id.user_ids', 'in', [uid])]</field>
    <field name="context">{'coop_create_label': 'Добавить навык', 'coop_create_method': 'action_new_offer'}</field>
    <field name="search_view_id" ref="view_coop_skill_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока ничего не предложили</p>
      <p>Расскажите, что умеете делать и на каких условиях. Предложений
         может быть несколько — по числу занятий.</p>
    </field>
  </record>

  <menuitem id="menu_coop_skills_root" name="Навыки" sequence="40"/>
  <menuitem id="menu_coop_skills" name="Каталог навыков"
            parent="menu_coop_skills_root" action="action_coop_skills" sequence="10"/>
  <menuitem id="menu_coop_my_skills" name="Мои предложения"
            parent="menu_coop_skills_root" action="action_coop_my_skills" sequence="20"/>

</odoo>
