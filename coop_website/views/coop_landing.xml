<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Лендинг платформы, версия 3 — макет дизайн-артефакта «Лендинг ДАО
    КООПТЕХ» (https://claude.ai/artifact/GTTCWiFifdoGD6ubiNXjqF, 11.11.2026):
    главная и три посадочные — для мастеров, инициаторов проектов и
    организаций.

    Макет интерактивный: выбор роли, тренажёр карточки, расчёт проекта,
    путь проекта, сценарии, калькулятор простоя, три вопроса, приглашение.
    Поэтому разметка и логика берутся из макета как есть скриптом
    tools/build_landing.py, а отрисовывает их static/src/landing/runtime.js.
    Страница своя, без шапки и подвала сайта Odoo: у макета свои.

    variant/role — номер посадочной и роль по умолчанию (0/0 — главная).
  -->
  <template id="coop_landing" name="ДАО КООПТЕХ — главная">
    <t t-set="variant" t-value="variant or 0"/>
    <t t-set="role" t-value="role or 0"/>
    <t t-set="titles" t-value="{
        0: 'DAO COOPTECH — объединяйтесь, владейте вместе, автоматизируйте общее дело',
        1: 'DAO COOPTECH — мастерам и специалистам',
        2: 'DAO COOPTECH — инициаторам проектов',
        3: 'DAO COOPTECH — организациям любой формы'}"/>
    <t t-set="legal" t-value="request.env['coop.website.landing'].sudo()._legal_facts()"/>
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <meta name="description" content="Платформа социально-экономических отношений с открытым исходным кодом: люди, сообщества и организации любой формы вместе ведут общее дело, вкладываются деньгами, трудом и активами и делят доли по понятным правилам."/>
      <t t-call-assets="coop_website.landing_assets"/>
    </t>
    <t t-call="web.layout"
        title="titles.get(variant, titles[0])"
        x_icon="website and '/web/image/website/%s/favicon' % website.id"
        head="head">
      <div id="coop-landing" t-att-data-variant="variant" t-att-data-role="role"
          t-att-data-contact="'mailto:%s' % legal['email']"/>
      <noscript>
        <p style="padding:24px;font-family:sans-serif">DAO COOPTECH — платформа социально-экономических отношений с открытым исходным кодом.
          <a href="/web/signup">Зарегистрироваться</a> · <a href="/web/login">Войти</a></p>
      </noscript>
    </t>
  </template>

</odoo>
