<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Лендинг платформы. Содержимое перенесено из прототипа (`index.html`) и
    обёрнуто в oe_structure — значит правится штатным конструктором сайта:
    текст, картинки, порядок секций и новые блоки меняются мышью, без
    правки этого файла.

    Шапка и подвал здесь не свои: их даёт сам модуль «Сайт», и они же
    несут меню, языки и вход. Тащить сюда шапку прототипа значило бы
    получить две шапки на одной странице.

    Ссылки ведут на настоящие разделы платформы. Там, где раздел ещё не
    перенесён на движок, ссылка ведёт в каталог расширений: битая ссылка
    на первой странице хуже честного перехода к тому, что уже работает.
  -->
  <template id="coop_landing" name="ДАО КООПТЕХ — главная">
    <t t-call="website.layout">
      <div id="wrap" class="coop-landing">
        <div class="oe_structure" id="coop_landing_content">
          <section class="hero" id="main">
            <div class="hero-text">
              <div class="eyebrow">Открытый исходный код · Некоммерческий проект</div>
              <h1>Платформа для тех, кто кооперируется, а не конкурирует</h1>
              <p>ДАО КООПТЕХ объединяет людей, кооперативы, ДАО и малые проекты в одном пространстве: находите людей и навыки, делитесь ресурсами, собирайте проекты вскладчину и ведите общие дела прозрачно — без посредников, извлекающих прибыль из вашей кооперации.</p>
              <div class="hero-actions">
                <a class="button" href="/web/signup">Присоединиться</a>
                <a class="button secondary" href="#how">Как это работает</a>
              </div>
              <a class="hero-jump" href="#cases">Посмотреть реальные сценарии на платформе ↓</a>
            </div>
            <div class="hero-illustration">
              <svg width="100%" height="100%" viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="hg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#146B64"/><stop offset="1" stop-color="#0E4F4A"/></linearGradient>
                  <linearGradient id="hg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#C98A2B"/><stop offset="1" stop-color="#a86f1e"/></linearGradient>
                </defs>
                <rect width="400" height="260" fill="#E3EFED"/>
                <g opacity="0.55" stroke="#146B64" stroke-width="1">
                  <line x1="60" y1="80" x2="160" y2="60"/><line x1="160" y1="60" x2="260" y2="100"/><line x1="260" y1="100" x2="340" y2="70"/>
                  <line x1="160" y1="60" x2="180" y2="160"/><line x1="260" y1="100" x2="220" y2="190"/><line x1="60" y1="80" x2="90" y2="180"/><line x1="90" y1="180" x2="220" y2="190"/>
                </g>
                <circle cx="60" cy="80" r="8" fill="url(#hg1)"/><circle cx="160" cy="60" r="11" fill="url(#hg1)"/><circle cx="260" cy="100" r="9" fill="url(#hg2)"/>
                <circle cx="340" cy="70" r="7" fill="url(#hg1)"/><circle cx="180" cy="160" r="7" fill="url(#hg2)"/><circle cx="220" cy="190" r="10" fill="url(#hg1)"/><circle cx="90" cy="180" r="6" fill="url(#hg2)"/>
              </svg>
            </div>
          </section>

          <div class="stats-strip">
            <!--
              Цифры считаются по базе, а не вписаны руками. В прототипе они
              были статическими и уже через неделю расходились с каталогом;
              на работающем движке врать о собственном содержимом незачем.
            -->
            <div class="stats-strip-inner">
              <div class="stat-block">
                <div class="stat-num"><t t-esc="request.env['res.partner'].sudo().search_count([('coop_is_participant', '=', True), ('is_company', '=', False)])"/></div>
                <div class="stat-label">участников в каталоге «Люди»</div>
              </div>
              <div class="stat-block">
                <div class="stat-num"><t t-esc="request.env['res.partner'].sudo().search_count([('coop_is_participant', '=', True), ('is_company', '=', True)])"/></div>
                <div class="stat-label">организаций — коммерческие, кооперативные, некоммерческие</div>
              </div>
              <div class="stat-block">
                <div class="stat-num"><t t-esc="request.env['coop.specialization'].sudo().search_count([])"/></div>
                <div class="stat-label">специализаций в общем справочнике платформы</div>
              </div>
              <div class="stat-block">
                <div class="stat-num"><t t-esc="request.env['coop.legal.form'].sudo().search_count([])"/></div>
                <div class="stat-label">правовых форм — от ООО до потребительского кооператива</div>
              </div>
            </div>
            <p class="stats-strip-note">Это не заглушки: цифры считаются по каталогу платформы в момент открытия страницы.</p>
          </div>

          <section class="landing-section" id="how">
            <h2>Восемь разделов — один общий контур</h2>
            <p class="section-sub">Всё, что нужно кооперативу или инициативной группе, чтобы находить друг друга и вести дела вместе, без отдельных разрозненных сервисов.</p>
            <div class="feature-grid">
              <div class="feature-card"><div class="f-icon">👤</div><div class="f-title">Моя страница</div><div class="f-desc">Личный кабинет: навыки, ресурсы, проекты, доверие и связи в одном профиле.</div></div>
              <div class="feature-card"><div class="f-icon">💬</div><div class="f-title">Сообщения</div><div class="f-desc">Переписка с людьми, организациями и командами проектов.</div></div>
              <div class="feature-card"><div class="f-icon">🧑‍🤝‍🧑</div><div class="f-title">Люди</div><div class="f-desc">Каталог участников — ищите специалистов и единомышленников рядом.</div></div>
              <div class="feature-card"><div class="f-icon">🛠️</div><div class="f-title">Навыки</div><div class="f-desc">Реестр «кто что умеет» — находите нужную экспертизу внутри сообщества.</div></div>
              <div class="feature-card"><div class="f-icon">📋</div><div class="f-title">Вакансии</div><div class="f-desc">Биржа задач и труда: деньгами, долей в проекте или обменом услугами.</div></div>
              <div class="feature-card"><div class="f-icon">📦</div><div class="f-title">Ресурсы</div><div class="f-desc">Материальные, технические и финансовые ресурсы в общем доступе.</div></div>
              <div class="feature-card"><div class="f-icon">🚀</div><div class="f-title">Проекты</div><div class="f-desc">Совместные инициативы: собирайте ресурсы, людей и доли на общий результат.</div></div>
              <div class="feature-card"><div class="f-icon">🏛️</div><div class="f-title">Организации</div><div class="f-desc">Кооперативы, ДАО, НКО и компании — как равноправные участники платформы.</div></div>
            </div>
            <div class="extensions-note">
              <p class="section-sub" style="margin:22px 0 12px">И ещё «Кошелёк» и 12 расширений сверху — для тех, кому нужно больше, чем базовый набор:</p>
              <div class="extensions-chips">
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Кошелёк</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Цифровые активы</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Нематериальные активы</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Целевые программы ПК</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Совместные закупки</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Мероприятия</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Аналитика</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Образование</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Аукционы</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Библиотеки</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Бартер</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Диск</a>
                <a class="chip" href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Здоровье</a>
              </div>
            </div>
          </section>

          <section class="landing-section" id="cases">
            <h2>Как этим пользуются на практике</h2>
            <p class="section-sub">Не абстрактные функции, а четыре сценария на реальных карточках прототипа — от одного человека с несколькими ролями до трёх разных типов организаций с разными правилами игры. Кликайте по ссылкам внутри — они ведут на настоящие страницы, не на макеты.</p>

            <div class="usecase-list">

              <article class="usecase-row">
                <div class="usecase-media"><img src="/coop_website/static/src/img/13.jpg" alt="Дашкевич Данил Игоревич"/></div>
                <div class="usecase-body">
                  <div class="usecase-kicker">Профиль человека · Данил Дашкевич</div>
                  <h3>Один участник — сразу учредитель, инициатор проекта и поставщик</h3>
                  <p>На платформе не нужно заводить отдельный аккаунт под каждую роль. В ООО «Мириталь» Данил — учредитель (карусель «Сотрудники»), одновременно он инициатор и участник кооперативного проекта «Строительный 3D-принтер»: доля/пай каждого вклада в проекте считается от денежной оценки, а не «на глаз», и голос при этом не зависит от размера доли. В карточке ресурса «Пельмени домашней лепки» он же — контактное лицо продавца от лица «Мириталь». А ещё публикует свою вакансию «Программист» как частное лицо, предлагая обмен навыками вместо денег.</p>
                  <div class="usecase-stats">
                    <div class="usecase-stat"><b>92%</b> доверие (33 из 35 сделок)</div>
                    <div class="usecase-stat"><b>89%</b> готовность проекта</div>
                    <div class="usecase-stat"><b>26</b> сделок в истории</div>
                  </div>
                  <div class="usecase-path">
                    <a href="/odoo/action-coop_people.action_coop_people">Профиль Данила</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_orgs.action_coop_orgs">ООО «Мириталь» (учредитель)</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/project">Проект «3D-принтер»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_extensions.action_coop_extensions_catalog">«Пельмени домашней лепки»</a>
                  </div>
                </div>
              </article>

              <article class="usecase-row reverse">
                <div class="usecase-media"><img src="/coop_website/static/src/img/pelmeni.jpg" alt="ООО «Мириталь»"/></div>
                <div class="usecase-body">
                  <div class="usecase-kicker">Организация · коммерческая</div>
                  <h3>От найма специалиста до готового продукта на витрине</h3>
                  <p>ООО «Мириталь» — коммерческая организация с обычной плоской структурой (Юридический отдел, ИТ, Продажи, Отдел кадров, Бухгалтерия). Публикует вакансии за деньги в формате, знакомом по hh.ru — «Электромонтажник» (60 000–90 000 ₽) и «Кладовщик» (45 000 ₽). Параллельно продаёт готовый продукт «Пельмени домашней лепки» — и это полный цикл витрины ресурса: описание и цена, этапы производства и неизменяемая история передачи прав («Трекинг»), список покупателей по дням («Покупатели») и отзывы в стиле Ozon с фото и ответом продавца («Отзывы»).</p>
                  <div class="usecase-stats">
                    <div class="usecase-stat"><b>2</b> открытые вакансии деньгами</div>
                    <div class="usecase-stat"><b>50</b> двусторонних отзывов формируют доверие к ресурсу</div>
                    <div class="usecase-stat"><b>26</b> покупателей за 6 дней</div>
                  </div>
                  <div class="usecase-path">
                    <a href="/odoo/action-coop_orgs.action_coop_orgs">ООО «Мириталь»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/recruitment">Вакансия «Электромонтажник»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_extensions.action_coop_extensions_catalog">«Пельмени домашней лепки»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Трекинг</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_extensions.action_coop_extensions_catalog">Отзывы</a>
                  </div>
                </div>
              </article>

              <article class="usecase-row">
                <div class="usecase-media"><img src="/coop_website/static/src/img/greenhouse.jpg" alt="Кооператив «Шукты»"/></div>
                <div class="usecase-body">
                  <div class="usecase-kicker">Организация · кооперативная</div>
                  <h3>Общее собрание пайщиков и совместное дело с соседями</h3>
                  <p>Кооператив «Шукты» (Дербент) управляется не единоличным директором, а коллегиально: отдельный блок «Организационная структура» так и показывает — Общее собрание пайщиков, Правление, Ревизионная комиссия, и профильные подразделения (Овцеводческий участок, Цех переработки шерсти, Сыроварня и сбыт). Кооператив публикует вакансию «Прораб на площадку 3D-принтера» с вознаграждением не деньгами, а долей в проекте (5–8%), делится ресурсами — молоком, мёдом, переработанной шерстью — и участвует как совладелец в коммерческом проекте «Круглогодичная теплица», который инициировало другое юрлицо, ООО «АгроСтрой».</p>
                  <div class="usecase-stats">
                    <div class="usecase-stat"><b>88%</b> доверие (30 из 34 сделок)</div>
                    <div class="usecase-stat"><b>3</b> пайщика в правлении</div>
                    <div class="usecase-stat"><b>5–8%</b> доля вместо зарплаты</div>
                  </div>
                  <div class="usecase-path">
                    <a href="/odoo/action-coop_orgs.action_coop_orgs">Кооператив «Шукты»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/recruitment">Вакансия «Прораб» за долю</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/project">Совместный проект «Теплица»</a>
                  </div>
                </div>
              </article>

              <article class="usecase-row reverse">
                <div class="usecase-media"><img src="/coop_website/static/src/img/coworking.jpg" alt="Фонд «Территория 2020»"/></div>
                <div class="usecase-body">
                  <div class="usecase-kicker">Организация · некоммерческая</div>
                  <h3>Гранты и партнёрство с НКО — без дивидендов, с отчётностью</h3>
                  <p>Фонд «Территория 2020» (Красноярск) устроен под свою задачу: Попечительский совет, Правление/Дирекция, Ревизионная комиссия, Грантовый отдел, Фандрайзинг и партнёрства, Аналитика и отчётность — вместо отдела продаж. В ленте фонда — не финансовые итоги для дольщиков, а отчёт о распределении грантов за прошлый год и объявление нового конкурса. Ресурсы (коворкинг, оборудование, методическая библиотека) достаются партнёрским НКО, а раздел «Потребности» собирает не инвестиции в долю, а волонтёров и пожертвования на грантовую программу.</p>
                  <div class="usecase-stats">
                    <div class="usecase-stat"><b>81%</b> доверие (17 из 21 сделки)</div>
                    <div class="usecase-stat">3 партнёрские НКО</div>
                    <div class="usecase-stat">приём заявок до 30 сентября</div>
                  </div>
                  <div class="usecase-path">
                    <a href="/odoo/action-coop_orgs.action_coop_orgs">Фонд «Территория 2020»</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/action-coop_orgs.action_coop_orgs">Лента: гранты и отчётность</a><span class="usecase-arrow">→</span>
                    <a href="/odoo/recruitment">Потребность: волонтёр-координатор</a>
                  </div>
                </div>
              </article>

            </div>
          </section>

          <section class="landing-section">
            <h2>На чём мы стоим</h2>
            <p class="section-sub">Платформа проектируется так, чтобы механики по умолчанию поддерживали кооперацию, а не извлечение прибыли из чужого труда.</p>
            <div class="principles-row">
              <div class="principle"><div class="p-num">01</div><div class="p-title">Открытый код</div><div class="p-desc">Исходники платформы открыты — любой кооператив может проверить, как считаются доверие, доли и распределение.</div></div>
              <div class="principle"><div class="p-num">02</div><div class="p-title">Прозрачность вместо посредника</div><div class="p-desc">Сделки, доли в проектах и репутация видны участникам напрямую, без скрытых комиссий платформы.</div></div>
              <div class="principle"><div class="p-num">03</div><div class="p-title">Децентрализация — цель, не лозунг</div><div class="p-desc">Начинаем с обычного сервиса, но данные и идентичность проектируются так, чтобы кооперативы могли со временем вести свой узел самостоятельно.</div></div>
              <div class="principle"><div class="p-num">04</div><div class="p-title">Кооперация по умолчанию</div><div class="p-desc">Доли, доверие и вознаграждение — предмет открытых правил сообщества, а не правил одной компании.</div></div>
            </div>
          </section>

          <div class="cta-band">
            <div>
              <h2>Готовы посмотреть платформу изнутри?</h2>
              <p>Это ранний кликабельный прототип — сценарии выше собраны из его реальных карточек. Заходите под демо-профилем и пройдитесь по разделам сами.</p>
            </div>
            <div class="hero-actions">
              <a class="button" href="/web/signup">Зарегистрироваться</a>
              <a class="button secondary" href="/web/login">Войти</a>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!--
    Лендинг ставится главной страницей функцией, а не переопределением
    представления: у каждого сайта своя копия главной, и переопределение
    из модуля до неё не доходит. Подробности — в models/coop_landing.py.
  -->
  <function model="coop.website.landing" name="apply"/>
  <function model="coop.website.landing" name="setup_site"/>

</odoo>
