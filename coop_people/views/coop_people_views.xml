<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Плитка человека повторяет макет: фото во всю ширину карточки, поверх
    него внизу тёмная полоса с городом, ниже имя с отметкой о проверке
    личности, строка «возраст · доверие», чипы навыков и три действия.

    Отметка о проверке стоит рядом с именем, а доверие — в строке мета, и
    это не случайно. Подтверждённый паспорт и надёжность в делах — разные
    вещи: рядом их ставить нельзя, иначе одно читается как подтверждение
    другого.
  -->
  <record id="view_coop_people_kanban" model="ir.ui.view">
    <field name="name">coop.people.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_people" quick_create="false">
        <field name="avatar_128"/>
        <field name="city"/>
        <field name="coop_age"/>
        <field name="coop_trust"/>
        <field name="coop_verified"/>
        <field name="coop_is_self"/>
        <field name="coop_is_following"/>
        <field name="coop_friend_state"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_person">
              <div class="o_coop_photo">
                <field name="avatar_128" widget="image" class="o_coop_photo_img"/>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>

              <div class="o_coop_body">
                <div class="o_coop_name">
                  <field name="name"/>
                  <span t-if="record.coop_verified.raw_value"
                        class="o_coop_badge o_coop_verified"
                        title="Подтверждены телефон и паспортные данные. На уровень доверия не влияет: это отдельная проверка личности.">✓ Верифицирован</span>
                </div>

                <div class="o_coop_meta">
                  <span t-if="record.coop_age.raw_value"><field name="coop_age"/> лет · </span>
                  <span t-if="record.coop_trust.raw_value">Уровень доверия <field name="coop_trust"/>%</span>
                  <!-- У новичка доверие не «ноль процентов», а «пока не
                       считается»: ноль читался бы как плохая репутация,
                       хотя человек просто ещё ничего не делал. -->
                  <span t-if="!record.coop_trust.raw_value" class="o_coop_muted">Доверие пока не считается</span>
                </div>

                <div class="o_coop_chips">
                  <field name="coop_skill_ids" widget="many2many_tags"/>
                </div>

                <!-- На своей карточке действий нет: подписываться на себя
                     и добавлять себя в друзья не на что. -->
                <div class="o_coop_actions" t-if="!record.coop_is_self.raw_value">
                  <button name="action_coop_message" type="object"
                          class="btn o_coop_btn o_coop_btn_primary">Написать</button>
                  <button name="action_coop_follow" type="object"
                          class="btn o_coop_btn"
                          t-if="!record.coop_is_following.raw_value">Подписаться</button>
                  <button name="action_coop_follow" type="object"
                          class="btn o_coop_btn o_coop_btn_on"
                          t-if="record.coop_is_following.raw_value">Вы подписаны</button>
                  <button name="action_coop_befriend" type="object" class="btn o_coop_btn"
                          t-if="record.coop_friend_state.raw_value == 'none'">Добавить в друзья</button>
                  <button name="action_coop_befriend" type="object"
                          class="btn o_coop_btn o_coop_btn_on"
                          t-if="record.coop_friend_state.raw_value == 'pending_in'">Принять дружбу</button>
                  <span class="o_coop_btn o_coop_btn_muted"
                        t-if="record.coop_friend_state.raw_value == 'pending_out'">Предложение отправлено</span>
                  <span class="o_coop_btn o_coop_btn_muted"
                        t-if="record.coop_friend_state.raw_value == 'accepted'">В друзьях</span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_people_list" model="ir.ui.view">
    <field name="name">coop.people.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Люди">
        <field name="name"/>
        <field name="city"/>
        <field name="coop_profession_id" string="Профессия" optional="show"/>
        <field name="coop_profession_category_id" string="Категория" optional="hide"/>
        <field name="coop_age" string="Возраст"/>
        <field name="coop_skill_ids" widget="many2many_tags" optional="show"/>
        <field name="coop_membership_count" string="Кооперативов"/>
        <field name="coop_trust" string="Доверие, %"/>
        <field name="coop_verified" widget="boolean_toggle" string="Верифицирован"/>
      </list>
    </field>
  </record>

  <record id="view_coop_people_search" model="ir.ui.view">
    <field name="name">coop.people.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Люди">
        <field name="name"/>
        <field name="city"/>
        <field name="coop_profession_id"/>
        <field name="coop_skill_ids"/>
        <filter name="verified" string="С подтверждённой личностью"
                domain="[('coop_verified', '=', True)]"/>
        <filter name="in_coop" string="Состоят в кооперативах"
                domain="[('coop_membership_count', '>', 0)]"/>
        <separator/>
        <filter name="trust_high" string="Доверие от 80%"
                domain="[('coop_trust', '>=', 80)]"/>
        <group>
          <filter name="by_category" string="По категории специализации"
                  context="{'group_by': 'coop_profession_category_id'}"/>
          <filter name="by_profession" string="По профессии"
                  context="{'group_by': 'coop_profession_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_people" model="ir.actions.act_window">
    <field name="name">Люди</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('coop_is_participant', '=', True), ('is_company', '=', False)]</field>
    <field name="context">{'default_coop_is_participant': True, 'default_is_company': False}</field>
    <field name="search_view_id" ref="view_coop_people_search"/>
    <!-- Явная привязка представлений. res.partner — общая модель, и без
         этого списка действие подберёт по приоритету стандартный канбан
         контакта, а наш в выборе даже не участвует. -->
    <field name="view_ids" eval="[(5, 0, 0),
           (0, 0, {'sequence': 10, 'view_mode': 'kanban', 'view_id': ref('view_coop_people_kanban')}),
           (0, 0, {'sequence': 20, 'view_mode': 'list', 'view_id': ref('view_coop_people_list')}),
           (0, 0, {'sequence': 30, 'view_mode': 'form'})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">В каталоге пока никого нет</p>
      <p>Сюда попадают участники платформы — люди с навыками, городом и
         историей сделок. Обычный контакт в каталог не попадает: для этого
         у него должен стоять признак участника.</p>
    </field>
  </record>

  <!-- Справочник специализаций: каталог людей в макете открывается
       перечнем специализаций, а не списком из ста фамилий. -->
  <record id="view_coop_profession_list" model="ir.ui.view">
    <field name="name">coop.profession.list</field>
    <field name="model">coop.profession</field>
    <field name="arch" type="xml">
      <list string="Профессии">
        <field name="category_id"/>
        <field name="name"/>
        <field name="partner_count" string="Людей"/>
      </list>
    </field>
  </record>

  <record id="view_coop_profession_category_list" model="ir.ui.view">
    <field name="name">coop.profession.category.list</field>
    <field name="model">coop.profession.category</field>
    <field name="arch" type="xml">
      <list string="Категории специализаций">
        <field name="name"/>
        <field name="profession_count" string="Профессий"/>
        <field name="partner_count" string="Людей"/>
      </list>
    </field>
  </record>

  <record id="action_coop_profession" model="ir.actions.act_window">
    <field name="name">Специализации</field>
    <field name="res_model">coop.profession</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_coop_profession_category" model="ir.actions.act_window">
    <field name="name">Категории специализаций</field>
    <field name="res_model">coop.profession.category</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_coop_people_root" name="Люди" sequence="12"/>
  <menuitem id="menu_coop_people" name="Каталог людей"
            parent="menu_coop_people_root" action="action_coop_people" sequence="10"/>
  <menuitem id="menu_coop_people_config" name="Справочники"
            parent="menu_coop_people_root" sequence="90"/>
  <menuitem id="menu_coop_profession" name="Специализации"
            parent="menu_coop_people_config" action="action_coop_profession" sequence="10"/>
  <menuitem id="menu_coop_profession_category" name="Категории специализаций"
            parent="menu_coop_people_config" action="action_coop_profession_category" sequence="20"/>

</odoo>
