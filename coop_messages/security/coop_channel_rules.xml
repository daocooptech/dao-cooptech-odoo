<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Переписка видна только тем, кто в ней состоит.

    Решение владельца 328 от 16 сентября 2026: «чаты видны только
    участникам чатов». Одно правило на все переписки без исключений —
    личную, чат сделки, чат организации, чат сообщества. Само сообщество
    остаётся видно в каталоге всем: закрыт разговор, а не витрина.

    Штатное правило движка закрывает по членству только личные и
    групповые переписки, а канал с названием открывает каждому
    внутреннему пользователю. Так были открыты чаты ста шестнадцати
    сообществ: человек читал разговор, не вступая.

    **Правило глобальное — и это не стиль, а необходимость.** Правила,
    выданные группе, движок объединяет по ИЛИ: наше правило, выданное
    той же группе, что и штатное, доступ бы не сузило, а расширило.
    Сужает только глобальное, потому что глобальные объединяются по И.

    Полномочия администратора при этом сохраняются явно: глобальное
    правило действует и на него, мимо проходит только служебный режим.

    Право писать в переписку у движка равно праву её читать
    (`_mail_post_access = 'read'`), поэтому отдельного правила на запись
    сообщений не нужно: закрыли видимость — закрыли и запись.

    `noupdate` здесь нет намеренно: флаг переживает удаление из XML, и
    исправленный домен в базу больше не попадёт. Эти грабли записаны.
  -->
  <record id="rule_channel_read_member_only" model="ir.rule">
    <field name="name">Переписка видна только своим участникам</field>
    <field name="model_id" ref="mail.model_discuss_channel"/>
    <field name="groups" eval="[]"/>
    <!-- Домен в одну строку: перевод строки внутри выражения движок не
         разбирает и отвечает «Invalid domain: invalid syntax», не
         показывая, где именно. -->
    <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['|', ('is_member', '=', True), ('parent_channel_id.is_member', '=', True)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

</odoo>
