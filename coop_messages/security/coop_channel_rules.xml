<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Переписка видна только тем, кто в ней состоит.

    Решение владельца 328 от 16 сентября 2026: «чаты видны только
    участникам чатов». Одно правило на все переписки без исключений —
    личную, чат сделки, чат организации, чат сообщества. Само сообщество
    остаётся видно в каталоге всем: закрыт разговор, а не витрина.

    Штатное правило движка закрывает по членству только личные и
    групповые переписки, а канал с названием открывает каждому
    внутреннему пользователю. Так были открыты чаты ста шестнадцати
    сообществ: человек читал разговор, не вступая.

    **Правило глобальное — и это не стиль, а необходимость.** Правила,
    выданные группе, движок объединяет по ИЛИ: наше правило, выданное
    той же группе, что и штатное, доступ бы не сузило, а расширило.
    Сужает только глобальное, потому что глобальные объединяются по И.

    Полномочия администратора при этом сохраняются явно: глобальное
    правило действует и на него, мимо проходит только служебный режим.

    Право писать в переписку у движка равно праву её читать
    (`_mail_post_access = 'read'`), поэтому отдельного правила на запись
    сообщений не нужно: закрыли видимость — закрыли и запись.

    `noupdate` здесь нет намеренно: флаг переживает удаление из XML, и
    исправленный домен в базу больше не попадёт. Эти грабли записаны.
  -->
  <record id="rule_channel_read_member_only" model="ir.rule">
    <field name="name">Переписка видна только своим участникам</field>
    <field name="model_id" ref="mail.model_discuss_channel"/>
    <field name="groups" eval="[]"/>
    <!-- Домен в одну строку: перевод строки внутри выражения движок не
         разбирает и отвечает «Invalid domain: invalid syntax», не
         показывая, где именно. -->
    <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['|', ('is_member', '=', True), ('parent_channel_id.is_member', '=', True)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!--
    Переименовать переписку может хозяин записи или тот, кто её завёл.

    До 16 сентября 2026 право записи на переписку было у всех внутренних
    пользователей: переименовать чужой чат мог кто угодно, и остальные
    участники узнавали об этом по изменившемуся названию.

    Правило снова глобальное — по той же причине, что и правило
    видимости: правила, выданные группе, движок объединяет по ИЛИ, и
    ограничение, выданное группе, доступ бы расширило.

    Что при этом не ломается, проверено по исходникам движка: отправка
    сообщения двигает служебное поле переписки через `sudo`, а прочтения,
    закрепление, «печатает…» и своё имя чата пишутся в запись участника,
    а не в саму переписку.
  -->
  <record id="rule_channel_write_owner" model="ir.rule">
    <field name="name">Переименовать переписку может хозяин записи или её создатель</field>
    <field name="model_id" ref="mail.model_discuss_channel"/>
    <field name="groups" eval="[]"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['|', ('create_uid', '=', user.id), ('coop_owner_partner_ids', 'in', user.partner_id.ids)]</field>
    <field name="perm_read" eval="False"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!--
    Переписку, которую ведёт платформа, не удаляет никто.

    Решение владельца 16 сентября 2026: «нельзя никому». Чат живёт, пока
    жива запись: удалённые переговоры по сделке — это исчезнувшие
    доказательства, на которые ссылаются в споре.

    Свои переписки, заведённые руками, удаляются по общему правилу —
    хозяином записи или тем, кто завёл.
  -->
  <record id="rule_channel_unlink" model="ir.rule">
    <field name="name">Переписку платформы не удаляют</field>
    <field name="model_id" ref="mail.model_discuss_channel"/>
    <field name="groups" eval="[]"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['&amp;', ('coop_managed', '=', False), '|', ('create_uid', '=', user.id), ('coop_owner_partner_ids', 'in', user.partner_id.ids)]</field>
    <field name="perm_read" eval="False"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="True"/>
  </record>

</odoo>
