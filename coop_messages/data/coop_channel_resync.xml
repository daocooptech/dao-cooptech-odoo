<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    При каждом обновлении модуля состав переписок платформы сводится с
    составом записей: стороны сделки, участники проекта.

    Почему при каждом, а не один раз: правило состава живёт в коде и
    меняется вместе с ним — 16 сентября 2026 оно за день поменялось
    дважды. Записи участников при этом остаются в базе прежними, и
    разойтись они могут от любой правки мимо платформы. Разовый прогон
    дешевле расследования «почему человек не видит свою сделку».

    `noupdate` здесь нет намеренно: с ним функция выполнилась бы однажды
    и больше никогда — ровно наоборот тому, что нужно.
  -->
  <function model="discuss.channel" name="coop_resync_managed"/>
</odoo>
