<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<!--
  Раскладка из макета: вкладка раздела, поиск, чипы-фильтры, ниже две
  колонки — список переписок и сама переписка. Лента и поле ввода внутри
  правой колонки — компоненты Discuss без изменений.
-->
<t t-name="coop_messages.Messages">
  <div class="o_coop_messages">
    <div class="o_coop_tabs o_coop_tabs_page">
      <span class="o_coop_tab active">Сообщения</span>
      <div class="o_coop_new_dialog" t-ref="newDialog">
        <button type="button" class="o_coop_new_dialog_btn"
                t-on-click="() => this.toggleNewDialog()">
          <span class="o_coop_new_dialog_plus">+</span> Добавить диалог
        </button>
        <div t-if="state.newDialogOpen" class="o_coop_new_dialog_pop">
          <input type="text" class="o_coop_input" autofocus="autofocus"
                 placeholder="Найти человека по имени..."
                 t-on-input="(ev) => this.searchNewDialog(ev.target.value)"/>
          <div class="o_coop_new_dialog_list">
            <t t-if="state.newDialogQuery.trim().length > 1 and !state.newDialogResults.length">
              <div class="o_coop_new_dialog_empty">Никого не нашли.</div>
            </t>
            <div t-foreach="state.newDialogResults" t-as="person" t-key="person.id"
                 class="o_coop_new_dialog_row"
                 t-on-click="() => this.startNewDialog(person)">
              <img class="o_coop_new_dialog_avatar"
                   t-attf-src="/web/image/res.partner/{{person.id}}/avatar_128"
                   alt=""/>
              <div class="o_coop_new_dialog_text">
                <div class="o_coop_new_dialog_name" t-esc="person.name"/>
                <div t-if="person.city" class="o_coop_new_dialog_city" t-esc="person.city"/>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="o_coop_msg_search">
      <input type="text" class="o_coop_input"
             placeholder="Найти по диалогам и сообщениям..."
             t-model="state.search"/>
    </div>

    <div class="o_coop_chips o_coop_msg_chips">
      <button t-foreach="shownCategories" t-as="category" t-key="category.id"
              type="button" class="o_coop_chip"
              t-att-class="{ o_coop_chip_on: state.category === category.id }"
              t-on-click="() => (state.category = category.id)">
        <t t-esc="category.label"/>
        <span class="o_coop_chip_num" t-esc="countOf(category.id)"/>
      </button>
    </div>

    <div class="o_coop_msg_body">
      <div class="o_coop_thread_list">
        <t t-if="visibleThreads.length">
          <div t-foreach="visibleThreads" t-as="thread" t-key="thread.localId"
               class="o_coop_thread_item"
               t-att-class="{
                 o_coop_thread_on: thread.eq(activeThread),
                 o_coop_thread_unread: unreadOf(thread),
               }"
               t-on-click="() => this.select(thread)">
            <img class="o_coop_thread_avatar" t-att-src="thread.avatarUrl" alt=""
                 t-att-class="{ o_coop_avatar_circle: thread.coop_kind === 'person' }"/>
            <div class="o_coop_thread_main">
              <div class="o_coop_thread_row">
                <span class="o_coop_thread_name">
                  <t t-if="thread.coop_pinned">📌 </t>
                  <t t-esc="thread.displayName"/>
                </span>
                <span class="o_coop_thread_time" t-esc="stampOf(thread)"/>
              </div>
              <div class="o_coop_thread_row">
                <span class="o_coop_thread_last" t-esc="previewOf(thread)"/>
                <span t-if="unreadOf(thread)" class="o_coop_thread_count"
                      t-esc="unreadOf(thread)"/>
              </div>
            </div>
          </div>
        </t>
        <div t-else="" class="o_coop_thread_empty">
          Ничего не найдено.<br/>Попробуйте другой запрос или снимите фильтр.
        </div>
      </div>

      <div class="o_coop_chat_pane" t-ref="pane">
        <t t-if="activeThread">
          <div class="o_coop_chat_head">
            <img class="o_coop_chat_avatar" t-att-src="activeThread.avatarUrl" alt=""
                 t-att-class="{ o_coop_avatar_circle: activeThread.coop_kind === 'person' }"/>
            <div class="o_coop_chat_head_text">
              <div class="o_coop_chat_name" t-esc="activeThread.displayName"/>
              <div class="o_coop_chat_sub">
                <t t-if="activeThread.coop_kind === 'person' and onlineStatus(activeThread)">
                  <span class="o_coop_online_dot"
                        t-att-class="{ o_coop_online_off: onlineStatus(activeThread) !== 'online' }"/>
                  <t t-esc="onlineStatus(activeThread) === 'online' ? 'в сети' : 'был(а) недавно'"/>
                  <t t-if="activeThread.coop_subtitle"> · </t>
                </t>
                <t t-esc="activeThread.coop_subtitle"/>
              </div>
            </div>
            <button t-if="activeThread.coop_link_label" type="button"
                    class="o_coop_chat_link"
                    t-on-click="() => this.openRecord(activeThread)">
              <t t-esc="activeThread.coop_link_label"/> →
            </button>

            <!--
              Действия движка: звонок, участники, приглашение, вложения,
              закреплённое, поиск по сообщениям, уведомления, «покинуть».
              Списком из реестра, а не своими кнопками, — чтобы ничего не
              пропало при обновлении движка. Что не умещается в строку,
              движок сам убирает под многоточие.
            -->
            <div class="o_coop_chat_actions">
              <ActionList actions="[quickActions]" inline="true" thread="activeThread"/>
              <Dropdown t-if="moreActions.length" position="'bottom-end'">
                <button type="button" class="o_coop_chat_more"
                        aria-label="Ещё действия" title="Ещё действия">⋯</button>
                <t t-set-slot="content">
                  <ActionList actions="[moreActions]" dropdown="true"
                              thread="activeThread"/>
                </t>
              </Dropdown>
            </div>
          </div>

          <Thread thread="activeThread" t-key="activeThread.localId"
                  jumpPresent="state.jump"/>
          <Composer composer="activeThread.composer" t-key="activeThread.localId"
                    autofocus="true" type="'message'"
                    onPostCallback.bind="() => this.state.jump++"/>
        </t>
        <div t-else="" class="o_coop_chat_none">
          Переписка не выбрана.
        </div>
      </div>

      <!--
        Третья колонка: панель открытого действия — участники, вложения,
        закреплённое, поиск по сообщениям, настройки уведомлений. Своя
        колонка, а не поверх переписки: список участников читают, не
        отрываясь от разговора.
      -->
      <div t-if="threadActions.activeAction?.actionPanelComponentCondition"
           class="o_coop_chat_panel">
        <!-- Возврат к переписке. Виден только там, где панель встаёт
             вместо переписки, а не рядом: на узком экране шапка диалога
             с её значками скрыта, и закрыть панель было бы нечем. -->
        <button type="button" class="o_coop_panel_back"
                t-on-click="() => this.threadActions.activeAction.close()">
          ← К переписке
        </button>
        <t t-component="threadActions.activeAction.actionPanelComponent"
           thread="activeThread"
           t-props="threadActions.activeAction.actionPanelComponentProps"/>
      </div>
    </div>
  </div>
</t>

<!--
  Полоса вкладок у значка чатов в шапке.

  У движка она собрана прямо в разметке тремя кнопками — «Notifications»,
  «Chats», «Channels», — и список действий в коде на неё не влияет. В
  первую кнопку «Chats» свалены и разговор с одним человеком, и групповой
  чат на пятерых.

  Владелец 16 сентября 2026: «если каналы это обычные групповые чаты, то
  надо так и написать, а не плодить сущности». Остаются две вкладки:
  «Личные» — разговор один на один, «Групповые» — всё остальное, и
  группы, и каналы. Какого вида чат на самом деле, видно по строке
  списка, а не по вкладке.
-->
<t t-name="coop_messages.MessagingMenuHeader" t-inherit="mail.MessagingMenu.content" t-inherit-mode="extension">
  <xpath expr="//button[contains(@t-on-click, &quot;activeTab = 'chat'&quot;)]" position="replace">
    <button class="o-mail-MessagingMenu-headerFilter btn btn-link o-px-1_5 py-1 m-1 lh-1"
            t-att-class="store.discuss.activeTab === 'chat' ? 'fw-bold o-active shadow-sm' : 'text-muted'"
            type="button" role="tab"
            t-on-click="() => store.discuss.activeTab = 'chat'">Личные</button>
  </xpath>
  <!--
    Строка списка говорит, к чему привязан чат: сделка, проект,
    сообщество, организация. Без этого все чаты разделов сваливались в
    одну кучу, и по строке было не понять, чат это сделки или общий
    разговор — а в самом разделе «Сообщения» они разложены чипами.
  -->
  <xpath expr="//t[@name='threads']//t[@t-set-slot='name']" position="inside">
    <!-- Имя переменной латиницей: разбор выражений в шаблонах движка
         русских имён не принимает и отказывает словами «could not
         tokenize», не называя причины. В коде на русском можно, в
         выражении шаблона — нет. -->
    <t t-set="coopKindLabels" t-value="{
      'deal': 'Сделка', 'project': 'Проект',
      'community': 'Сообщество', 'org': 'Организация',
    }"/>
    <span t-if="coopKindLabels[thread.coop_kind]" class="o_coop_menu_kind"
          t-esc="coopKindLabels[thread.coop_kind]"/>
  </xpath>

  <xpath expr="//button[contains(@t-on-click, &quot;activeTab = 'channel'&quot;)]" position="replace">
    <button class="o-mail-MessagingMenu-headerFilter btn btn-link o-px-1_5 py-1 m-1 lh-1"
            t-att-class="store.discuss.activeTab === 'channel' ? 'fw-bold o-active shadow-sm' : 'text-muted'"
            type="button" role="tab"
            t-on-click="() => store.discuss.activeTab = 'channel'">Групповые</button>
    <!-- Переписки с самой платформой: помощник и извещения системы.
         Отдельной вкладкой по решению владельца — в общем списке они
         стоят наравне с живыми людьми и занимают верх, потому что пишут
         чаще всех. -->
    <button class="o-mail-MessagingMenu-headerFilter btn btn-link o-px-1_5 py-1 m-1 lh-1"
            t-att-class="store.discuss.activeTab === 'coop_service' ? 'fw-bold o-active shadow-sm' : 'text-muted'"
            type="button" role="tab"
            t-on-click="() => store.discuss.activeTab = 'coop_service'">Служебные</button>
  </xpath>
</t>

</templates>
