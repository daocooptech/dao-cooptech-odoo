<?xml version="1.0" encoding="utf-8"?>
<!--
  Без noupdate — правила доступа должны доезжать до узла обновлением
  модуля.
-->
<odoo>
  <data>

    <!--
      Свой чёрный список видит только его хозяин. Заблокированному о
      блокировке не сообщают и списка не показывают: он узнаёт об этом
      в тот момент, когда пробует написать, — и этого достаточно.
    -->
    <record id="rule_block_own" model="ir.rule">
      <field name="name">Чёрный список видит и правит его хозяин</field>
      <field name="model_id" ref="model_coop_block"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

  </data>
</odoo>
