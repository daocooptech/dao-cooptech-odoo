<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <menuitem id="menu_coop_root" name="Кооператив" sequence="15"
            web_icon="coop_base,static/description/icon.png"/>

  <menuitem id="menu_coop_membership" name="Членство"
            parent="menu_coop_root" action="action_coop_membership" sequence="10"
            groups="coop_base.group_coop_member"/>

  <!--
    Подтверждения ведёт правление: очная проверка — его работа. Участнику
    свои подтверждения видны в профиле, отдельный пункт меню ему не нужен.
  -->
  <menuitem id="menu_coop_verification" name="Подтверждения"
            parent="menu_coop_root" action="action_coop_verification" sequence="20"
            groups="coop_base.group_coop_board"/>

  <menuitem id="menu_coop_power" name="Полномочия"
            parent="menu_coop_root" action="action_coop_power" sequence="30"
            groups="coop_base.group_coop_board"/>

  <!--
    Справочники узла — одним разделом, а не вкладкой в каждом разделе.

    Рубрики ресурсов, правовые формы, специализации — это настройка узла,
    а не то, чем участник пользуется каждый день: вкладка «Справочники»
    рядом с «Каталогом организаций» ставила настройку в один ряд с
    витриной. Владелец 16 сентября 2026: «убери вкладку справочники, это
    наверно надо перенести в админку куда то».

    Корень живёт здесь, а сами справочники — в своих модулях: каждый
    добавляет свою вкладку к этому корню. Новые (события, торги,
    программы) идут туда же, а не заводят по вкладке у себя.

    Группа — та, что выдаётся переключателем полномочий
    (`coop_admin/models/res_users.py`, `ADMIN_GROUPS`): раздел виден,
    пока режим включён, и пропадает вместе с ним. Решение владельца 208.
  -->
  <menuitem id="menu_coop_reference_root" name="Справочники" sequence="900"
            groups="coop_base.group_coop_platform"/>

</odoo>
