<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coop_membership_list" model="ir.ui.view">
    <field name="name">coop.membership.list</field>
    <field name="model">coop.membership</field>
    <field name="arch" type="xml">
      <list string="Членство" decoration-muted="state == 'ended'"
            decoration-warning="state in ('applied', 'leaving')">
        <field name="partner_id"/>
        <field name="organization_id"/>
        <field name="job_title"/>
        <field name="role"/>
        <field name="power_ids" widget="many2many_tags"/>
        <field name="joined_on"/>
        <field name="has_vote" widget="boolean_toggle" readonly="1"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-warning="state in ('applied', 'leaving')"/>
      </list>
    </field>
  </record>

  <record id="view_coop_membership_form" model="ir.ui.view">
    <field name="name">coop.membership.form</field>
    <field name="model">coop.membership</field>
    <field name="arch" type="xml">
      <form string="Членство">
        <header>
          <button name="action_admit" type="object" string="Принять в члены"
                  class="btn-primary" invisible="state != 'applied'"/>
          <button name="action_apply_to_leave" type="object"
                  string="Подано заявление о выходе"
                  invisible="state != 'active'"/>
          <button name="action_terminate" type="object" string="Прекратить членство"
                  invisible="state not in ('leaving', 'applied')"
                  confirm="Членство будет прекращено. Расчёт по паю производится
по уставу — как правило, после утверждения годового отчёта. Продолжить?"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="applied,active,ended"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="display_name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Кто и где">
              <field name="partner_id"/>
              <field name="organization_id"/>
              <field name="job_title" placeholder="Бухгалтер"/>
              <field name="role"/>
              <field name="has_vote"/>
            </group>
            <group string="Сроки и основания">
              <field name="joined_on"/>
              <field name="admission_basis"
                     placeholder="Протокол общего собрания № 4 от 18.03.2024"/>
              <field name="left_on" invisible="state not in ('leaving', 'ended')"/>
              <field name="termination_basis"
                     invisible="state not in ('leaving', 'ended')"/>
            </group>
          </group>
          <group string="Полномочия">
            <field name="power_ids" widget="many2many_checkboxes" nolabel="1"/>
          </group>
          <div class="alert alert-info" role="status">
            Один член — один голос, независимо от размера пая. Приём и прекращение
            членства — решение органа управления: без ссылки на протокол членство
            не может стать действующим.
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_membership_search" model="ir.ui.view">
    <field name="name">coop.membership.search</field>
    <field name="model">coop.membership</field>
    <field name="arch" type="xml">
      <search string="Членство">
        <field name="partner_id"/>
        <field name="organization_id"/>
        <filter name="active" string="Действующие" domain="[('state', '=', 'active')]"/>
        <filter name="pending" string="Ждут решения"
                domain="[('state', 'in', ['applied', 'leaving'])]"/>
        <separator/>
        <filter name="members" string="Пайщики" domain="[('role', '=', 'member')]"/>
        <filter name="board" string="Правление" domain="[('role', '=', 'board')]"/>
        <filter name="audit" string="Ревизионная комиссия" domain="[('role', '=', 'audit')]"/>
        <separator/>
        <filter name="pw_publish" string="Публикуют"
                domain="[('power_ids.code', '=', 'publish')]"/>
        <filter name="pw_treasury" string="Ведут счета"
                domain="[('power_ids.code', '=', 'treasury')]"/>
        <filter name="pw_sign" string="Право подписи"
                domain="[('power_ids.code', '=', 'sign')]"/>
        <group>
          <filter name="by_org" string="По организации"
                  context="{'group_by': 'organization_id'}"/>
          <filter name="by_role" string="По роли" context="{'group_by': 'role'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_membership" model="ir.actions.act_window">
    <field name="name">Членство</field>
    <field name="res_model">coop.membership</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Записей о членстве пока нет</p>
      <p>Членство — это участие в организации, а не работа в ней: у одного
         человека оно бывает сразу в нескольких кооперативах, и у каждого
         свой устав и свой порядок выхода.</p>
    </field>
  </record>

</odoo>
