<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Первым делом при обновлении. Остальные модули грузят свои правила
    после coop_base — к этому моменту пометка уже снята, и их правки
    доезжают до базы в том же запуске.
  -->
  <function model="coop.security.unfreeze" name="apply"/>
</odoo>
