<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Объявления видят все вошедшие участники, правит — автор. Только
         вошедшие: предлагать цифровую валюту неопределённому кругу лиц
         нельзя (разбор юриста, 2.3), поэтому ни публичных страниц, ни
         доступа для портала. -->
    <record id="rule_crypto_offer_read" model="ir.rule">
      <field name="name">Объявления обмена — читают участники</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_crypto_offer_own" model="ir.rule">
      <field name="name">Объявления обмена — правит автор</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('author_id', '=', user.partner_id.id)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Обмен — дело двоих. -->
    <record id="rule_crypto_trade_parties" model="ir.rule">
      <field name="name">Свои обмены</field>
      <field name="model_id" ref="model_coop_crypto_trade"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('maker_id', '=', user.partner_id.id), ('taker_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_crypto_trade_admin" model="ir.rule">
      <field name="name">Обмены — администратор</field>
      <field name="model_id" ref="model_coop_crypto_trade"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_crypto_offer_admin" model="ir.rule">
      <field name="name">Объявления обмена — администратор</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
  </data>
</odoo>
