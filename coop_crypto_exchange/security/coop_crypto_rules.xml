<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Объявления видят все вошедшие участники, правит — автор. Только
         вошедшие: предлагать цифровую валюту неопределённому кругу лиц
         нельзя (разбор юриста, 2.3), поэтому ни публичных страниц, ни
         доступа для портала. -->
    <record id="rule_crypto_offer_read" model="ir.rule">
      <field name="name">Объявления обмена — читают участники</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_crypto_offer_own" model="ir.rule">
      <field name="name">Объявления обмена — правит автор</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('author_id', '=', user.partner_id.id)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Обмен — дело двоих. -->
    <record id="rule_crypto_trade_parties" model="ir.rule">
      <field name="name">Свои обмены</field>
      <field name="model_id" ref="model_coop_crypto_trade"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('maker_id', '=', user.partner_id.id), ('taker_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_crypto_trade_admin" model="ir.rule">
      <field name="name">Обмены — администратор</field>
      <field name="model_id" ref="model_coop_crypto_trade"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_crypto_offer_admin" model="ir.rule">
      <field name="name">Объявления обмена — администратор</field>
      <field name="model_id" ref="model_coop_crypto_offer"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- Пулы проектов: видят все участники, открывает и правит пул
         только инициатор проекта — администратор за него не открывает
         (решение 434, п. 7; проверка в create модели). Администратору
         остаётся правка для разбора споров. Взносы — свои; сводные цифры
         пула считаются на сервере. -->
    <record id="rule_farm_pool_read" model="ir.rule">
      <field name="name">Пулы ликвидности — читают участники</field>
      <field name="model_id" ref="model_coop_farm_pool"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_farm_pool_own" model="ir.rule">
      <field name="name">Пулы ликвидности — открывает инициатор проекта</field>
      <field name="model_id" ref="model_coop_farm_pool"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('project_id.partner_id', '=', user.partner_id.id)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_farm_pool_admin" model="ir.rule">
      <field name="name">Пулы ликвидности — администратор</field>
      <field name="model_id" ref="model_coop_farm_pool"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_farm_stake_own" model="ir.rule">
      <field name="name">Свои взносы в пулы</field>
      <field name="model_id" ref="model_coop_farm_stake"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_farm_stake_admin" model="ir.rule">
      <field name="name">Взносы в пулы — администратор</field>
      <field name="model_id" ref="model_coop_farm_stake"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- Доля участника в выплате пула (решение 436, п. 6): видит сам
         участник и инициатор проекта; подтверждают и оспаривают — методы
         модели от имени участника. -->
    <record id="rule_farm_payout_line_own" model="ir.rule">
      <field name="name">Выплаты участнику пула — свои и своего пула</field>
      <field name="model_id" ref="model_coop_farm_payout_line"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id),
                                  ('payout_id.pool_id.partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_farm_payout_line_admin" model="ir.rule">
      <field name="name">Выплаты участнику пула — администратор</field>
      <field name="model_id" ref="model_coop_farm_payout_line"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- Возврат комиссии DEX (решение 436, п. 8): свой. -->
    <record id="rule_dex_rebate_own" model="ir.rule">
      <field name="name">Возврат комиссии DEX — свой</field>
      <field name="model_id" ref="model_coop_dex_rebate"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_dex_rebate_admin" model="ir.rule">
      <field name="name">Возврат комиссии DEX — администратор</field>
      <field name="model_id" ref="model_coop_dex_rebate"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
  </data>
</odoo>
