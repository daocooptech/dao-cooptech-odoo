<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ru_bank_form" model="ir.ui.view">
        <field name="name">ru.bank.form</field>
        <field name="model">ru.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <group>
                    <group>
                        <field name="name" />
                        <field name="bic" />
                        <field name="country_code" invisible="1" />
                        <field name="corr_acc_ids" invisible="country_code != 'RU'" />
                    </group>
                    <group>
                        <field name="street" />
                        <field name="street2" />
                        <field name="zip" />
                        <field name="city" />
                        <field name="state_id" />
                        <field name="country_id" />
                        <field name="email" />
                        <field name="phone" />
                        <field name="active" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_ru_bank_list" model="ir.ui.view">
        <field name="name">ru.bank.list</field>
        <field name="model">ru.bank</field>
        <field name="arch" type="xml">
            <list string="Banks">
                <field name="name" />
                <field name="bic" />
                <field name="city" />
                <field name="country_id" />
            </list>
        </field>
    </record>

    <record id="view_ru_bank_search" model="ir.ui.view">
        <field name="name">ru.bank.search</field>
        <field name="model">ru.bank</field>
        <field name="arch" type="xml">
            <search string="Banks">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('bic', 'ilike', self)]" string="Bank" />
                <field name="bic" />
                <field name="city" />
            </search>
        </field>
    </record>

    <record id="action_ru_bank" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">ru.bank</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_ru_bank"
        name="Banks"
        parent="account.menu_finance_configuration"
        action="action_ru_bank"
        groups="account.group_account_manager"
        sequence="3"
    />

    <record id="update_ru_banks_wizard_form" model="ir.ui.view">
        <field name="name">update.ru.banks.wizard.form</field>
        <field name="model">update.ru.banks.wizard</field>
        <field name="arch" type="xml">
            <form string="Update the directory of Russian banks">
                 <button
                    class="btn-primary"
                    type="object"
                    name="action_import_banks"
                >Update</button>
            </form>
        </field>
    </record>

    <record id="update_ru_banks_wizard_action" model="ir.actions.act_window">
        <field name="name">Update the directory of Russian banks</field>
        <field name="res_model">update.ru.banks.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_action_update_ru_banks"
        name="Update the directory of Russian banks"
        parent="account.menu_finance_configuration"
        action="update_ru_banks_wizard_action"
        groups="account.group_account_manager"
        sequence="4"
    />

    <record id="ir_cron_action_update_ru_banks" model="ir.cron">
        <field name="name">Update Banks Russian</field>
        <field name="model_id" ref="l10n_ru_banks.model_update_ru_banks_wizard" />
        <field name="state">code</field>
        <field name="code">model.action_import_banks()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <!-- A bank chosen here copies its details into the account fields. -->
    <record id="view_partner_bank_form_ru_bank" model="ir.ui.view">
        <field name="name">res.partner.bank.form.ru.bank</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <field name="bank_name" position="before">
                <field name="ru_bank_id" options="{'no_create': True}" />
            </field>
        </field>
    </record>
</odoo>
