<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rsbu_vat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rsbu.vat</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="31"/>
        <field name="inherit_id" ref="rsbu_kudir.res_config_settings_view_form_rsbu"/>
        <field name="arch" type="xml">
            <block name="rsbu_usn_setting_container" position="after">
                <block title="НДС на УСН" name="rsbu_vat_setting_container">
                    <setting id="rsbu_vat_mode_setting"
                             string="Режим НДС"
                             help="Для компании без истории режимов. У организации пула режим на дату документа берётся из её карточки (Режим НДС).">
                        <field name="rsbu_vat_mode"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
