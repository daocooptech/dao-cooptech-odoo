<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rsbu_vat_summary_list" model="ir.ui.view">
        <field name="name">rsbu.vat.summary.list</field>
        <field name="model">rsbu.vat.summary</field>
        <field name="arch" type="xml">
            <list string="Итоги НДС">
                <field name="period_key"/>
                <field name="vat_charged"/>
                <field name="vat_deducted"/>
                <field name="vat_payable"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_rsbu_vat_summary" model="ir.actions.act_window">
        <field name="name">Итоги НДС</field>
        <field name="res_model">rsbu.vat.summary</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
