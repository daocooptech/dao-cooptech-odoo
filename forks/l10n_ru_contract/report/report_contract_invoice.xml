                                </t>
                            </tr>
                            <tr class="R0">
                                <td class="R0C6rl" colspan="3">Юридический адрес:
                                </td>
                                <td class="R0C6rl" colspan="3">Юридический адрес:
                                </td>
                            </tr>
                            <tr class="R0">
                                <td class="R0C6l" colspan="3">
                                    <t t-out="o.mt_contractid.address(o.company_id) or ''"/>
                                </td>
                                <td class="R0C7rl" colspan="3">
                                    <t t-out="o.mt_contractid.address(o.partner_id) or ''"/>
                                </td>
                            </tr>
                            <tr class="R0">
                                <td class="R0C6rl" colspan="3"></td>
                                <td class="R0C6rl" colspan="3"></td>
                            </tr>
                            <tr class="R0">
                                <td class="R0C6rl" colspan="3"></td>
                                <td class="R0C6rl" colspan="3"></td>
                            </tr>
                            <tr class="R0">
                                <td class="R0C6rl" colspan="3"></td>
                                <td class="R0C6rl" colspan="3"></td>
                            </tr>
