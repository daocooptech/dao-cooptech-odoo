<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_move_form_contract" model="ir.ui.view">
        <field name="name">account.move.form.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="mt_contract_id" readonly="state != 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="osnovanie" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="sf_number" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_contract" model="ir.ui.view">
        <field name="name">sale.order.form.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="mt_contract_id" readonly="state in ('cancel', 'sale')"/>
            </xpath>
        </field>
    </record>
</odoo>
