<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_rsbu" model="ir.ui.view">
        <field name="name">res.company.form.rsbu</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="РСБУ" name="rsbu"
                      groups="rsbu_journal.group_rsbu_journal_manager">
                    <group>
                        <field name="rsbu_enabled"/>
                        <field name="rsbu_start_date"
                               invisible="not rsbu_enabled"/>
                        <field name="rsbu_lock_date"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
