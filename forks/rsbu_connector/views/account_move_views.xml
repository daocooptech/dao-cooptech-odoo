<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_rsbu" model="ir.ui.view">
        <field name="name">account.move.form.rsbu</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_rsbu_move" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="rsbu_move_count == 0">
                    <field name="rsbu_move_count" widget="statinfo"
                           string="РСБУ"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
