<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_rsbu_tab" model="ir.ui.view">
        <field name="name">account.move.form.rsbu.tab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="РСБУ" name="rsbu" groups="rsbu_journal.group_rsbu_journal_user">
                    <group>
                        <field name="rsbu_template_id"/>
                        <field name="rsbu_move_id" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
