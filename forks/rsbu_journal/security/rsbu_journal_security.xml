<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rsbu_journal_user" model="res.groups">
        <field name="name">РСБУ / Журнал: пользователь</field>
        <field name="implied_ids" eval="[(4, ref('rsbu_chart_of_accounts.group_rsbu_account_user'))]"/>
    </record>

    <record id="group_rsbu_journal_manager" model="res.groups">
        <field name="name">РСБУ / Журнал: менеджер</field>
        <field name="implied_ids" eval="[(4, ref('group_rsbu_journal_user'))]"/>
    </record>

    <record id="rsbu_move_company_rule" model="ir.rule">
        <field name="name">РСБУ Операция: мультикомпания</field>
        <field name="model_id" ref="model_rsbu_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rsbu_move_line_company_rule" model="ir.rule">
        <field name="name">РСБУ Строка: мультикомпания</field>
        <field name="model_id" ref="model_rsbu_move_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
