<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rsbu_account_user" model="res.groups">
        <field name="name">РСБУ / План счетов: чтение</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rsbu_account_manager" model="res.groups">
        <field name="name">РСБУ / План счетов: администрирование</field>
        <field name="implied_ids" eval="[(4, ref('group_rsbu_account_user'))]"/>
    </record>

    <record id="rsbu_account_company_rule" model="ir.rule">
        <field name="name">РСБУ Счёт: мультикомпания</field>
        <field name="model_id" ref="model_rsbu_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
