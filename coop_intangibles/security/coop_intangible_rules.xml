<?xml version="1.0" encoding="utf-8"?>
<!--
  Без noupdate — правила доступа должны доезжать до узла обновлением
  модуля. Флаг «не обновлять» запоминается в ir_model_data при первой
  загрузке и переживает удаление из XML.

  Разбор архитектора 15 сентября 2026: у этого модуля в `security/` лежал
  только `ir.model.access.csv`, а файла с `ir.rule` не было ни одного —
  при том, что право на запись выдано всем участникам. Проверено на
  стенде от имени обычного участника: чужую запись удавалось переписать
  и удалить.

  Ниже — тот же образец, что уже работает в ресурсах, вакансиях,
  проектах и сообществах: опубликованное читают все, правит владелец,
  своё участие ведёт сам участник.
-->
<odoo>
  <data>

    <!-- Черновик — дело хозяина. Опубликованное читают все: это витрина,
         и закрывать её значило бы закрыть каталог. -->
    <record id="rule_intangible_read" model="ir.rule">
      <field name="name">Актив: черновик виден правообладателю, остальное всем</field>
      <field name="model_id" ref="model_coop_intangible"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('state', '!=', 'draft'),
          ('owner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Правит тот, кому доверено публиковать от имени владельца. Без
         этого правила любой участник переписывал чужую запись —
         цену, состояние, владельца — и удалял её. -->
    <record id="rule_intangible_write" model="ir.rule">
      <field name="name">Актив правит правообладатель</field>
      <field name="model_id" ref="model_coop_intangible"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('owner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Лицензия — договор двоих. Посторонним знать, кто у кого что
         лицензировал, не положено: это сведения о хозяйственных
         связях участников. -->
    <record id="rule_intangible_license_side" model="ir.rule">
      <field name="name">Лицензию видят её стороны</field>
      <field name="model_id" ref="model_coop_intangible_license"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('licensee_id', 'in', user.coop_actor_partner_ids.ids),
          ('intangible_id.owner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Правит тот, кому доверено публиковать от имени владельца. Без
         этого правила любой участник переписывал чужую запись —
         цену, состояние, владельца — и удалял её. -->
    <record id="rule_intangible_license_owner" model="ir.rule">
      <field name="name">Лицензию выдаёт правообладатель</field>
      <field name="model_id" ref="model_coop_intangible_license"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('intangible_id.owner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

  </data>
</odoo>
