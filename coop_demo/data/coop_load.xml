<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Вызов загрузчика идёт последним: он опирается на справочники навыков и
    на людей, заведённых в reference-данных, и до их появления работать
    ему не с чем.

    Через <function>, а не через post_init_hook: хук выполняется только
    при установке, а каталог должен обновляться и при `-u coop_demo` —
    иначе правки макета доезжают до стенда лишь после пересборки базы.
  -->
  <function model="coop.demo.loader" name="load_all"/>
</odoo>
