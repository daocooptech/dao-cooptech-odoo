<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Администратор стенда получает все роли платформы: видит и правит всё,
      включая членство в кооперативах. Решение владельца от 2026-09-01.

      Это решение об учётной записи, а не об модели доступа. Само правило
      «платформа не сторона отношений участников» остаётся в силе: группа
      «Рабочая группа платформы» по-прежнему не даёт прав в чужих
      кооперативах, а правила доступа перечисляют пайщика, правление и
      ревизию. Просто конкретному администратору стенда выданы ещё и эти
      роли — чтобы вести данные и показывать разделы, не переключая
      пользователей.

      На боевом узле так делать не следует: там у администратора должна
      быть только группа платформы, иначе поимённый состав чужих
      кооперативов открыт оператору сети.
    -->
    <record id="base.user_admin" model="res.users">
      <field name="group_ids" eval="[
          (4, ref('coop_base.group_coop_platform')),
          (4, ref('coop_base.group_coop_member')),
          (4, ref('coop_base.group_coop_board')),
          (4, ref('coop_base.group_coop_audit')),
      ]"/>
    </record>


    <!--
      Сквозное правило для администратора узла. Роли выше сами по себе
      ничего не открывают: правила доступа к членству привязаны к
      собственному членству пользователя, а администратор ни в одном
      кооперативе не состоит — и без этого правила видел бы пустой список.

      Правило живёт в демонстрационном модуле намеренно. На узле, где
      coop_demo не установлен, строгая модель остаётся нетронутой: состав
      кооператива видят только его пайщики, правление и ревизия.
    -->
    <record id="rule_membership_system" model="ir.rule">
      <field name="name">Администратор узла видит всё членство</field>
      <field name="model_id" ref="coop_base.model_coop_membership"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

  </data>
</odoo>
