<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coop_warehouse_offer_kanban" model="ir.ui.view">
    <field name="name">coop.warehouse.offer.kanban</field>
    <field name="model">coop.warehouse.offer</field>
    <field name="arch" type="xml">
      <kanban js_class="coop_catalog_kanban" class="o_coop_wh_offers"
              default_order="published_on desc">
        <field name="icon"/>
        <field name="side"/>
        <field name="side_short"/>
        <field name="city"/>
        <field name="storage_kind"/>
        <field name="volume_label"/>
        <field name="terms_label"/>
        <field name="main_price_label"/>
        <field name="period_label"/>
        <field name="owner_id"/>
        <field name="state"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_listing o_coop_who">
              <!-- Снимок карточки. Свой, если есть; иначе лицо той стороны,
                   с которой придётся иметь дело, — знак организации или
                   аватар человека. Значок остаётся последним средством. -->
              <div class="o_coop_media">
                <img class="o_coop_media_logo" t-if="record.owner_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.owner_id.raw_value}/image_512"
                     t-att-alt="record.owner_id.value"/>
                <span t-else="" class="o_coop_media_sign"><t t-esc="record.icon.value"/></span>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>
              <div class="o_coop_listing_body">

                <div class="o_coop_who_head">
                  <span class="o_coop_badge o_coop_who_side"
                        t-att-class="'o_coop_who_' + record.side.raw_value">
                    <t t-esc="record.side_short.value"/>
                  </span>
                  <span class="o_coop_who_meta" t-if="record.city.raw_value">
                    <i class="fa fa-map-marker" aria-hidden="true"/>
                    <t t-esc="record.city.value"/>
                  </span>
                </div>

                <div class="o_coop_listing_title o_coop_who_name">
                  <field name="name"/>
                </div>

                <div class="o_coop_who_head">
                  <span class="o_coop_who_price">
                    <t t-esc="record.main_price_label.value"/>
                  </span>
                  <span class="o_coop_who_meta">
                    <t t-esc="record.volume_label.value"/>
                  </span>
                </div>

                <div class="o_coop_who_terms" t-if="record.terms_label.raw_value">
                  <t t-esc="record.terms_label.value"/>
                </div>

                <div class="o_coop_listing_foot o_coop_who_foot">
                  <span class="o_coop_who_meta">
                    <t t-esc="record.owner_id.value"/>
                  </span>
                  <span class="o_coop_who_meta">
                    <t t-esc="record.period_label.value"/>
                  </span>
                </div>

              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_warehouse_offer_list" model="ir.ui.view">
    <field name="name">coop.warehouse.offer.list</field>
    <field name="model">coop.warehouse.offer</field>
    <field name="arch" type="xml">
      <list string="Биржа мощностей"
            decoration-muted="state == 'closed'"
            decoration-success="state == 'published'">
        <field name="name"/>
        <field name="side"/>
        <field name="owner_id" string="Кто"/>
        <field name="city"/>
        <field name="storage_kind" string="Хранение"/>
        <field name="volume_label" string="Сколько"/>
        <field name="terms_label" string="Условия"/>
        <field name="main_price_label" string="Цена"/>
        <field name="period_label" string="Срок"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_coop_warehouse_offer_form" model="ir.ui.view">
    <field name="name">coop.warehouse.offer.form</field>
    <field name="model">coop.warehouse.offer</field>
    <field name="arch" type="xml">
      <form string="Объявление на бирже">
        <header>
          <!-- Единственное действие участника: до него все три кнопки
               были хозяйскими. Как в макете (`ext-warehouse.html`). -->
          <button name="action_respond" type="object" string="Отправить отклик"
                  class="btn-primary" invisible="not can_respond"/>
          <button name="action_publish" type="object" string="Опубликовать"
                  class="btn-primary" invisible="state == 'published'"/>
          <button name="action_matched" type="object" string="Договорились"
                  invisible="state != 'published'"/>
          <button name="action_close" type="object" string="Снять"
                  invisible="state in ('draft', 'closed')"/>
          <button name="action_back_to_draft" type="object" string="В черновик"
                  invisible="state == 'draft'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,published,matched"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <field name="can_respond" invisible="1"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Что предлагаете или что ищете" widget="coop_inline" options="{'wrap': true}" readonly="not coop_can_edit"/></h1>
          </div>
          <group>
            <group string="Кто и что">
              <field name="side" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="owner_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="warehouse_id"
                     required="side == 'offer'"
                     invisible="side == 'request'" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="city" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="storage_kind" widget="coop_inline" readonly="not coop_can_edit"/>
            </group>
            <group string="Сколько и когда">
              <label for="volume"/>
              <div class="o_row">
                <field name="volume" widget="coop_inline" readonly="not coop_can_edit"/>
                <field name="capacity_unit" widget="coop_inline" readonly="not coop_can_edit"/>
              </div>
              <field name="date_from" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="date_to" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="published_on" readonly="1"/>
              <field name="main_price_label" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Условия" name="terms">
              <field name="term_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="kind"/>
                  <field name="price"/>
                  <field name="price_unit" placeholder="за м² в месяц"/>
                  <field name="note" placeholder="Оговорка"/>
                </list>
              </field>
              <div class="text-muted mt-2">
                Условий бывает несколько сразу, и выбирает откликающийся.
                У обмена, пая и участия в проекте цены нет — там платят не
                деньгами, и пустая цена в этих строках правильна.
              </div>
            </page>
            <page string="Описание" name="description">
              <field name="description"
                     placeholder="Что за место, что рядом, чего нельзя хранить" widget="coop_block" readonly="not coop_can_edit"/>
              <field name="contact_note" placeholder="Как связаться и когда приезжать" widget="coop_inline" readonly="not coop_can_edit"/>
            </page>
            <page string="Сделки" name="deals">
              <field name="deal_ids">
                <list>
                  <field name="number"/>
                  <field name="name"/>
                  <field name="party_b_id" string="С кем"/>
                  <field name="warehouse_volume" string="Объём"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_warehouse_offer_search" model="ir.ui.view">
    <field name="name">coop.warehouse.offer.search</field>
    <field name="model">coop.warehouse.offer</field>
    <field name="arch" type="xml">
      <search string="Биржа мощностей">
        <field name="name"/>
        <field name="owner_id" string="Кто разместил"/>
        <field name="city"/>
        <field name="storage_kind"/>
        <filter name="side_offer" string="Предлагают мощности"
                domain="[('side', '=', 'offer')]"/>
        <filter name="side_request" string="Ищут мощности"
                domain="[('side', '=', 'request')]"/>
        <separator/>
        <filter name="published" string="Опубликованные"
                domain="[('state', '=', 'published')]"/>
        <filter name="matched" string="Договорились"
                domain="[('state', '=', 'matched')]"/>
        <filter name="mine" string="Мои объявления"
                domain="[('is_mine', '=', True)]"/>
        <separator/>
        <filter name="term_project" string="Под участие в проекте"
                domain="[('term_ids.kind', '=', 'project')]"/>
        <filter name="term_barter" string="В обмен на мощности"
                domain="[('term_ids.kind', '=', 'barter')]"/>
        <filter name="term_share" string="Паем"
                domain="[('term_ids.kind', '=', 'share')]"/>
        <group>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
          <filter name="by_kind" string="По типу хранения"
                  context="{'group_by': 'storage_kind'}"/>
          <filter name="by_side" string="По стороне"
                  context="{'group_by': 'side'}"/>
          <filter name="by_state" string="По состоянию"
                  context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_warehouse_offer" model="ir.actions.act_window">
    <field name="name">Биржа мощностей</field>
    <field name="res_model">coop.warehouse.offer</field>
    <field name="path">warehouse-market</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('state', 'in', ('published', 'matched'))]</field>
    <field name="context">{'bin_size': True,'coop_catalog': 1, 'search_default_side_offer': 1, 'coop_shelf_field': 'storage_kind'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">На бирже пока пусто</p>
      <p>Свободное место одного участника закрывает потребность другого
         напрямую, без склада-посредника. Платформа мощности на себя не
         берёт и не перепродаёт: она сводит стороны и фиксирует условия
         обычной сделкой.</p>
    </field>
  </record>

  <record id="action_coop_warehouse_offer_mine" model="ir.actions.act_window">
    <field name="name">Мои объявления</field>
    <field name="res_model">coop.warehouse.offer</field>
    <field name="path">my-warehouse-offers</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('is_mine', '=', True)]</field>
    <field name="context">{'bin_size': True,'coop_catalog': 1, 'coop_create_label': 'Разместить объявление'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока ничего не выставляли</p>
      <p>Выставить свободное место можно с карточки склада — кнопкой
         «Выставить свободные мощности».</p>
    </field>
  </record>

  <menuitem id="menu_coop_warehouse_market" name="Биржа мощностей"
            parent="menu_coop_warehouse_root"
            action="action_coop_warehouse_offer" sequence="30"/>
  <menuitem id="menu_coop_warehouse_offers_mine" name="Мои объявления"
            parent="menu_coop_warehouse_root"
            action="action_coop_warehouse_offer_mine" sequence="35"/>

</odoo>
