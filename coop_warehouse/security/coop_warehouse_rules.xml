<?xml version="1.0" encoding="utf-8"?>
<!--
  Без `noupdate`. Правила доступа — это код, а не данные пользователя:
  правка правила должна доезжать до узла обновлением модуля. С пометкой
  «не обновлять» исправления молча теряются, и правило продолжает
  работать в прежнем, ошибочном виде.
-->
<odoo>
  <data>

    <!--
      Склад — не объявление: чужой склад участнику видеть незачем, пока
      хозяин сам не выставил с него мощности. Поэтому читать можно свои
      склады и те, с которых есть опубликованное объявление на бирже, —
      иначе карточка биржи ведёт в пустоту.
    -->
    <record id="rule_warehouse_read" model="ir.rule">
      <field name="name">Участник видит свои склады и те, что на бирже</field>
      <field name="model_id" ref="model_coop_warehouse"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', ('owner_id', 'in', user.coop_actor_partner_ids.ids),
         ('offer_ids.state', '=', 'published')]
      </field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!--
      Своё — это и своё личное, и своих организаций: складом обычно
      распоряжается представитель кооператива, а не его председатель
      лично.
    -->
    <record id="rule_warehouse_own" model="ir.rule">
      <field name="name">Править можно только свой склад</field>
      <field name="model_id" ref="model_coop_warehouse"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('owner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_warehouse_system" model="ir.rule">
      <field name="name">Администратор узла ведёт все склады</field>
      <field name="model_id" ref="model_coop_warehouse"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!--
      Объявление на бирже — публичная витрина: опубликованное видно всем,
      черновик и снятое — только хозяину. Договорившиеся объявления
      остаются видимыми: по ним ищут, чем всё кончилось.
    -->
    <record id="rule_warehouse_offer_read" model="ir.rule">
      <field name="name">Участник видит опубликованные объявления и свои</field>
      <field name="model_id" ref="model_coop_warehouse_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', ('state', 'in', ('published', 'matched')),
         ('owner_id', 'in', user.coop_actor_partner_ids.ids)]
      </field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_warehouse_offer_own" model="ir.rule">
      <field name="name">Править можно только своё объявление</field>
      <field name="model_id" ref="model_coop_warehouse_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('owner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_warehouse_offer_system" model="ir.rule">
      <field name="name">Администратор узла ведёт все объявления биржи</field>
      <field name="model_id" ref="model_coop_warehouse_offer"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

  </data>
</odoo>
