[Unit]
Description=ДАО КООПТЕХ (Odoo 19)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=odoo
Group=odoo
# Путь к venv первым: при перезапуске по пределу памяти Odoo делает
# execv с argv[0] = «python» и ищет его по PATH. Без этой строки находился
# системный Python без зависимостей (ModuleNotFoundError: passlib), процесс
# падал, и systemd поднимал его через 5 с — «Соединение потеряно» у
# участников после каждой выкатки. Владелец разрешил 25.09.2026.
Environment=PATH=/opt/coop/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/coop/venv/bin/python /opt/coop/odoo/odoo-bin -c /etc/coop-odoo.conf
KillMode=mixed
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
