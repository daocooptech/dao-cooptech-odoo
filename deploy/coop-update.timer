[Unit]
Description=Обновлять ДАО КООПТЕХ (выключен: выкатываем по команде)

[Timer]
; Решение владельца: выкатываем по команде, а не по расписанию.
; Каждое обновление перезапускает службу, и участник на эти секунды
; видит страницу «платформа обновляется». Пачка правок доводится
; до конца и выкатывается разом:
;
;     ssh root@217.15.207.46 "bash /opt/coop/coop-addons/deploy/update.sh"
;
; Раз в сутки оставлено страховкой — на случай, если выкатить забыли.
OnCalendar=*-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
