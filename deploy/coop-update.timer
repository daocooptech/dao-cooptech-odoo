[Unit]
Description=Обновлять ДАО КООПТЕХ, как только в main появились изменения

[Timer]
; Раз в минуту. Раз в сутки отменено решением владельца: правка, сделанная
; днём, до следующего утра не существовала — её нельзя было ни показать,
; ни проверить. Проверка стоит одного git fetch в минуту: если нового нет,
; update.sh выходит, не трогая ни базу, ни службу, ни сборку стилей.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
