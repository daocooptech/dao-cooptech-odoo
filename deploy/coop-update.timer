[Unit]
Description=Обновлять ДАО КООПТЕХ, когда в main появились изменения

[Timer]
; Каждые пять минут вместо раза в сутки. Проверка стоит одного git fetch:
; если в main ничего нового, update.sh выходит, не трогая ни базу, ни службу.
; Сутки ожидания стоили дороже — правка, сделанная днём, попадала на экран
; только на следующее утро, и до тех пор её нельзя было ни показать,
; ни проверить.
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
