# Ротация журнала Odoo.
#
# Зачем. За две недели журнал вырос до 215 МБ — это около пяти гигабайт в
# год при семи свободных на диске в двадцать. Правила ротации на него не
# было ни одного: в `/etc/logrotate.d/` лежат nginx и postgresql, а
# `/var/log/coop/` никто не подметал. Диск кончился бы молча, и первым
# признаком стала бы не запись в журнале, а вставшая база.
#
# `copytruncate`, а не `create`: Odoo держит файл журнала открытым всё
# время работы и переоткрывать его по сигналу не умеет. При обычной
# ротации он продолжил бы писать в переименованный файл, и новый остался
# бы пустым навсегда — ровно та беда, которую не замечают, пока не
# понадобится журнал.
#
# `size` вместо `daily`: в тихие дни ротировать нечего, а в день с кругом
# перезагрузок журнал набирает сотню мегабайт за часы. Мера — объём, а не
# календарь.
/var/log/coop/*.log {
    su odoo odoo
    size 50M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
