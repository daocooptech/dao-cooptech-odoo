<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Одна форма на «Мою страницу» и на карточку того же человека глазами
    постороннего. Второй формы нет намеренно: они разъедутся на первой же
    правке, и владелец начнёт видеть не то, что показывает гостям.
    Разница выражена признаком «это я» и правами.

    Раскладка повторяет макет: слева колонка в 300 пикселей с обложкой и
    справками, справа — полосы владений с плитками. Штатные группы полей
    здесь не годятся: они дают две колонки «подпись — значение», а в
    макете левая колонка самостоятельная и живёт по своим правилам.
  -->
  <!--
    Форма записи об образовании. Открывается кнопкой «+ добавить» из
    блока на странице — по одной записи за раз, как просил владелец.

    Заведение выбирается из справочника; ступень подставляется сама —
    университет даёт высшее, техникум профессиональное, и спрашивать об
    этом участника незачем. Своё, которого в справочнике нет, вписывается
    в отдельное поле.
  -->
  <record id="view_coop_education_form" model="ir.ui.view">
    <field name="name">coop.education.form</field>
    <field name="model">coop.education</field>
    <field name="arch" type="xml">
      <form string="Образование">
        <field name="partner_id" invisible="1"/>
        <group>
          <field name="institution_id" options="{'no_create': True}"
                 placeholder="Начните вводить: СФУ, МГУ, ИФКАТТ"/>
          <field name="name" invisible="institution_id"
                 placeholder="Если вашего заведения нет в справочнике"/>
          <field name="level"/>
          <field name="speciality" placeholder="Электроснабжение, агрономия"/>
          <field name="year_from"/>
          <field name="year_to"/>
        </group>
        <footer>
          <button string="Сохранить" special="save" class="btn-primary"/>
          <button string="Отмена" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_profile_form" model="ir.ui.view">
    <field name="name">coop.profile.form</field>
    <field name="model">res.partner</field>
    <!-- Меньше штатного: вид по умолчанию движок выбирает по
         наименьшему приоритету, и по прямой ссылке на участника
         должна открываться страница платформы, а не карточка
         контакта из справочника. -->
    <field name="priority">1</field>
    <field name="arch" type="xml">
      <form string="Участник" class="o_coop_profile">
        <header>
          <button name="action_coop_message" type="object" string="Написать"
                  class="btn-primary" invisible="coop_is_self"/>
          <button name="action_coop_befriend" type="object"
                  string="Добавить в друзья"
                  invisible="coop_is_self or coop_friend_state != 'none'"/>
          <button name="action_coop_befriend" type="object"
                  string="Принять дружбу" class="btn-primary"
                  invisible="coop_friend_state != 'pending_in'"/>
          <button name="action_coop_follow" type="object" string="Подписаться"
                  invisible="coop_is_self or coop_is_following"/>
          <button name="action_coop_follow" type="object" string="Отписаться"
                  invisible="coop_is_self or not coop_is_following"/>
          <!--
            Блокировка — последней и без выделения: это редкое
            действие, и яркая кнопка рядом с «Написать» предлагала бы
            его наравне с разговором.
          -->
          <field name="coop_is_blocked_by_me" invisible="1"/>
          <button name="action_coop_block" type="object" string="Заблокировать"
                  invisible="coop_is_self or coop_is_blocked_by_me"
                  confirm="Заблокировать участника? Он не сможет вам писать. Извещения об этом он не получит."/>
          <button name="action_coop_unblock" type="object" string="Разблокировать"
                  invisible="coop_is_self or not coop_is_blocked_by_me"/>
        </header>
        <sheet class="o_coop_profile_sheet">
          <!--
            Вкладка «Мои объявления» убрана словом владельца 14 сентября
            2026. Ряд из одной вкладки «Моя страница» рядом с ней тоже:
            вкладки нужны, когда между ними переключаются, а одна
            вкладка — это заголовок, и заголовок у страницы уже есть.

            Само действие осталось: к неопубликованным объявлениям
            участник приходит из полос владений ниже, где рядом стоят и
            опубликованные.
          -->
          <field name="coop_page_visible" invisible="1"/>
          <field name="coop_page_audience" invisible="1"/>

          <!--
            Закрытая страница. Не отказ доступа и не пустой экран:
            человек имеет право не показывать себя, и об этом надо
            сказать словами, а не оборванной вёрсткой.
          -->
          <div class="o_coop_closed_page" invisible="coop_page_visible">
            <h2><field name="name" nolabel="1" readonly="1"/></h2>
            <p>Участник открывает свою страницу только своим связям и
               сторонам совместных сделок.</p>
            <p class="text-muted">Напишите ему в сообщениях, если он
               принимает письма от всех. Появится общая сделка или он
               примет ваше предложение дружбы — страница откроется.</p>
            <button name="action_coop_message" type="object"
                    string="Написать" class="btn-primary"/>
          </div>

          <div class="o_coop_profile_layout" invisible="not coop_page_visible">

            <!-- ── Левая колонка ─────────────────────────────────── -->
            <div class="o_coop_profile_side">
              <div class="o_coop_cover">
                <field name="image_1920" widget="image"
                       options="{'preview_image': 'avatar_256'}"
                       readonly="not coop_is_self"/>
              </div>

              <!--
                Строка показателей: доверие, баланс, сделки, подписчики,
                друзья — как в макете. У каждого числа, которое нельзя
                проверить взглядом, рядом стоит переход туда, где оно
                раскладывается.
              -->
              <div class="o_coop_stats">
                <!--
                  Доверие без пояснения — число, взявшееся ниоткуда, а по
                  нему решают, иметь ли с человеком дело. Ссылка ведёт в
                  реестр сделок: там видно, из чего оно сложилось.
                -->
                <!-- Переключатели приватности действуют на чужом
                     взгляде, себе видно всё: настройка про то, что
                     показывают другим, а не про то, что видишь сам. -->
                <div invisible="not coop_is_self and not coop_show_trust">Уровень доверия:
                  <b><field name="coop_trust" nolabel="1" readonly="1"/>%</b>
                  <!-- Дробь — как в макете, короткой записью: колонка
                       узкая, а расшифровка живёт в подсказке рядом. -->
                  <span class="o_coop_stat_frac" invisible="not coop_deals_reviewed">
                    (<field name="coop_deals_positive" nolabel="1" readonly="1"/>/<field
                       name="coop_deals_reviewed" nolabel="1" readonly="1"/>)
                  </span>
                  <button name="action_coop_my_deals" type="object"
                          class="o_coop_stat_note"
                          title="Слева — сделки, по которым о вас отозвались на «хорошо» или «отлично»; справа — все сделки с отзывом о вас. Сделка, по которой никто не высказался, в счёт не идёт. Отзыв задним числом не меняется. Открыть реестр сделок.">как считается?</button>
                </div>
                <!--
                  Баланс — только себе. В макете он стоит и на чужой
                  карточке, то есть остаток чужих денег виден
                  постороннему; это ошибка выгрузки, а не решение.
                -->
                <div invisible="not coop_is_self">Баланс:
                  <b><field name="coop_balance" nolabel="1" readonly="1"/></b>
                  <button name="action_coop_my_wallet" type="object"
                          class="o_coop_stat_note">история операций →</button>
                </div>
                <!--
                  Здесь настоящее число сделок из реестра, а не отметка
                  «завершённых» из карточки: рядом стоит ссылка на сам
                  реестр, и два разных числа в двух щелчках друг от друга
                  выглядят как сбой. Отметка осталась в строке доверия —
                  она про отзывы, а не про количество.
                -->
                <div invisible="not coop_is_self and not coop_show_deals">Сделки:
                  <b><field name="coop_deal_count" nolabel="1" readonly="1"/></b>
                  <button name="action_coop_my_deals" type="object"
                          class="o_coop_stat_note">реестр сделок →</button>
                </div>
                <div invisible="not coop_follower_count or (not coop_is_self and not coop_show_followers)">Подписчиков:
                  <b><field name="coop_follower_count" nolabel="1" readonly="1"/></b>
                </div>
                <div invisible="not coop_friend_count or (not coop_is_self and not coop_show_friends)">Друзей:
                  <b><field name="coop_friend_count" nolabel="1" readonly="1"/></b>
                </div>
              </div>

              <div class="o_coop_infobox">
                <div class="o_coop_infobox_head">Контакты</div>
                <!--
                  Четыре строки вместо восьми. Skype, мессенджеры, соцсети
                  и приложения убраны: перечень видов связи устаревает
                  быстрее, чем платформа обновляется, и каждый новый
                  требовал бы своего поля. Вместо перечня — «добавить
                  поле» ниже: человек сам называет, чем с ним связаться.
                  Решение владельца 332.

                  Правка по месту: карандаш у самой строки, галочка
                  публикует, крестик отменяет. Право правки — то же
                  условие, что и раньше, только теперь оно решает, будет
                  ли карандаш, а не будет ли поле рамкой.
                -->
                <div class="o_coop_infobox_body">
                  <div invisible="not coop_is_self and not coop_show_city">
                    <span class="o_coop_key">Город</span>
                    <field name="city" widget="coop_inline"
                           readonly="not coop_is_self"
                           placeholder="не указан"/></div>
                  <div invisible="not coop_is_self and not coop_show_email">
                    <span class="o_coop_key">Почта</span>
                    <field name="email" widget="coop_inline"
                           readonly="not coop_is_self"
                           placeholder="не указана"/></div>
                  <div invisible="not coop_is_self and not coop_show_phone">
                    <span class="o_coop_key">Телефон</span>
                    <field name="phone" widget="coop_inline"
                           readonly="not coop_is_self"
                           placeholder="не указан"/></div>
                  <div invisible="not coop_is_self and not coop_show_contacts">
                    <span class="o_coop_key">Сайт</span>
                    <field name="website" widget="coop_inline"
                           readonly="not coop_is_self" placeholder="нет"/></div>
                  <!--
                    Дальше — то, что человек дописал сам: пара «название —
                    значение», сколько нужно строк. Подписи у них нет: подпись
                    и есть то, что набрали в левой колонке.
                  -->
                  <div class="o_coop_contact_extra"
                       invisible="not coop_is_self and not coop_show_contacts">
                    <field name="coop_contact_line_ids" nolabel="1"
                           widget="coop_contact_lines"
                           readonly="not coop_is_self"/>
                  </div>
                </div>
              </div>

              <div class="o_coop_infobox" invisible="is_company">
                <div class="o_coop_infobox_head">Личная информация</div>
                <div class="o_coop_infobox_body">
                  <div invisible="not coop_age">
                    <span class="o_coop_key">Возраст</span>
                    <field name="coop_age" readonly="1"/>
                  </div>
                  <!--
                    Дата — тем же приёмом, что и строки: карандаш, а при
                    правке выбор даты. Виджет один на все виды полей,
                    разница только в том, чем набирают (решение 332).
                  -->
                  <div invisible="not coop_is_self and not coop_show_birthdate">
                    <span class="o_coop_key">Родился</span>
                    <field name="coop_birthdate" widget="coop_inline"
                           readonly="not coop_is_self"
                           placeholder="не указано"/>
                  </div>
                  <div><span class="o_coop_key">Проверка</span>
                    <field name="coop_verification_level" readonly="1"/></div>
                  <div invisible="not coop_languages and not coop_is_self">
                    <span class="o_coop_key">Языки</span>
                    <field name="coop_languages" widget="coop_inline"
                           readonly="not coop_is_self"
                           placeholder="русский, английский"/>
                  </div>
                  <div invisible="not coop_registered_on">
                    <span class="o_coop_key">На платформе с</span>
                    <field name="coop_registered_on" readonly="1"/>
                  </div>
                </div>
              </div>

              <!--
                Образование строками по ступеням, как велел владелец
                15 сентября 2026: «напиши высшее и сокращённо заведение,
                например СФУ и год окончания, ниже профессиональное…
                ниже среднее».

                Ступень — подзаголовком, заведение — строкой во всю
                ширину под ним. Меткой слева, как в «Контактах», было
                нельзя: в колонку шириной девяносто точек не помещается
                ни «МГТУ им. Баумана — 1997 г.», ни «КМС — 2015 г.,
                ПК № 8 — 1991 г.», и строка ломалась посреди названия.
                Владелец 20 сентября 2026: «в блоке образование как то
                всё не красиво, давай сделаем так что есть подзаголовок
                например высшее, а ниже строчка полностью под название
                учреждения».

                Сокращение — из справочника учебных заведений; вписанное
                вручную показывается как есть.
              -->
              <div class="o_coop_infobox"
                   invisible="not coop_education_ids and not coop_is_self">
                <div class="o_coop_infobox_head">Образование</div>
                <div class="o_coop_infobox_body">
                  <div class="o_coop_edu_row" invisible="not coop_edu_higher">
                    <span class="o_coop_key">Высшее</span>
                    <field name="coop_edu_higher" readonly="1"/>
                  </div>
                  <div class="o_coop_edu_row" invisible="not coop_edu_college">
                    <span class="o_coop_key">Профессиональное</span>
                    <field name="coop_edu_college" readonly="1"/>
                  </div>
                  <div class="o_coop_edu_row" invisible="not coop_edu_school">
                    <span class="o_coop_key">Среднее</span>
                    <field name="coop_edu_school" readonly="1"/>
                  </div>
                  <div class="o_coop_edu_row" invisible="not coop_edu_courses">
                    <span class="o_coop_key">Доп. образование</span>
                    <field name="coop_edu_courses" readonly="1"/>
                  </div>
                  <!--
                    Своя страница — можно дописать. Владелец просил
                    «возможность добавить в список по одному»: заводится
                    по одной записи на своей форме, где есть и годы, и
                    специальность.
                  -->
                  <div class="o_coop_infobox_add" invisible="not coop_is_self">
                    <button name="action_coop_add_education" type="object"
                            class="btn btn-link p-0">+ добавить</button>
                  </div>
                </div>
              </div>

            </div>

            <!-- ── Правая колонка ────────────────────────────────── -->
            <div class="o_coop_profile_main">
              <div class="o_coop_name_row">
                <h1><field name="name" readonly="not coop_is_self"
                           placeholder="Имя и фамилия"/></h1>
                <span class="o_coop_verified"
                      invisible="coop_verification_level != 'identity'">
                  Личность подтверждена
                </span>
              </div>
              <div class="o_coop_role">
                <!-- Признаки приватности: условия выше считаются по ним. -->
                <field name="coop_show_trust" invisible="1"/>
                <field name="coop_show_deals" invisible="1"/>
                <field name="coop_show_balance" invisible="1"/>
                <field name="coop_show_friends" invisible="1"/>
                <field name="coop_show_followers" invisible="1"/>
                <field name="coop_show_phone" invisible="1"/>
                <field name="coop_show_email" invisible="1"/>
                <field name="coop_show_contacts" invisible="1"/>
                <field name="coop_show_birthdate" invisible="1"/>
                <field name="coop_show_city" invisible="1"/>
                <field name="coop_show_orgs" invisible="1"/>
                <field name="coop_specialization_id"
                       readonly="not coop_is_self"
                       placeholder="Чем занимаетесь"/>
              </div>

              <div class="o_coop_notice o_coop_notice_wait"
                   invisible="not coop_is_self or coop_verification_level == 'identity'">
                Подтвердите личность — после этого откроются сделки,
                вакансии, организации, проекты и операции с деньгами.
              </div>

              <!--
                Напоминание из макета. Показывается только владельцу и
                только когда есть о чём напоминать: подтверждение
                возвращает объявлению место в выдаче, где свежие стоят
                выше, — иначе подтверждать было бы незачем.
              -->
              <div class="o_coop_notice o_coop_notice_stale"
                   invisible="not coop_stale_resource_ids">
                <div class="o_coop_notice_text">
                  <!-- Название плашкой, без кавычек вокруг неё: плашка и
                       так отделяет название от текста, а кавычки рядом с
                       ней читались как часть названия. -->
                  Ваше объявление
                  <field name="coop_stale_resource_ids" widget="many2many_tags"
                         readonly="1" nolabel="1"/>
                  висит в каталоге больше месяца.
                  <div class="o_coop_notice_sub">
                    Оно всё ещё актуально? Свежие объявления выше в выдаче.
                  </div>
                </div>
                <div class="o_coop_notice_actions">
                  <button name="action_coop_confirm_listing" type="object"
                          class="btn btn-secondary">Да, актуально</button>
                  <button name="action_coop_unpublish_listing" type="object"
                          class="btn btn-secondary">Снять с публикации</button>
                </div>
              </div>


              <!--
                Строка статуса, а не статья. Стояло штатное `comment` —
                поле Html, а с ним весь редактор движка: вставка
                картинок и видео, загрузка файлов, кнопки, оглавление,
                оценка звёздами. Блок отвечает на вопрос «чем
                занимаюсь»; лента, портфолио и файлы на платформе есть
                свои. Длина ограничена самим полем — 280 знаков.
              -->
              <!--
                Шапку и тело рисует само поле: в шапке стоит карандаш, и
                держать кнопку в представлении, а её состояние — в
                виджете значило бы связывать их через разметку.
              -->
              <div class="o_coop_band o_coop_about_band"
                   invisible="not coop_about and not coop_is_self">
                <field name="coop_about" widget="coop_about" nolabel="1"
                       placeholder="Чем занимаетесь, что умеете, чем готовы помочь — до 280 знаков"
                       readonly="not coop_is_self"/>
              </div>

              <!--
                Полосы владений. Пустые не показываются вовсе: в макете
                они есть все девять, и у человека с двумя записями семь
                из них пустуют со стрелками, которые нечего листать —
                страница читается как недогрузившаяся.
              -->
              <div class="o_coop_band"
                   invisible="not coop_friend_ids or (not coop_is_self and not coop_show_friends)">
                <div class="o_coop_band_head">
                  <span>Друзья</span>
                  <button name="action_coop_my_friends" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_friend_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/res.partner/' + record.id.raw_value + '/avatar_256'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="coop_offer_count == 0">
                <div class="o_coop_band_head">
                  <span>Навыки</span>
                  <button name="action_coop_my_offers" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_offer_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="image_512"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.skill.offer/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="coop_resource_count == 0">
                <div class="o_coop_band_head">
                  <span>Ресурсы</span>
                  <button name="action_coop_my_resources" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_resource_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="image_512"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.resource/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="coop_vacancy_count == 0">
                <div class="o_coop_band_head">
                  <span>Вакансии</span>
                  <button name="action_coop_my_vacancies" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_vacancy_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="city"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.vacancy/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                            <div class="o_coop_mini_note">
                              <field name="city"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="coop_project_count == 0">
                <div class="o_coop_band_head">
                  <span>Проекты</span>
                  <button name="action_coop_my_projects" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_project_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="image_512"/>
                      <field name="readiness"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.project/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                            <div class="o_coop_mini_note">
                              собрано <t t-esc="record.readiness.value"/>%
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>


              <!--
                Потребности — собственные объявления спроса, а не новая
                сущность: «ищу морковь» живёт по тем же правилам, что и
                любое объявление, включая снятие с публикации. Состояние
                показано подписью, как в макете: открыта или закрыта.
              -->
              <div class="o_coop_band" invisible="not coop_need_ids">
                <div class="o_coop_band_head">
                  <span>Потребности</span>
                  <button name="action_coop_my_needs" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_need_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="state"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.resource/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                            <div class="o_coop_mini_note"
                                 t-att-class="record.state.raw_value === 'published' ? 'o_coop_open' : 'o_coop_closed'">
                              <t t-if="record.state.raw_value === 'published'">● открыта</t>
                              <t t-else="">● закрыта</t>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band"
                   invisible="coop_membership_count == 0 or (not coop_is_self and not coop_show_orgs)">
                <div class="o_coop_band_head">
                  <span>Организации</span>
                  <button name="action_coop_my_organizations" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <!--
                    По действующим членствам, а не по всем с доменом:
                    домен у поля в карточке отбирает то, что можно
                    выбрать, а не то, что показано. С ним полка рисовала
                    все сорок девять членств — тридцать два прекращённых,
                    два заявления и одну организацию четырежды: человек
                    уходил и возвращался.
                  -->
                  <field name="coop_active_membership_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="organization_id"/>
                      <field name="role_id"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/res.partner/' + record.organization_id.raw_value + '/avatar_256'"
                                   t-att-alt="record.organization_id.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="organization_id"/>
                            </div>
                            <div class="o_coop_mini_note">
                              <field name="role_id"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="coop_community_count == 0">
                <div class="o_coop_band_head">
                  <span>Сообщества</span>
                  <button name="action_coop_my_communities" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_community_member_ids" readonly="1" nolabel="1"
                         domain="[('state', '=', 'active')]">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="community_id"/>
                      <field name="role_id"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.community/' + record.community_id.raw_value + '/image_512'"
                                   t-att-alt="record.community_id.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="community_id"/>
                            </div>
                            <div class="o_coop_mini_note">
                              <field name="role_id"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_empty"
                   invisible="not coop_holdings_empty or not coop_is_self">
                <div class="o_coop_empty_title">Страница пока пустая</div>
                <div class="o_coop_empty_text">
                  Начните с того, что у вас уже есть: умение, которым готовы
                  поделиться, вещь или помещение, которые простаивают, или
                  задача, которую в одиночку не потянуть.
                </div>
              </div>
              <div class="o_coop_empty"
                   invisible="not coop_holdings_empty or coop_is_self">
                <div class="o_coop_empty_text">
                  Участник ещё не заполнил страницу.
                </div>
              </div>
            </div>
          </div>
        </sheet>
        <!--
          Стена участника из макета — она же лента записи в движке. Двух
          разных лент на платформе нет намеренно: у организации она уже
          была, и вторая, своя, разошлась бы с первой на первой правке.

          Под карточкой, а не сбоку: сбоку от неё остаётся полоса в
          двести пикселей, где плитки идут столбиком. Сторону задаёт
          `static/src/js/wall.js`.
        -->
        <!-- Лента закрытой страницы — такая же её часть, как полки. -->
        <chatter reload_on_post="True" invisible="not coop_page_visible"/>
      </form>
    </field>
  </record>

  <!--
    «Моя страница» — серверное действие, а не окно с доменом: от чьего
    имени человек действует, от того и страница, и это должно решаться
    при каждом открытии, а не один раз при загрузке меню.
  -->
  <record id="action_coop_my_page" model="ir.actions.server">
    <field name="name">Моя страница</field>
    <field name="path">my-page</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_coop_open_my_page()</field>
  </record>

  <menuitem id="menu_coop_profile_root" name="Моя страница" sequence="1"/>
  <menuitem id="menu_coop_my_page" name="Моя страница"
            parent="menu_coop_profile_root" action="action_coop_my_page"
            sequence="10"/>

</odoo>
