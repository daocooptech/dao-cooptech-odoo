<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Повторный вызов настроек — уже после того, как «Моя страница»
    объявлена. При установке coop_base грузится раньше, и домашним тогда
    становится каталог людей; здесь он сменяется на свою страницу.

    Решение владельца от 14 сентября 2026: после ввода логина и пароля
    человек попадает на свою страницу.

    Вызов идемпотентный: у кого домашний уже выбран сознательно —
    не трогает.
  -->
  <function model="coop.setup" name="apply"/>
</odoo>
