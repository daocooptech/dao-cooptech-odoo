<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    «Адрес» — сразу под «Городом» и с теми же правилами правки: где город
    правится строкой справки, там и адрес. Координаты в форме не видны —
    их находит сервер по адресу при сохранении.
  -->

  <record id="view_geo_view_coop_auction_form" model="ir.ui.view">
    <field name="name">coop.auction.form.coop_geo</field>
    <field name="model">coop.auction</field>
    <field name="inherit_id" ref="coop_auctions.view_coop_auction_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group/field[@name='city']" position="after">
        <field name="coop_address" widget="coop_inline" readonly="not coop_can_edit" placeholder="Улица, дом"/>
      </xpath>
    </field>
  </record>

