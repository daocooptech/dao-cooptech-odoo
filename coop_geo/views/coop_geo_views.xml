  <record id="view_geo_view_coop_resource_add" model="ir.ui.view">
    <field name="name">coop.resource.form.coop_geo</field>
    <field name="model">coop.resource</field>
    <field name="inherit_id" ref="coop_resources.view_coop_resource_add"/>
    <field name="arch" type="xml">
      <!-- Страница размещения — разделами по дизайн-системе (27.10.2026),
           групп в ней нет: адрес — своим полем в разделе «Где и как
           связаться», рядом с городом. -->
      <xpath expr="//section[@name='add_where']//field[@name='pickup_point']/.." position="after">
        <div class="coop-add_field">
          <label for="coop_address" string="Адрес"/>
          <field name="coop_address" nolabel="1" placeholder="Улица, дом"/>
        </div>
      </xpath>
    </field>
  </record>

