<?xml version="1.0" encoding="utf-8"?>
<!--
  Без noupdate — правила доступа должны доезжать до узла обновлением
  модуля. Флаг «не обновлять» запоминается в ir_model_data при первой
  загрузке и переживает удаление из XML.

  Разбор архитектора 15 сентября 2026: у этого модуля в `security/` лежал
  только `ir.model.access.csv`, а файла с `ir.rule` не было ни одного —
  при том, что право на запись выдано всем участникам. Проверено на
  стенде от имени обычного участника: чужую запись удавалось переписать
  и удалить.

  Ниже — тот же образец, что уже работает в ресурсах, вакансиях,
  проектах и сообществах: опубликованное читают все, правит владелец,
  своё участие ведёт сам участник.
-->
<odoo>
  <data>

    <!-- Черновик — дело хозяина. Опубликованное читают все: это витрина,
         и закрывать её значило бы закрыть каталог. -->
    <record id="rule_cfa_issue_read" model="ir.rule">
      <field name="name">Выпуск: черновик виден эмитенту, остальное всем</field>
      <field name="model_id" ref="model_coop_cfa_issue"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('state', '!=', 'draft'),
          ('issuer_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Правит тот, кому доверено публиковать от имени владельца. Без
         этого правила любой участник переписывал чужую запись —
         цену, состояние, владельца — и удалял её. -->
    <record id="rule_cfa_issue_write" model="ir.rule">
      <field name="name">Выпуск ведёт эмитент</field>
      <field name="model_id" ref="model_coop_cfa_issue"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('issuer_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Кто чем владеет — сведения имущественные, и посторонним их
         знать не положено. -->
    <record id="rule_cfa_holding_own" model="ir.rule">
      <field name="name">Своё владение цифровым активом</field>
      <field name="model_id" ref="model_coop_cfa_holding"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Эмитент обязан знать реестр держателей: без него он не может
         ни погасить выпуск, ни начислить по нему. -->
    <record id="rule_cfa_holding_issuer" model="ir.rule">
      <field name="name">Эмитент видит держателей своего выпуска</field>
      <field name="model_id" ref="model_coop_cfa_holding"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('issue_id.issuer_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

  </data>
</odoo>
