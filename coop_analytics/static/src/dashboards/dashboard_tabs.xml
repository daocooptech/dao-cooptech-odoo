<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- Вкладки раздела над готовыми дашбордами (dashboard_tabs.js). -->
  <t t-inherit="spreadsheet_dashboard.DashboardAction" t-inherit-mode="extension">
    <xpath expr="//ControlPanel" position="before">
      <div class="o_coop_board_tabs o_coop_dash_tabs"><CoopTabs/></div>
    </xpath>
    <!-- Дашборд раздела открывается один (`coop_single` в параметрах
         действия, решение 708): списка дашбордов слева нет. -->
    <xpath expr="//t[@t-if='!this.uiService.isSmall']" position="attributes">
      <attribute name="t-if">!this.uiService.isSmall and !this.props.action.params?.coop_single</attribute>
    </xpath>
  </t>
</templates>
