<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Переключатель вида с подписями (ViewSwitch) — у графика и сводной. -->
  <t t-name="coop_analytics.ViewSwitch">
    <nav class="ms-auto o_coop_viewswitch" role="toolbar" aria-label="Вид отчёта"
           t-if="this.coopViews().length > 1">
        <button t-foreach="this.coopViews()" t-as="v" t-key="v.type" type="button"
                class="o_coop_viewswitch_btn" t-att-class="{ active: v.active }"
                t-attf-class="o_{{v.type}}"
                t-on-click="() => this.coopSwitchView(v.type)">
          <i class="oi oi-fw" t-att-data-icon="v.icon"/>
          <span t-out="this.coopViewName(v)"/>
        </button>
      </nav>
  </t>

  <!-- Меры — переключателями (js/measure_chips.js). -->
  <t t-name="coop_analytics.MeasureChips">
    <div class="o_coop_measures" role="group" aria-label="Меры">
      <span class="o_coop_measures_label">Показать</span>
      <button t-foreach="this.coopMeasureList()" t-as="m" t-key="m.name" type="button"
              class="o_coop_measure" t-att-class="{ active: this.coopMeasureActive(m.name) }"
              t-att-disabled="this.coopMeasureDisabled(m.name) ? 'disabled' : undefined"
              t-att-aria-pressed="this.coopMeasureActive(m.name) ? 'true' : 'false'"
              t-on-click="() => this.coopToggleMeasure(m.name)" t-out="m.label"/>
    </div>
  </t>

  <!--
    Панель отчёта «График» — по образцу «Сделки» дизайн-системы
    (AnalyticsDealsPage; владелец 27.11.2026: «что за куча кнопок
    невпопад»). В ряду: мера слева, переключатель вида с подписями справа.
    Накопление, сортировка и тип графика убраны: в образце их нет, тип
    графика задаёт сам отчёт.
  -->
  <t t-inherit="web.GraphView.Buttons" t-inherit-mode="extension">
    <xpath expr="//div[@aria-label='Main actions']" position="replace">
      <t t-call="coop_analytics.MeasureChips"/>
    </xpath>
    <xpath expr="//div[@aria-label='Graph actions']" position="replace">
      <t t-call="coop_analytics.ViewSwitch"/>
    </xpath>
  </t>

  <!-- Сводная — так же: мера слева, переключатель справа; разворот осей,
       «развернуть всё» и выгрузка убраны, как и на графике. -->
  <t t-inherit="web.PivotView.Buttons" t-inherit-mode="extension">
    <xpath expr="//div[@aria-label='Main actions']" position="replace">
      <t t-call="coop_analytics.MeasureChips"/>
    </xpath>
    <xpath expr="//div[@aria-label='Pivot settings']" position="replace">
      <t t-call="coop_analytics.ViewSwitch"/>
    </xpath>
  </t>

  <!-- Простая сводная — таблицей Table (js/pivot_table.js). -->
  <t t-inherit="web.PivotRenderer" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_pivot')]" position="attributes">
      <attribute name="t-if">this.model.hasData() and this.model.metaData.activeMeasures.length and !this.coopSimple()</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_pivot')]" position="before">
      <div t-if="this.model.hasData() and this.coopSimple()" class="o_coop_pt_wrap">
        <p class="o_coop_pt_keys" t-if="this.coopN() > 1">
          В клетке: <b t-out="this.coopMeasureLabels()[0]"/>
          <t t-foreach="this.coopMeasureLabels().slice(1)" t-as="label" t-key="label_index">
            · <span t-out="label.toLowerCase()"/>
          </t>
        </p>
        <div class="o_coop_pt">
          <table>
            <thead>
              <tr>
                <th t-out="this.coopRowLabel()"/>
                <th t-foreach="this.coopColumns()" t-as="col" t-key="col_index" class="o_coop_pt_num">
                  <i class="o_coop_pt_dot" t-attf-style="background: var(--coop-{{col.tone}})"/>
                  <t t-out="col.title"/>
                </th>
                <th class="o_coop_pt_num o_coop_pt_total">Всего</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="this.coopRows()" t-as="row" t-key="row_index">
                <th t-out="this.coopRowTitle(row)"/>
                <td t-foreach="this.coopCells(row)" t-as="group" t-key="group_index"
                    t-att-class="{ o_coop_pt_num: true, o_coop_pt_empty: group[0].value === undefined, o_coop_pt_total: group_last }"
                    t-att-style="this.coopHeat(group, group_last)"
                    t-on-click="() => this.onOpenView(group[0])">
                  <span class="o_coop_pt_main" t-out="this.coopValue(group[0])"/>
                  <span t-foreach="group.slice(1)" t-as="sub" t-key="sub_index" t-if="group[0].value !== undefined"
                        class="o_coop_pt_sub" t-out="this.coopValue(sub)"/>
                </td>
              </tr>
            </tbody>
            <tfoot>
              <t t-set="total" t-value="this.coopTotalRow()"/>
              <tr>
                <th>Итого</th>
                <td t-foreach="this.coopCells(total)" t-as="group" t-key="group_index"
                    t-att-class="{ o_coop_pt_num: true, o_coop_pt_total: group_last }"
                    t-on-click="() => this.onOpenView(group[0])">
                  <span class="o_coop_pt_main" t-out="this.coopValue(group[0])"/>
                  <span t-foreach="group.slice(1)" t-as="sub" t-key="sub_index"
                        class="o_coop_pt_sub" t-out="this.coopValue(sub)"/>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </xpath>
  </t>

  <!-- Над графиком — итог за период и шаг; под ним — что показано. -->
  <t t-inherit="web.GraphRenderer" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_graph_canvas_container')]" position="before">
      <header class="o_coop_graph_head" t-if="this.model.hasData() and this.model.metaData.mode !== 'pie'">
        <div class="o_coop_graph_total">
          <span t-out="this.coopTotalLabel()"/>
          <b t-out="this.coopTotal()"/>
        </div>
        <nav class="o_coop_graph_steps" t-if="this.coopDateGroup()" aria-label="Шаг">
          <button t-foreach="this.coopSteps" t-as="s" t-key="s.id" type="button"
                  t-att-class="{ active: this.coopDateGroup().interval === s.id }"
                  t-on-click="() => this.coopSetStep(s.id)" t-out="s.label"/>
        </nav>
      </header>
    </xpath>
    <xpath expr="//div[hasclass('o_graph_canvas_container')]" position="after">
      <p class="o_coop_graph_note" t-if="this.model.hasData()" t-out="this.coopCaption()"/>
    </xpath>
  </t>

</templates>
