<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- «Прогноз и план» (решение 423), js/forecast.js. Классы — o_coop_fc_*. -->
  <t t-name="coop_analytics.Forecast">
    <div class="o_action o_coop_fc">
      <div class="o_coop_board_tabs"><CoopTabs/></div>

      <div t-if="!this.state.data" class="o_coop_fc_loading">Считаем тренды…</div>
      <t t-else="">
        <t t-set="d" t-value="this.state.data"/>
        <header class="o_coop_fc_head">
          <h2>Прогноз и план</h2>
          <p>
            Факт за год, тренд на полгода вперёд и ваши цели на месяц. Прогноз — продолжение вашего же
            тренда за последние 12 месяцев, а не обещание: одна крупная сделка сдвигает его сильно.
          </p>
          <nav class="o_coop_fc_who" t-if="d.partners.length > 1">
            <span>Чей план:</span>
            <button t-foreach="d.partners" t-as="p" t-key="p.id"
                    t-att-class="{ active: p.id === d.partner.id }"
                    t-on-click="() => this.pickPartner(p.me ? null : p.id)">
              <t t-if="p.me">Мой</t><t t-else="" t-out="p.name"/>
            </button>
          </nav>
        </header>

        <div class="o_coop_fc_grid">
          <section class="o_coop_fc_card" t-foreach="d.metrics" t-as="m" t-key="m.key">
            <header>
              <div>
                <h3 t-out="m.label"/>
                <p t-out="m.hint"/>
              </div>
              <button class="o_coop_fc_planbtn" t-on-click="() => this.openEdit(m)">
                <i class="oi" data-icon="flag"/> <t t-if="m.now.plan !== null">Изменить план</t><t t-else="">Задать план</t>
              </button>
            </header>

            <div class="o_coop_fc_now">
              <div>
                <span>Этот месяц</span>
                <b t-out="this.fmt(m, m.now.fact)"/>
              </div>
              <div>
                <span t-if="m.better === 'down'">Лимит</span><span t-else="">План</span>
                <b t-if="m.now.plan !== null" t-out="this.fmt(m, m.now.plan)"/>
                <b t-else="" class="o_coop_fc_muted">не задан</b>
              </div>
              <div>
                <span>К концу месяца при таком темпе</span>
                <b t-out="this.fmt(m, m.now.pace)"/>
              </div>
              <div>
                <span>Тренд на месяц</span>
                <b t-out="this.fmt(m, m.now.forecast)"/>
              </div>
            </div>
            <div class="o_coop_fc_progress" t-if="m.now.plan !== null" t-att-data-status="this.status(m)">
              <i t-att-style="this.barWidth(m)"/>
              <span><t t-out="this.pctLabel(m)"/><t t-if="m.now.days_left"> · осталось <t t-out="m.now.days_left"/> дн.</t></span>
            </div>

            <div class="o_coop_fc_chart">
              <div class="o_coop_fc_col" t-foreach="m.months" t-as="c" t-key="c.key"
                   t-att-class="this.colClass(m, c)" t-att-title="this.colTitle(m, c)">
                <div class="o_coop_fc_bars">
                  <i t-if="c.forecast !== null and !c.past" class="o_coop_fc_b_trend" t-att-style="this.h(m, c.forecast)"/>
                  <i t-if="c.fact" class="o_coop_fc_b_fact" t-att-style="this.h(m, c.fact)"/>
                  <em t-if="c.plan !== null and c.plan !== undefined" class="o_coop_fc_plan" t-att-style="this.planTop(m, c.plan)"/>
                </div>
                <span t-out="c.label"/>
              </div>
            </div>
            <footer>
              <span>средний месяц <b t-out="this.fmt(m, m.avg)"/></span>
              <span t-if="m.plans_total">планов выполнено <b><t t-out="m.plans_done"/> из <t t-out="m.plans_total"/></b></span>
              <span t-if="m.mode === 'average'" class="o_coop_fc_muted">данных мало — вместо тренда средний месяц</span>
            </footer>

            <form class="o_coop_fc_edit" t-if="this.state.edit and this.state.edit.metric === m.key"
                  t-on-submit.prevent="() => this.savePlan()">
              <label>С месяца
                <select t-model.proxy="this.state.edit.month">
                  <option t-foreach="this.futureMonths(m)" t-as="f" t-key="f.key" t-att-value="f.key" t-out="f.label"/>
                </select>
              </label>
              <label><t t-if="m.better === 'down'">Лимит</t><t t-else="">Цель</t><t t-if="m.unit === 'rub'">, ₽</t>
                <input type="number" min="0" step="any" t-model.proxy="this.state.edit.target"/>
              </label>
              <label>На сколько месяцев
                <select t-model.proxy="this.state.edit.repeat">
                  <option value="1">1</option>
                  <option value="3">3</option>
                  <option value="6">6</option>
                  <option value="12">12</option>
                </select>
              </label>
              <div class="o_coop_fc_editbtns">
                <button type="submit" class="btn btn-primary" t-att-disabled="this.state.busy">Сохранить</button>
                <button type="button" class="btn btn-light" t-att-disabled="this.state.busy"
                        t-on-click="() => this.savePlan(true)">Снять план</button>
                <button type="button" class="btn btn-link" t-on-click="() => this.state.edit = null">Отмена</button>
              </div>
            </form>
          </section>
        </div>

        <p class="o_coop_fc_legend">
          <i class="o_coop_fc_k_fact"/> факт <i class="o_coop_fc_k_done"/> план выполнен
          <i class="o_coop_fc_k_miss"/> не выполнен <i class="o_coop_fc_k_trend"/> тренд
          <i class="o_coop_fc_k_plan"/> план
        </p>
      </t>
    </div>
  </t>
</templates>
