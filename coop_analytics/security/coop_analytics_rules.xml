<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Активность видна только своя: это не рейтинг участников. -->
  <record id="rule_account_activity_own" model="ir.rule">
    <field name="name">Своя активность</field>
    <field name="model_id" ref="model_coop_account_activity"/>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
  </record>

  <!-- План видит тот, за кого он поставлен: сам участник и те, кто
       действует от имени организации. -->
  <record id="rule_analytics_plan_own" model="ir.rule">
    <field name="name">Свои планы</field>
    <field name="model_id" ref="model_coop_analytics_plan"/>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="domain_force">[('partner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
  </record>
</odoo>
