<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Снимок показателей «Моего аккаунта» раз в сутки (решение 473):
       искры в плитках читают снимки, а не пересчитывают год по записям. -->
  <record id="cron_coop_account_snapshot" model="ir.cron">
    <field name="name">Аналитика: снимок показателей аккаунтов</field>
    <field name="model_id" ref="model_coop_account_snapshot"/>
    <field name="state">code</field>
    <field name="code">model._cron_snapshot()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>

  <!-- При установке и обновлении — сразу: история за прошлые месяцы по
       записям тем, у кого её нет, и снимок на сегодня. -->
  <function model="coop.account.snapshot" name="_cron_snapshot"/>

</odoo>
