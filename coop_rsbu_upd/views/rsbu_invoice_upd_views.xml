<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Кнопки УПД (XML/печать) на форме документа реализации. -->
    <record id="view_rsbu_realization_form_upd" model="ir.ui.view">
        <field name="name">rsbu.realization.form.upd</field>
        <field name="model">rsbu.realization</field>
        <field name="inherit_id" ref="rsbu_vat.view_rsbu_realization_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_upd_xml" type="object"
                        string="Выгрузить УПД (XML)"
                        invisible="state != 'confirmed'"/>
                <button name="action_print_upd_docx" type="object"
                        string="Печать УПД (DOCX)"/>
                <button name="action_print_updn_docx" type="object"
                        string="УПД без печатей (DOCX)"/>
            </xpath>
        </field>
    </record>

    <!-- Форма инвойса: статус закрывающего документа и кнопки реализации. -->
    <record id="view_move_form_upd" model="ir.ui.view">
        <field name="name">account.move.form.upd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_realization" type="object"
                        string="Создать документ реализации" class="btn-primary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or rsbu_realization_id != False"/>
                <button name="action_open_realization" type="object"
                        string="Открыть УПД"
                        invisible="rsbu_realization_id == False"/>
                <field name="closing_document" widget="statusbar"
                       statusbar_visible="not_done,issued,signed"
                       invisible="move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//sheet//field[@name='invoice_date']" position="after">
                <field name="rsbu_realization_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Фильтры по закрывающим документам в списке инвойсов. -->
    <record id="view_account_invoice_filter_upd" model="ir.ui.view">
        <field name="name">account.invoice.select.upd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="upd_not_done"
                        string="Нет закрывающих документов"
                        domain="[('move_type', '=', 'out_invoice'), ('closing_document', '=', 'not_done')]"/>
                <filter name="upd_waiting_sign"
                        string="Ждём подпись клиента"
                        domain="[('move_type', '=', 'out_invoice'), ('closing_document', '=', 'issued')]"/>
            </xpath>
        </field>
    </record>
</odoo>
