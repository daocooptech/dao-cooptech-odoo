<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Карточка вакансии в двух видах, как и остальные каталоги: плиткой по
    умолчанию, строкой по кнопке. Разметка одна, раскладку задаёт класс на
    корне представления.

    Вознаграждение стоит сразу под заголовком и набрано крупно: это первое,
    на что смотрят, и прятать его в мета-строку значит заставлять открывать
    каждую карточку.
  -->
  <record id="view_coop_vacancy_kanban" model="ir.ui.view">
    <field name="name">coop.vacancy.kanban</field>
    <field name="model">coop.vacancy</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_vacancies" quick_create="false" js_class="coop_catalog_kanban">
        <field name="image_512"/>
        <field name="city"/>
        <field name="reward_display"/>
        <field name="reward_kind"/>
        <field name="employment"/>
        <field name="partner_id"/>
        <field name="my_application_state"/>
        <field name="is_mine"/>
        <field name="application_count"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_vacancy">
              <div class="o_coop_vac_photo o_coop_media">
                <!-- Цепочка одна на все каталоги: свой снимок, иначе лицо той
                     стороны, с которой придётся иметь дело, иначе значок
                     раздела. Штатное поле-картинка так не умеет: при пустом
                     значении оно рисует заглушку «добавить фото», и карточка
                     выглядит незагрузившейся. -->
                <field name="image_512" widget="image" t-if="record.image_512.raw_value"/>
                <img class="o_coop_media_logo" t-elif="record.partner_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/image_512"
                     t-att-alt="record.partner_id.value"/>
                <span t-else="" class="o_coop_media_sign"><field name="id" widget="coop_sign" options="{'icon': 'briefcase'}"/></span>
                <img class="o_coop_vac_owner"
                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/avatar_128"
                     t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
                <!-- Вид вознаграждения помечается на фотографии: доля в
                     проекте и волонтёрство — это принципиально другое
                     предложение, чем зарплата, и человек должен видеть
                     разницу до того, как прочитал строку. -->
                <span class="o_coop_vac_kind"
                      t-attf-class="o_coop_vac_kind o_coop_vac_kind_#{record.reward_kind.raw_value}"
                      t-if="record.reward_kind.raw_value != 'money'">
                  <field name="reward_kind"/>
                </span>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="oi" data-icon="location_on" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>

              <div class="o_coop_vac_body">
                <div class="o_coop_vac_name"><field name="name"/></div>
                <div class="o_coop_vac_reward"><field name="reward_display"/></div>
                <div class="o_coop_vac_meta">
                  <field name="partner_id"/>
                  <span> · </span>
                  <field name="employment"/>
                </div>
                <div class="o_coop_vac_desc">
                  <field name="description" widget="html"/>
                </div>
                <div class="o_coop_vac_foot">
                  <span class="o_coop_vac_applications"
                        t-if="record.is_mine.raw_value and record.application_count.raw_value">
                    <t>Откликов:</t>
                    <field name="application_count"/></span>
                  <div class="o_coop_vac_actions">
                    <button name="action_apply" type="object"
                            class="btn o_coop_vac_btn"
                            t-if="!record.is_mine.raw_value and record.my_application_state.raw_value == 'none'">Откликнуться</button>
                    <span class="o_coop_vac_state"
                          t-if="record.my_application_state.raw_value == 'applied'">Вы откликнулись</span>
                    <span class="o_coop_vac_state o_coop_vac_state_on"
                          t-if="record.my_application_state.raw_value == 'invited'">Вас пригласили</span>
                    <button name="action_open_applications" type="object"
                            class="btn o_coop_vac_btn"
                            t-if="record.is_mine.raw_value">Смотреть отклики</button>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_vacancy_list" model="ir.ui.view">
    <field name="name">coop.vacancy.list</field>
    <field name="model">coop.vacancy</field>
    <field name="arch" type="xml">
      <list string="Вакансии">
        <field name="name"/>
        <field name="partner_id" string="Кто ищет"/>
        <field name="project_id" optional="hide"/>
        <field name="coop_specialization_id" optional="show"/>
        <field name="city"/>
        <field name="employment"/>
        <field name="experience_level" string="Опыт"/>
        <field name="reward_kind" string="Вознаграждение"/>
        <field name="contract_kind" optional="show"/>
        <field name="pay_method" optional="hide"/>
        <!-- Числа, а не строка: по вычисляемому виду сортировка идёт по
             алфавиту, и «120 000» встаёт выше «60 000». -->
        <field name="pay_from" string="Оплата от" optional="show"/>
        <field name="share_percent" string="Доля, %" options="{'hide_trailing_zeros': true}" optional="hide"/>
        <field name="application_count" string="Откликов"/>
        <field name="state" widget="badge"
               decoration-success="state == 'published'"
               decoration-muted="state != 'published'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_vacancy_form" model="ir.ui.view">
    <field name="name">coop.vacancy.form</field>
    <field name="model">coop.vacancy</field>
    <field name="arch" type="xml">
      <form string="Вакансия" class="o_coop_show">
        <header>
          <!-- В шапке — только кнопки автора; «Откликнуться» и «Задать
               вопрос» — в витрине под вознаграждением (`VacancyPage`). -->
          <button name="action_publish" type="object" string="Опубликовать"
                  class="btn-primary" invisible="(state == 'published') or not coop_can_edit"/>
          <button name="action_to_recruitment" type="object"
                  string="Перенести в набор персонала"
                  invisible="not is_mine or hr_job_id"
                  help="Для организаций, оформляющих человека по трудовому договору: в модуле «Найм» есть этапы отбора и переход в сотрудника."/>
          <button name="action_close" type="object" string="Закрыть вакансию"
                  invisible="(state == 'closed') or not coop_can_edit"
                  confirm="Закрыть вакансию? Из каталога она пропадёт, отклики останутся."
                  help="Из каталога пропадёт, отклики останутся."/>
          <field name="coop_role_label" invisible="not coop_role_label"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,published,closed"
                 invisible="not coop_can_edit"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <field name="is_mine" invisible="1"/>
          <field name="my_application_state" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <!--
            Витрина вакансии (дизайн-система, `VacancyPage`, решение 625):
            те же плоскости, что у навыка и ресурса — шапка со снимком,
            вознаграждением и умениями; основная колонка; боковая с
            работодателем и проектом. Пустое смотрящему не показывается,
            условия правит только автор — отдельным блоком.
          -->
          <section class="coop-show_hero">
            <div class="coop-gallery">
              <!-- Фото и видео — две карусели (`coop_media`, задача 424). -->
              <field name="coop_media_data" widget="coop_media" nolabel="1" readonly="1"/>
              <span class="coop-gallery_badge" invisible="not employment">
                <field name="employment" readonly="1" nolabel="1"/>
              </span>
            </div>
            <div class="coop-show_info">
              <div class="coop-show_kicker">
                <!-- Плашки над названием нет (владелец 10.11.2026: «везде
                     убери эту таблетку»). -->
                <field name="coop_specialization_id" readonly="1" nolabel="1"
                       options="{'no_open': True}"/>
              </div>
              <div class="oe_title">
                <h1 class="coop-show_title"><field name="name" placeholder="Кто нужен" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/></h1>
              </div>
              <ul class="coop-show_meta">
                <!-- Значки перед словами — как в эталоне: метка, портфель,
                     люди. -->
                <li class="coop-meta_city" invisible="not city"><field name="city" readonly="1" nolabel="1"/></li>
                <li class="coop-meta_exp" invisible="not experience_level">
                  <span>Опыт:</span>
                  <field name="experience_level" readonly="1" nolabel="1"/>
                </li>
                <li class="coop-meta_people">
                  <span>Откликов:</span>
                  <field name="application_count" readonly="1" nolabel="1"/>
                </li>
              </ul>
              <hr class="coop-show_rule"/>
              <div class="coop-price">
                <span class="coop-price_label">Вознаграждение</span>
                <span class="coop-price_value">
                  <field name="reward_display" readonly="1" nolabel="1"/>
                </span>
                <span class="coop-price_note" invisible="reward_kind != 'share' or not contribution_display">
                  Оценка вклада <field name="contribution_display" readonly="1" nolabel="1"/>
                </span>
              </div>
              <div class="coop-show_words" invisible="not skill_ids">
                <h3>Что потребуется</h3>
                <field name="skill_ids" widget="many2many_tags" readonly="1" nolabel="1"
                       options="{'no_open': True}"/>
              </div>
              <div class="coop-show_acts" invisible="is_mine or state != 'published'">
                <button name="action_apply" type="object" string="Откликнуться"
                        class="btn-primary"
                        invisible="my_application_state != 'none'"/>
                <span class="btn btn-secondary disabled"
                      invisible="my_application_state == 'none'">
                  <field name="my_application_state" readonly="1" nolabel="1"/>
                </span>
                <button name="action_message_owner" type="object" string="Задать вопрос"
                        class="btn-secondary"/>
              </div>
            </div>
          </section>
          <div class="coop-show_grid">
            <div class="coop-show_main">
              <section class="coop-show_block" invisible="not description and not coop_can_edit">
                <h2>Что делать</h2>
                <field name="description"
                       placeholder="Задача и условия. Конкретнее, чем «работа в дружном коллективе»." widget="coop_block" readonly="not coop_can_edit"/>
                <!-- Четыре факта, как в образце: занятость, опыт,
                     вознаграждение, доля — короткими значениями. -->
                <dl class="coop-show_facts">
                  <div invisible="not employment">
                    <dt>Занятость</dt>
                    <dd><field name="employment" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div invisible="not experience_level">
                    <dt>Опыт</dt>
                    <dd><field name="experience_level" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div>
                    <dt>Вознаграждение</dt>
                    <dd><field name="reward_kind" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div invisible="reward_kind != 'share'">
                    <dt>Доля</dt>
                    <dd><field name="share_percent" readonly="1" nolabel="1" options="{'hide_trailing_zeros': true}"/> %</dd>
                  </div>
                </dl>
                <p class="coop-price_note" invisible="not reward_note_shown">
                  <field name="reward_note_shown" readonly="1" nolabel="1"/>
                </p>
                <p class="coop-price_note" invisible="not pay_explain">
                  <field name="pay_explain" readonly="1" nolabel="1"/>
                </p>
              </section>
              <!-- Условия правит только автор; остальным те же значения
                   видны в шапке и фактах словами. -->
              <section class="coop-show_block" invisible="not coop_can_edit">
                <h2>Условия</h2>
          <group col="1">
            <group string="Кто ищет">
              <field name="partner_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="author_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="project_id" options="{'no_create': True}" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="city" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="coop_specialization_id" options="{'no_create': True}" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="coop_specialization_category_id" readonly="1"/>
            </group>
            <group string="Условия">
              <field name="employment" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="experience_level" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="reward_kind" widget="coop_inline" readonly="not coop_can_edit"/>
              <label for="pay_from" string="Оплата"
                     invisible="reward_kind in ('barter', 'volunteer')"/>
              <!-- Ширина полей — по содержимому: поровну на троих сумма
                   «55 000,00 ₽» не влезала и обрезалась до «55 000…», а
                   пустое «до» с прочерком занимало столько же. Пустое «до»
                   читателю не показывается (находка 28.09, решение 433). -->
              <div class="o_row o_coop_pay_row" invisible="reward_kind in ('barter', 'volunteer')">
                <field name="pay_from" widget="coop_inline" readonly="not coop_can_edit"/>
                <span invisible="not pay_to and not coop_can_edit">–</span>
                <field name="pay_to" widget="coop_inline" readonly="not coop_can_edit"
                       invisible="not pay_to and not coop_can_edit"/>
                <field name="pay_period" widget="coop_inline" readonly="not coop_can_edit"/>
              </div>
              <field name="currency_id" invisible="1"/>
              <!-- Доля вводится оценкой вклада, а не процентом: процент
                   считается от суммы вкладов проекта и меняется, когда в
                   проект вносят что-то ещё. -->
              <field name="contribution_value" invisible="reward_kind != 'share'" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="share_percent" readonly="1" options="{'hide_trailing_zeros': true}" invisible="reward_kind != 'share'"/>
              <field name="reward_note" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/>
              <!-- Договор и способ выплаты (решение 425, по заключению
                   юриста): выбирает работодатель, соискатель видит до
                   отклика. Что допустимо — от того, кто ищет: трудовое
                   участие только у артели, «в пай по желанию» только у
                   кооператива по подряду, ДАО — токенами по подряду. -->
              <field name="employer_kind" invisible="1"/>
              <field name="contract_kind" widget="coop_inline" options="{'wrap': True}"
                     readonly="not coop_can_edit or employer_kind == 'dao'"
                     invisible="not contract_kind"/>
              <field name="pay_method" widget="coop_inline" options="{'wrap': True}"
                     readonly="not coop_can_edit or employer_kind in ('dao', 'other') or contract_kind != 'civil'"
                     invisible="not contract_kind"/>
              <field name="pay_explain" readonly="1" nolabel="1" colspan="2"
                     class="text-muted"
                     invisible="not pay_explain"/>
              <field name="reward_display" readonly="1" string="В каталоге"/>
              <field name="hr_job_id" readonly="1" invisible="not hr_job_id"/>
            </group>
          </group>
          <group string="Что потребуется">
            <field name="skill_ids" widget="many2many_tags" nolabel="1"
                   options="{'no_create_edit': True, 'no_create': True}"/>
          </group>
              </section>
          <notebook class="coop-show_tabs">
            <page string="Отклики" name="applications" invisible="not is_mine">
              <field name="application_ids" nolabel="1" readonly="1">
                <list>
                  <field name="create_date" string="Когда"/>
                  <field name="partner_id"/>
                  <field name="message"/>
                  <field name="state"/>
                  <button name="action_invite" type="object" string="Пригласить"
                          icon="check" invisible="state == 'invited'"/>
                  <button name="action_decline" type="object" string="Отклонить"
                          icon="close" invisible="state == 'declined'"/>
                </list>
              </field>
            </page>
          </notebook>
            </div>
            <aside class="coop-show_aside">
              <div class="coop-owner">
                <span class="coop-owner_title">Кто ищет</span>
                <div class="coop-owner_who">
                  <field name="partner_avatar" widget="image" readonly="1" nolabel="1"
                         class="coop-owner_pic" options="{'size': [48, 48]}"/>
                  <div class="coop-owner_name">
                    <field name="partner_id" readonly="1" nolabel="1"/>
                    <span invisible="not city"><field name="city" readonly="1" nolabel="1"/></span>
                  </div>
                </div>
                <div class="coop-owner_trust">
                  <div class="coop-owner_trust_head">
                    <span>Уровень доверия</span>
                    <b><field name="partner_trust" readonly="1" nolabel="1"/> %</b>
                  </div>
                  <field name="partner_trust" widget="progressbar" readonly="1" nolabel="1"
                         class="coop-owner_bar"/>
                </div>
                <dl class="coop-owner_stats">
                  <div>
                    <dt>сделок</dt>
                    <dd><field name="partner_deals_done" readonly="1" nolabel="1"/></dd>
                  </div>
                  <div>
                    <dt>отзывов</dt>
                    <dd><field name="partner_deals_reviewed" readonly="1" nolabel="1"/></dd>
                  </div>
                </dl>
                <ul class="coop-owner_lines" invisible="not author_shown_id">
                  <li><span>Опубликовал</span> <field name="author_shown_id" readonly="1" nolabel="1"/></li>
                </ul>
                <div class="coop-owner_acts" invisible="is_mine">
                  <button name="action_message_owner" type="object" class="btn-secondary"
                          string="Написать"/>
                </div>
              </div>
              <section class="coop-show_block" invisible="not project_id">
                <h2>Проект</h2>
                <button name="action_open_project" type="object" class="coop-link">
                  <field name="project_image" widget="image" readonly="1" nolabel="1"
                         class="coop-owner_pic" options="{'size': [40, 40]}"/>
                  <span class="coop-link_body">
                    <b><field name="project_id" readonly="1" nolabel="1" options="{'no_open': True}"/></b>
                  </span>
                </button>
                <div class="coop-owner_trust mt-3" invisible="not project_threshold">
                  <div class="coop-owner_trust_head">
                    <span>Собрано, порог <field name="project_threshold" readonly="1" nolabel="1"/> %</span>
                    <b><field name="project_readiness" readonly="1" nolabel="1"/> %</b>
                  </div>
                  <field name="project_readiness" widget="progressbar" readonly="1" nolabel="1"
                         class="coop-owner_bar"/>
                </div>
              </section>
            </aside>
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_vacancy_search" model="ir.ui.view">
    <field name="name">coop.vacancy.search</field>
    <field name="model">coop.vacancy</field>
    <field name="arch" type="xml">
      <search string="Вакансии">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="city"/>
        <field name="coop_specialization_id"/>
        <field name="skill_ids"/>
        <filter name="money" string="За деньги"
                domain="[('reward_kind', '=', 'money')]"/>
        <filter name="share" string="За долю в проекте"
                domain="[('reward_kind', '=', 'share')]"/>
        <filter name="barter" string="Обменом услугами"
                domain="[('reward_kind', '=', 'barter')]"/>
        <filter name="volunteer" string="Волонтёрство"
                domain="[('reward_kind', '=', 'volunteer')]"/>
        <separator/>
        <filter name="contract_labour" string="Трудовой договор"
                domain="[('contract_kind', '=', 'labour')]"/>
        <filter name="contract_civil" string="Договор подряда"
                domain="[('contract_kind', '=', 'civil')]"/>
        <filter name="contract_artel" string="Трудовое участие в артели"
                domain="[('contract_kind', '=', 'artel')]"/>
        <separator/>
        <filter name="pay_rub_share" string="Можно внести в пай"
                domain="[('pay_method', '=', 'rub_share')]"/>
        <filter name="pay_tokens" string="Платят токенами"
                domain="[('pay_method', '=', 'tokens')]"/>
        <separator/>
        <filter name="full" string="Полная занятость"
                domain="[('employment', '=', 'full')]"/>
        <filter name="project_work" string="Проектная работа"
                domain="[('employment', '=', 'project')]"/>
        <filter name="no_experience" string="Без опыта"
                domain="[('experience_level', '=', 'none')]"/>
        <separator/>
        <filter name="mine" string="Мои вакансии"
                domain="[('partner_id.user_ids', 'in', [uid])]"/>
        <group>
          <filter name="by_reward" string="По виду вознаграждения"
                  context="{'group_by': 'reward_kind'}"/>
          <filter name="by_contract" string="По договору"
                  context="{'group_by': 'contract_kind'}"/>
          <filter name="by_pay_method" string="Как выплачивается"
                  context="{'group_by': 'pay_method'}"/>
          <filter name="by_employment" string="По занятости"
                  context="{'group_by': 'employment'}"/>
          <filter name="by_area" string="По сфере деятельности"
                  context="{'group_by': 'coop_specialization_category_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_vacancies" model="ir.actions.act_window">
    <field name="name">Вакансии</field>
    <field name="res_model">coop.vacancy</field>
    <field name="path">vacancies</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить вакансию', 'coop_shelf_field': 'coop_specialization_category_id'}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('state', '=', 'published')]</field>
    <field name="search_view_id" ref="view_coop_vacancy_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Открытых вакансий пока нет</p>
      <p>Здесь участники ищут тех, кто сделает работу. Вознаграждение
         бывает не только деньгами: долей в проекте, обменом услугами или
         волонтёрством.</p>
    </field>
  </record>

  <record id="action_coop_my_vacancies" model="ir.actions.act_window">
    <field name="name">Мои вакансии</field>
    <field name="res_model">coop.vacancy</field>
    <field name="path">my-vacancies</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('partner_id.user_ids', 'in', [uid])]</field>
    <field name="search_view_id" ref="view_coop_vacancy_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока никого не ищете</p>
      <p>Закрытая или черновая вакансия из каталога уходит, но остаётся
         здесь.</p>
    </field>
    <field name="context">{'coop_create_label': 'Добавить вакансию'}</field>
  </record>

  <!--
    Окно отклика: одно поле и две кнопки. Больше здесь ничего не нужно —
    вакансию человек только что прочитал, а имя и город у него уже на
    странице.
  -->
  <record id="view_coop_vacancy_apply_form" model="ir.ui.view">
    <field name="name">coop.vacancy.apply.form</field>
    <field name="model">coop.vacancy.apply</field>
    <field name="arch" type="xml">
      <form string="Отклик">
        <field name="vacancy_id" invisible="1"/>
        <group>
          <field name="message" nolabel="1"
                 placeholder="Почему вы подходите. Необязательно — можно отправить и так."/>
        </group>
        <footer>
          <button name="action_send" type="object" string="Отправить отклик"
                  class="btn-primary"/>
          <button name="action_cancel" type="object" string="Отмена"
                  special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!--
    Отклики списком. Своих представлений у модели не было вовсе, и обе
    стороны получали то, что движок рисует по умолчанию: столбец из
    номеров записей — 861, 865, 573. Откликнувшийся не видел, на что
    откликался, наниматель не видел, кто к нему пришёл, а «Пригласить» и
    «Отклонить» негде было нажать, хотя в модели они написаны. Действие
    доходило до середины и обрывалось.

    Один список на обе стороны: разделяет их не представление, а правило
    доступа — откликнувшийся видит свои отклики, наниматель отклики на
    свои вакансии. Кнопки решения показываются по `can_decide`, который
    считается по тем же двоим, что и правило.
  -->
  <record id="view_coop_vacancy_application_list" model="ir.ui.view">
    <field name="name">coop.vacancy.application.list</field>
    <field name="model">coop.vacancy.application</field>
    <field name="arch" type="xml">
      <list string="Отклики" create="false">
        <field name="create_date" string="Когда" widget="date"/>
        <field name="vacancy_id" string="Вакансия"/>
        <field name="partner_id" string="Кто откликнулся"/>
        <field name="message" string="Сопроводительное письмо" optional="show"/>
        <field name="state" string="Состояние" widget="badge"
               decoration-info="state == 'applied'"
               decoration-success="state == 'invited'"
               decoration-muted="state == 'declined'"/>
        <!-- Решение принимается прямо из списка: выбирают из нескольких
             откликов сразу, и заходить в каждый ради одной кнопки
             значит потерять из виду остальные. -->
        <field name="can_decide" column_invisible="1"/>
        <button name="action_invite" type="object" string="Пригласить"
                icon="check" invisible="not can_decide or state == 'invited'"/>
        <button name="action_decline" type="object" string="Отклонить"
                icon="close" invisible="not can_decide or state == 'declined'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_vacancy_application_form" model="ir.ui.view">
    <field name="name">coop.vacancy.application.form</field>
    <field name="model">coop.vacancy.application</field>
    <field name="arch" type="xml">
      <form string="Отклик">
        <header>
          <button name="action_invite" type="object" string="Пригласить"
                  class="btn-primary" invisible="not can_decide or state == 'invited'"/>
          <button name="action_decline" type="object" string="Отклонить"
                  invisible="not can_decide or state == 'declined'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="applied,invited"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="vacancy_id" readonly="1"/>
              <field name="partner_id" readonly="1"/>
            </group>
            <group>
              <field name="create_date" string="Когда" readonly="1"/>
              <field name="can_decide" invisible="1"/>
            </group>
          </group>
          <group string="Сопроводительное письмо">
            <field name="message" nolabel="1" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_vacancy_application" model="ir.actions.act_window">
    <field name="name">Мои отклики</field>
    <field name="res_model">coop.vacancy.application</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('partner_id.user_ids', 'in', [uid])]</field>
      <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Откликов пока нет</p>
      <p>Отклик появляется здесь, когда вы отправили его из карточки вакансии. Наниматель видит его сразу, а вы — его ответ и состояние: рассматривается, приглашение или отказ.</p>
    </field>
</record>

  <menuitem id="menu_coop_vacancies_root" name="Вакансии" sequence="50"/>
  <menuitem id="menu_coop_vacancies" name="Каталог вакансий"
            parent="menu_coop_vacancies_root" action="action_coop_vacancies" sequence="10"/>
  <menuitem id="menu_coop_my_vacancies" name="Мои вакансии"
            parent="menu_coop_vacancies_root" action="action_coop_my_vacancies" sequence="20"/>
  <menuitem id="menu_coop_vacancy_application" name="Мои отклики"
            parent="menu_coop_vacancies_root" action="action_coop_vacancy_application"
            sequence="30"/>

</odoo>
