<?xml version="1.0" encoding="utf-8"?>
<!--
  Без `noupdate`. Правила доступа — это код, а не данные пользователя:
  правку правила нужно доставить на узел обновлением модуля. С пометкой
  «не обновлять» исправления молча не доезжали до базы, и правило
  продолжало работать в прежнем, ошибочном виде — так и вышло с правкой
  объявлений от имени организации.

  Если администратор узла подстроит правило под себя, обновление модуля
  вернёт нашу редакцию. Это осознанно: правила доступа задаёт платформа.
-->
<odoo>
  <data>


    <!--
      Читать опубликованные вакансии может любой участник, править — только
      свои. Без этого правила участник мог бы переписать чужую вакансию и
      сменить у неё автора: права на модель выданы, а правил записи нет.
      Тот же случай, что был в навыках.

      Третье условие — вакансия, на которую человек откликался. Без него
      отклик переживал вакансию: объявление закрывали, оно уходило из
      каталога, а вместе с ним пропадало и право читать его у того, кто
      уже откликнулся. В разделе «Мои отклики» это валило весь экран —
      «нет доступа „чтение“ к: Вакансия», — и человек не мог узнать даже,
      на что подавался. Откликнувшийся имеет к этой вакансии прямое
      отношение, и закрытие объявления его не отменяет.
    -->
    <record id="rule_vacancy_read" model="ir.rule">
      <field name="name">Участник видит опубликованные вакансии, свои и те, на которые откликался</field>
      <field name="model_id" ref="model_coop_vacancy"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', '|', ('state', '=', 'published'),
         ('partner_id', 'in', user.coop_actor_partner_ids.ids),
         ('application_ids.partner_id', 'in', user.coop_actor_partner_ids.ids)]
      </field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vacancy_own" model="ir.rule">
      <field name="name">Править можно только свою вакансию</field>
      <field name="model_id" ref="model_coop_vacancy"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_vacancy_system" model="ir.rule">
      <field name="name">Администратор узла ведёт все вакансии</field>
      <field name="model_id" ref="model_coop_vacancy"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!--
      Отклик видит тот, кто его подал, и тот, кому он адресован. Чужие
      отклики на чужую вакансию не видно: это переписка двоих, а не
      публичный список.

      Третий — ответственный за потребность у вакансии проекта. Владелец
      14 сентября 2026 поручил утверждение ему наравне с инициатором, а
      выбрать один отклик из пяти, не видя их, нельзя. Пока этой строки
      не было, ответственный получал пустой список и отказ в доступе при
      нажатии «Пригласить».
    -->
    <record id="rule_vacancy_application" model="ir.rule">
      <field name="name">Отклик виден откликнувшемуся, автору вакансии и ответственному</field>
      <field name="model_id" ref="model_coop_vacancy_application"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', ('partner_id', '=', user.partner_id.id),
         '|', ('vacancy_id.partner_id', 'in', user.coop_actor_partner_ids.ids),
              ('vacancy_id.need_manager_id', 'in', user.coop_actor_partner_ids.ids)]
      </field>
    </record>

    <record id="rule_vacancy_application_system" model="ir.rule">
      <field name="name">Администратор узла видит все отклики</field>
      <field name="model_id" ref="model_coop_vacancy_application"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

  </data>
</odoo>
