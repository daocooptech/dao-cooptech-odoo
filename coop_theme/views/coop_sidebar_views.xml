<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Настройка своего меню. Список, а не форма: правят здесь порядок и
    состав, а это работа со всем списком сразу, а не с одной записью.
  -->
  <record id="view_coop_sidebar_item_list" model="ir.ui.view">
    <field name="name">coop.sidebar.item.list</field>
    <field name="model">coop.sidebar.item</field>
    <field name="arch" type="xml">
      <list string="Меню" editable="bottom" default_order="section desc,sequence,id">
        <field name="sequence" widget="handle"/>
        <field name="section"/>
        <field name="name"/>
        <field name="icon" optional="hide"/>
        <field name="action_id" options="{'no_create': True}"/>
        <field name="is_required" string="Обязательный" readonly="1" optional="show"/>
      </list>
    </field>
  </record>

  <record id="action_coop_sidebar_items" model="ir.actions.act_window">
    <field name="name">Настройка меню</field>
    <field name="res_model">coop.sidebar.item</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Меню собирается при первом входе</p>
      <p>
        Разделы платформы одинаковы у всех — по ним люди договариваются, где
        что лежит. Их можно переставить местами, но не убрать. Расширения ниже
        каждый подключает себе сам.
      </p>
    </field>
  </record>

</odoo>
