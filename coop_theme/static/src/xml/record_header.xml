<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Полоса кнопок записи на широком экране: обычные кнопки в ряд,
    необратимые — в меню «⋯» (`record_header.js`). На телефоне ветка
    движка своя — там все кнопки, кроме первой, и так уходят в меню.
  -->
  <t t-name="coop_theme.StatusBarButtons" t-inherit="web.StatusBarButtons" t-inherit-mode="extension">
    <xpath expr="//t[@t-else]/t[@t-foreach]" position="replace">
      <t t-foreach="this.coopMainSlots" t-as="slot" t-key="slot">
        <t t-call-slot="{{ slot }}" />
      </t>
      <Dropdown t-if="this.coopMoreSlots.length" state="this.coopMoreState" position="'bottom-end'" menuClass="'o_coop_rh_menu'">
        <button type="button" class="btn btn-secondary o_coop_rh_more"
                title="Ещё действия" aria-label="Ещё действия">
          <!-- Контур Tabler `dots`. -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
            <path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
            <path d="M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
          </svg>
        </button>
        <t t-set-slot="content">
          <t t-foreach="this.coopMoreSlots" t-as="slot" t-key="slot">
            <DropdownItem class="'o-dropdown-item-unstyled-button o_coop_rh_item'">
              <div class="o_coop_rh_item_body" t-on-click.capture="() => this.coopMoreState.close()">
                <t t-call-slot="{{ slot }}" />
                <small t-if="this.props.slots[slot].coopNote" t-out="this.props.slots[slot].coopNote"/>
              </div>
            </DropdownItem>
          </t>
        </t>
      </Dropdown>
    </xpath>
  </t>

</templates>
