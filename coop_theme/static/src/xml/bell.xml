<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Колокол с числом непрошедших событий. Значок взят из дизайн-макета
    один в один: у платформы свой набор линейных значков, и подставлять
    сюда шрифтовую иконку движка значит ставить рядом два разных почерка.
  -->
  <t t-name="coop_theme.Bell">
    <!--
      Колокол открывает список последних извещений, как значок сообщений;
      весь раздел — ссылкой внизу (задача владельца 08.10.2026).
    -->
    <Dropdown state="this.dropdown" position="'bottom-end'"
              menuClass="'o_coop_bell_menu p-0'" beforeOpen="() => this.load()">
      <button class="o_coop_bell" type="button"
              t-att-aria-label="this.state.count ? 'Уведомления: ' + this.state.count + ' новых' : 'Уведомления'"
              title="Уведомления">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6"/>
          <path d="M9 17v1a3 3 0 0 0 6 0v-1"/>
        </svg>
        <span class="o_coop_bell_count" t-if="this.state.count">
          <t t-out="this.state.count"/>
        </span>
      </button>
      <t t-set-slot="content">
        <div class="o_coop_bell_head">
          <span>Уведомления</span>
          <button t-if="this.state.count" type="button" class="o_coop_bell_markall"
                  t-on-click="() => this.markAll()">Прочитать все</button>
        </div>
        <div class="o_coop_bell_list">
          <div t-if="!this.state.items.length" class="o_coop_bell_empty">
            <t t-if="this.state.loading">Загружаю…</t>
            <t t-else="">Уведомлений пока нет</t>
          </div>
          <button t-foreach="this.state.items" t-as="item" t-key="item.id" type="button"
                  t-att-class="'o_coop_bell_item' + (item.is_read ? '' : ' o_coop_bell_unread')"
                  t-on-click="() => this.openItem(item)">
            <span class="o_coop_bell_meta">
              <span t-out="item.kind"/> · <span t-out="this.when(item.date)"/>
            </span>
            <span class="o_coop_bell_text" t-out="item.text"/>
          </button>
        </div>
        <button type="button" class="o_coop_bell_all" t-on-click="() => this.openAll()">
          Посмотреть все уведомления
        </button>
      </t>
    </Dropdown>
  </t>

</templates>
