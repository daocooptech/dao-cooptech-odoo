<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="coop_theme.CatalogFilters">
    <aside class="o_coop_filters" t-att-class="{ 'o_coop_filters_open': this.ui.open }">
      <!-- Затемнение нижней шторки. Только на узком экране: на большом
           панель стоит колонкой справа и ничего не перекрывает. -->
      <div class="o_coop_filters_scrim" t-if="this.ui.open"
           t-on-click="() => this.toggleOpen()"/>

      <div class="o_coop_filters_body" id="coop_filters_body">
        <div class="o_coop_filters_title">
          Фильтр
          <!-- Закрыть шторку, ничего не применяя. Кнопка видна только
               на узком экране: на большом закрывать нечего. -->
          <button type="button" class="o_coop_filters_close"
                  aria-label="Закрыть фильтр"
                  t-on-click="() => this.toggleOpen()">×</button>
        </div>

        <!--
          Раздел, у которого набор полей ещё не описан, показывает не
          пустую карточку с заголовком «Фильтр», а прямую строку о том,
          чем здесь пока отбирают. Карточка без единого поля читается как
          недогрузившаяся, и человек ждёт, что она вот-вот появится.
        -->
        <div class="o_coop_filters_none" t-if="!this.state.blocks.length">
          В этом разделе пока отбирают порядком и поиском по названию.
        </div>

        <t t-foreach="this.state.blocks" t-as="block" t-key="block.code">

          <!-- Быстрые фильтры — чипами, как в макете. -->
          <div class="o_coop_field" t-if="block.widget === 'quick'">
            <label t-out="block.label"/>
            <div class="o_coop_chips">
              <button t-foreach="block.options" t-as="option" t-key="option.value"
                      type="button" class="o_coop_chip"
                      t-att-class="{ 'o_coop_chip_on': this.isQuick(option.value) }"
                      t-att-aria-pressed="this.isQuick(option.value) ? 'true' : 'false'"
                      t-on-click="() => this.toggleQuick(option.value)">
                <t t-out="option.label"/>
              </button>
            </div>
          </div>

          <div class="o_coop_field" t-if="block.widget === 'select'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <select class="o_coop_input"
                    t-on-change="(ev) => this.onChange(block.code, ev.target.value)">
              <option value=""><t t-out="block.placeholder or 'Любой'"/></option>
              <option t-foreach="block.options" t-as="option" t-key="option.value"
                      t-att-value="option.value"
                      t-att-selected="this.isSelected(block, option)">
                <t t-out="option.label"/>
                <t t-if="option.count"> · <t t-out="option.count"/></t>
              </option>
            </select>
          </div>

          <div class="o_coop_field" t-if="block.widget === 'text'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <!-- Подсказка значений, если каталог их дал: город в макете —
                 свободный ввод со списком известных городов. -->
            <input type="text" class="o_coop_input"
                   t-att-list="block.options and block.options.length ? 'coop-suggest-' + block.code : undefined"
                   t-att-placeholder="block.placeholder"
                   t-att-value="this.state.values[block.code] or ''"
                   t-on-change="(ev) => this.onChange(block.code, ev.target.value)"/>
            <datalist t-if="block.options and block.options.length"
                      t-att-id="'coop-suggest-' + block.code">
              <option t-foreach="block.options" t-as="option" t-key="option.value"
                      t-att-value="option.label"/>
            </datalist>
          </div>

          <!-- Несколько значений из длинного списка: ввод с подсказкой,
               выбранное — чипами под полем, как «Навыки» в макете.
               Флажками сотню навыков не перебрать. -->
          <div class="o_coop_field" t-if="block.widget === 'tags'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <input type="text" class="o_coop_input"
                   t-att-list="'coop-suggest-' + block.code"
                   t-att-placeholder="block.placeholder"
                   t-on-input="(ev) => this.onTagInput(block, ev)"/>
            <datalist t-att-id="'coop-suggest-' + block.code">
              <option t-foreach="block.options" t-as="option" t-key="option.value"
                      t-att-value="option.label"/>
            </datalist>
            <div class="o_coop_chips o_coop_tags" t-if="this.pickedOptions(block).length">
              <button type="button" class="o_coop_chip o_coop_chip_on"
                      t-foreach="this.pickedOptions(block)" t-as="option" t-key="option.value"
                      t-att-aria-label="'Убрать: ' + option.label"
                      t-on-click="() => this.toggleMulti(block.code, option.value)">
                <t t-out="option.label"/> ×
              </button>
            </div>
          </div>

          <!-- Свободный ввод с подсказкой значений: в макете это поле
               «Например, аренда», а не список. -->
          <div class="o_coop_field" t-if="block.widget === 'suggest'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <input type="text" class="o_coop_input"
                   t-att-list="'coop-suggest-' + block.code"
                   t-att-placeholder="block.placeholder"
                   t-att-value="this.state.values[block.code] or ''"
                   t-on-change="(ev) => this.onChange(block.code, ev.target.value)"/>
            <datalist t-att-id="'coop-suggest-' + block.code">
              <option t-foreach="block.options" t-as="option" t-key="option.value"
                      t-att-value="option.label"/>
            </datalist>
          </div>

          <!-- Несколько значений разом: флажки, а не выпадающий список —
               в нём за раз выбирается одно. -->
          <div class="o_coop_field" t-if="block.widget === 'multi'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <div class="o_coop_multi">
              <label class="o_coop_multi_item" t-foreach="block.options"
                     t-as="option" t-key="option.value">
                <input type="checkbox" t-att-checked="this.isPicked(block, option)"
                       t-on-change="() => this.toggleMulti(block.code, option.value)"/>
                <span t-out="option.label"/>
              </label>
              <div class="o_coop_multi_empty" t-if="!block.options.length"
                   t-out="block.empty or 'Выбирать пока не из чего'"/>
            </div>
          </div>

          <div class="o_coop_field" t-if="block.widget === 'daterange'">
            <label>
              <t t-out="block.label"/>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <div class="o_coop_range">
              <input type="date" class="o_coop_input" aria-label="с"
                     t-att-value="this.state.values[block.code + '_from'] or ''"
                     t-on-change="(ev) => this.onChange(block.code + '_from', ev.target.value)"/>
              <input type="date" class="o_coop_input" aria-label="по"
                     t-att-value="this.state.values[block.code + '_to'] or ''"
                     t-on-change="(ev) => this.onChange(block.code + '_to', ev.target.value)"/>
            </div>
          </div>

          <div class="o_coop_field" t-if="block.widget === 'range'">
            <label>
              <t t-out="block.label"/><t t-if="block.unit">, <t t-out="block.unit"/></t>
              <span class="o_coop_hint" t-if="block.hint" role="img"
                    t-att-title="block.hint" t-att-aria-label="block.hint">ⓘ</span>
            </label>
            <div class="o_coop_range">
              <input type="number" class="o_coop_input" placeholder="от"
                     t-att-value="this.state.values[block.code + '_from'] or ''"
                     t-on-change="(ev) => this.onChange(block.code + '_from', ev.target.value)"/>
              <input type="number" class="o_coop_input" placeholder="до"
                     t-att-value="this.state.values[block.code + '_to'] or ''"
                     t-on-change="(ev) => this.onChange(block.code + '_to', ev.target.value)"/>
            </div>
          </div>
        </t>

        <!-- Порядок — последним, перед «Сбросить» (владелец 27.09.2026:
             «сортировка во всех фильтрах последним пунктом перед кнопкой
             сбросить»): сначала отбирают, потом упорядочивают. -->
        <div class="o_coop_field">
          <label for="coop_sort">Сортировка</label>
          <select id="coop_sort" class="o_coop_input" t-on-change="this.onSortChange">
            <option t-foreach="this.sortOptions" t-as="option" t-key="option[0]"
                    t-att-value="option[0]"
                    t-att-selected="option[0] === this.currentSort">
              <t t-out="option[1]"/>
            </option>
          </select>
        </div>

        <button type="button" class="o_coop_btn o_coop_btn_light"
                t-on-click="() => this.reset()">Сбросить</button>

        <!-- Единственная тёмная кнопка: ею фильтр и применяется.
             Раньше условия применялись сами на каждое изменение поля —
             на рубрике с десятком характеристик это был десяток
             запросов на щелчок, и каталог заметно вставал. -->
        <button type="button" class="o_coop_btn o_coop_btn_dark"
                t-att-class="{ 'o_coop_btn_dirty': this.state.dirty }"
                t-on-click="() => this.showResults()">
          Показать результаты
          <!-- Число произносится вслух при пересчёте: иначе незрячий
               человек не узнает, что после последнего выбора показывать
               уже нечего. -->
          <t t-if="this.state.preview !== null">
            · <span aria-live="polite" t-out="this.state.preview"/>
          </t>
        </button>

        <button type="button" class="o_coop_btn o_coop_btn_light"
                t-on-click="() => this.saveSearch()">🔔 Сохранить поиск</button>

        <button type="button" class="o_coop_btn o_coop_btn_light"
                t-on-click="() => this.toggleSaved()">
          Сохранённые поиски
          <t t-if="this.state.saved.length"> · <t t-out="this.state.saved.length"/></t>
        </button>

        <div class="o_coop_saved" t-if="this.state.savedOpen">
          <div class="o_coop_saved_empty" t-if="!this.state.saved.length">
            Пока ничего не сохранено
          </div>
          <div class="o_coop_saved_row" t-foreach="this.state.saved" t-as="saved"
               t-key="saved.id">
            <button type="button" class="o_coop_saved_name"
                    t-on-click="() => this.applySaved(saved)"
                    t-out="saved.name"/>
            <button type="button" class="o_coop_saved_drop"
                    title="Удалить сохранённый поиск"
                    t-on-click="() => this.dropSaved(saved)">×</button>
          </div>
        </div>
      </div>
    </aside>
  </t>

</templates>
