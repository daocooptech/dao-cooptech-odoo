<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Кнопка возврата. Подпись рисуется всегда, но на широком экране
    скрывается стилями: там справа стоит весь путь и говорит, куда
    ведёт стрелка. На телефоне пути нет, и без подписи стрелка отвечает
    «назад», но не отвечает «куда» — а на третьем уровне это и есть
    главный вопрос.
  -->
  <t t-name="coop_theme.BackButton">
    <button t-if="this.coopBack" type="button" class="o_coop_back"
            t-att-title="this.coopBack.title" t-att-aria-label="this.coopBack.title"
            data-hotkey="b"
            t-on-click="() => this.coopGoBack()">
      <i class="oi oi-arrow-left" role="img" aria-hidden="true"/>
      <span class="o_coop_back_label" t-out="this.coopBack.label"/>
    </button>
  </t>

  <t t-name="coop_theme.Breadcrumbs" t-inherit="web.Breadcrumbs" t-inherit-mode="extension">

    <!--
      Кнопка — первой в полосе, до пути.
    -->
    <xpath expr="//t[@t-if='this.env.isSmall']" position="before">
      <t t-call="coop_theme.BackButton"/>
    </xpath>

    <!--
      Штатная стрелка убирается. Не удалением узла, а условием: за ним
      идёт `t-else` с самим путём, и без `t-if` перед ним шаблон не
      собрался бы вовсе.

      Так путь рисуется на всех ширинах, а прячется на узком экране
      стилями — одно место вместо двух, расходящихся на 767 точках.
    -->
    <xpath expr="//t[@t-if='this.env.isSmall']" position="attributes">
      <attribute name="t-if">false</attribute>
    </xpath>

    <!--
      Путь предков — только там, где он что-то объясняет. На странице
      человека он называет кого угодно, кроме того, кто перед глазами;
      см. `coopIsPersonPage` в `breadcrumb.js`.
    -->
    <xpath expr="//ol[hasclass('breadcrumb')]" position="attributes">
      <attribute name="t-if">!this.coopIsPersonPage</attribute>
    </xpath>

    <!--
      Вместе с путём убирается и последняя крошка: это имя открытой
      записи, и на странице человека оно приходит пустым — от него
      остаётся один значок настроек, висящий в пустоте.
    -->
    <xpath expr="//div[hasclass('o_last_breadcrumb_item')][hasclass('gap-2')]" position="attributes">
      <attribute name="t-if">!this.coopIsPersonPage</attribute>
    </xpath>

    <!--
      Шестерёнка — штатное «Меню действий» записи: «Дублировать»,
      «Удалить», «Отправить SMS», «Выгрузить vCard», «Предоставить
      доступ к порталу». Это действия над строкой таблицы, а не над
      человеком, ресурсом или сделкой, и в языке платформы их нет.

      Убирается на всех страницах записей платформы — см.
      `coopHideActions` в `breadcrumb.js`, — и в обеих ветках шаблона: и
      когда есть предки, и когда карточка открыта по прямой ссылке.
    -->
    <xpath expr="(//t[@t-call='web.Breadcrumb.Actions'])[1]" position="attributes">
      <attribute name="t-if">!this.coopHideActions</attribute>
    </xpath>

    <xpath expr="(//t[@t-call='web.Breadcrumb.Actions'])[2]" position="attributes">
      <attribute name="t-if">!this.coopHideActions</attribute>
    </xpath>

    <!--
      Вторая ветка шаблона: крошка одна, предков нет. Кнопка нужна и
      здесь — это случай прямой ссылки на запись, откуда наружу не ведёт
      ничего.
    -->
    <xpath expr="//div[hasclass('o_last_breadcrumb_item')][hasclass('fs-4')]" position="before">
      <t t-call="coop_theme.BackButton"/>
    </xpath>

  </t>

</templates>
