<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Кнопка возврата. Подпись рисуется всегда, но на широком экране
    скрывается стилями: там справа стоит весь путь и говорит, куда
    ведёт стрелка. На телефоне пути нет, и без подписи стрелка отвечает
    «назад», но не отвечает «куда» — а на третьем уровне это и есть
    главный вопрос.
  -->
  <t t-name="coop_theme.BackButton">
    <button t-if="this.coopBack" type="button" class="o_coop_back"
            t-att-title="this.coopBack.title" t-att-aria-label="this.coopBack.title"
            data-hotkey="b"
            t-on-click="() => this.coopGoBack()">
      <!-- Контур Tabler `arrow-left`. Шрифтовой `oi-arrow-left` в Odoo 20
           пуст: значки `oi` теперь рисуются по `data-icon`, и от кнопки
           оставалась одна рамка (владелец 12.10.2026). -->
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12l14 0"/>
        <path d="M5 12l6 6"/>
        <path d="M5 12l6 -6"/>
      </svg>
      <span class="o_coop_back_label" t-out="this.coopBack.label"/>
    </button>
  </t>

  <!--
    Хвост пути на странице записи (№ 407): рубрика ссылкой на каталог,
    отобранный по ней. Названия записи в пути нет — оно стоит заголовком
    страницы прямо под ним (владелец 12.11.2026).
  -->
  <t t-name="coop_theme.TrailTail">
    <t t-if="this.coopRubricsHere">
      <li t-foreach="this.coopTrail.rubrics" t-as="rubric" t-key="rubric.field + rubric.id"
          class="breadcrumb-item d-inline-flex min-w-0 o_coop_rubric">
        <a href="#" class="text-truncate" t-att-title="rubric.name"
           t-on-click.prevent="() => this.coopOpenRubric(rubric)" t-out="rubric.name"/>
      </li>
    </t>
  </t>

  <!--
    Путь от раздела: прямая ссылка на запись (предков нет) и страница
    человека или организации (предки не показываются, см.
    `coopIsPersonPage`).
  -->
  <t t-name="coop_theme.Trail">
    <ol class="breadcrumb flex-nowrap text-nowrap lh-sm o_coop_trail">
      <li t-if="this.coopTrailSection" class="breadcrumb-item d-inline-flex min-w-0">
        <a href="#" class="text-truncate" t-on-click.prevent="() => this.coopOpenSection()"
           t-out="this.coopTrailSection.label"/>
      </li>
      <t t-call="coop_theme.TrailTail"/>
    </ol>
  </t>

  <!-- Вкладка «Я инициатор» звеном пути — «Мои проекты» (`coopCrumbName`). -->
  <t t-name="coop_theme.BreadcrumbName" t-inherit="web.Breadcrumb.Name" t-inherit-mode="extension">
    <xpath expr="//t[@t-out='breadcrumb.name']" position="attributes">
      <attribute name="t-out">this.coopCrumbName ? this.coopCrumbName(breadcrumb) : breadcrumb.name</attribute>
    </xpath>
  </t>

  <t t-name="coop_theme.Breadcrumbs" t-inherit="web.Breadcrumbs" t-inherit-mode="extension">

    <!--
      Путь предков продолжается рубрикой и записью — на странице записи
      платформы. Имя записи тогда стоит в пути, а не отдельной строкой.
    -->
    <xpath expr="//li[hasclass('o_back_button')]" position="after">
      <t t-if="this.coopTrail" t-call="coop_theme.TrailTail"/>
    </xpath>
    <!--
      Путь целиком, без «…» (владелец 19.11.2026: «путь попробуй
      полностью пропиши»): «Проекты › Управление проектами › MVP DAO
      COOPTECH › Задачи». Длинное звено обрезается многоточием само.
      Раздел в начале — когда путь начался с экрана без пункта меню.
    -->
    <xpath expr="//li[@t-if='collapsedBreadcrumbs.length']" position="replace">
      <li t-if="this.coopCrumbRoot" class="breadcrumb-item d-inline-flex min-w-0"
          t-on-click.prevent="() => this.coopOpenCrumbRoot()">
        <a href="#" class="text-truncate" t-out="this.coopCrumbRoot.label"/>
      </li>
      <t t-foreach="collapsedBreadcrumbs.slice().reverse()" t-as="crumb" t-key="crumb.jsId">
        <li class="breadcrumb-item d-inline-flex min-w-0" t-on-click.prevent="crumb.onSelected">
          <a t-att-href="crumb.url" class="text-truncate">
            <t t-call="web.Breadcrumb.Name" breadcrumb="crumb"/>
          </a>
        </li>
      </t>
    </xpath>

    <xpath expr="//ol[hasclass('breadcrumb')]" position="after">
      <t t-if="this.coopIsPersonPage and this.coopTrail" t-call="coop_theme.Trail"/>
    </xpath>

    <!--
      Кнопка — первой в полосе, до пути.
    -->
    <xpath expr="//t[@t-if='this.uiService.isSmall']" position="before">
      <t t-call="coop_theme.BackButton"/>
    </xpath>

    <!--
      Штатная стрелка убирается. Не удалением узла, а условием: за ним
      идёт `t-else` с самим путём, и без `t-if` перед ним шаблон не
      собрался бы вовсе.

      Так путь рисуется на всех ширинах, а прячется на узком экране
      стилями — одно место вместо двух, расходящихся на 767 точках.
    -->
    <xpath expr="//t[@t-if='this.uiService.isSmall']" position="attributes">
      <attribute name="t-if">false</attribute>
    </xpath>

    <!--
      Путь предков — только там, где он что-то объясняет. На странице
      человека он называет кого угодно, кроме того, кто перед глазами;
      см. `coopIsPersonPage` в `breadcrumb.js`.
    -->
    <xpath expr="//ol[hasclass('breadcrumb')]" position="attributes">
      <attribute name="t-if">!this.coopIsPersonPage</attribute>
      <attribute name="t-att-class">{ o_coop_trail_on: this.coopTrail }</attribute>
    </xpath>

    <!--
      Вместе с путём убирается и последняя крошка: это имя открытой
      записи, и на странице человека оно приходит пустым — от него
      остаётся один значок настроек, висящий в пустоте.
    -->
    <xpath expr="//div[hasclass('o_last_breadcrumb_item')][hasclass('gap-2')]" position="attributes">
      <attribute name="t-if">!this.coopIsPersonPage and !this.coopTrail</attribute>
      <attribute name="t-att-class">{ o_coop_last_shown: this.coopShowLast }</attribute>
    </xpath>

    <!--
      Шестерёнка — штатное «Меню действий» записи: «Дублировать»,
      «Удалить», «Отправить SMS», «Выгрузить vCard», «Предоставить
      доступ к порталу». Это действия над строкой таблицы, а не над
      человеком, ресурсом или сделкой, и в языке платформы их нет.

      Убирается на всех страницах записей платформы — см.
      `coopHideActions` в `breadcrumb.js`, — и в обеих ветках шаблона: и
      когда есть предки, и когда карточка открыта по прямой ссылке.
    -->
    <xpath expr="(//t[@t-call='web.Breadcrumb.Actions'])[1]" position="attributes">
      <attribute name="t-if">!this.coopHideActions</attribute>
    </xpath>

    <xpath expr="(//t[@t-call='web.Breadcrumb.Actions'])[2]" position="attributes">
      <attribute name="t-if">!this.coopHideActions</attribute>
    </xpath>

    <!--
      Вторая ветка шаблона: крошка одна, предков нет. Кнопка нужна и
      здесь — это случай прямой ссылки на запись, откуда наружу не ведёт
      ничего.
    -->
    <xpath expr="//div[hasclass('o_last_breadcrumb_item')][hasclass('fs-4')]" position="before">
      <t t-call="coop_theme.BackButton"/>
      <t t-if="this.coopTrail" t-call="coop_theme.Trail"/>
      <!-- Запись экрана без пункта меню по прямой ссылке — путь
           достраивается (`coopLoneRoot`, владелец 19.11.2026). -->
      <ol t-if="this.coopLoneRoot" class="breadcrumb o_coop_trail flex-nowrap text-nowrap lh-sm">
        <li class="breadcrumb-item d-inline-flex min-w-0"
            t-on-click.prevent="() => this.coopOpenCrumbRoot(this.coopLoneRoot)">
          <a href="#" class="text-truncate" t-out="this.coopLoneRoot.label"/>
        </li>
        <li class="breadcrumb-item d-inline-flex min-w-0 o_back_button"
            t-on-click.prevent="() => this.coopOpenLoneScreen()">
          <a href="#" class="text-truncate" t-out="this.coopLoneRoot.screen"/>
        </li>
      </ol>
    </xpath>

    <!-- Имя записи — последним звеном пути, а не отдельно крупно. -->
    <xpath expr="//div[hasclass('o_last_breadcrumb_item')][hasclass('fs-4')]" position="attributes">
      <attribute name="t-if">!this.coopTrail</attribute>
      <attribute name="t-att-class">{ o_coop_last_shown: this.coopLoneRoot }</attribute>
    </xpath>

  </t>

</templates>
