<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- Лента не забирает фокус при открытии страницы.

       Odoo ставит курсор в поле сообщения сразу, как только чаттер
       нарисован. На форме записи это безобидно: чаттер там сбоку или в
       конце короткой формы. На странице участника лента идёт последним
       блоком после «Достижений», «Потребностей», «Организаций» и
       «Сообществ», а прокрутка у нас общая для всей страницы — и браузер,
       ставя курсор в поле, прокручивает страницу к нему. Участник
       нажимал «Мою страницу» и попадал в самый низ, на ленту, будто
       перешёл по якорю.

       Меняется одно слово в чужом шаблоне. Полностью переписывать его
       нельзя: он большой и живёт своей жизнью от версии к версии, а нам
       нужен только этот признак. -->
  <t t-name="coop_theme.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
    <xpath expr="//Composer" position="attributes">
      <attribute name="autofocus">false</attribute>
    </xpath>
  </t>

</templates>
