<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- Лента не забирает фокус при открытии страницы.

       Odoo ставит курсор в поле сообщения сразу, как только чаттер
       нарисован. На форме записи это безобидно: чаттер там сбоку или в
       конце короткой формы. На странице участника лента идёт последним
       блоком после «Достижений», «Потребностей», «Организаций» и
       «Сообществ», а прокрутка у нас общая для всей страницы — и браузер,
       ставя курсор в поле, прокручивает страницу к нему. Участник
       нажимал «Мою страницу» и попадал в самый низ, на ленту, будто
       перешёл по якорю.

       Меняется одно слово в чужом шаблоне. Полностью переписывать его
       нельзя: он большой и живёт своей жизнью от версии к версии, а нам
       нужен только этот признак. -->
  <t t-name="coop_theme.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
    <xpath expr="//Composer" position="attributes">
      <attribute name="autofocus">false</attribute>
    </xpath>
  </t>


  <!--
    Видео в ленте записи — проигрывателем прямо в записи, а не карточкой с
    именем файла. Владелец 24 сентября 2026: «добавь разного вида контент
    на стену и чтобы это красиво смотрелось, например видео, аудиозапись
    или документ». Картинки, документы и голосовые движок показывает сам
    (миниатюра, превью первой страницы, проигрыватель с волной); видео он
    показывает только карточкой.

    Только в ленте записи (`env.inChatter`): в переписках вид прежний.
    Щелчок по проигрывателю не всплывает до карточки — иначе он открывал
    бы поверх ещё и окно просмотра файла.
  -->
  <t t-name="coop_theme.AttachmentListVideo" t-inherit="mail.AttachmentList" t-inherit-mode="extension">
    <xpath expr="//Gif" position="after">
      <video t-elif="env.inChatter and attachment.mimetype and attachment.mimetype.startsWith('video/')"
             class="o_coop_wall_video"
             controls="controls" preload="metadata"
             t-att-src="'/web/content/' + attachment.id"
             t-on-click.stop=""/>
    </xpath>
  </t>


  <!--
    Пустая стена — «Записей пока нет.» (решение 410, п. 8), а не «Беседа
    пуста» со смайликом: стена — не переписка, и пустота у неё своя.
    Только у стен (люди и организации, проекты, сообщества — те же модели,
    что WALL_MODELS в js/wall.js); в переписке записи — как у движка.
    Текст появляется после загрузки: условие `isLoaded` — у движка, выше.
  -->
  <t t-name="coop_theme.ThreadWallEmpty" t-inherit="mail.Thread" t-inherit-mode="extension">
    <xpath expr="//t[@name='empty-message']/div" position="attributes">
      <attribute name="t-elif">!['res.partner', 'coop.project', 'coop.community'].includes(props.thread.model)</attribute>
      <attribute name="t-else"></attribute>
    </xpath>
    <xpath expr="//t[@name='empty-message']" position="inside">
      <div t-else="" class="o_coop_wall_empty text-muted">Записей пока нет.</div>
    </xpath>
    <!-- В ленте есть только скрытый на стене журнал — движок считает её
         непустой (js/wall.js, coopWallEmpty). -->
    <xpath expr="//t[@name='content']/div" position="inside">
      <div t-if="coopWallEmpty" class="o_coop_wall_empty text-muted">Записей пока нет.</div>
    </xpath>
  </t>

</templates>
