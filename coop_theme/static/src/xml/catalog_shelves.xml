<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Полка: заголовок рубрики со счётчиком, ряд карточек и «Смотреть все».
    Ряд прокручивается вбок — на узком экране полка не превращается
    в сетку, иначе витрина занимает три экрана и до каталога никто
    не долистывает.
  -->
  <t t-name="coop_theme.CatalogShelves">
    <div class="o_coop_shelves" t-if="state.shelves.length">
      <div class="o_coop_shelf" t-foreach="state.shelves" t-as="shelf" t-key="shelf.id">
        <div class="o_coop_shelf_head">
          <div class="o_coop_shelf_title">
            <t t-esc="shelf.label"/>
            <span class="o_coop_shelf_count"><t t-esc="shelf.count"/></span>
          </div>
          <button class="o_coop_shelf_all" type="button" t-on-click="() => this.openAll(shelf)">
            Смотреть все
          </button>
        </div>
        <div class="o_coop_shelf_row">
          <!--
            Две карточки, и обе — карточки этого же каталога.

            Где есть снимки, полка повторяет плиточную карточку: снимок
            сверху, название под ним. Где снимков нет — закупки, сделки,
            выпуски ЦФА, — повторяет строчную: квадратная плитка со
            значком слева, название и город справа. Классы взяты те же,
            что у каталога (`o_coop_listing`), а не скопированы: иначе
            полка и каталог разойдутся при первой же правке стиля.

            Владелец на это и указал 15 сентября: «на стенде какие-то
            микро-карточки, на хостинге вообще по-другому». Своя мелкая
            карточка поверх чужого каталога — и есть разнобой.
          -->
          <div t-foreach="shelf.records" t-as="rec" t-key="rec.id"
               t-att-class="hasPhotos ? 'o_coop_shelf_card' : 'o_coop_shelf_card o_coop_listing o_coop_shelf_listing'"
               t-on-click="() => this.open(rec)">
            <t t-if="hasPhotos">
              <div class="o_coop_shelf_photo">
                <img t-att-src="photo(rec)" t-att-alt="rec.display_name" loading="lazy"/>
                <span class="o_coop_shelf_city" t-if="rec.city">
                  <i class="fa fa-map-marker" aria-hidden="true"/>
                  <t t-esc="rec.city"/>
                </span>
              </div>
              <div class="o_coop_shelf_name"><t t-esc="rec.display_name"/></div>
            </t>
            <t t-else="">
              <div class="o_coop_listing_ico"><t t-esc="icon(rec)"/></div>
              <div class="o_coop_listing_body">
                <div class="o_coop_listing_title"><t t-esc="rec.display_name"/></div>
                <div class="o_coop_shelf_where" t-if="rec.city">
                  <i class="fa fa-map-marker" aria-hidden="true"/>
                  <t t-esc="rec.city"/>
                </div>
              </div>
            </t>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
