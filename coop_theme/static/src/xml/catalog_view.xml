<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Класс вида ставится на корень представления: карточка одна и та же,
    меняется её раскладка. Так же устроен прототип, где переключался класс
    `tile-mode`. Своих кнопок здесь нет — переключатель один, штатный,
    справа.
  -->
  <t t-name="coop_theme.CatalogKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
    <xpath expr="//div[@t-ref='root']" position="attributes">
      <attribute name="t-attf-class">{{ className }} {{ hasSelectedRecords ? 'o_kanban_selection_active' : 'o_kanban_selection_available' }} o_coop_{{ coopLayout.mode }}</attribute>
    </xpath>

    <!--
      Страницы переключаются внизу, под плитками, как в макете. Наверху
      им не место: там человек ещё ничего не посмотрел, и переключать
      нечего.
    -->
    <xpath expr="//button[hasclass('o-kanban-button-new')]" position="replace">
      <button t-if="canCreate and props.showButtons" type="button"
              t-att-disabled="isNewButtonDisabled"
              class="btn btn-primary o-kanban-button-new" accesskey="c"
              t-on-click="() => this.createRecord()" data-bounce-button="">
        <t t-esc="coopCreateLabel"/>
      </button>
    </xpath>

    <!--
      Панель фильтров — своя, а не штатная: та берёт фиксированный список
      полей из разметки и умеет только ссылки и списки значений, без
      диапазона цены, свободного ввода города и набора полей, зависящего
      от раздела.
    -->
    <!--
      Условие штатное плюс своё. Своё в одиночку сюда ставить нельзя:
      `model.isReady` — это признак того, что данные уже загружены, и без
      него список рисуется по пустой модели.
    -->
    <xpath expr="//t[@t-component='props.Renderer']" position="attributes">
      <attribute name="t-if">model.isReady and coopLayout.mode !== 'map'</attribute>
    </xpath>

    <!--
      Одной вставкой, а не тремя: каждая следующая «after» встаёт вплотную
      к списку и отодвигает предыдущую, и порядок в разметке выходил
      обратный тому, что видно на экране.
    -->
    <xpath expr="//t[@t-component='props.Renderer']" position="after">
      <CoopMap t-if="coopLayout.mode === 'map'"
               resModel="props.resModel" domain="model.root.domain"
               showTiles.bind="coopShowTiles"/>
      <CoopFilters resModel="props.resModel"/>
      <div class="o_coop_pager" t-if="env.config.pagerProps and coopLayout.mode !== 'map'">
        <Pager t-props="env.config.pagerProps"/>
      </div>
    </xpath>
  </t>

  <!--
    Переключатель видов. У каталога платформы кнопок три: плиткой,
    канбаном, списком. Первые две — одно представление в двух раскладках,
    третья — отдельное представление Odoo.

    Подменяется источник кнопок, а не добавляется вторая группа: два
    переключателя на экране заставляют гадать, чем они отличаются.
  -->
  <t t-name="coop_theme.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
    <!--
      Признак каталога ставится классом на саму панель: по нему строка
      поиска раскладывается во всю ширину, как в макете, и не борется за
      место с названием раздела и пагинатором.
    -->
    <xpath expr="//div[hasclass('o_control_panel')]" position="attributes">
      <attribute name="t-att-class">{ o_coop_catalog: coopIsCatalog, o_coop_lone_crumb: coopSingleCrumb }</attribute>
    </xpath>

    <!--
      Название раздела заменяется вкладками: оно дублирует активную
      вкладку, а места занимает столько же.
    -->
    <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]" position="inside">
      <CoopTabs t-if="coopIsCatalog"/>
    </xpath>

    <!--
      Явный перенос строки. Без него поиск умещается рядом с вкладками и
      встаёт в первую строку: перенос во флексе считается по исходным
      ширинам, а не по тому, как элементы растянутся потом.
    -->
    <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="after">
      <div class="o_coop_row_break" t-if="coopIsCatalog"/>
    </xpath>

    <!--
      Переключатель записей над единственной записью показывает «1 / 1»:
      переключать нечего, а полосу он держит.
    -->
    <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
      <attribute name="t-if">pagerProps and pagerProps.total > 1</attribute>
    </xpath>

    <xpath expr="//t[@t-if='env.config.viewSwitcherEntries?.length > 1']" position="attributes">
      <attribute name="t-if">coopViewEntries.length > 1</attribute>
    </xpath>
    <xpath expr="//Dropdown//t[@t-set='activeView']" position="attributes">
      <attribute name="t-value">coopViewEntries.find((view) => view.active)</attribute>
    </xpath>
    <xpath expr="//t[@t-set-slot='content']//t[@t-foreach='env.config.viewSwitcherEntries']" position="attributes">
      <attribute name="t-foreach">coopViewEntries</attribute>
    </xpath>
    <xpath expr="//nav[hasclass('o_cp_switch_buttons')]//t[@t-foreach='env.config.viewSwitcherEntries']" position="attributes">
      <attribute name="t-foreach">coopViewEntries</attribute>
    </xpath>
  </t>

  <!--
    Строка поиска каталога.

    Выпадающее меню «Фильтры / Группировать по / Избранное» вместе с
    кнопкой-стрелкой убрано: у каталога есть своя панель фильтров, и два
    разных набора условий на одном экране расходятся между собой — снял
    условие в одном, а второй продолжает его показывать.

    Подсказка своя: «Search...» ничего не говорит о том, что искать, а в
    каталоге ищут по названию.
  -->
  <t t-name="coop_theme.SearchBar" t-inherit="web.SearchBar" t-inherit-mode="extension">
    <xpath expr="//input[hasclass('o_searchview_input')]" position="attributes">
      <attribute name="t-att-placeholder">coopPlaceholder</attribute>
    </xpath>
    <xpath expr="//SearchBarMenu" position="attributes">
      <attribute name="t-if">!coopIsCatalog</attribute>
    </xpath>
  </t>

</templates>