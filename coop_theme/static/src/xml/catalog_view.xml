<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Класс вида ставится на корень представления: карточка одна и та же,
    меняется её раскладка. Так же устроен прототип, где переключался класс
    `tile-mode`. Своих кнопок здесь нет — переключатель один, штатный,
    справа.
  -->
  <!-- Карточка каталога с сердечком «в избранное» — `js/catalog_view.js`,
       `CoopCatalogKanbanRecord` (решение 408). -->
  <t t-name="coop_theme.CatalogKanbanRecord" t-inherit="web.KanbanRecord" t-inherit-mode="primary">
    <xpath expr="//t[@t-call='{{ this.constructor.menuTemplate }}']" position="before">
      <CoopFavoriteHeart t-if="coopFavorable" record="props.record" name="'id'"/>
    </xpath>
  </t>

  <t t-name="coop_theme.CatalogKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
    <xpath expr="//div[@t-ref='root']" position="attributes">
      <attribute name="t-attf-class">{{ className }} {{ hasSelectedRecords ? 'o_kanban_selection_active' : 'o_kanban_selection_available' }} o_coop_{{ coopLayout.mode }}</attribute>
    </xpath>

    <!--
      Страницы переключаются внизу, под плитками, как в макете. Наверху
      им не место: там человек ещё ничего не посмотрел, и переключать
      нечего.
    -->
    <xpath expr="//button[hasclass('o-kanban-button-new')]" position="replace">
      <button t-if="canCreate and props.showButtons" type="button"
              t-att-disabled="isNewButtonDisabled"
              class="btn btn-primary o-kanban-button-new" accesskey="c"
              t-on-click="() => this.createRecord()" data-bounce-button="">
        <t t-esc="coopCreateLabel"/>
      </button>
    </xpath>

    <!--
      Панель фильтров — своя, а не штатная: та берёт фиксированный список
      полей из разметки и умеет только ссылки и списки значений, без
      диапазона цены, свободного ввода города и набора полей, зависящего
      от раздела.
    -->
    <!--
      Условие штатное плюс своё. Своё в одиночку сюда ставить нельзя:
      `model.isReady` — это признак того, что данные уже загружены, и без
      него список рисуется по пустой модели.
    -->
    <!--
      Полки по рубрикам — над сеткой каталога и только на чистом экране:
      как только человек искал или отбирал, витрина по рубрикам мешает,
      он уже знает, что ищет.
    -->
    <!--
      Ключи у всех соседей списка обязательны, и это не украшение.

      Owl раздаёт соседям по блоку позиционные ключи. Стоит любому
      `t-if` в этом ряду переключиться — а их здесь четыре: полки,
      сам список, карта и пагинатор, — как ряд пересобирается целиком,
      и соседи создаются заново. Дальше начинается круг: полки при
      создании поднимают признак «грузятся», от него прячется список,
      от этого ряд пересобирается, полки создаются заново — и так
      дважды в секунду. Со стороны это выглядит как «ничего не
      грузится»: на экране пусто, а сервер получает по три сотни
      запросов в минуту. Измерено 21 сентября 2026 на боевой: раздел
      «Навыки», 343 запроса в минуту, страница пустая.

      Явный ключ закрепляет за каждым соседом своё место, и переключение
      чужого `t-if` его больше не трогает.
    -->
    <xpath expr="//t[@t-component='props.Renderer']" position="before">
      <CoopShelves t-if="coopShelvesVisible" t-key="'coop_shelves'"
                   resModel="props.resModel"
                   field="coopShelfField"
                   split="coopShelfSplit"
                   domain="props.domain or []"
                   orderBy="coopShelfOrder"
                   archInfo="props.archInfo"
                   fields="props.fields"
                   openRecord="(record) => this.openRecord(record)"
                   onLoaded="(count) => this.coopShelvesLoaded(count)"/>
    </xpath>

    <!--
      Лента под полками не показывается.

      Решение владельца 15 сентября 2026: «полки оставь, остальное убери,
      все предложения должны быть по полкам». Двух раскладок на одном
      экране не бывает без разнобоя: полка и лента считали ширину
      карточки по-разному, и в строку их вставало разное число. Спор
      решается не подбором чисел, а тем, что раскладка остаётся одна.

      Полки покрывают каталог целиком — за этим следит «Другое», куда
      попадает всё, что не вошло в остальные. В строчном виде и на карте
      лента остаётся: там полок нет.
    -->
    <xpath expr="//t[@t-component='props.Renderer']" position="attributes">
      <attribute name="t-if">model.isReady and coopLayout.mode !== 'map' and !coopShelvesFilled</attribute>
      <attribute name="t-key">'coop_renderer'</attribute>
    </xpath>

    <!--
      Одной вставкой, а не тремя: каждая следующая «after» встаёт вплотную
      к списку и отодвигает предыдущую, и порядок в разметке выходил
      обратный тому, что видно на экране.
    -->
    <xpath expr="//t[@t-component='props.Renderer']" position="after">
      <CoopMap t-if="coopLayout.mode === 'map'" t-key="'coop_map'"
               resModel="props.resModel" domain="model.root.domain"
               showTiles.bind="coopShowTiles"/>
      <CoopFilters t-key="'coop_filters'"
                   resModel="props.resModel" baseDomain="coopBaseDomain"/>
      <!-- Постраничная навигация вместе с лентой: листать нечего, когда
           весь каталог разложен по полкам. -->
      <div class="o_coop_pager" t-key="'coop_pager'"
           t-if="env.config.pagerProps and coopLayout.mode !== 'map' and !coopShelvesVisible">
        <Pager t-props="env.config.pagerProps"/>
      </div>
    </xpath>
  </t>

  <!--
    Переключатель видов. У каталога платформы кнопок три: плиткой,
    канбаном, списком. Первые две — одно представление в двух раскладках,
    третья — отдельное представление Odoo.

    Подменяется источник кнопок, а не добавляется вторая группа: два
    переключателя на экране заставляют гадать, чем они отличаются.
  -->
  <t t-name="coop_theme.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
    <!--
      Признак каталога ставится классом на саму панель: по нему строка
      поиска раскладывается во всю ширину, как в макете, и не борется за
      место с названием раздела и пагинатором.
    -->
    <xpath expr="//div[hasclass('o_control_panel')]" position="attributes">
      <attribute name="t-att-class">{ o_coop_catalog: coopIsCatalog, o_coop_lone_crumb: coopSingleCrumb }</attribute>
    </xpath>

    <!--
      Название раздела заменяется вкладками: оно дублирует активную
      вкладку, а места занимает столько же.
    -->
    <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]" position="inside">
      <CoopTabs t-if="coopHasTabs"/>
    </xpath>

    <!--
      Явный перенос строки. Без него поиск умещается рядом с вкладками и
      встаёт в первую строку: перенос во флексе считается по исходным
      ширинам, а не по тому, как элементы растянутся потом.
    -->
    <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="after">
      <div class="o_coop_row_break" t-if="coopIsCatalog"/>
    </xpath>

    <!--
      Кнопка отбора — в строке каталога, рядом с переключателем вида, как
      `.filter-sheet-btn` в макете. Показывается только на узком экране:
      на большом панель стоит колонкой справа и открывать её не нужно.
    -->
    <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="inside">
      <button type="button" class="o_coop_filters_toggle" t-if="coopHasFilters"
              aria-controls="coop_filters_body"
              t-att-aria-expanded="coopFilters.open ? 'true' : 'false'"
              t-on-click="() => this.coopToggleFilters()">
        Фильтр
      </button>
    </xpath>

    <!--
      Шестерёнка «Действия» на узком экране.

      Со страниц записей платформы штатное меню записи убрано ещё
      21 сентября 2026 (решение 349), но убрано оно было в шаблоне крошки
      (`breadcrumb.xml`, обе ветки `web.Breadcrumb.Actions`). На телефоне
      панель управления до крошки не доходит: у неё своя ветка
      (`t-elif="env.isSmall"`), и меню она рисует сама — прямо в
      `section.o_control_panel_breadcrumbs_actions`. Поэтому на большом
      экране шестерёнки не было, а на телефоне она стояла над карточкой;
      владелец 23 сентября 2026 прислал снимок своей страницы с ней.

      Условие то же, что у крошки, и считается тем же способом —
      `coopHideActions` в `control_panel.js`.

      Обе ветки, а не одна: вторая (`env.config.noBreadcrumbs`) рисует ту
      же секцию на экранах без пути, и оставить её значило бы вернуть
      шестерёнку там же через полгода.
    -->
    <xpath expr="(//section[hasclass('o_control_panel_breadcrumbs_actions')]/t[@t-slot='control-panel-additional-actions'])[1]"
           position="attributes">
      <attribute name="t-if">!coopHideActions</attribute>
    </xpath>

    <xpath expr="(//section[hasclass('o_control_panel_breadcrumbs_actions')]/t[@t-slot='control-panel-additional-actions'])[2]"
           position="attributes">
      <attribute name="t-if">!coopHideActions</attribute>
    </xpath>

    <!--
      Переключатель записей над единственной записью показывает «1 / 1»:
      переключать нечего, а полосу он держит.
    -->
    <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
      <attribute name="t-if">pagerProps and pagerProps.total > 1</attribute>
    </xpath>

    <xpath expr="//t[@t-if='env.config.viewSwitcherEntries?.length > 1']" position="attributes">
      <attribute name="t-if">coopViewEntries.length > 1</attribute>
    </xpath>
    <xpath expr="//Dropdown//t[@t-set='activeView']" position="attributes">
      <attribute name="t-value">coopViewEntries.find((view) => view.active)</attribute>
    </xpath>
    <xpath expr="//t[@t-set-slot='content']//t[@t-foreach='env.config.viewSwitcherEntries']" position="attributes">
      <attribute name="t-foreach">coopViewEntries</attribute>
    </xpath>
    <xpath expr="//nav[hasclass('o_cp_switch_buttons')]//t[@t-foreach='env.config.viewSwitcherEntries']" position="attributes">
      <attribute name="t-foreach">coopViewEntries</attribute>
    </xpath>
  </t>

  <!--
    Строка поиска каталога.

    Выпадающее меню «Фильтры / Группировать по / Избранное» вместе с
    кнопкой-стрелкой убрано: у каталога есть своя панель фильтров, и два
    разных набора условий на одном экране расходятся между собой — снял
    условие в одном, а второй продолжает его показывать.

    Подсказка своя: «Search...» ничего не говорит о том, что искать, а в
    каталоге ищут по названию.
  -->
  <t t-name="coop_theme.SearchBar" t-inherit="web.SearchBar" t-inherit-mode="extension">
    <xpath expr="//input[hasclass('o_searchview_input')]" position="attributes">
      <attribute name="t-att-placeholder">coopPlaceholder</attribute>
    </xpath>
    <xpath expr="//SearchBarMenu" position="attributes">
      <attribute name="t-if">!coopIsCatalog</attribute>
    </xpath>
  </t>

  <!--
    Кнопка создания в списке подписывается по разделу, как в плитке.
    Штатная называется одинаково во всех разделах — «Новое», — и по ней
    не видно, что заводится: вакансия, ресурс или закупка. Подпись
    берётся из того же `coop_create_label`, что и в плитке; там, где его
    в действии нет, остаётся прежнее слово.
  -->
  <t t-name="coop_theme.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o_list_button_add')]" position="replace">
      <button t-if="!editedRecord and activeActions.create and props.showButtons"
              type="button" class="btn btn-primary o_list_button_add"
              data-hotkey="c" t-on-click="onClickCreate" data-bounce-button="">
        <t t-esc="coopCreateLabel"/>
      </button>
    </xpath>
  </t>

  <!--
    То же для формы: кнопка создания там называется так же «Новое», и
    встречается она на каждом экране записи.
  -->
  <t t-name="coop_theme.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o_form_button_create')]" position="replace">
      <button t-if="canCreate" type="button"
              class="btn btn-outline-primary o_form_button_create"
              data-hotkey="c" t-on-click.stop="create">
        <t t-esc="coopCreateLabel"/>
      </button>
    </xpath>
  </t>

</templates>