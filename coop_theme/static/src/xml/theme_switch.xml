<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Переключатель темы — тумблер с солнцем и луной, как в прототипе.
    Иконки нарисованы здесь, а не подключены шрифтом значков: те же две
    фигуры уже нарисованы в прототипе, и брать их из чужого набора значит
    получить другую толщину линий рядом с остальной шапкой.
  -->
  <t t-name="coop_theme.ThemeSwitch">
    <button type="button" class="o_coop_theme_switch"
            t-att-class="{ o_coop_theme_dark: state.dark }"
            t-att-aria-pressed="state.dark ? 'true' : 'false'"
            aria-label="Тёмная тема" title="Светлая или тёмная тема"
            t-on-click="() => this.toggle()">
      <span class="o_coop_tt_sun">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>
        </svg>
      </span>
      <span class="o_coop_tt_moon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M20.4 14.8A8.8 8.8 0 019.2 3.6 8.8 8.8 0 1020.4 14.8z"/>
        </svg>
      </span>
      <span class="o_coop_tt_knob"/>
    </button>
  </t>

</templates>
