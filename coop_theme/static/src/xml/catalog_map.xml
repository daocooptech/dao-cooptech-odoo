<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Настоящая карта (OpenStreetMap) с метками по городам. Метки ставит
    сам компонент (`catalog_map.js`, Leaflet): число в кружке — сколько
    записей в городе с учётом текущего отбора; щелчок по метке отбирает
    город. Сообщения о загрузке и пустом отборе — поверх карты.
  -->
  <t t-name="coop_theme.CatalogMap">
    <div class="o_coop_mapboard">
      <div class="o_coop_map_frame">
        <div class="o_coop_map_canvas" t-ref="this.canvas"
             t-att-aria-busy="this.state.loading ? 'true' : 'false'"/>
        <div class="o_coop_map_empty" t-if="this.state.failed" role="alert">
          Не удалось посчитать метки. Попробуйте открыть карту ещё раз.
        </div>
        <!-- Пока считаем — так и написано. Карта без единой метки
             неотличима от «ничего не нашлось», и человек успевает менять
             отбор, который ещё не применился. -->
        <div class="o_coop_map_empty" t-elif="this.state.loading">
          Считаем метки…
        </div>
        <div class="o_coop_map_empty" t-elif="!this.state.shown">
          Нет объявлений с местом, подходящих под текущий отбор
        </div>
      </div>
      <p class="o_coop_map_note" t-if="this.byPoint">
        Каждое объявление стоит по своему адресу; число в кружке — сколько
        объявлений рядом, нажатие приближает. Нажмите на точку — откроется
        карточка объявления.
        <t t-if="this.state.other">
          Ещё <t t-out="this.state.other"/> без адреса — они видны плиткой и списком.
        </t>
      </p>
      <p class="o_coop_map_note" t-else="">
        Число в метке — сколько записей в городе с учётом текущего отбора;
        названия городов видны при приближении. Нажмите на метку: отберём
        этот город и покажем записи плиткой.
        <t t-if="this.state.other">
          Ещё <t t-out="this.state.other"/> без города или вне карты.
        </t>
      </p>
    </div>
  </t>

</templates>
