<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="coop_theme.FavoriteHeart">
    <span class="o_coop_fav" t-att-class="this.state.on ? 'o_coop_fav_on' : ''"
          role="button" tabindex="0"
          t-att-title="this.state.on ? 'Убрать из избранного' : 'Добавить в избранное'"
          t-att-aria-label="this.state.on ? 'Убрать из избранного' : 'Добавить в избранное'"
          t-att-aria-pressed="this.state.on ? 'true' : 'false'"
          t-on-click="this.toggle">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 7v14l-6 -4l-6 4v-14a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4z"/>
      </svg>
    </span>
  </t>

</templates>
