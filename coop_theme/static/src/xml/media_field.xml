<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Фото и видео записи (`coop_media`): одно превью, под ним две
       ленты — фото и видео; «+» последней плиткой ленты. Нет ни фото,
       ни видео — заглушка в кадре. Метка вида записи стоит поверх кадра
       разметкой формы, не здесь. -->
  <t t-name="coop_theme.Media">
    <div class="coop-media coop-gallery_view" t-att-class="{ 'coop-media_busy': this.state.busy }"
         tabindex="0" aria-roledescription="карусель фото и видео"
         t-on-keydown="(ev) => this.onKeydown(ev)">
      <input type="file" class="d-none" accept="image/*" multiple="multiple"
             t-ref="this.photoInput" t-on-change="(ev) => this.onPhotoFiles(ev)"/>
      <input type="file" class="d-none" accept="video/*"
             t-ref="this.videoInput" t-on-change="(ev) => this.onVideoFile(ev)"/>

      <!-- Превью -->
      <div class="coop-gallery_frame" t-if="this.current"
           t-att-class="{ 'coop-media_frame': this.current.kind === 'video' }">
        <t t-if="this.current.kind === 'photo'">
          <img class="coop-gallery_photo" t-att-src="this.current.src" t-att-alt="this.current.alt"/>
        </t>
        <t t-elif="this.current.how === 'embed'">
          <iframe class="coop-media_player" t-att-src="this.current.src" t-key="this.current.id"
                  t-att-title="this.current.alt or 'Видео'" loading="lazy"
                  allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen="allowfullscreen"/>
        </t>
        <t t-else="">
          <video class="coop-media_player" t-att-src="this.current.src" t-key="this.current.id"
                 controls="controls" preload="metadata" playsinline="playsinline"/>
        </t>
        <t t-if="this.items.length > 1">
          <button type="button" class="coop-gallery_nav coop-gallery_prev"
                  aria-label="Назад" t-on-click="() => this.step(-1)">‹</button>
          <button type="button" class="coop-gallery_nav coop-gallery_next"
                  aria-label="Вперёд" t-on-click="() => this.step(1)">›</button>
          <span class="coop-gallery_count"><t t-esc="this.state.index + 1"/> / <t t-esc="this.items.length"/></span>
        </t>
      </div>
      <div class="coop-media_stub" t-else="">
        <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/>
          <path d="M21 16l-5-5-8 8"/>
        </svg>
        <span>Фото и видео пока нет</span>
        <div class="coop-media_stub_row" t-if="this.canAdd">
          <button type="button" class="coop-media_stub_add" t-att-disabled="this.state.busy"
                  t-on-click="() => this.pickPhoto()">+ Фото</button>
          <button type="button" class="coop-media_stub_add" t-att-disabled="this.state.busy"
                  t-on-click="() => this.openVideoForm()">+ Видео</button>
        </div>
      </div>

      <!-- Лента фото -->
      <div class="coop-gallery_thumbs" t-ref="this.photoStrip"
           t-if="this.current and (this.photos.length and (this.items.length > 1 or this.canAddPhoto) or (!this.photos.length and this.canAddPhoto))">
        <t t-foreach="this.photos" t-as="image" t-key="image.id">
          <button type="button" class="coop-gallery_thumb"
                  t-att-class="{ 'coop-gallery_thumb_on': this.isOn('photo', image_index) }"
                  t-att-aria-label="'Снимок ' + (image_index + 1)"
                  t-att-aria-current="this.isOn('photo', image_index) ? 'true' : 'false'"
                  t-on-click="() => this.select('photo', image_index)">
            <img t-att-src="image.thumb" alt="" loading="lazy"/>
          </button>
        </t>
        <button type="button" class="coop-gallery_thumb coop-media_add" t-if="this.canAddPhoto"
                aria-label="Добавить фото" title="Добавить фото"
                t-att-disabled="this.state.busy" t-on-click="() => this.pickPhoto()">
          +<small>фото</small>
        </button>
      </div>

      <!-- Лента видео -->
      <div class="coop-gallery_thumbs" t-ref="this.videoStrip"
           t-if="this.current and (this.videos.length or this.canAddVideo)">
        <t t-foreach="this.videos" t-as="clip" t-key="clip.id">
          <button type="button" class="coop-gallery_thumb coop-media_clip"
                  t-att-class="{ 'coop-gallery_thumb_on': this.isOn('video', clip_index) }"
                  t-att-aria-label="'Видео ' + (clip_index + 1)"
                  t-att-aria-current="this.isOn('video', clip_index) ? 'true' : 'false'"
                  t-on-click="() => this.select('video', clip_index)">
            <span aria-hidden="true">▶</span><t t-esc="clip_index + 1"/>
          </button>
        </t>
        <button type="button" class="coop-gallery_thumb coop-media_add" t-if="this.canAddVideo"
                aria-label="Добавить видео" title="Добавить видео"
                t-att-disabled="this.state.busy" t-on-click="() => this.openVideoForm()">
          +<small>видео</small>
        </button>
      </div>

      <div class="coop-media_form" t-if="this.state.videoForm">
        <input type="url" class="o_input" placeholder="Ссылка: YouTube, VK, Rutube или .mp4"
               t-att-value="this.state.url" t-on-input="(ev) => this.state.url = ev.target.value"
               t-on-keydown="(ev) => this.onUrlKeydown(ev)"/>
        <div class="coop-media_form_row">
          <button type="button" class="btn btn-primary btn-sm" t-att-disabled="this.state.busy or !this.state.url.trim()"
                  t-on-click="() => this.addVideoUrl()">Добавить</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="this.state.busy"
                  t-on-click="() => this.pickVideoFile()">Загрузить файл</button>
          <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.closeVideoForm()">Отмена</button>
        </div>
        <span class="coop-media_hint">Файл — до <t t-esc="this.data.video_mb or 50"/> МБ; большое видео дайте ссылкой.</span>
      </div>
    </div>
  </t>

</templates>
