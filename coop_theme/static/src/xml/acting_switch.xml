<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Список того, от чьего имени можно действовать, внутри меню под
    аватаром. Показывается, только когда выбирать есть из чего: человек,
    ни в одной организации не состоящий, всегда действует от себя, и
    список из одной строки ему ничего не сообщает.
  -->
  <t t-name="coop_theme.ActingMenu">
    <t t-if="state.actors.length > 1">
      <div class="o_coop_acting_menu">
        <div class="o_coop_acting_title">Действую от имени</div>
        <button t-foreach="state.actors" t-as="actor" t-key="actor.id"
                type="button" class="o_coop_acting_item"
                t-att-class="{ o_coop_acting_on: actor.id === state.acting }"
                t-on-click="() => this.select(actor)">
          <img class="o_coop_acting_pic" t-att-src="avatar(actor)"
               t-att-alt="actor.name" loading="lazy"/>
          <span class="o_coop_acting_name" t-esc="actor.name"/>
          <span class="o_coop_acting_mark" t-if="actor.id === state.acting">✓</span>
        </button>
      </div>
      <div role="separator" class="dropdown-divider"/>
    </t>
  </t>

</templates>
