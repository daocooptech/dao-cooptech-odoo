<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Строка карточки, которая правится по месту. Карандаш показывается
    только своему (условие в самом поле представления), при правке
    подменяется галочкой и крестиком.
  -->
  <t t-name="coop_theme.InlineField">
    <span class="o_coop_inline" t-att-class="{ 'o_coop_inline_editing': ui.editing }">
      <t t-if="ui.editing">
        <input class="o_input o_coop_inline_input" t-ref="input"
               t-att-type="inputType"
               t-att-value="ui.draft"
               t-att-maxlength="maxlength"
               t-att-placeholder="props.placeholder"
               t-on-input="onInput"
               t-on-keydown="onKeydown"/>
        <button type="button" class="o_coop_inline_btn o_coop_inline_ok"
                t-att-disabled="ui.busy"
                title="Опубликовать" aria-label="Опубликовать"
                t-on-click="() => this.accept()">
          <i class="fa fa-check" role="img" aria-hidden="true"/>
        </button>
        <button type="button" class="o_coop_inline_btn o_coop_inline_cancel"
                t-att-disabled="ui.busy"
                title="Отменить" aria-label="Отменить"
                t-on-click="() => this.cancel()">
          <i class="fa fa-times" role="img" aria-hidden="true"/>
        </button>
      </t>
      <t t-else="">
        <span class="o_coop_inline_value" t-if="display" t-esc="display"/>
        <span class="o_coop_inline_empty" t-else="" t-esc="props.placeholder or '—'"/>
        <button type="button" class="o_coop_inline_btn o_coop_inline_start"
                t-if="canEdit"
                title="Изменить" aria-label="Изменить"
                t-on-click="() => this.start()">
          <i class="fa fa-pencil" role="img" aria-hidden="true"/>
        </button>
      </t>
    </span>
  </t>

</templates>
