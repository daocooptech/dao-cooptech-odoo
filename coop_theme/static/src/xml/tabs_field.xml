<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Вкладки страницы из поля выбора — `js/tabs_field.js`. -->
  <t t-name="coop_theme.TabsField">
    <div class="o_coop_tabs o_coop_tabs_page" role="tablist">
      <button t-foreach="this.items" t-as="item" t-key="item.value"
              type="button" role="tab" class="o_coop_tab"
              t-att-class="{ 'active': item.value === this.current }"
              t-att-aria-selected="item.value === this.current ? 'true' : 'false'"
              t-on-click="() => this.select(item.value)"
              t-out="item.label"/>
    </div>
  </t>

</templates>
