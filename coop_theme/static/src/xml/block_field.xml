<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Описание карточки: в чтении — абзацы, в правке — поле на несколько
    строк с галочкой и крестиком. Карандаш стоит над текстом справа, а не
    в шапке полосы: полоса может быть не своя (её рисует представление), а
    кнопка относится к самому полю.
  -->
  <t t-name="coop_theme.BlockField">
    <div class="o_coop_block" t-att-class="{ 'o_coop_block_editing': this.ui.editing }">
      <t t-if="this.ui.editing">
        <textarea class="o_input o_coop_block_input" t-ref="this.input"
                  t-att-rows="this.props.rows or 6"
                  t-att-placeholder="this.props.placeholder"
                  t-on-input="this.onInput"
                  t-on-keydown="this.onKeydown"><t t-out="this.ui.draft"/></textarea>
        <div class="o_coop_block_actions">
          <button type="button" class="o_coop_block_btn o_coop_block_ok"
                  t-att-disabled="this.ui.busy"
                  title="Опубликовать" aria-label="Опубликовать"
                  t-on-click="() => this.accept()">
            <i class="oi" data-icon="check" role="img" aria-hidden="true"/>
          </button>
          <button type="button" class="o_coop_block_btn o_coop_block_cancel"
                  t-att-disabled="this.ui.busy"
                  title="Отменить" aria-label="Отменить"
                  t-on-click="() => this.cancel()">
            <i class="oi" data-icon="close" role="img" aria-hidden="true"/>
          </button>
        </div>
      </t>
      <t t-else="">
        <div class="o_coop_block_text" t-if="this.paragraphs.length">
          <!--
            Имя переменной цикла — латиницей, и это не вкусовщина.
            Owl сам дописывает к нему `_index` и разбирает получившееся
            своим разборщиком выражений, а тот кириллицу в именах не
            принимает: `абзац_index` роняет разбор шаблона целиком. Не
            блок описания, не страницу — весь экран, с «Упс! Что-то
            пошло не так». Блок стоит на страницах доброго десятка
            разделов, и все они падали.
          -->
          <p t-foreach="this.paragraphs" t-as="para" t-key="para_index"
             t-out="para"/>
        </div>
        <!--
          Пустое описание зовёт заполнить только своего: на чужой
          странице это просто карточка без описания.
        -->
        <div class="o_coop_block_empty" t-elif="this.canEdit"
             t-out="this.props.placeholder or 'Описания пока нет'"/>
        <button type="button" class="o_coop_block_btn o_coop_block_start"
                t-if="this.canEdit"
                title="Изменить" aria-label="Изменить"
                t-on-click="() => this.start()">
          <i class="oi oi-filled" data-icon="edit" role="img" aria-hidden="true"/>
        </button>
      </t>
    </div>
  </t>

</templates>
