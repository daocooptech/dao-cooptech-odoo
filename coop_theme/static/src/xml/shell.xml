<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Оболочка платформы: слева постоянное меню разделов, снизу подвал.
    В Odoo разделы живут в списке приложений, и чтобы перейти в соседний
    каталог, надо этот список открыть. В прототипе они всегда на виду —
    платформа устроена как одно пространство, а не набор приложений.
  -->
  <t t-name="coop_theme.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
    <xpath expr="//ActionContainer" position="replace">
      <div class="o_coop_layout">
        <CoopSidebar t-if="!this.state.fullscreen"/>
        <CoopSubnav t-if="!this.state.fullscreen"/>
        <div class="o_coop_main">
          <CoopLoader t-if="this.coopBoot.loading"/>
          <ActionContainer/>
          <CoopFooter t-if="!this.state.fullscreen"/>
        </div>
      </div>
    </xpath>
  </t>

  <!--
    Заставка первой загрузки.

    Растягивается на всю свободную высоту — от этого подвал оказывается
    внизу экрана, а не подпирает шапку, как было на пустой области.

    Дуга крутится, знак платформы дышит. Текст под ними сказан словами
    платформы: «собираем страницу», а не «loading».
  -->
  <t t-name="coop_theme.Loader">
    <div class="o_coop_loader" role="status" aria-live="polite">
      <div class="o_coop_loader_art">
        <svg class="o_coop_loader_ring" viewBox="0 0 64 64" aria-hidden="true">
          <circle class="o_coop_loader_track" cx="32" cy="32" r="28"/>
          <circle class="o_coop_loader_arc" cx="32" cy="32" r="28"/>
        </svg>
        <img class="o_coop_loader_mark"
             src="/coop_theme/static/src/img/cooptech-logo.png"
             alt=""/>
      </div>
      <p class="o_coop_loader_text">Собираем страницу…</p>
    </div>
  </t>

  <!--
    Один корневой узел, а не три подряд: у шаблона с несколькими корнями
    перерисовка не доходила до разметки — подсветка раздела застревала на
    предыдущем, а панель не выдвигалась. Обёртка раскладку не меняет, она
    `display: contents`.
  -->
  <t t-name="coop_theme.Sidebar">
    <div class="o_coop_sidebar_wrap">
      <div class="o_coop_scrim" t-if="this.ui.open" t-on-click="() => this.toggle()"/>
      <!--
        Планка разделов — дизайн-система, решение 459 (`Rail`): тёмная
        полоса значков; развёрнутая — значок и название. Сворачивает её
        кнопка слева в шапке, выбор хранится за участником. На узком
        экране она же выезжает панелью по той же кнопке (`ui.open`).
      -->
      <aside class="o_coop_sidebar o_coop_rail"
             t-att-class="{ 'o_coop_sidebar_open': this.ui.open, 'o_coop_rail_wide': this.ui.railWide }"
             t-on-mouseleave="() => this.hideFly()"
             t-on-scroll="() => this.hideFly()"
             t-on-keydown="(ev) => this.onRailKey(ev)">
      <nav class="o_coop_rail_main" aria-label="Разделы платформы">
        <a t-foreach="this.state.main" t-as="item" t-key="item.label"
           href="#" class="o_coop_nav_item"
           t-att-class="{ 'active': this.isActive(item) }"
           t-att-aria-label="item.label"
           t-att-aria-current="this.isActive(item) ? 'page' : undefined"
           t-on-mouseenter="(ev) => this.showFly(item, ev)"
           t-on-focus="(ev) => this.showFly(item, ev)"
           t-on-click.prevent="() => this.open(item)">
          <CoopIcon name="item.icon" size="18"/>
          <span class="o_coop_nav_label" t-out="item.label"/>
        </a>
      </nav>

      <div class="o_coop_rail_sep" aria-hidden="true"/>
      <!-- Рубрика расширений — у развёрнутой планки; у свёрнутой её место
           занимает черта, а «+» стоит под расширениями. -->
      <div class="o_coop_ext_title">
        Расширения
        <button type="button" class="o_coop_ext_add" title="Добавить расширение"
                aria-label="Добавить расширение"
                t-on-click="() => this.openCatalog()">
          <CoopIcon name="'plus'" size="14"/>
        </button>
      </div>
      <!--
        Прокручиваются только расширения (дизайн-система, `Rail`): разделы
        и «Настроить меню» остаются на месте. Полосы нет — у края, за
        которым есть ещё пункты, планка затухает, а по наведению там
        появляется стрелка.
      -->
      <div class="o_coop_rail_scrollbox"
           t-att-class="{ 'o_coop_rail_more_up': this.state.moreUp, 'o_coop_rail_more_down': this.state.moreDown }">
      <button type="button" class="o_coop_rail_arrow o_coop_rail_arrow_up"
              tabindex="-1" aria-hidden="true" t-if="this.state.moreUp"
              t-on-mouseenter="() => this.hideFly()"
              t-on-click="() => this.scrollExt(-1)">
        <CoopIcon name="'chevron-up'" size="14"/>
      </button>
      <div class="o_coop_rail_scroll" t-ref="this.extScroll"
           t-on-scroll="() => this.onExtScroll()">
      <nav class="o_coop_rail_ext" aria-label="Расширения">
        <!-- Раздел без действия ещё не перенесён на движок. Пункт
             оставлен намеренно, но выглядеть он должен иначе: без
             пометки меню читается как наполовину сломанное, а не как
             наполовину готовое. -->
        <a t-foreach="this.state.extensions" t-as="item" t-key="item.label"
           href="#" class="o_coop_nav_item"
           t-att-class="{ 'active': this.isActive(item), 'o_coop_nav_soon': !item.actionId }"
           t-att-title="item.actionId ? undefined : (item.pending ? 'Модуль устанавливается на платформу' : 'Раздел ещё не перенесён на движок')"
           t-att-aria-label="item.label"
           t-att-aria-current="this.isActive(item) ? 'page' : undefined"
           t-on-mouseenter="(ev) => this.showFly(item, ev)"
           t-on-focus="(ev) => this.showFly(item, ev)"
           t-on-click.prevent="() => this.open(item)">
          <CoopIcon name="item.icon" size="18"/>
          <span class="o_coop_nav_label" t-out="item.label"/>
          <!-- «устанавливается» — подключено из каталога, модуль ставит
               рабочая группа (решение 463). -->
          <span class="o_coop_soon_mark" t-if="!item.actionId"
                t-out="item.pending ? 'устанавливается' : 'скоро'"/>
        </a>
      </nav>
      </div>
      <button type="button" class="o_coop_rail_arrow o_coop_rail_arrow_down"
              tabindex="-1" aria-hidden="true" t-if="this.state.moreDown"
              t-on-mouseenter="() => this.hideFly()"
              t-on-click="() => this.scrollExt(1)">
        <CoopIcon name="'chevron-down'" size="14"/>
      </button>
      </div>
      <button type="button" class="o_coop_rail_add" title="Добавить расширение"
              aria-label="Добавить расширение"
              t-on-mouseenter="() => this.hideFly()"
              t-on-click="() => this.openCatalog()">
        <CoopIcon name="'plus'" size="16"/>
      </button>

      <div class="o_coop_rail_gap"/>
      <!-- Порядок пунктов у каждого свой: кто-то живёт в ресурсах, кто-то
           в сделках. Разделы платформы при этом убрать нельзя — по ним
           люди договариваются, где что лежит. -->
        <button type="button" class="o_coop_nav_settings"
                t-att-title="this.ui.railWide ? undefined : 'Настроить меню'"
                t-on-mouseenter="() => this.hideFly()"
                t-on-click="() => this.openSettings()">
          <CoopIcon name="'adjustments-horizontal'" size="18"/>
          <span class="o_coop_nav_label">Настроить меню</span>
        </button>
        <!-- Только на телефоне (shell.scss): на большом экране выход — в
             меню учётной записи в шапке. -->
        <button type="button" class="o_coop_nav_settings o_coop_nav_logout"
                t-on-click="() => this.logout()">
          <CoopIcon name="'logout'" size="18"/>
          <span class="o_coop_nav_label">Выйти</span>
        </button>
        <!--
          Выезд у свёрнутой планки (дизайн-система, `Rail`, `flyout`):
          имя раздела и его подразделы рядом со значком. Внутри планки, а
          не отдельно: курсор, перешедший на плашку, планку не покидает, и
          плашка не гаснет на полпути. Положение — от значка, `fixed`.
        -->
        <div t-if="this.state.fly" class="o_coop_rail_fly"
             t-att-style="'top: ' + this.state.fly.top + 'px; left: ' + this.state.fly.left + 'px'">
          <div class="o_coop_rail_flybox"
               t-att-role="this.state.fly.children.length ? 'menu' : 'tooltip'">
            <div class="o_coop_rail_flytitle">
              <t t-out="this.state.fly.label"/>
              <span class="o_coop_rail_flysoon" t-if="this.state.fly.soon"
                    t-out="this.state.fly.pending ? 'устанавливается' : 'скоро'"/>
            </div>
            <a t-foreach="this.state.fly.children" t-as="sub" t-key="sub.id"
               href="#" role="menuitem" class="o_coop_subnav_item"
               t-att-class="{ 'active': sub.id === this.state.fly.current }"
               t-att-aria-current="sub.id === this.state.fly.current ? 'page' : undefined"
               t-on-click.prevent="() => this.openSub(sub)">
              <CoopIcon name="this.subIcon(sub.name)" size="18"/>
              <span class="o_coop_subnav_label" t-out="sub.name"/>
            </a>
          </div>
        </div>
      </aside>

      <!--
        Нижняя панель разделов на телефоне — пять пунктов, как в макете.
        Место под неё внизу страницы отведено давно (`.o_coop_main`,
        нижнее поле 84 точки): до сих пор там была пустота, через которую
        просвечивал подвал.

        Переход и подсветка — те же, что в боковом меню: один обработчик,
        одно правило активности.
      -->
      <nav class="o_coop_tabbar" aria-label="Быстрые разделы">
        <a t-foreach="this.tabbar" t-as="item" t-key="item.label"
           href="#" class="o_coop_tabbar_item"
           t-att-class="{ 'active': this.isActive(item) }"
           t-att-aria-current="this.isActive(item) ? 'page' : undefined"
           t-on-click.prevent="() => this.open(item)">
          <CoopIcon name="item.icon" size="20"/>
          <span t-out="item.label"/>
        </a>
      </nav>
    </div>
  </t>

  <!--
    Вкладки раздела. Стоят в строке панели над поиском, как `entity-tabs`
    в макете, а не в верхней панели рядом с названием приложения: та
    панель на большом экране убрана целиком.
  -->
  <!--
    Лого и название платформы в шапке слева, как в макете. Место
    освободилось от списка приложений: разделы платформы живут в боковом
    меню.

    Лого — ссылка на свою страницу: в макете знак платформы ведёт туда
    же, и это привычный жест — щёлкнуть по знаку, чтобы вернуться к себе.
  -->
  <t t-name="coop_theme.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_navbar_breadcrumbs')]" position="before">
      <!-- Слева в шапке: на большом экране сворачивает и разворачивает
           планку разделов (дизайн-система, `TopMenu`), на узком — выдвигает
           меню разделов. -->
      <button type="button" class="o_coop_burger"
              t-att-aria-label="this.coopBurgerLabel"
              t-att-title="this.coopBurgerLabel"
              t-att-aria-expanded="(this.coopShell.open || this.coopShell.railWide) ? 'true' : 'false'"
              t-on-click="() => this.coopToggleSidebar()">
        <CoopIcon name="this.coopShell.railWide ? 'layout-sidebar-left-collapse' : 'layout-sidebar-left-expand'" size="18"/>
      </button>
      <a class="o_coop_logo" href="/odoo/my-page" title="На свою страницу">
        <img src="/coop_theme/static/src/img/cooptech-logo.png"
             alt="ДАО КООПТЕХ" width="100" height="32"/>
      </a>
      <span class="o_coop_platform_name">
        Децентрализованная социально-экономическая платформа
      </span>
    </xpath>
  </t>

  <t t-name="coop_theme.Tabs">
    <!--
      Имя выборки вместо вкладок: человек смотрит свой список, а не
      раздел, и подразделы раздела здесь только сбивают.
    -->
    <div class="o_coop_tabs_wrap">
    <!--
      Заголовок экрана (дизайн-система, `PageHeader`) — на большом экране,
      где подразделы ушли в меню слева (shell.scss). На узком остаются
      вкладки.
    -->
    <div class="o_coop_pagehead" t-if="this.pageTitle">
      <div class="o_coop_pagehead_crumbs" t-if="this.pageSection" t-out="this.pageSection"/>
      <h1 class="o_coop_pagehead_title" t-out="this.pageTitle"/>
    </div>
    <div class="o_coop_tabs" t-if="this.state.label">
      <span class="o_coop_tab o_coop_tab_label" t-out="this.state.label"/>
    </div>
    <div class="o_coop_tabs" t-elif="this.state.tabs.length">
      <a t-foreach="this.state.tabs" t-as="tab" t-key="tab.id"
         href="#" class="o_coop_tab"
         t-att-class="{ 'active': tab.id === this.state.current }"
         t-on-click.prevent="() => this.open(tab)">
        <t t-out="tab.name"/>
      </a>
      <!-- «Избранное N» — как в макете, решение 408 (`js/shell.js`). -->
      <a t-if="this.state.fav" href="#" class="o_coop_tab o_coop_tab_fav"
         t-att-class="{ 'active': this.state.fav.on }"
         t-on-click.prevent="() => this.openFav()">
        Избранное <span class="o_coop_tab_count" t-out="this.state.fav.count"/>
      </a>
    </div>
    </div>
  </t>

  <!-- Меню подразделов (дизайн-система, `Sidebar`, решение 459). -->
  <t t-name="coop_theme.Subnav">
    <aside class="o_coop_subnav" t-if="this.visible"
           t-att-class="{ 'o_coop_subnav_collapsed': this.ui.subCollapsed }"
           aria-label="Подразделы">
      <div class="o_coop_subnav_head">
        <span class="o_coop_subnav_title" t-out="this.state.title"/>
        <button type="button" class="o_coop_subnav_toggle"
                t-att-title="this.ui.subCollapsed ? 'Развернуть подразделы' : 'Свернуть подразделы'"
                t-att-aria-label="this.ui.subCollapsed ? 'Развернуть подразделы' : 'Свернуть подразделы'"
                t-att-aria-expanded="this.ui.subCollapsed ? 'false' : 'true'"
                t-on-click="() => this.toggleCollapsed()">
          <CoopIcon name="this.ui.subCollapsed ? 'chevrons-right' : 'chevrons-left'" size="16"/>
        </button>
      </div>
      <nav>
        <a t-foreach="this.state.tabs" t-as="tab" t-key="tab.id"
           href="#" class="o_coop_subnav_item"
           t-att-class="{ 'active': tab.id === this.state.current }"
           t-att-title="this.ui.subCollapsed ? tab.name : undefined"
           t-att-aria-current="tab.id === this.state.current ? 'page' : undefined"
           t-on-click.prevent="() => this.open(tab)">
          <CoopIcon name="this.icon(tab.name)" size="18"/>
          <span class="o_coop_subnav_label" t-out="tab.name"/>
        </a>
        <a t-if="this.state.fav" href="#" class="o_coop_subnav_item"
           t-att-class="{ 'active': this.state.fav.on }"
           t-att-title="this.ui.subCollapsed ? 'Избранное' : undefined"
           t-on-click.prevent="() => this.openFav()">
          <CoopIcon name="'bookmark'" size="18"/>
          <span class="o_coop_subnav_label">Избранное</span>
          <span class="o_coop_subnav_count" t-out="this.state.fav.count"/>
        </a>
      </nav>
    </aside>
  </t>

  <t t-name="coop_theme.Footer">
    <div class="o_coop_footer">
      <a href="/help-project">помощь проекту</a>
      <a href="/">о платформе</a>
      <a href="#">правила</a>
      <a href="https://github.com/daocooptech/dao-cooptech-odoo" target="_blank" rel="noopener">разработчикам</a>
    </div>
  </t>

  <t t-name="coop_theme.Soon">
    <div class="o_coop_soon" t-att-class="this.props.className">
      <div class="o_coop_soon_box">
        <h2 t-out="this.label"/>
        <t t-if="this.pending">
        <p>
          Расширение подключено и устанавливается на платформу: рабочая
          группа проверяет код модуля и ставит его. Пункт откроется сам, как
          только установка закончится, — нажимать «Подключить» ещё раз не нужно.
        </p>
        </t>
        <t t-else="">
        <p>
          Раздел ещё не перенесён на движок. Он есть в макете платформы и
          появится здесь по мере переноса — порядок разделов в меню задан
          заранее, чтобы было видно, чего ждать.
        </p>
        <p class="o_coop_soon_note">
          Пункт меню оставлен намеренно: меню без него выглядело бы полным,
          и понять, что раздела не хватает, было бы неоткуда.
        </p>
        </t>
      </div>
    </div>
  </t>

  <!--
    Значки «Сообщения» и «Дела» в шапке — контуры Tabler, как соседние
    «Уведомления» и «Избранное» (эталон `TopMenu`), а не шрифт движка.
    «Дела» вместо «Активностей» (владелец 12.10.2026): слово движка
    служебное, человеку оно ничего не говорит.
  -->
  <t t-name="coop_theme.MessagingMenuInDropdown" t-inherit="mail.MessagingMenuInDropdown" t-inherit-mode="extension">
    <xpath expr="//i[@data-icon='forum']" position="replace">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
           role="img" aria-label="Сообщения">
        <path d="M3 20l1.3 -3.9c-2.324 -3.437 -1.426 -7.872 2.1 -10.374c3.526 -2.501 8.59 -2.296 11.845 .48c3.255 2.777 3.695 7.266 1.029 10.501c-2.666 3.235 -7.615 4.215 -11.574 2.293l-4.7 1"/>
      </svg>
    </xpath>
  </t>

  <t t-name="coop_theme.ActivityMenu" t-inherit="mail.ActivityMenu" t-inherit-mode="extension">
    <xpath expr="//i[@data-icon='schedule']" position="replace">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
           role="img" aria-label="Дела">
        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/>
        <path d="M12 7v5l3 3"/>
      </svg>
    </xpath>
    <xpath expr="//div[hasclass('o-mail-ActivityMenu-empty')]/span" position="replace">
      <span>Поздравляем, вы завершили все свои дела.</span>
    </xpath>
  </t>

</templates>
