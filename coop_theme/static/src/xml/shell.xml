<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Оболочка платформы: слева постоянное меню разделов, снизу подвал.
    В Odoo разделы живут в списке приложений, и чтобы перейти в соседний
    каталог, надо этот список открыть. В прототипе они всегда на виду —
    платформа устроена как одно пространство, а не набор приложений.
  -->
  <t t-name="coop_theme.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
    <xpath expr="//ActionContainer" position="replace">
      <div class="o_coop_layout">
        <CoopSidebar t-if="!state.fullscreen"/>
        <div class="o_coop_main">
          <ActionContainer/>
          <CoopFooter t-if="!state.fullscreen"/>
        </div>
      </div>
    </xpath>
  </t>

  <!--
    Один корневой узел, а не три подряд: у шаблона с несколькими корнями
    перерисовка не доходила до разметки — подсветка раздела застревала на
    предыдущем, а панель не выдвигалась. Обёртка раскладку не меняет, она
    `display: contents`.
  -->
  <t t-name="coop_theme.Sidebar">
    <div class="o_coop_sidebar_wrap">
      <button type="button" class="o_coop_burger" aria-label="Меню разделов"
              t-att-aria-expanded="state.open ? 'true' : 'false'"
              t-on-click="() => this.toggle()">
        <i class="fa fa-bars" role="img" aria-hidden="true"/>
      </button>
      <div class="o_coop_scrim" t-if="state.open" t-on-click="() => this.toggle()"/>
      <aside class="o_coop_sidebar" t-att-class="{ 'o_coop_sidebar_open': state.open }">
        <!--
          «Добавить» первым пунктом, как в макете. Здесь оно уместнее,
          чем в каждом каталоге по отдельности: завести объявление или
          проект человек решает, находясь где угодно, и идти ради этого
          в нужный раздел — лишний шаг.
        -->
        <button type="button" class="o_coop_add_main"
                t-on-click="() => this.openAdd()">
          <span class="o_coop_add_main_icon">+</span> Добавить
        </button>
        <!-- Пока человек ни в одной организации не состоит, выбирать не из
             чего, и переключателя нет. -->
        <div class="o_coop_acting" t-if="state.actors.length > 1">
          <label for="coop_acting">Действую от имени</label>
          <select id="coop_acting" t-on-change="(ev) => this.setActing(ev.target.value)">
            <option t-foreach="state.actors" t-as="actor" t-key="actor.id"
                    t-att-value="actor.id" t-att-selected="actor.id === state.acting">
              <t t-esc="actor.name"/>
            </option>
          </select>
        </div>

      <nav aria-label="Разделы платформы">
        <a t-foreach="state.main" t-as="item" t-key="item.label"
           href="#" class="o_coop_nav_item"
           t-att-class="{ 'active': isActive(item) }"
           t-on-click.prevent="() => this.open(item)">
          <i class="fa fa-fw" t-att-class="item.icon" role="img" aria-hidden="true"/>
          <span t-esc="item.label"/>
        </a>
      </nav>

      <!-- Рубрика расширений набрана моноширинным, как в макете: она не
           пункт меню, а заголовок раздела меню, и читаться должна иначе. -->
      <div class="o_coop_ext_title">
        Расширения
        <button type="button" class="o_coop_ext_add" title="Добавить расширение"
                t-on-click="() => this.openCatalog()">+</button>
      </div>
      <nav aria-label="Расширения">
        <a t-foreach="state.extensions" t-as="item" t-key="item.label"
           href="#" class="o_coop_nav_item"
           t-att-class="{ 'active': isActive(item) }"
           t-on-click.prevent="() => this.open(item)">
          <span t-esc="item.label"/>
        </a>
      </nav>

      <!-- Порядок пунктов у каждого свой: кто-то живёт в ресурсах, кто-то
           в сделках. Разделы платформы при этом убрать нельзя — по ним
           люди договариваются, где что лежит. -->
        <button type="button" class="o_coop_nav_settings"
                t-on-click="() => this.openSettings()">Настроить меню</button>
      </aside>
    </div>
  </t>

  <!--
    Вкладки раздела. Стоят в строке панели над поиском, как `entity-tabs`
    в макете, а не в верхней панели рядом с названием приложения: та
    панель на большом экране убрана целиком.
  -->
  <!--
    Название платформы в шапке слева, как в макете. Место освободилось
    от списка приложений: разделы платформы живут в боковом меню.
  -->
  <t t-name="coop_theme.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_navbar_breadcrumbs')]" position="before">
      <span class="o_coop_platform_name">
        Децентрализованная социально-экономическая платформа
      </span>
    </xpath>
  </t>

  <t t-name="coop_theme.Tabs">
    <div class="o_coop_tabs" t-if="state.tabs.length">
      <a t-foreach="state.tabs" t-as="tab" t-key="tab.id"
         href="#" class="o_coop_tab"
         t-att-class="{ 'active': tab.id === state.current }"
         t-on-click.prevent="() => this.open(tab)">
        <t t-esc="tab.name"/>
      </a>
    </div>
  </t>

  <t t-name="coop_theme.Footer">
    <div class="o_coop_footer">
      <a href="/help-project">помощь проекту</a>
      <a href="/">о платформе</a>
      <a href="#">правила</a>
      <a href="https://github.com/daocooptech/dao-cooptech-odoo" target="_blank" rel="noopener">разработчикам</a>
    </div>
  </t>

  <t t-name="coop_theme.Soon">
    <div class="o_coop_soon">
      <div class="o_coop_soon_box">
        <h2 t-esc="label"/>
        <p>
          Раздел ещё не перенесён на движок. Он есть в макете платформы и
          появится здесь по мере переноса — порядок разделов в меню задан
          заранее, чтобы было видно, чего ждать.
        </p>
        <p class="o_coop_soon_note">
          Пункт меню оставлен намеренно: меню без него выглядело бы полным,
          и понять, что раздела не хватает, было бы неоткуда.
        </p>
      </div>
    </div>
  </t>

</templates>
