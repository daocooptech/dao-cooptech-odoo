<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Меню — вещь личная. Читать и править чужое незачем даже
    администратору: полезного там нет, а возможность переставить кому-то
    пункты местами — источник недоумения, а не польза.
  -->
  <record id="coop_sidebar_item_own" model="ir.rule">
    <field name="name">Своё боковое меню</field>
    <field name="model_id" ref="model_coop_sidebar_item"/>
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

</odoo>
