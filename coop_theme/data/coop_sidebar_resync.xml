<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Меню участника собирается один раз и дальше живёт записями — чтобы
    человек мог переставить разделы под себя. Обратная сторона: новый
    обязательный раздел в уже собранное меню сам не попадает, и его
    видят только те, кто завёлся позже.

    Поэтому при каждом обновлении темы набор доводится до нынешнего:
    недостающие разделы добавляются, номера выравниваются по порядку в
    коде. Иначе раздел, вставленный в середину списка, получает уже
    занятый номер и уезжает вниз — при равных номерах порядок решает
    идентификатор.
  -->
  <function model="coop.sidebar.item" name="resync_defaults"/>

  <!--
    Отдельным проходом: пересборка выше строит список по умолчаниям, а
    те при обновлении темы могут не увидеть раздел, который появляется
    по участию, — модуль проектов на этот момент ещё не загружен.
    Раздел у участника при этом есть, и перевести его на нынешнее
    действие надо.
  -->
  <function model="coop.sidebar.item" name="repoint_obligatory"/>
</odoo>
