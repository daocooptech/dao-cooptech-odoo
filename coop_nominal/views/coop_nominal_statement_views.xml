<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Строка выписки -->
  <record id="view_coop_nominal_statement_line_list" model="ir.ui.view">
    <field name="name">coop.nominal.statement.line.list</field>
    <field name="model">coop.nominal.statement.line</field>
    <field name="arch" type="xml">
      <list string="Строки выписок" decoration-warning="state == 'unrecognized'">
        <field name="date"/>
        <field name="number"/>
        <field name="direction"/>
        <field name="amount" sum="Итого"/>
        <field name="partner_name"/>
        <field name="partner_inn" optional="show"/>
        <field name="purpose"/>
        <field name="state" widget="badge"
               decoration-success="state == 'matched'"
               decoration-warning="state == 'unrecognized'"/>
        <field name="match_rule" optional="show"/>
        <field name="hold_ids" widget="many2many_tags" optional="show"/>
        <field name="note" optional="show"/>
        <field name="resolution" optional="hide"/>
        <field name="statement_id" optional="hide"/>
        <field name="currency_id" column_invisible="True"/>
        <button name="action_resolve" type="object" string="Разобрать"
                class="btn-link" invisible="state != 'unrecognized'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_nominal_statement_line_form" model="ir.ui.view">
    <field name="name">coop.nominal.statement.line.form</field>
    <field name="model">coop.nominal.statement.line</field>
    <field name="arch" type="xml">
      <form string="Строка выписки" create="false" edit="false" delete="false">
        <header>
          <button name="action_resolve" type="object" string="Разобрать"
                  class="btn-primary" invisible="state != 'unrecognized'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="alert" invisible="state != 'unrecognized'">
            <field name="note" nolabel="1"/>
          </div>
          <group>
            <group string="Банк">
              <field name="statement_id"/>
              <field name="direction"/>
              <field name="date"/>
              <field name="number"/>
              <field name="amount"/>
              <field name="purpose"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group string="Контрагент">
              <field name="partner_name"/>
              <field name="partner_inn"/>
              <field name="partner_kpp"/>
              <field name="partner_account"/>
              <field name="partner_bic"/>
            </group>
            <group string="Разбор">
              <field name="match_rule" invisible="not match_rule"/>
              <field name="resolution" invisible="not resolution"/>
              <field name="resolved_by_id" invisible="not resolution"/>
              <field name="resolved_on" invisible="not resolution"/>
              <field name="hold_ids" widget="many2many_tags" invisible="not hold_ids"/>
              <field name="payout_id" invisible="not payout_id"/>
              <field name="counterpart_line_id" invisible="not counterpart_line_id"/>
            </group>
          </group>
          <notebook>
            <page string="Книга" name="entries">
              <field name="entry_ids" readonly="1"/>
            </page>
            <page string="Возврат" name="refund" invisible="not refund_payout_ids">
              <field name="refund_payout_ids" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Разбор нераспознанного -->
  <record id="view_coop_nominal_statement_resolve_form" model="ir.ui.view">
    <field name="name">coop.nominal.statement.resolve.form</field>
    <field name="model">coop.nominal.statement.resolve</field>
    <field name="arch" type="xml">
      <form string="Разобрать строку выписки">
        <group>
          <group>
            <field name="line_id"/>
            <field name="direction"/>
            <field name="amount"/>
          </group>
          <group>
            <field name="partner_name"/>
            <field name="purpose"/>
            <field name="account_id" invisible="1"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </group>
        <group>
          <field name="mode" widget="radio"/>
          <field name="hold_ids" widget="many2many_tags"
                 invisible="mode != 'holds'" required="mode == 'holds'"
                 domain="[('account_id', '=', account_id), ('state', '=', 'awaiting')]"/>
          <field name="payout_id"
                 invisible="mode != 'payout'" required="mode == 'payout'"
                 domain="[('account_id', '=', account_id), ('amount', '=', amount),
                          ('state', 'in', ['queued', 'bank_review', 'sent', 'unknown'])]"/>
          <field name="counterpart_line_id"
                 invisible="mode != 'offset'" required="mode == 'offset'"
                 domain="[('account_id', '=', account_id), ('state', '=', 'unrecognized'),
                          ('direction', '!=', direction), ('amount', '=', amount)]"/>
        </group>
        <p class="text-muted" invisible="mode != 'refund'">
          Возврат встанет в очередь выплат по реквизитам отправителя из строки. Строка
          закроется, когда списание появится в выписке.
        </p>
        <footer>
          <button name="action_apply" type="object" string="Разобрать" class="btn-primary"/>
          <button special="cancel" string="Отмена"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_nominal_statement_line_search" model="ir.ui.view">
    <field name="name">coop.nominal.statement.line.search</field>
    <field name="model">coop.nominal.statement.line</field>
    <field name="arch" type="xml">
      <search string="Строки выписок">
        <field name="purpose"/>
        <field name="partner_name"/>
        <field name="partner_inn"/>
        <field name="number"/>
        <filter name="unrecognized" string="Нераспознанное"
                domain="[('state', '=', 'unrecognized')]"/>
        <filter name="matched" string="Сопоставлено"
                domain="[('state', '=', 'matched')]"/>
        <separator/>
        <filter name="incoming" string="Поступления" domain="[('direction', '=', 'in')]"/>
        <filter name="outgoing" string="Списания" domain="[('direction', '=', 'out')]"/>
        <group>
          <filter name="by_statement" string="Выписка" context="{'group_by': 'statement_id'}"/>
          <filter name="by_rule" string="Как сопоставлено" context="{'group_by': 'match_rule'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Выписка -->
  <record id="view_coop_nominal_statement_list" model="ir.ui.view">
    <field name="name">coop.nominal.statement.list</field>
    <field name="model">coop.nominal.statement</field>
    <field name="arch" type="xml">
      <list string="Выписки" create="false" decoration-warning="unrecognized_count">
        <field name="name"/>
        <field name="account_id"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="balance_start"/>
        <field name="total_in"/>
        <field name="total_out"/>
        <field name="balance_end"/>
        <field name="unrecognized_count"/>
        <field name="uploaded_by_id" optional="show"/>
        <field name="create_date" string="Загружена" optional="hide"/>
        <field name="currency_id" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="view_coop_nominal_statement_form" model="ir.ui.view">
    <field name="name">coop.nominal.statement.form</field>
    <field name="model">coop.nominal.statement</field>
    <field name="arch" type="xml">
      <form string="Выписка" create="false" edit="false" delete="false">
        <sheet>
          <div class="alert alert-warning" role="alert" invisible="not opening_discrepancy">
            Начальный остаток выписки не сходится с книгой накануне: между выписками
            пропущен день или строка.
          </div>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group string="Файл">
              <field name="account_id"/>
              <field name="file_name"/>
              <field name="uploaded_by_id"/>
              <field name="create_date" string="Загружена"/>
              <field name="skipped_count"/>
              <field name="file_hash" groups="base.group_no_one"/>
            </group>
            <group string="Остатки">
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="balance_start"/>
              <field name="total_in"/>
              <field name="total_out"/>
              <field name="balance_end"/>
              <field name="opening_discrepancy"/>
              <field name="unrecognized_count"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <field name="line_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Загрузка выписки -->
  <record id="view_coop_nominal_statement_import_form" model="ir.ui.view">
    <field name="name">coop.nominal.statement.import.form</field>
    <field name="model">coop.nominal.statement.import</field>
    <field name="arch" type="xml">
      <form string="Загрузить выписку">
        <p class="text-muted">
          Файл обмена с клиент-банком (1CClientBankExchange). Поступления с кодом
          удержания в назначении платежа зачтутся сами; что не опознано — ляжет
          в «Нераспознанное» до разбора.
        </p>
        <group>
          <field name="account_id"/>
          <field name="file" filename="file_name"/>
          <field name="file_name" invisible="1"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Загрузить" class="btn-primary"/>
          <button special="cancel" string="Отмена"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Кнопка и вкладка на счёте -->
  <record id="view_coop_nominal_account_form_statement" model="ir.ui.view">
    <field name="name">coop.nominal.account.form.statement</field>
    <field name="model">coop.nominal.account</field>
    <field name="inherit_id" ref="view_coop_nominal_account_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header groups="base.group_system">
          <button name="action_import_statement" type="object"
                  string="Загрузить выписку" class="btn-primary"
                  groups="base.group_system"/>
        </header>
      </xpath>
      <xpath expr="//page[@name='holds']" position="after">
        <page string="Выписки" name="statements" groups="base.group_system">
          <field name="statement_ids" readonly="1"/>
        </page>
      </xpath>
    </field>
  </record>

  <record id="action_coop_nominal_statement" model="ir.actions.act_window">
    <field name="name">Выписки</field>
    <field name="res_model">coop.nominal.statement</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_coop_nominal_statement_line" model="ir.actions.act_window">
    <field name="name">Строки выписок</field>
    <field name="res_model">coop.nominal.statement.line</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_unrecognized': 1}</field>
  </record>

  <menuitem id="menu_coop_nominal_statement" name="Выписки"
            parent="menu_coop_nominal_root" action="action_coop_nominal_statement" sequence="25"/>
  <menuitem id="menu_coop_nominal_statement_line" name="Строки выписок"
            parent="menu_coop_nominal_root" action="action_coop_nominal_statement_line" sequence="26"/>

</odoo>
