<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="coop_tokenomics.Exchange">
    <div class="o_coop_dex">

      <!-- Шапка: кошелёк слева, потому что без него нельзя ни купить, ни
           продать, и узнать об этом лучше до выбора партии. -->
      <div class="o_coop_dex_top">
        <div class="o_coop_dex_wallet" t-if="state.wallet">
          <t t-if="state.wallet.connected">
            <span class="o_coop_dex_dot"/>
            <span class="o_coop_dex_addr" t-esc="state.wallet.address.slice(0, 6) + '…' + state.wallet.address.slice(-4)"/>
            <span class="o_coop_dex_net" t-esc="state.wallet.network === 'testnet' ? 'тестовая сеть' : 'основная сеть'"/>
          </t>
          <t t-else="">
            <button class="o_coop_dex_connect" t-on-click="openWallet">
              Подключить кошелёк TON
            </button>
          </t>
        </div>
        <div class="o_coop_dex_stats" t-if="state.wallet">
          <span>Позиций: <b t-esc="state.wallet.positions"/></span>
          <span>Своих выпусков: <b t-esc="state.wallet.my_claims"/></span>
          <span>Рынков: <b t-esc="rows.length"/></span>
        </div>
      </div>

      <!-- Категории — как вкладки «Тренд / Новые / Растущие» на биржах,
           переведённые на товар. Число рядом с подписью: без него
           непонятно, есть ли там что смотреть. -->
      <div class="o_coop_dex_cats">
        <button t-foreach="constructor.CATEGORIES" t-as="c" t-key="c.key"
                class="o_coop_dex_cat"
                t-att-class="{ 'o_coop_dex_caton': state.category === c.key }"
                t-on-click="() => this.setCategory(c.key)">
          <t t-esc="c.label"/>
          <span class="o_coop_dex_catn" t-if="counts[c.key] !== undefined" t-esc="counts[c.key]"/>
        </button>
      </div>

      <div class="o_coop_dex_body">

        <!-- ═══ Рынки ═══ -->
        <div class="o_coop_dex_markets">
          <div class="o_coop_dex_search">
            <input type="text" placeholder="Товар, поставщик, качество или город"
                   t-att-value="state.search" t-on-input="onSearch"/>
            <select t-on-change="setGrouping">
              <option t-foreach="constructor.GROUPINGS" t-as="g" t-key="g.key"
                      t-att-value="g.key" t-att-selected="state.grouping === g.key">
                <t t-esc="g.label"/>
              </option>
            </select>
          </div>

          <div class="o_coop_dex_mhead">
            <span class="o_coop_dex_sortable" t-on-click="() => this.sortBy('name')">
              Рынок<t t-esc="sortMark('name')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('price')">
              Цена<t t-esc="sortMark('price')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('change')">
              Изм.<t t-esc="sortMark('change')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('score')">
              Оценка<t t-esc="sortMark('score')"/>
            </span>
          </div>

          <div class="o_coop_dex_mlist">

            <!-- Без группировки: плоский список. -->
            <t t-if="state.grouping === 'none'">
              <t t-call="coop_tokenomics.MarketRows">
                <t t-set="rowset" t-value="sortedRows"/>
              </t>
            </t>

            <!-- С группировкой: заголовок группы с итогом и её строки.
                 Итог по группе — число рынков и оборот: без них
                 группировка превращается в оглавление, по которому не
                 видно, где что-то происходит. -->
            <t t-else="">
              <div t-foreach="groups" t-as="g" t-key="g.key" class="o_coop_dex_group">
                <div class="o_coop_dex_ghead" t-on-click="() => this.toggleGroup(g)">
                  <span class="o_coop_dex_gname">
                    <t t-esc="isGroupOpen(g) ? '▾' : '▸'"/> <t t-esc="g.label"/>
                  </span>
                  <span class="o_coop_dex_gmeta">
                    <t t-esc="g.count"/> рын. · оборот <t t-esc="qty(g.volume)"/>
                  </span>
                </div>
                <t t-if="isGroupOpen(g)">
                  <t t-call="coop_tokenomics.MarketRows">
                    <t t-set="rowset" t-value="groupRows(g)"/>
                  </t>
                </t>
              </div>
            </t>

            <div class="o_coop_dex_empty" t-if="!sortedRows.length and !state.loading">
              По этой категории и запросу рынков нет. Рынок — это партия
              товара: попробуйте искать по товару, хозяйству или городу.
            </div>
          </div>
        </div>

        <!-- ═══ Выбранный рынок ═══ -->
        <div class="o_coop_dex_pane" t-if="current">

          <div class="o_coop_dex_head">
            <div>
              <div class="o_coop_dex_title" t-esc="current.name"/>
              <div class="o_coop_dex_sub">
                <t t-esc="current.quality"/> · <t t-esc="current.place"/> ·
                поставка до <t t-esc="current.due"/> · <t t-esc="current.issuer"/>
              </div>
            </div>
            <div class="o_coop_dex_headright">
              <span class="o_coop_dex_chip" t-if="current.is_future">товара ещё нет</span>
              <span class="o_coop_dex_chip" t-if="current.deposit_paid">
                залог <t t-esc="money(current.deposit, current.currency)"/>
              </span>
              <button class="o_coop_dex_link" t-on-click="openClaim">карточка выпуска</button>
            </div>
          </div>

          <!-- Оценка выпуска с расшифровкой. Балл без объяснения — просьба
               поверить платформе на слово; участник должен видеть, из чего
               он сложился, и решать сам. -->
          <div class="o_coop_dex_score" t-if="currentRow">
            <div class="o_coop_dex_scoreline" t-on-click="toggleScore">
              <span class="o_coop_dex_scoreval" t-esc="currentRow.score"/>
              <span class="o_coop_dex_scoremax">из 40</span>
              <span class="o_coop_dex_scorename">надёжность выпуска</span>
              <span class="o_coop_dex_link" t-esc="state.showScore ? 'свернуть' : 'из чего сложилась'"/>
            </div>
            <div class="o_coop_dex_scoreparts" t-if="state.showScore">
              <div class="o_coop_dex_part">
                <span>Доверие поставщика</span>
                <b t-esc="currentRow.score_parts.trust"/>
                <span class="o_coop_dex_partnote">
                  уровень <t t-esc="currentRow.issuer_trust"/> по завершённым сделкам
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Залог</span>
                <b t-esc="currentRow.score_parts.deposit"/>
                <span class="o_coop_dex_partnote">
                  <t t-if="current.deposit_paid">внесён — при срыве уходит держателям</t>
                  <t t-else="">не внесён</t>
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Как исполняет</span>
                <b t-esc="currentRow.score_parts.record"/>
                <span class="o_coop_dex_partnote">
                  <t t-if="currentRow.first_issue">первый выпуск, истории ещё нет</t>
                  <t t-else="">
                    исполнено <t t-esc="currentRow.issuer_settled"/>,
                    сорвано <t t-esc="currentRow.issuer_broken"/>
                  </t>
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Живость торгов</span>
                <b t-esc="currentRow.score_parts.liveliness"/>
                <span class="o_coop_dex_partnote">
                  держателей <t t-esc="currentRow.holders"/>, сделок <t t-esc="currentRow.trades"/>
                </span>
              </div>
            </div>
          </div>

          <!-- Линия цены по сделкам. Свечей нет: по большинству выпусков
               сделок единицы, и свечной график рисовал бы движение,
               которого не было. -->
          <div class="o_coop_dex_chart" t-if="chartRange and chartRange.count &gt; 1">
            <div class="o_coop_dex_chartlabels">
              <span>Цена по сделкам</span>
              <span class="o_coop_dex_msub">
                от <t t-esc="money(chartRange.min, current.currency)"/>
                до <t t-esc="money(chartRange.max, current.currency)"/>
                · сделок <t t-esc="chartRange.count"/>
              </span>
            </div>
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="o_coop_dex_svg">
              <path t-att-d="chartPath" fill="none" stroke="currentColor"
                    stroke-width="1.4" vector-effect="non-scaling-stroke"/>
            </svg>
          </div>

          <div class="o_coop_dex_grid">

            <!-- Стакан: продают слева, покупают справа. Своё помечено —
                 чтобы не пытаться купить у самого себя. -->
            <div class="o_coop_dex_book">
              <div class="o_coop_dex_bookcol">
                <div class="o_coop_dex_bookhead">
                  <span>Продают</span>
                  <span class="o_coop_dex_num">Цена</span>
                  <span class="o_coop_dex_num">Объём</span>
                </div>
                <div t-foreach="state.book.asks" t-as="o" t-key="o.id"
                     class="o_coop_dex_row o_coop_ask"
                     t-att-class="{ 'o_coop_dex_picked': state.selectedOrder and state.selectedOrder.id === o.id }"
                     t-on-click="() => this.pick(o)">
                  <span class="o_coop_dex_depth o_coop_depth_ask"
                        t-attf-style="width: {{ depth(o, state.book.asks) }}"/>
                  <span class="o_coop_dex_who">
                    <t t-esc="o.partner"/>
                    <b t-if="o.mine"> — ваша</b>
                  </span>
                  <span class="o_coop_dex_num" t-esc="money(o.price, current.currency)"/>
                  <span class="o_coop_dex_num" t-esc="qty(o.quantity)"/>
                </div>
                <div class="o_coop_dex_empty" t-if="!state.book.asks.length">
                  Никто не продаёт. Можно оставить заявку на покупку —
                  держатель увидит её и решит сам.
                </div>
              </div>

              <div class="o_coop_dex_bookcol">
                <div class="o_coop_dex_bookhead">
                  <span>Покупают</span>
                  <span class="o_coop_dex_num">Цена</span>
                  <span class="o_coop_dex_num">Объём</span>
                </div>
                <div t-foreach="state.book.bids" t-as="o" t-key="o.id"
                     class="o_coop_dex_row o_coop_bid"
                     t-att-class="{ 'o_coop_dex_picked': state.selectedOrder and state.selectedOrder.id === o.id }"
                     t-on-click="() => this.pick(o)">
                  <span class="o_coop_dex_depth o_coop_depth_bid"
                        t-attf-style="width: {{ depth(o, state.book.bids) }}"/>
                  <span class="o_coop_dex_who">
                    <t t-esc="o.partner"/>
                    <b t-if="o.mine"> — ваша</b>
                  </span>
                  <span class="o_coop_dex_num" t-esc="money(o.price, current.currency)"/>
                  <span class="o_coop_dex_num" t-esc="qty(o.quantity)"/>
                </div>
                <div class="o_coop_dex_empty" t-if="!state.book.bids.length">
                  Заявок на покупку нет.
                </div>
              </div>
            </div>

            <!-- Форма сделки. Не «обменять по рынку», а «купить у
                 названного участника по его цене»: сведение здесь ручное,
                 и человек должен видеть, с кем имеет дело. -->
            <div class="o_coop_dex_form">
              <div class="o_coop_dex_formhead">Сделка</div>

              <div class="o_coop_dex_field">
                <label>Заявка</label>
                <div class="o_coop_dex_value" t-if="state.selectedOrder">
                  <t t-esc="state.selectedOrder.partner"/>,
                  <t t-esc="money(state.selectedOrder.price, current.currency)"/>
                  за <t t-esc="current.unit"/>
                </div>
                <div class="o_coop_dex_hint" t-else="">
                  Выберите строку в стакане — цена и объём подставятся сюда.
                </div>
              </div>

              <div class="o_coop_dex_field">
                <label>Сколько (<t t-esc="current.unit"/>)</label>
                <input type="number" min="0" step="0.001"
                       t-att-value="state.amount" t-on-input="onAmount"
                       t-att-disabled="!state.selectedOrder"/>
                <div class="o_coop_dex_hint" t-if="state.selectedOrder">
                  доступно <t t-esc="qty(state.selectedOrder.quantity)"/>
                </div>
              </div>

              <div class="o_coop_dex_total">
                <span>К оплате</span>
                <b t-esc="money(total, current.currency)"/>
              </div>

              <button class="o_coop_dex_go" t-att-disabled="!canTrade" t-on-click="trade">
                Купить
              </button>

              <div class="o_coop_dex_note" t-if="state.wallet and !state.wallet.connected">
                Чтобы покупать и продавать, подключите кошелёк TON: расчёт
                идёт между кошельками напрямую, платформа чужих ключей не
                хранит.
              </div>
              <div class="o_coop_dex_note" t-else="">
                Токены и оплата переходят одной транзакцией. Не поставили в
                срок — эскроу возвращает деньги без заявления и разбора.
              </div>

              <div class="o_coop_dex_myline" t-if="state.book.my_holding">
                На руках: <b t-esc="qty(state.book.my_holding)"/> <t t-esc="current.unit"/>
              </div>
            </div>
          </div>

          <!-- Прошедшие сделки: по ним и видно настоящую цену, а не ту,
               которую кто-то просит. -->
          <div class="o_coop_dex_trades">
            <div class="o_coop_dex_formhead">Сделки</div>
            <div class="o_coop_dex_thead">
              <span>Когда</span>
              <span>Продавец</span>
              <span>Покупатель</span>
              <span class="o_coop_dex_num">Цена</span>
              <span class="o_coop_dex_num">Объём</span>
            </div>
            <div t-foreach="state.book.trades" t-as="t" t-key="t_index" class="o_coop_dex_trow">
              <span t-esc="t.when"/>
              <span t-esc="t.seller"/>
              <span t-esc="t.buyer"/>
              <span class="o_coop_dex_num" t-esc="money(t.price, current.currency)"/>
              <span class="o_coop_dex_num" t-esc="qty(t.quantity)"/>
            </div>
            <div class="o_coop_dex_empty" t-if="!state.book.trades.length">
              По этому выпуску ещё не торговали. Первая сделка и задаст цену.
            </div>
          </div>
        </div>

        <div class="o_coop_dex_pane o_coop_dex_blank" t-if="!current and !state.loading">
          Рынков пока нет: чтобы они появились, участники должны выпустить
          токены на свои объявления.
        </div>
      </div>
    </div>
  </t>

  <!-- Строки списка рынков. Вынесены отдельно, потому что рисуются в двух
       местах: плоским списком и внутри групп. -->
  <t t-name="coop_tokenomics.MarketRows">
    <div t-foreach="rowset" t-as="m" t-key="m.id"
         class="o_coop_dex_market"
         t-att-class="{ 'o_coop_dex_active': m.id === state.currentId }"
         t-on-click="() => this.select(m.id)">
      <div class="o_coop_dex_mname">
        <div class="o_coop_dex_mtitle" t-esc="m.name"/>
        <div class="o_coop_dex_msub">
          <t t-esc="m.type_label"/> · <t t-esc="m.city"/> · <t t-esc="dueLabel(m)"/>
        </div>
        <div class="o_coop_dex_msub"><t t-esc="m.issuer"/></div>
      </div>
      <div class="o_coop_dex_num">
        <div class="o_coop_dex_price" t-esc="money(m.price, m.currency)"/>
        <div class="o_coop_dex_msub">за <t t-esc="m.unit"/></div>
      </div>
      <div class="o_coop_dex_num">
        <span class="o_coop_dex_change"
              t-att-class="{ 'o_coop_up': m.change &gt; 0, 'o_coop_down': m.change &lt; 0 }"
              t-esc="percent(m.change)"/>
        <div class="o_coop_dex_msub" t-if="m.trades">сделок <t t-esc="m.trades"/></div>
        <div class="o_coop_dex_msub" t-else="">сделок нет</div>
      </div>
      <div class="o_coop_dex_num">
        <span class="o_coop_dex_scorepill"
              t-att-class="{ 'o_coop_up': m.score &gt;= 28, 'o_coop_down': m.score &lt; 18 }"
              t-esc="m.score"/>
      </div>
    </div>
  </t>

</templates>
