<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="coop_tokenomics.Exchange">
    <div class="o_coop_dex" t-att-class="this.props.className">

      <!-- Шапка: кошелёк слева, потому что без него нельзя ни купить, ни
           продать, и узнать об этом лучше до выбора партии. -->
      <div class="o_coop_dex_top">
        <div class="o_coop_dex_wallet" t-if="this.state.wallet">
          <t t-if="this.state.wallet.connected">
            <span class="o_coop_dex_dot"/>
            <span class="o_coop_dex_addr" t-out="this.state.wallet.address.slice(0, 6) + '…' + this.state.wallet.address.slice(-4)"/>
            <span class="o_coop_dex_net" t-out="this.state.wallet.network === 'testnet' ? 'тестовая сеть' : 'основная сеть'"/>
          </t>
          <t t-else="">
            <button class="o_coop_dex_connect" t-on-click="this.connectWallet">
              Подключить кошелёк TON
            </button>
          </t>
        </div>
        <div class="o_coop_dex_stats" t-if="this.state.wallet">
          <span>Позиций: <b t-out="this.state.wallet.positions"/></span>
          <span>Своих выпусков: <b t-out="this.state.wallet.my_claims"/></span>
          <span>Рынков: <b t-out="this.rows.length"/></span>
        </div>
      </div>

      <!-- Категории — как вкладки «Тренд / Новые / Растущие» на биржах,
           переведённые на товар. Число рядом с подписью: без него
           непонятно, есть ли там что смотреть. -->
      <!-- Общий `Segmented` темы (`coop_theme/scss/segmented.scss`),
           как в эталоне TokenExchangePage. -->
      <div class="o_coop_dex_cats coop-seg">
        <button t-foreach="this.constructor.CATEGORIES" t-as="c" t-key="c.key"
                class="coop-seg_item"
                t-att-class="{ 'coop-seg_on': this.state.category === c.key }"
                t-on-click="() => this.setCategory(c.key)">
          <t t-out="c.label"/>
          <span class="coop-seg_count" t-if="this.counts[c.key] !== undefined" t-out="this.counts[c.key]"/>
        </button>
      </div>

      <div class="o_coop_dex_body">

        <!-- ═══ Рынки ═══ -->
        <div class="o_coop_dex_markets">
          <div class="o_coop_dex_search">
            <input type="text" placeholder="Товар, поставщик, качество или город"
                   t-att-value="this.state.search" t-on-input="this.onSearch"/>
            <select t-on-change="this.setGrouping">
              <option t-foreach="this.constructor.GROUPINGS" t-as="g" t-key="g.key"
                      t-att-value="g.key" t-att-selected="this.state.grouping === g.key">
                <t t-out="g.label"/>
              </option>
            </select>
          </div>

          <div class="o_coop_dex_mhead">
            <span class="o_coop_dex_sortable" t-on-click="() => this.sortBy('name')">
              Рынок<t t-out="this.sortMark('name')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('price')">
              Цена<t t-out="this.sortMark('price')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('change')">
              Изм.<t t-out="this.sortMark('change')"/>
            </span>
            <span class="o_coop_dex_num o_coop_dex_sortable" t-on-click="() => this.sortBy('score')">
              Оценка<t t-out="this.sortMark('score')"/>
            </span>
          </div>

          <div class="o_coop_dex_mlist">

            <!-- Без группировки: плоский список. -->
            <t t-if="this.state.grouping === 'none'">
              <t t-call="coop_tokenomics.MarketRows" rowset="this.sortedRows"/>
            </t>

            <!-- С группировкой: заголовок группы с итогом и её строки.
                 Итог по группе — число рынков и оборот: без них
                 группировка превращается в оглавление, по которому не
                 видно, где что-то происходит. -->
            <t t-else="">
              <div t-foreach="this.groups" t-as="g" t-key="g.key" class="o_coop_dex_group">
                <div class="o_coop_dex_ghead" t-on-click="() => this.toggleGroup(g)">
                  <span class="o_coop_dex_gname">
                    <t t-out="this.isGroupOpen(g) ? '▾' : '▸'"/> <t t-out="g.label"/>
                  </span>
                  <span class="o_coop_dex_gmeta">
                    <t t-out="g.count"/> рын. · оборот <t t-out="this.qty(g.volume)"/>
                  </span>
                </div>
                <t t-if="this.isGroupOpen(g)">
                  <t t-call="coop_tokenomics.MarketRows" rowset="this.groupRows(g)"/>
                </t>
              </div>
            </t>

            <div class="o_coop_dex_empty" t-if="!this.sortedRows.length and !this.state.loading">
              По этой категории и запросу рынков нет. Рынок — это партия
              товара: попробуйте искать по товару, хозяйству или городу.
            </div>
          </div>
        </div>

        <!-- ═══ Выбранный рынок ═══ -->
        <div class="o_coop_dex_pane" t-if="this.current">

          <div class="o_coop_dex_head">
            <div>
              <div class="o_coop_dex_title" t-out="this.current.name"/>
              <div class="o_coop_dex_sub">
                <t t-out="this.current.quality"/> · <t t-out="this.current.place"/> ·
                поставка до <t t-out="this.current.due"/> · <t t-out="this.current.issuer"/>
              </div>
            </div>
            <div class="o_coop_dex_headright">
              <span class="o_coop_dex_chip" t-if="this.current.is_future">товара ещё нет</span>
              <span class="o_coop_dex_chip" t-if="this.current.deposit_paid">
                залог <t t-out="this.money(this.current.deposit, this.current.currency)"/>
              </span>
              <button class="o_coop_dex_link" t-on-click="this.openClaim">карточка выпуска</button>
            </div>
          </div>

          <!-- Оценка выпуска с расшифровкой. Балл без объяснения — просьба
               поверить платформе на слово; участник должен видеть, из чего
               он сложился, и решать сам. -->
          <div class="o_coop_dex_score" t-if="this.currentRow">
            <div class="o_coop_dex_scoreline" t-on-click="this.toggleScore">
              <span class="o_coop_dex_scoreval" t-out="this.currentRow.score"/>
              <span class="o_coop_dex_scoremax">из 40</span>
              <span class="o_coop_dex_scorename">надёжность выпуска</span>
              <span class="o_coop_dex_link" t-out="this.state.showScore ? 'свернуть' : 'из чего сложилась'"/>
            </div>
            <div class="o_coop_dex_scoreparts" t-if="this.state.showScore">
              <div class="o_coop_dex_part">
                <span>Доверие поставщика</span>
                <b t-out="this.currentRow.score_parts.trust"/>
                <span class="o_coop_dex_partnote">
                  уровень <t t-out="this.currentRow.issuer_trust"/> по завершённым сделкам
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Залог</span>
                <b t-out="this.currentRow.score_parts.deposit"/>
                <span class="o_coop_dex_partnote">
                  <t t-if="this.current.deposit_paid">внесён — при срыве уходит держателям</t>
                  <t t-else="">не внесён</t>
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Как исполняет</span>
                <b t-out="this.currentRow.score_parts.record"/>
                <span class="o_coop_dex_partnote">
                  <t t-if="this.currentRow.first_issue">первый выпуск, истории ещё нет</t>
                  <t t-else="">
                    исполнено <t t-out="this.currentRow.issuer_settled"/>,
                    сорвано <t t-out="this.currentRow.issuer_broken"/>
                  </t>
                </span>
              </div>
              <div class="o_coop_dex_part">
                <span>Живость торгов</span>
                <b t-out="this.currentRow.score_parts.liveliness"/>
                <span class="o_coop_dex_partnote">
                  держателей <t t-out="this.currentRow.holders"/>, сделок <t t-out="this.currentRow.trades"/>
                </span>
              </div>
            </div>
          </div>

          <!-- График как на бирже: свечи с объёмом и средней, линия, глубина
               стакана; сводка по периоду и подсказка по свече под курсором. -->
          <div class="o_coop_tx_chart">
            <div class="o_coop_tx_head">
              <div class="o_coop_tx_price" t-if="this.chartStats">
                <b t-out="this.money(this.chartStats.last, this.current.currency)"/>
                <span t-att-class="this.chartStats.day &gt;= 0 ? 'o_coop_tx_up' : 'o_coop_tx_down'"
                      t-out="this.percent(this.chartStats.day)"/>
                <span class="o_coop_tx_sub">за день</span>
              </div>
              <div class="o_coop_tx_price" t-else="">
                <b>График</b>
              </div>
              <div class="o_coop_tx_stats" t-if="this.chartStats">
                <span>Макс. <b t-out="this.money(this.chartStats.high, this.current.currency)"/></span>
                <span>Мин. <b t-out="this.money(this.chartStats.low, this.current.currency)"/></span>
                <span>Объём <b t-out="this.qty(this.chartStats.volume)"/> <t t-out="this.current.unit"/></span>
                <span>Сделок <b t-out="this.chartStats.trades"/></span>
                <span>За период
                  <b t-att-class="this.chartStats.period &gt;= 0 ? 'o_coop_tx_up' : 'o_coop_tx_down'"
                     t-out="this.percent(this.chartStats.period)"/></span>
              </div>
            </div>
            <div class="o_coop_tx_controls">
              <div class="coop-seg">
                <button class="coop-seg_item" t-att-class="{ 'coop-seg_on': this.state.chart === 'candles' }"
                        t-on-click="() => this.setChart('candles')">Свечи</button>
                <button class="coop-seg_item" t-att-class="{ 'coop-seg_on': this.state.chart === 'line' }"
                        t-on-click="() => this.setChart('line')">Линия</button>
                <button class="coop-seg_item" t-att-class="{ 'coop-seg_on': this.state.chart === 'depth' }"
                        t-on-click="() => this.setChart('depth')">Глубина</button>
              </div>
              <div class="coop-seg coop-seg_small" t-if="this.state.chart !== 'depth'">
                <button t-foreach="this.ranges" t-as="r" t-key="r.key"
                        class="coop-seg_item" t-att-class="{ 'coop-seg_on': this.state.range === r.key }"
                        t-on-click="() => this.setRange(r.key)" t-out="r.label"/>
              </div>
            </div>

            <t t-if="this.state.chart !== 'depth'">
              <div class="o_coop_tx_plot" t-if="this.candles.length &gt;= 2">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="o_coop_tx_svg">
                  <line t-foreach="this.priceTicks" t-as="tk" t-key="tk_index"
                        x1="0" x2="100" t-att-y1="tk.top" t-att-y2="tk.top"
                        class="o_coop_tx_gridline" vector-effect="non-scaling-stroke"/>
                  <t t-foreach="this.candleBars" t-as="b" t-key="b.day">
                    <rect t-att-x="b.x - b.w / 2" t-att-width="b.w" t-att-y="b.vy" t-att-height="b.vh"
                          t-att-class="b.up ? 'o_coop_tx_vol_up' : 'o_coop_tx_vol_down'"/>
                  </t>
                  <t t-if="this.state.chart === 'candles'">
                    <t t-foreach="this.candleBars" t-as="b" t-key="b.day">
                      <line t-att-x1="b.x" t-att-x2="b.x" t-att-y1="b.yh" t-att-y2="b.yl"
                            t-att-class="b.up ? 'o_coop_candle_up' : 'o_coop_candle_down'"
                            stroke-width="1" vector-effect="non-scaling-stroke"/>
                      <rect t-att-x="b.x - b.w / 2" t-att-width="b.w" t-att-y="b.yt" t-att-height="b.hh"
                            t-att-class="b.up ? 'o_coop_candle_up' : 'o_coop_candle_down'"/>
                    </t>
                    <path t-if="this.movingAverage" t-att-d="this.movingAverage" class="o_coop_tx_ma"
                          fill="none" vector-effect="non-scaling-stroke"/>
                  </t>
                  <t t-else="">
                    <path t-att-d="this.closeLine.area" class="o_coop_tx_area"/>
                    <path t-att-d="this.closeLine.line" class="o_coop_tx_line" fill="none"
                          vector-effect="non-scaling-stroke"/>
                  </t>
                  <line t-if="this.lastPriceLine" x1="0" x2="100"
                        t-att-y1="this.lastPriceLine.y" t-att-y2="this.lastPriceLine.y"
                        t-att-class="'o_coop_tx_lastline ' + (this.lastPriceLine.up ? 'o_coop_tx_lastup' : 'o_coop_tx_lastdown')"
                        vector-effect="non-scaling-stroke"/>
                  <t t-if="this.hoverInfo">
                    <line t-att-x1="this.hoverInfo.left" t-att-x2="this.hoverInfo.left" y1="0" y2="100"
                          class="o_coop_tx_cross" vector-effect="non-scaling-stroke"/>
                    <line x1="0" x2="100" t-att-y1="this.hoverInfo.cy" t-att-y2="this.hoverInfo.cy"
                          class="o_coop_tx_cross" vector-effect="non-scaling-stroke"/>
                  </t>
                </svg>
                <div class="o_coop_tx_ticks">
                  <span t-foreach="this.priceTicks" t-as="tk" t-key="tk_index"
                        t-attf-style="top: {{ tk.top }}%" t-out="this.money(tk.v)"/>
                  <span t-if="this.lastPriceLine" class="o_coop_tx_lasttag"
                        t-att-class="this.lastPriceLine.up ? 'o_coop_tx_tagup' : 'o_coop_tx_tagdown'"
                        t-attf-style="top: {{ this.lastPriceLine.y }}%" t-out="this.money(this.lastPriceLine.v)"/>
                </div>
                <div class="o_coop_tx_days">
                  <span t-foreach="this.dayLabels" t-as="d" t-key="d_index"
                        t-attf-style="left: {{ d.left }}" t-out="d.label"/>
                </div>
                <div class="o_coop_tx_hit" t-on-mousemove="this.onPlotMove" t-on-mouseleave="this.onPlotLeave"/>
                <div t-if="this.hoverInfo" class="o_coop_tx_tip"
                     t-att-class="this.hoverInfo.flip ? 'o_coop_tx_tip_left' : 'o_coop_tx_tip_right'"
                     t-attf-style="left: calc((100% - 72px) * {{ this.hoverInfo.left / 100 }})">
                  <b t-out="this.hoverInfo.date"/>
                  <span>Откр. <t t-out="this.money(this.hoverInfo.o)"/></span>
                  <span>Макс. <t t-out="this.money(this.hoverInfo.h)"/></span>
                  <span>Мин. <t t-out="this.money(this.hoverInfo.l)"/></span>
                  <span>Закр. <t t-out="this.money(this.hoverInfo.c)"/>
                    <i t-att-class="this.hoverInfo.change &gt;= 0 ? 'o_coop_tx_up' : 'o_coop_tx_down'"
                       t-out="this.percent(this.hoverInfo.change)"/></span>
                  <span>Объём <t t-out="this.qty(this.hoverInfo.v)"/> · сделок <t t-out="this.hoverInfo.n"/></span>
                </div>
              </div>
              <div class="o_coop_dex_empty" t-else="">
                Торгов по этому рынку пока мало для графика: нужны сделки хотя бы за два дня.
              </div>
            </t>
            <t t-else="">
              <div class="o_coop_tx_plot" t-if="this.depthChart">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="o_coop_tx_svg">
                  <path t-att-d="this.depthChart.bids" class="o_coop_tx_depth_bid" vector-effect="non-scaling-stroke"/>
                  <path t-att-d="this.depthChart.asks" class="o_coop_tx_depth_ask" vector-effect="non-scaling-stroke"/>
                </svg>
                <div class="o_coop_tx_depthlegend">
                  <span class="o_coop_tx_up">Покупают всего <t t-out="this.qty(this.depthChart.bidTotal)"/></span>
                  <span t-if="this.depthChart.mid">середина <b t-out="this.money(this.depthChart.mid, this.current.currency)"/></span>
                  <span class="o_coop_tx_down">Продают всего <t t-out="this.qty(this.depthChart.askTotal)"/></span>
                </div>
                <div class="o_coop_tx_days">
                  <span style="left: 3%" t-out="this.money(this.depthChart.lo)"/>
                  <span style="left: 97%" t-out="this.money(this.depthChart.hi)"/>
                </div>
              </div>
              <div class="o_coop_dex_empty" t-else="">Стакан пуст.</div>
            </t>
          </div>

          <div class="o_coop_dex_grid">

            <!-- Стакан: продают слева, покупают справа. Своё помечено —
                 чтобы не пытаться купить у самого себя. -->
            <div class="o_coop_dex_book">
              <div class="o_coop_dex_bookcol">
                <div class="o_coop_dex_bookhead">
                  <span>Продают</span>
                  <span class="o_coop_dex_num">Цена</span>
                  <span class="o_coop_dex_num">Объём</span>
                </div>
                <div t-foreach="this.state.book.asks" t-as="o" t-key="o.id"
                     class="o_coop_dex_row o_coop_ask"
                     t-att-class="{ 'o_coop_dex_picked': this.state.selectedOrder and this.state.selectedOrder.id === o.id }"
                     t-on-click="() => this.pick(o)">
                  <span class="o_coop_dex_depth o_coop_depth_ask"
                        t-attf-style="width: {{ this.depth(o, this.state.book.asks) }}"/>
                  <span class="o_coop_dex_who">
                    <t t-out="o.partner"/>
                    <b t-if="o.mine"> — ваша</b>
                  </span>
                  <span class="o_coop_dex_num" t-out="this.money(o.price, this.current.currency)"/>
                  <span class="o_coop_dex_num" t-out="this.qty(o.quantity)"/>
                </div>
                <div class="o_coop_dex_empty" t-if="!this.state.book.asks.length">
                  Никто не продаёт. Можно оставить заявку на покупку —
                  держатель увидит её и решит сам.
                </div>
              </div>

              <div class="o_coop_dex_bookcol">
                <div class="o_coop_dex_bookhead">
                  <span>Покупают</span>
                  <span class="o_coop_dex_num">Цена</span>
                  <span class="o_coop_dex_num">Объём</span>
                </div>
                <div t-foreach="this.state.book.bids" t-as="o" t-key="o.id"
                     class="o_coop_dex_row o_coop_bid"
                     t-att-class="{ 'o_coop_dex_picked': this.state.selectedOrder and this.state.selectedOrder.id === o.id }"
                     t-on-click="() => this.pick(o)">
                  <span class="o_coop_dex_depth o_coop_depth_bid"
                        t-attf-style="width: {{ this.depth(o, this.state.book.bids) }}"/>
                  <span class="o_coop_dex_who">
                    <t t-out="o.partner"/>
                    <b t-if="o.mine"> — ваша</b>
                  </span>
                  <span class="o_coop_dex_num" t-out="this.money(o.price, this.current.currency)"/>
                  <span class="o_coop_dex_num" t-out="this.qty(o.quantity)"/>
                </div>
                <div class="o_coop_dex_empty" t-if="!this.state.book.bids.length">
                  Заявок на покупку нет.
                </div>
              </div>
            </div>

            <!-- Форма заявки (решение 417): купить или продать, лимитная или
                 по рынку. Заявка сводится со встречными сразу; исполнение —
                 сделка, которую подписывают кошельки сторон. Щелчок по
                 строке стакана подставляет цену и объём. -->
            <div class="o_coop_dex_form">
              <div class="o_coop_dex_tabs">
                <button t-att-class="{ 'o_coop_dex_tab': true, 'o_coop_dex_tab_buy': this.state.side === 'buy' }"
                        t-on-click="() => this.setSide('buy')">Купить</button>
                <button t-att-class="{ 'o_coop_dex_tab': true, 'o_coop_dex_tab_sell': this.state.side === 'sell' }"
                        t-on-click="() => this.setSide('sell')">Продать</button>
              </div>
              <div class="o_coop_dex_types">
                <label><input type="radio" name="coop_dex_type" value="limit"
                              t-att-checked="this.state.orderType === 'limit'"
                              t-on-change="() => this.setType('limit')"/> Лимитная</label>
                <label><input type="radio" name="coop_dex_type" value="market"
                              t-att-checked="this.state.orderType === 'market'"
                              t-on-change="() => this.setType('market')"/> По рынку</label>
              </div>

              <div class="o_coop_dex_field" t-if="this.state.orderType === 'limit'">
                <label>Цена за <t t-out="this.current.unit"/></label>
                <input type="number" min="0" step="0.01"
                       t-att-value="this.state.price" t-on-input="this.onPrice"/>
              </div>
              <div class="o_coop_dex_field" t-else="">
                <label>Цена</label>
                <div class="o_coop_dex_value">
                  лучшая встречная —
                  <t t-out="this.marketPrice ? this.money(this.marketPrice, this.current.currency) : 'нет заявок'"/>
                </div>
              </div>

              <div class="o_coop_dex_field">
                <label>Сколько (<t t-out="this.current.unit"/>)</label>
                <input type="number" min="0" step="0.001"
                       t-att-value="this.state.amount" t-on-input="this.onAmount"/>
                <div class="o_coop_dex_hint" t-if="this.state.side === 'sell'">
                  на руках <t t-out="this.qty(this.state.book.my_holding or 0)"/>
                </div>
              </div>

              <div class="o_coop_dex_total">
                <span><t t-out="this.state.side === 'buy' ? 'К оплате' : 'Получите'"/></span>
                <b t-out="this.money(this.total, this.current.currency)"/>
              </div>

              <button class="o_coop_dex_go"
                      t-att-class="{ 'o_coop_dex_go_sell': this.state.side === 'sell' }"
                      t-att-disabled="!this.canTrade" t-on-click="this.placeOrder">
                <t t-out="this.state.side === 'buy' ? 'Купить' : 'Продать'"/>
              </button>

              <div class="o_coop_dex_note" t-if="this.state.wallet and !this.state.wallet.connected">
                Чтобы покупать и продавать, подключите кошелёк TON: расчёт
                идёт между кошельками напрямую, платформа чужих ключей не
                хранит.
              </div>
              <div class="o_coop_dex_note" t-else="">
                Заявка сводится со встречными сразу. Токены и оплата переходят
                одной транзакцией после подписи в кошельке; не поставили в
                срок — эскроу возвращает деньги.
              </div>
            </div>
          </div>

          <!-- Прошедшие сделки: по ним и видно настоящую цену, а не ту,
               которую кто-то просит. -->
          <div class="o_coop_dex_trades">
            <div class="o_coop_dex_formhead">Сделки</div>
            <div class="o_coop_dex_thead">
              <span>Когда</span>
              <span>Продавец</span>
              <span>Покупатель</span>
              <span class="o_coop_dex_num">Цена</span>
              <span class="o_coop_dex_num">Объём</span>
            </div>
            <div t-foreach="this.state.book.trades" t-as="t" t-key="t_index" class="o_coop_dex_trow">
              <span t-out="t.when"/>
              <span t-out="t.seller"/>
              <span t-out="t.buyer"/>
              <span class="o_coop_dex_num" t-out="this.money(t.price, this.current.currency)"/>
              <span class="o_coop_dex_num" t-out="this.qty(t.quantity)"/>
            </div>
            <div class="o_coop_dex_empty" t-if="!this.state.book.trades.length">
              По этому выпуску ещё не торговали. Первая сделка и задаст цену.
            </div>
          </div>
        </div>

        <div class="o_coop_dex_pane o_coop_dex_blank" t-if="!this.current and !this.state.loading">
          Рынков пока нет: чтобы они появились, участники должны выпустить
          токены на свои объявления.
        </div>
      </div>
    </div>
  </t>

  <!-- Строки списка рынков. Вынесены отдельно, потому что рисуются в двух
       местах: плоским списком и внутри групп. -->
  <t t-name="coop_tokenomics.MarketRows">
    <div t-foreach="rowset" t-as="m" t-key="m.id"
         class="o_coop_dex_market"
         t-att-class="{ 'o_coop_dex_active': m.id === this.state.currentId }"
         t-on-click="() => this.select(m.id)">
      <div class="o_coop_dex_mname">
        <div class="o_coop_dex_mtitle" t-out="m.name"/>
        <div class="o_coop_dex_msub">
          <t t-out="m.type_label"/> · <t t-out="m.city"/>
        </div>
        <!-- Срок стоит первым во второй строке, а не последним в первой:
             строка обрезается по правому краю, и именно срок пропадал —
             признак, без которого обещание на товар не читается. -->
        <div class="o_coop_dex_msub">
          <t t-out="this.dueLabel(m)"/> · <t t-out="m.issuer"/>
        </div>
      </div>
      <div class="o_coop_dex_num">
        <div class="o_coop_dex_price" t-out="this.money(m.price, m.currency)"/>
        <div class="o_coop_dex_msub">за <t t-out="m.unit"/></div>
      </div>
      <div class="o_coop_dex_num">
        <span class="o_coop_dex_change"
              t-att-class="{ 'o_coop_up': m.change &gt; 0, 'o_coop_down': m.change &lt; 0 }"
              t-out="this.percent(m.change)"/>
        <div class="o_coop_dex_msub" t-if="m.trades">сделок <t t-out="m.trades"/></div>
        <div class="o_coop_dex_msub" t-else="">сделок нет</div>
      </div>
      <div class="o_coop_dex_num">
        <span class="o_coop_dex_scorepill"
              t-att-class="{ 'o_coop_up': m.score &gt;= 28, 'o_coop_down': m.score &lt; 18 }"
              t-out="m.score"/>
      </div>
    </div>
  </t>

</templates>
