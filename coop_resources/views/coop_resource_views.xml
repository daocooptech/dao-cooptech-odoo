<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Плитка ресурса повторяет макет: фотография во всю ширину, поверх неё
    метка вида объявления и полоса города, ниже название и цена.

    Продвигаемое объявление помечено отдельно и подписано тем, за счёт
    чего оно наверху. Скрывать это нельзя: непомеченное продвижение — это
    обман читателя, который думает, что видит лучшее предложение.
  -->
  <record id="view_coop_resource_kanban" model="ir.ui.view">
    <field name="name">coop.resource.kanban</field>
    <field name="model">coop.resource</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_resources" quick_create="false" js_class="coop_catalog_kanban">
        <field name="image_512"/>
        <field name="city"/>
        <field name="category_id"/>
        <field name="owner_id"/>
        <field name="listing_type"/>
        <field name="price_display"/>
        <field name="is_promoted"/>
        <!-- Объявлено ради выражения в разметке: ниже поле читается как
             `record.can_respond.raw_value`, а разбор представления видит
             только `<field>`. -->
        <field name="can_respond"/>
        <field name="respond_label"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_resource">
              <div class="o_coop_res_photo o_coop_media">
                <!-- Цепочка одна на все каталоги: свой снимок, иначе лицо той
                     стороны, с которой придётся иметь дело, иначе значок
                     раздела. Штатное поле-картинка так не умеет: при пустом
                     значении оно рисует заглушку «добавить фото», и карточка
                     выглядит незагрузившейся. -->
                <field name="image_512" widget="image" t-if="record.image_512.raw_value"/>
                <img class="o_coop_media_logo" t-elif="record.owner_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.owner_id.raw_value}/image_512"
                     t-att-alt="record.owner_id.value"/>
                <span t-else="" class="o_coop_media_sign">📦</span>
                <!-- Сердечко поверх снимка, как в макете: справа сверху,
                     одинаково во всех каталогах. Привязано к `id`, потому
                     что виджету нужна сама запись, а не значение поля. -->
                <field name="id" widget="coop_favorite_heart" nolabel="1"/>
                <span class="o_coop_res_type"
                      t-attf-class="o_coop_res_type #{record.listing_type.raw_value == 'request' ? 'o_coop_res_request' : ''}">
                  <field name="listing_type"/>
                </span>
                <span class="o_coop_res_promo" t-if="record.is_promoted.raw_value"
                      title="Объявление продвигается владельцем за токены платформы, а не показано выше по качеству">Продвигается</span>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>
              <div class="o_coop_res_body">
                <div class="o_coop_res_name"><field name="name"/></div>
                <!-- Подпись под названием: владелец и рубрика. Города здесь
                     нет намеренно — он стоит плашкой на фотографии, как во
                     всех каталогах, и в подписи выходил вторым разом.
                     Владелец указал на это 15 сентября 2026. -->
                <div class="o_coop_res_meta o_coop_listing_meta">
                  <t t-if="record.owner_id.raw_value"><t t-esc="record.owner_id.value"/></t>
                  <t t-if="record.owner_id.raw_value and record.category_id.raw_value"> · </t>
                  <t t-if="record.category_id.raw_value"><t t-esc="record.category_id.value"/></t>
                </div>
                <div class="o_coop_res_price"><field name="price_display"/></div>
                <!-- Отклик прямо с витрины: ради этого каталог и
                     открывают. Полоса есть всегда, даже когда
                     откликаться нельзя, — иначе карточки с кнопкой и без
                     неё расходятся по высоте ровно на её строку. То же
                     было у торгов и у проектов, и лечится тем же. -->
                <div class="o_coop_tile_act">
                  <button name="action_respond" type="object"
                          class="btn o_coop_btn o_coop_tile_respond"
                          t-if="record.can_respond.raw_value">
                    <t t-esc="record.respond_label.value"/>
                  </button>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_resource_list" model="ir.ui.view">
    <field name="name">coop.resource.list</field>
    <field name="model">coop.resource</field>
    <field name="arch" type="xml">
      <list string="Ресурсы">
        <field name="name"/>
        <field name="listing_type"/>
        <field name="resource_type"/>
        <field name="category_id" optional="show"/>
        <field name="method_ids" widget="many2many_tags" optional="show"/>
        <field name="owner_id"/>
        <field name="city"/>
        <field name="price_display" string="Цена"/>
        <field name="is_promoted" string="Продвигается" optional="hide"/>
        <field name="state" widget="badge"
               decoration-success="state == 'published'"
               decoration-muted="state != 'published'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_resource_promote_form" model="ir.ui.view">
    <field name="name">coop.resource.promote.form</field>
    <field name="model">coop.resource.promote</field>
    <field name="arch" type="xml">
      <form string="Продвинуть объявление">
        <p class="text-muted">
          Наверху каждой страницы каталога четыре платных места. Цена
          зависит от охвата: до первой строки первой страницы доходят все,
          до пятой страницы — единицы. Токены списываются вперёд за весь
          срок, место занимается целиком.
        </p>
        <group>
          <field name="resource_id" readonly="1"/>
          <field name="slot_id" options="{'no_create': True}"/>
          <field name="price_per_day" readonly="1"/>
          <field name="reach_share" readonly="1"
                 help="Оценка доли смотрящих каталог, которые доходят до этого места."/>
          <field name="days"/>
          <field name="total_tokens" readonly="1"/>
          <field name="balance" readonly="1"/>
          <field name="free_slots" readonly="1"/>
        </group>
        <footer>
          <button name="action_promote" type="object" string="Продвинуть"
                  class="btn-primary"/>
          <button string="Отмена" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_coop_resource_promote" model="ir.actions.act_window">
    <field name="name">Продвинуть объявление</field>
    <field name="res_model">coop.resource.promote</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!--
    Окно отклика. Заводит сделку в состоянии «Переговоры», а не письмо и
    не заявку: сделка на платформе уже есть, она двусторонняя, у неё
    состояния, спецификация, сроки, приёмка, спор и отзывы. Вторая
    сущность «отклик» рядом с ней означала бы две конструкции об одном.
  -->
  <record id="view_coop_resource_respond_form" model="ir.ui.view">
    <field name="name">coop.resource.respond.form</field>
    <field name="model">coop.resource.respond</field>
    <field name="arch" type="xml">
      <form string="Отклик на объявление">
        <field name="resource_id" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <field name="available_method_ids" invisible="1"/>
        <field name="listing_type" invisible="1"/>
        <group>
          <field name="owner_id"/>
          <field name="method_id" options="{'no_create': True}"/>
          <field name="amount"/>
          <field name="note" placeholder="Когда готовы, на каких условиях"/>
        </group>
        <div class="alert alert-info" role="status"
             invisible="listing_type != 'offer'">
          Отклик заведёт сделку в переговорах: вы принимаете, владелец
          объявления передаёт. Условия дальше согласуете в самой сделке —
          там же спецификация, сроки, приёмка и отзывы.
        </div>
        <div class="alert alert-info" role="status"
             invisible="listing_type != 'request'">
          Это объявление о спросе: вы передаёте, разместивший принимает.
          Отклик заведёт сделку в переговорах — условия согласуете в ней.
        </div>
        <footer>
          <button name="action_respond" type="object" string="Подтвердить"
                  class="btn-primary"/>
          <button string="Отмена" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_resource_form" model="ir.ui.view">
    <field name="name">coop.resource.form</field>
    <field name="model">coop.resource</field>
    <field name="arch" type="xml">
      <form string="Ресурс">
        <header>
          <!--
            Единственное действие участника в самом большом каталоге
            платформы. До него здесь было три кнопки, и все три — хозяина
            объявления: опубликовать, закрыть, продвинуть. Тому, кто
            нашёл нужное, нажать было нечего.
          -->
          <button name="action_respond" type="object"
                  class="btn-primary" invisible="not can_respond">
            <field name="respond_label" nolabel="1" readonly="1"/>
          </button>
          <button name="action_message_owner" type="object"
                  string="Написать владельцу" invisible="not can_respond"/>
          <button name="action_publish" type="object" string="Опубликовать"
                  class="btn-primary" invisible="state == 'published'"/>
          <button name="%(action_coop_resource_promote)d" type="action"
                  string="Продвинуть" invisible="state != 'published'"
                  context="{'default_resource_id': id}"/>
          <button name="action_close" type="object" string="Закрыть"
                  invisible="state == 'closed'"/>
          <field name="can_respond" invisible="1"/>
          <field name="respond_label" invisible="1"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,published,closed"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <field name="image_1920" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Что предлагаете или ищете" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/></h1>
          </div>
          <group>
            <group string="Что это">
              <field name="listing_type" widget="radio" options="{'horizontal': True}"/>
              <field name="resource_type" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="category_id" options="{'no_create': True}" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="method_ids" widget="many2many_tags"
                     options="{'no_create': True}"/>
            </group>
            <group string="Условия">
              <field name="price_kind" widget="coop_inline" readonly="not coop_can_edit"/>
              <label for="price"/>
              <div class="o_row">
                <field name="price" readonly="price_kind == 'none'" widget="coop_inline"/>
                <field name="price_unit_label" placeholder="кг, шт., сутки"
                       readonly="price_kind == 'none'" widget="coop_inline"/>
              </div>
              <field name="currency_id" invisible="1"/>
              <field name="price_display" readonly="1"/>
            </group>
          </group>
          <group>
            <group string="Кто и где">
              <field name="owner_id" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="city" widget="coop_inline" readonly="not coop_can_edit"/>
            </group>
            <group string="Продвижение">
              <field name="is_promoted" readonly="1"/>
              <field name="promoted_until" readonly="1"
                     invisible="not promoted_until"/>
              <field name="promotion_slot_id" readonly="1"
                     invisible="not promoted_until"/>
              <field name="catalog_rank" readonly="1" groups="base.group_no_one"/>
            </group>
          </group>
          <notebook>
            <page string="Описание" name="description">
              <field name="description"
                     placeholder="Что это, в каком состоянии, на каких условиях." widget="coop_block" readonly="not coop_can_edit"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_resource_search" model="ir.ui.view">
    <field name="name">coop.resource.search</field>
    <field name="model">coop.resource</field>
    <field name="arch" type="xml">
      <search string="Ресурсы">
        <field name="name"/>
        <field name="city"/>
        <field name="category_id"/>
        <field name="owner_id"/>
        <filter name="offers" string="Предложения"
                domain="[('listing_type', '=', 'offer')]"/>
        <filter name="requests" string="Спрос"
                domain="[('listing_type', '=', 'request')]"/>
        <separator/>
        <filter name="free" string="Отдают даром"
                domain="[('method_ids.code', '=', 'free')]"/>
        <filter name="barter" string="Готовы к обмену"
                domain="[('method_ids.code', '=', 'barter')]"/>
        <filter name="project" string="Можно внести в проект"
                domain="[('method_ids.code', '=', 'project')]"/>
        <separator/>
        <filter name="promoted" string="Продвигаемые"
                domain="[('is_promoted', '=', True)]"/>
        <group>
          <filter name="by_type" string="По типу ресурса"
                  context="{'group_by': 'resource_type'}"/>
          <filter name="by_category" string="По категории"
                  context="{'group_by': 'category_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
          <filter name="by_listing" string="По виду объявления"
                  context="{'group_by': 'listing_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_resources" model="ir.actions.act_window">
    <field name="name">Ресурсы</field>
    <field name="res_model">coop.resource</field>
    <field name="path">resources</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить ресурс', 'coop_shelf_field': 'category_id'}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('state', '=', 'published')]</field>
    <field name="search_view_id" ref="view_coop_resource_search"/>
    <!-- Двадцать на страницу — то же число, из которого считается
         сквозной номер платного места. Разойдутся — и объявление,
         купившее третью строку пятой страницы, окажется не там. -->
    <field name="limit">20</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">В каталоге пока пусто</p>
      <p>Сюда попадает то, что участники предлагают и что ищут: материалы,
         оборудование, финансы и труд. Продать, сдать, обменять, отдать
         даром или внести в проект — способ выбирает владелец.</p>
    </field>
  </record>

  <record id="view_coop_resource_category_list" model="ir.ui.view">
    <field name="name">coop.resource.category.list</field>
    <field name="model">coop.resource.category</field>
    <field name="arch" type="xml">
      <list string="Категории ресурсов">
        <field name="complete_name" string="Категория"/>
        <field name="resource_count" string="Ресурсов"/>
      </list>
    </field>
  </record>

  <record id="view_coop_resource_method_list" model="ir.ui.view">
    <field name="name">coop.resource.method.list</field>
    <field name="model">coop.resource.method</field>
    <field name="arch" type="xml">
      <list string="Способы передачи">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="requires_price" string="Нужна оценка"/>
        <field name="is_monetary" string="Денежный расчёт"/>
      </list>
    </field>
  </record>

  <record id="action_coop_resource_category" model="ir.actions.act_window">
    <field name="name">Категории ресурсов</field>
    <field name="res_model">coop.resource.category</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'coop_section': True}</field>
  </record>

  <record id="action_coop_resource_method" model="ir.actions.act_window">
    <field name="name">Способы передачи</field>
    <field name="res_model">coop.resource.method</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'coop_section': True}</field>
  </record>

  <record id="view_coop_promotion_slot_list" model="ir.ui.view">
    <field name="name">coop.promotion.slot.list</field>
    <field name="model">coop.promotion.slot</field>
    <field name="arch" type="xml">
      <list string="Места в выдаче" create="false">
        <field name="name"/>
        <field name="page"/>
        <field name="position" string="Строка"/>
        <field name="price_per_day" string="Цена суток, ₽"/>
        <field name="reach_share" string="Доля просмотров, %"/>
        <field name="is_taken" string="Занято"/>
        <field name="resource_id" string="Сейчас показывается"/>
        <field name="occupied_until" string="Занято до"/>
      </list>
    </field>
  </record>

  <record id="action_coop_promotion_slot" model="ir.actions.act_window">
    <field name="name">Места в выдаче</field>
    <field name="res_model">coop.promotion.slot</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Мест пока нет</p>
      <p>Наверху каждой страницы каталога четыре платных места. Цена
         каждого выведена из охвата: сколько смотрящих каталог до него
         доходит.</p>
    </field>
  </record>

  <!-- Продвижение: список трат и того, что показывается сейчас.
       Без своего вида Odoo рисует таблицу из одного столбца «ID» — по
       ней не видно ни объявления, ни места, ни срока. -->
  <record id="view_coop_promotion_list" model="ir.ui.view">
    <field name="name">coop.promotion.list</field>
    <field name="model">coop.promotion</field>
    <field name="arch" type="xml">
      <list string="Продвижение" create="false"
            decoration-success="is_running == True"
            decoration-muted="is_running == False">
        <field name="resource_id" string="Объявление"/>
        <field name="slot_id" string="Место"/>
        <field name="partner_id" string="Плательщик" optional="show"/>
        <field name="date_from" string="С"/>
        <field name="date_to" string="По"/>
        <field name="days" string="Дней" sum="Дней всего"/>
        <field name="price_per_day" string="Цена суток, ₽" optional="hide"/>
        <field name="total_tokens" string="Списано, ₽" sum="Списано всего"/>
        <field name="is_running" string="Идёт сейчас" widget="boolean_toggle"
               readonly="1"/>
      </list>
    </field>
  </record>

  <record id="view_coop_promotion_form" model="ir.ui.view">
    <field name="name">coop.promotion.form</field>
    <field name="model">coop.promotion</field>
    <field name="arch" type="xml">
      <form string="Продвижение">
        <sheet>
          <group>
            <group string="Что и где">
              <field name="resource_id" widget="coop_inline"/>
              <field name="slot_id" widget="coop_inline"/>
              <field name="partner_id" widget="coop_inline"/>
            </group>
            <group string="Срок и плата">
              <field name="date_from" widget="coop_inline"/>
              <field name="date_to" widget="coop_inline"/>
              <field name="days" widget="coop_inline"/>
              <field name="price_per_day" widget="coop_inline"/>
              <field name="total_tokens"/>
              <field name="is_running"/>
              <field name="transaction_id" widget="coop_inline"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_coop_promotion_search" model="ir.ui.view">
    <field name="name">coop.promotion.search</field>
    <field name="model">coop.promotion</field>
    <field name="arch" type="xml">
      <search string="Продвижение">
        <field name="resource_id" string="Объявление"/>
        <field name="partner_id" string="Плательщик"/>
        <field name="slot_id" string="Место"/>
        <filter name="running" string="Идут сейчас"
                domain="[('is_running', '=', True)]"/>
        <filter name="finished" string="Завершённые"
                domain="[('date_to', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
        <group>
          <filter name="by_slot" string="По месту" context="{'group_by': 'slot_id'}"/>
          <filter name="by_payer" string="По плательщику"
                  context="{'group_by': 'partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_promotion" model="ir.actions.act_window">
    <field name="name">Продвижение</field>
    <field name="res_model">coop.promotion</field>
    <field name="path">promotion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Продвижений пока нет</p>
      <p>Место в выдаче занимается под ваше объявление на срок и
      оплачивается вперёд, в рублях. Пока место занято вами,
      объявление стоит выше обычной выдачи; когда срок выйдет, оно
      вернётся на своё место, а строка останется здесь в истории.</p>
    </field>
</record>

  <!--
    «Мои ресурсы» — свои объявления, включая те, которых в каталоге не
    видно: черновики и снятые с публикации. Без этого вкладки человек
    находит своё только поиском по каталогу, где неопубликованного нет
    вовсе, — и снятое объявление выглядит пропавшим.

    Тот же вид, что и у каталога, и тот же поиск: разные экраны для
    «всех» и «моих» разъедутся на первой же правке.
  -->
  <record id="action_coop_my_resources" model="ir.actions.act_window">
    <field name="name">Мои ресурсы</field>
    <field name="res_model">coop.resource</field>
    <field name="path">my-resources</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить ресурс'}</field>
    <field name="view_mode">kanban,list,form</field>
    <!--
      Только своё, без потребностей своих проектов.

      Владельцем потребности проекта стоит его инициатор — иначе не
      понять, кто её объявил и с кем договариваться. Из-за этого в «Моих
      ресурсах» у инициатора четырёх проектов висели сорок три чужие по
      смыслу строки: «Крепёж и метизы, 15780 кг», «Разнорабочие на
      монтаж, 911 смен». Владелец 16 сентября 2026: «почему в ресурсах у
      человека потребности проекта?»

      Потребности проекта ведутся на его карточке, а в каталоге ресурсов
      они остаются в разделе спроса — там их и ищут те, кто готов
      закрыть.
    -->
    <field name="domain">[('owner_id.user_ids', 'in', [uid]),
                          ('project_id', '=', False)]</field>
    <field name="search_view_id" ref="view_coop_resource_search"/>
    <field name="limit">20</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока ничего не предложили</p>
      <p>Начните с того, что уже есть и простаивает: инструмент, помещение,
         машина, излишки урожая.</p>
    </field>
  </record>

  <menuitem id="menu_coop_resources_root" name="Ресурсы" sequence="60"/>
  <menuitem id="menu_coop_resources" name="Каталог ресурсов"
            parent="menu_coop_resources_root" action="action_coop_resources" sequence="10"/>
  <menuitem id="menu_coop_my_resources" name="Мои ресурсы"
            parent="menu_coop_resources_root" action="action_coop_my_resources"
            sequence="15"/>
  <menuitem id="menu_coop_promotion" name="Продвижение"
            parent="menu_coop_resources_root" action="action_coop_promotion" sequence="20"/>
  <!--
    Места в выдаче — часть продвижения, а не отдельная вкладка раздела
    (решение владельца от 2026-09-14). Участник приходит сюда не «сначала
    посмотреть места», а купить показ: место — подробность покупки, и
    жить ей внутри продвижения.
  -->
  <menuitem id="menu_coop_promotion_slot" name="Места в выдаче"
            parent="menu_coop_promotion" action="action_coop_promotion_slot"
            sequence="30"/>

  <!--
    Справочников в разделе нет: рубрики и способы передачи — настройка
    узла, а не то, чем участник пользуется каждый день. Вкладка убрана
    решением владельца от 2026-09-14, а 16 сентября 2026 сами справочники
    переехали в общий раздел `coop_base.menu_coop_reference_root`, где
    стоят рядом со справочниками организаций. Погашенный пустой пункт
    убран вместе с ними.
  -->
  <menuitem id="menu_coop_resource_category" name="Категории ресурсов"
            parent="coop_base.menu_coop_reference_root"
            action="action_coop_resource_category" sequence="40"/>
  <menuitem id="menu_coop_resource_method" name="Способы передачи"
            parent="coop_base.menu_coop_reference_root"
            action="action_coop_resource_method" sequence="50"/>

</odoo>
