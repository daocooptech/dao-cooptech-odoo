<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Способы передачи вкладками, «+» в конце; под вкладкой — условия способа. -->
  <t t-name="coop_resources.MethodTabs">
    <div class="coop-mtabs">
      <div class="coop-mtabs_row" role="tablist">
        <t t-foreach="this.tabs" t-as="tab" t-key="tab.id">
          <div class="coop-mtabs_tab" role="tab"
               t-att-class="{ 'coop-mtabs_on': this.current and this.current.id === tab.id }"
               t-att-aria-selected="this.current and this.current.id === tab.id ? 'true' : 'false'">
            <button type="button" class="coop-mtabs_name" t-on-click="() => this.select(tab)"
                    t-out="tab.name"/>
            <button type="button" class="coop-mtabs_x" t-if="!this.props.readonly"
                    t-att-title="'Убрать способ «' + tab.name + '»'"
                    t-att-aria-label="'Убрать способ «' + tab.name + '»'"
                    t-on-click="() => this.remove(tab)">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </t>
        <div class="coop-mtabs_add" t-if="!this.props.readonly and this.rest.length">
          <button type="button" class="coop-mtabs_plus" title="Добавить способ"
                  aria-label="Добавить способ" t-att-aria-expanded="this.ui.menu ? 'true' : 'false'"
                  t-on-click="() => this.toggleMenu()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            <span t-if="!this.tabs.length">Добавить способ</span>
          </button>
          <div class="coop-mtabs_menu" t-if="this.ui.menu">
            <t t-foreach="this.rest" t-as="method" t-key="method.id">
              <button type="button" t-on-click="() => this.add(method)" t-out="method.name"/>
            </t>
          </div>
        </div>
      </div>

      <div class="coop-mtabs_panel" t-if="this.current">
        <t t-set="lay" t-value="this.layout"/>
        <div class="coop-add_field" t-if="lay.noteFirst">
          <label t-out="this.noteLabel"/>
          <input class="o_input" type="text" t-att-value="this.value('note')"
                 t-att-readonly="this.props.readonly"
                 t-on-change="(ev) => this.onInput('note', ev)"/>
        </div>
        <div class="coop-add_field" t-if="lay.price">
          <label>Цена</label>
          <div class="coop-seg coop-mtabs_kind">
            <t t-foreach="this.priceKinds" t-as="kind" t-key="kind[0]">
              <button type="button" class="coop-seg_item"
                      t-att-class="{ 'coop-seg_on': this.priceKind === kind[0] }"
                      t-att-disabled="this.props.readonly"
                      t-on-click="() => this.setKind(kind[0])" t-out="kind[1]"/>
            </t>
          </div>
        </div>
        <div class="coop-add_pair" t-if="(lay.price and this.priceKind !== 'none') or lay.estimate">
          <div class="coop-add_field">
            <label t-out="this.priceLabel"/>
            <input class="o_input" type="text" inputmode="decimal" t-att-value="this.value('price')"
                   t-att-readonly="this.props.readonly"
                   t-on-change="(ev) => this.onInput('price', ev)"/>
          </div>
          <div class="coop-add_field" t-if="lay.unit">
            <label>За что</label>
            <input class="o_input" type="text" t-att-placeholder="lay.unit"
                   t-att-value="this.value('price_unit_label')"
                   t-att-readonly="this.props.readonly"
                   t-on-change="(ev) => this.onInput('price_unit_label', ev)"/>
          </div>
          <div class="coop-add_field" t-if="lay.period">
            <label>За период</label>
            <select class="o_input" t-att-disabled="this.props.readonly"
                    t-on-change="(ev) => this.onInput('price_unit_label', ev)">
              <option value="" t-att-selected="!this.value('price_unit_label')">—</option>
              <t t-foreach="this.rentPeriods" t-as="period" t-key="period">
                <option t-att-value="period" t-att-selected="this.value('price_unit_label') === period"
                        t-out="period"/>
              </t>
              <!-- Своя единица у старых объявлений («смена», «выходные») не теряется. -->
              <option t-if="this.value('price_unit_label') and !this.rentPeriods.includes(this.value('price_unit_label'))"
                      t-att-value="this.value('price_unit_label')" selected="selected"
                      t-out="this.value('price_unit_label')"/>
            </select>
          </div>
        </div>
        <div class="coop-add_field" t-if="lay.deposit and !this.isRequest">
          <label>Залог, ₽</label>
          <input class="o_input" type="text" inputmode="decimal" t-att-value="this.value('deposit')"
                 t-att-readonly="this.props.readonly"
                 t-on-change="(ev) => this.onInput('deposit', ev)"/>
        </div>
        <div class="coop-add_row coop-mtabs_grid">
          <t t-foreach="this.extraFields" t-as="field" t-key="field.name">
            <div class="coop-add_field"
                 t-att-class="{ 'coop-mtabs_wide': ['seg', 'chips'].includes(field.kind) }">
              <label t-out="field.label"/>
              <div class="coop-seg" t-if="field.kind === 'seg'">
                <t t-foreach="field.opt.options" t-as="choice" t-key="choice[0]">
                  <button type="button" class="coop-seg_item"
                          t-att-class="{ 'coop-seg_on': this.value(field.name) === choice[0] }"
                          t-att-disabled="this.props.readonly"
                          t-on-click="() => this.setChoice(field.name, choice[0])" t-out="choice[1]"/>
                </t>
              </div>
              <div class="coop-mtabs_chips" t-elif="field.kind === 'chips'">
                <t t-foreach="this.chips(field)" t-as="chip" t-key="chip.option">
                  <button type="button" class="coop-mtabs_chip"
                          t-att-class="{ 'coop-mtabs_chip_on': chip.on }"
                          t-att-aria-pressed="chip.on ? 'true' : 'false'"
                          t-att-disabled="this.props.readonly"
                          t-on-click="() => this.toggleChip(field, chip.option)" t-out="chip.option"/>
                </t>
              </div>
              <input t-else="" class="o_input"
                     t-att-type="field.kind === 'date' ? 'date' : 'text'"
                     t-att-inputmode="['num', 'int', 'pct', 'money'].includes(field.kind) ? 'decimal' : undefined"
                     t-att-placeholder="field.opt.ph"
                     t-att-value="this.inputValue(field)"
                     t-att-readonly="this.props.readonly"
                     t-on-change="(ev) => this.onInput(field.name, ev)"/>
            </div>
          </t>
        </div>
        <div class="coop-mtabs_calc" t-if="this.calc">
          <t t-set="calc" t-value="this.calc"/>
          <t t-foreach="calc.lines" t-as="line" t-key="line[0]">
            <span><t t-out="line[0]"/>: <b t-out="line[1]"/></span>
          </t>
        </div>
        <p class="coop-add_help coop-mtabs_hint" t-foreach="this.hints" t-as="hint" t-key="hint_index"
           t-out="hint"/>
        <div class="coop-add_field" t-if="!lay.noteFirst">
          <label t-out="this.noteLabel"/>
          <input class="o_input" type="text" t-att-value="this.value('note')"
                 t-att-readonly="this.props.readonly"
                 t-on-change="(ev) => this.onInput('note', ev)"/>
        </div>
      </div>
      <p class="coop-add_help" t-elif="!this.props.readonly">
        Нажмите «+» и выберите, как готовы передать: продать, сдать в аренду,
        обменять, отдать даром. У каждого способа — свои условия.
      </p>
    </div>
  </t>

</templates>
