<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Вид записи «Событие сообщества».

    Решение 7 от 2 сентября 2026: экономические события сообщества идут в
    общую ленту **отдельным видом записи**. Отдельным — чтобы ход закупок,
    вех и сборов не утонул в разговорах: в ленте, где «набрано 7 из 12»
    лежит вперемешку с «а когда привезут?», отличить одно от другого
    нечем, и фильтр потом не на что опереть.

    `default="False"`: на события не подписывают молча. Кто хочет следить
    за экономикой сообщества — включает сам.
  -->
  <record id="mt_community_economics" model="mail.message.subtype">
    <field name="name">Событие сообщества</field>
    <field name="res_model">coop.community</field>
    <field name="default" eval="False"/>
    <field name="description">Закупки, сборы, вехи — то, что происходит, а не то, что обсуждают.</field>
  </record>
</odoo>
