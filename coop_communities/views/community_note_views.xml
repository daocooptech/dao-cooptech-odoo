<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Пространство «Группа» у заметок и задач (решение 696, № 353). -->
  <record id="view_todo_form_coop_community" model="ir.ui.view">
    <field name="name">project.task.todo.form.coop.community</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="coop_projects.view_todo_form_coop_project"/>
    <field name="arch" type="xml">
      <xpath expr="//group[field[@name='date_deadline']]" position="inside">
        <field name="coop_community_id" options="{'no_create': True, 'no_open': True}"
               invisible="coop_space != 'community'" required="coop_space == 'community'"
               domain="[('member_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('state', '=', 'active')])]"/>
      </xpath>
    </field>
  </record>
  <record id="view_todo_list_coop_community" model="ir.ui.view">
    <field name="name">project.task.todo.list.coop.community</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="coop_projects.view_todo_list_coop_project"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='coop_project_id']" position="after">
        <field name="coop_community_id" optional="show"/>
      </xpath>
    </field>
  </record>
  <record id="view_todo_search_coop_community" model="ir.ui.view">
    <field name="name">project.task.todo.search.coop.community</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="coop_projects.view_todo_search_coop_project"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='coop_project_id']" position="after">
        <field name="coop_community_id"/>
      </xpath>
      <xpath expr="//filter[@name='space_project']" position="after">
        <filter name="space_community" string="Группы" domain="[('coop_space', '=', 'community')]"/>
      </xpath>
      <xpath expr="//filter[@name='by_coop_project']" position="after">
        <filter name="by_coop_community" string="Группа"
                context="{'group_by': 'coop_community_id'}"/>
      </xpath>
    </field>
  </record>
</odoo>
