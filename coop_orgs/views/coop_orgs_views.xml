<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Плитка организации повторяет макет и намеренно скупее людской: логотип,
    полоса города, название. Ни доверия, ни чипов, ни кнопок.

    Так и в прототипе, и причина понятна: у человека с карточки нужно
    что-то сделать прямо сейчас — написать, подписаться, позвать в друзья.
    Организацию сначала открывают.
  -->
  <record id="view_coop_orgs_kanban" model="ir.ui.view">
    <field name="name">coop.orgs.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_orgs" quick_create="false" js_class="coop_catalog_kanban">
        <field name="avatar_256"/>
        <field name="city"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_org">
              <div class="o_coop_org_logo o_coop_media">
                <field name="avatar_256" widget="image"/>
                <span class="o_coop_locbar" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" role="img" aria-label="Город"/>
                  <field name="city"/>
                </span>
              </div>
              <div class="o_coop_org_name">
                <field name="name"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_orgs_list" model="ir.ui.view">
    <field name="name">coop.orgs.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Организации">
        <field name="name"/>
        <field name="coop_legal_form_id" string="Форма"/>
        <field name="city"/>
        <field name="coop_specialization_id" string="Специализация" optional="show"/>
        <field name="coop_specialization_category_id" string="Сфера деятельности" optional="hide"/>
        <field name="coop_okved_section_id" string="Раздел ОКВЭД" optional="show"/>
        <field name="coop_okved_code" string="ОКВЭД" optional="hide"/>
        <field name="coop_member_count" string="Участников"/>
        <field name="coop_trust" string="Доверие, %"/>
        <field name="coop_inn" string="ИНН" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_coop_orgs_search" model="ir.ui.view">
    <field name="name">coop.orgs.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Организации">
        <field name="name"/>
        <field name="city"/>
        <field name="coop_specialization_id"/>
        <field name="coop_inn"/>
        <filter name="cooperative" string="Кооперативные"
                domain="[('coop_is_cooperative', '=', True)]"/>
        <filter name="with_members" string="С членством"
                domain="[('coop_member_count', '>', 0)]"/>
        <separator/>
        <filter name="trust_high" string="Доверие от 80%"
                domain="[('coop_trust', '>=', 80)]"/>
        <group>
          <filter name="by_form_group" string="По группе форм"
                  context="{'group_by': 'coop_legal_form_group_id'}"/>
          <filter name="by_form" string="По правовой форме"
                  context="{'group_by': 'coop_legal_form_id'}"/>
          <filter name="by_area" string="По сфере деятельности"
                  context="{'group_by': 'coop_specialization_category_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <!--
    Профиль организации. Реквизиты вынесены вперёд, потому что с
    организацией имеют дело как с юридическим лицом: прежде чем
    договариваться, смотрят, кто это по документам.

    Состав показывается только там, где членство вообще бывает. У фонда и
    АНО его нет по закону, и пустая вкладка «Состав» на карточке фонда
    читалась бы как «участников пока не добавили», хотя добавлять их туда
    не следует вовсе.
  -->
  <!--
    Окно заявления о вступлении.

    Окном, а не кнопкой сразу: основание участия — не мелочь. Пайщик
    вносит пай и получает голос, наёмный сотрудник не получает ни того
    ни другого, и выбрать должен человек, а не узнать постфактум, кем
    его записали.
  -->
  <record id="view_coop_org_join_form" model="ir.ui.view">
    <field name="name">coop.org.join.form</field>
    <field name="model">coop.org.join</field>
    <field name="arch" type="xml">
      <form string="Заявление о вступлении">
        <field name="organization_id" invisible="1"/>
        <field name="is_cooperative" invisible="1"/>
        <group>
          <field name="allowed_role_ids" invisible="1"/>
          <field name="role_code" invisible="1"/>
          <field name="role_id" widget="radio"
                 options="{'no_create': True}"/>
          <field name="job_title" placeholder="Бухгалтер, механик, менеджер по продажам"
                 invisible="role_code != 'staff'"/>
          <field name="note" placeholder="Необязательно"/>
        </group>
        <div class="alert alert-info" role="status"
             invisible="role_code != 'member'">
          Пайщик вносит пай и получает голос на собрании: один член —
          один голос, независимо от размера пая. Решение о приёме
          принимает тот, кто ведёт состав организации.
        </div>
        <div class="alert alert-info" role="status"
             invisible="role_code != 'staff'">
          Наёмный сотрудник пая не вносит и голоса на собрании не имеет.
          Что ему позволено делать от имени организации, задают
          полномочия — их выдают при приёме.
        </div>
        <footer>
          <button name="action_apply" type="object" string="Подать заявление"
                  class="btn-primary"/>
          <button string="Отмена" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_orgs_form" model="ir.ui.view">
    <field name="name">coop.orgs.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <!--
        Карточка организации — та же раскладка, что у страницы человека:
        слева колонка со справками, справа полосы владений. Организация
        на платформе — такой же участник, и разводить два разных вида
        карточки значило бы, что человек каждый раз заново ищет, где что
        лежит.
      -->
      <form string="Организация" class="o_coop_profile o_coop_org_form">
        <header>
          <button name="action_coop_org_message" type="object"
                  string="Написать" class="btn-primary"/>
          <button name="action_coop_org_follow" type="object"
                  string="Подписаться" invisible="coop_org_is_following"/>
          <button name="action_coop_org_follow" type="object"
                  string="Вы подписаны" invisible="not coop_org_is_following"/>
          <!--
            Вступление. Модель членства была описана до мелочей, а подать
            заявление участник не мог: путь к составу вёл только через
            загрузчик демо-данных и администраторский список.

            Четыре состояния — четыре кнопки, потому что человеку важно
            не только что он может сделать, но и где он сейчас: подано
            заявление, состоит, выходит или не состоит вовсе.
          -->
          <button name="action_coop_join" type="object" string="Вступить"
                  class="btn-secondary" invisible="not coop_can_join"/>
          <button name="action_coop_withdraw" type="object"
                  string="Отозвать заявление"
                  invisible="coop_my_membership_state != 'applied'"/>
          <button name="action_coop_leave" type="object" string="Выйти"
                  invisible="coop_my_membership_state != 'active'"
                  confirm="Подать заявление о выходе из организации?"/>
          <button name="action_coop_applications" type="object"
                  class="btn-primary"
                  invisible="not coop_application_count"
                  string="Заявления"/>
        </header>
        <sheet class="o_coop_profile_sheet">
          <field name="coop_has_members" invisible="1"/>
          <field name="coop_org_is_following" invisible="1"/>
          <field name="coop_can_join" invisible="1"/>
          <field name="coop_my_membership_state" invisible="1"/>
          <field name="coop_application_count" invisible="1"/>
          <field name="coop_can_manage_roster" invisible="1"/>
          <field name="coop_card_label" invisible="1"/>
          <field name="coop_member_label" invisible="1"/>
          <field name="coop_project_count" invisible="1"/>
          <field name="coop_symbol_mark" invisible="1"/>
          <!--
            Право править карточку решает, будет ли у строки карандаш.
            До 20 сентября 2026 карандаши видели все, а запись
            правило пускало только своих: человек правил чужую
            организацию и получал отказ только при сохранении.
          -->
          <field name="coop_can_edit_card" invisible="1"/>
          <!-- Что видят другие — решение 67 журнала владельца. Переключатели
               те же, что у человека: настройки открываются на того, от
               чьего имени действуют, и управляющий, переключившись на
               организацию, выставляет их в «Приватности». Себе — то есть
               тому, кто правит карточку, — видно всё. -->
          <field name="coop_show_trust" invisible="1"/>
          <field name="coop_show_contacts" invisible="1"/>

          <div class="o_coop_profile_layout">

            <!-- ── Левая колонка ─────────────────────────────────── -->
            <div class="o_coop_profile_side">
              <div class="o_coop_cover">
                <field name="image_1920" widget="image"
                       options="{'preview_image': 'avatar_256'}"/>
              </div>

              <div class="o_coop_stats">
                <div invisible="not coop_can_edit_card and not coop_show_trust">Уровень доверия:
                  <b><field name="coop_trust" nolabel="1" readonly="1"/>%</b>
                </div>
                <!-- Где я в этой организации. Без строки человек,
                     подавший заявление неделю назад, не может узнать,
                     рассмотрели его или нет. -->
                <div class="o_coop_my_membership"
                     invisible="coop_my_membership_state == 'none'">
                  <t invisible="coop_my_membership_state != 'applied'">
                    Заявление подано, ждёт решения
                  </t>
                  <t invisible="coop_my_membership_state != 'active'">
                    Вы состоите в организации
                  </t>
                  <t invisible="coop_my_membership_state != 'leaving'">
                    Подано заявление о выходе
                  </t>
                </div>
                <!-- Проектов — как в макете, рядом с составом: это две
                     величины, по которым организацию и оценивают. -->
                <div invisible="not coop_project_count">Проектов:
                  <b><field name="coop_project_count" nolabel="1" readonly="1"/></b>
                </div>
                <div invisible="not coop_member_count"><field name="coop_member_label" nolabel="1" readonly="1"/>:
                  <b><field name="coop_member_count" nolabel="1" readonly="1"/></b>
                  <button name="action_coop_members" type="object"
                          class="o_coop_stat_note"
                          groups="coop_base.group_coop_member,coop_base.group_coop_board,coop_base.group_coop_audit">состав →</button>
                </div>
              </div>

              <div class="o_coop_infobox">
                <div class="o_coop_infobox_head">Контакты</div>
                <div class="o_coop_infobox_body">
                  <div><span class="o_coop_key">Город</span>
                    <field name="city" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указан"/></div>
                  <div><span class="o_coop_key">Адрес</span>
                    <field name="street" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="улица, дом"/></div>
                  <div><span class="o_coop_key">Индекс</span>
                    <field name="zip" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="нет"/></div>
                  <div><span class="o_coop_key">Страна</span>
                    <field name="country_id" widget="coop_inline" readonly="not coop_can_edit_card"
                           placeholder="не указана"/></div>
                  <div><span class="o_coop_key">Телефон</span>
                    <field name="phone" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указан"/></div>
                  <div><span class="o_coop_key">Почта</span>
                    <field name="email" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указана"/></div>
                  <div invisible="not coop_can_edit_card and not coop_show_contacts"><span class="o_coop_key">Сайт</span>
                    <field name="website" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="нет"/></div>
                  <!-- То же, что у человека: способ связи организация
                       называет сама, а не выбирает из нашего перечня. -->
                  <div class="o_coop_contact_extra"
                       invisible="not coop_can_edit_card and not coop_show_contacts">
                    <field name="coop_contact_line_ids" nolabel="1"
                           widget="coop_contact_lines" readonly="not coop_can_edit_card"/>
                  </div>
                </div>
              </div>

              <div class="o_coop_infobox">
                <div class="o_coop_infobox_head">Реквизиты</div>
                <div class="o_coop_infobox_body">
                  <div><span class="o_coop_key">ИНН</span>
                    <field name="coop_inn" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указан"/></div>
                  <div><span class="o_coop_key">КПП</span>
                    <field name="coop_kpp" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="нет"/></div>
                  <div><span class="o_coop_key">ОГРН</span>
                    <field name="coop_ogrn" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указан"/></div>
                  <div><span class="o_coop_key">Зарегистрирована</span>
                    <field name="coop_registered_on" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указано"/></div>
                  <div><span class="o_coop_key">Устав</span>
                    <field name="coop_charter_url" widget="coop_inline" readonly="not coop_can_edit_card"
                           placeholder="нет"/></div>
                  <!-- Вид деятельности стоит среди реквизитов, а не в
                       блоке «На платформе»: это выписка, а не то, что
                       организация о себе рассказала. -->
                  <div><span class="o_coop_key">Вид деятельности</span>
                    <field name="coop_okved_id" widget="coop_inline" readonly="not coop_can_edit_card"
                           placeholder="не указан"/></div>
                  <div><span class="o_coop_key">Код ОКВЭД</span>
                    <field name="coop_okved_code" widget="coop_inline" readonly="not coop_can_edit_card" placeholder="не указан"/></div>
                </div>
              </div>

              <div class="o_coop_infobox">
                <div class="o_coop_infobox_head">На платформе</div>
                <div class="o_coop_infobox_body">
                  <div><span class="o_coop_key">Специализация</span>
                    <field name="coop_specialization_id" widget="coop_inline" readonly="not coop_can_edit_card"
                           placeholder="не указана"/></div>
                  <div><span class="o_coop_key">Сфера</span>
                    <field name="coop_specialization_category_id" readonly="1"/></div>
                  <div><span class="o_coop_key">Участник</span>
                    <field name="coop_is_participant" readonly="not coop_can_edit_card"/></div>
                </div>
              </div>
            </div>

            <!-- ── Правая колонка ────────────────────────────────── -->
            <div class="o_coop_profile_main">
              <div class="o_coop_name_row">
                <h1><field name="name" widget="coop_inline" readonly="not coop_can_edit_card"
                           placeholder="Название организации"/></h1>
                <span class="o_coop_verified" invisible="not coop_is_cooperative">
                  Кооперативная организация
                </span>
              </div>
              <div class="o_coop_role">
                <field name="coop_legal_form_id" widget="coop_inline" readonly="not coop_can_edit_card"
                       placeholder="Правовая форма"/>
              </div>

              <!-- То же, что у человека: короткая заметка, а не статья
                   с редактором. -->
              <!-- Вид организации под названием, как в макете:
                   «Кооперативная организация», «Коммерческая», и так
                   далее. Слово берётся у группы правовых форм, а не
                   пишется в разметке: групп четыре, и пятая появится
                   вместе с новой формой, а не с правкой шаблона. -->
              <div class="o_coop_org_kind" invisible="not coop_card_label">
                <field name="coop_card_label" nolabel="1" readonly="1"/>
              </div>

              <div class="o_coop_about">
                <field name="coop_about" nolabel="1" widget="coop_about" readonly="not coop_can_edit_card"
                       placeholder="Чем занимается организация — до 280 знаков"/>
              </div>

              <!--
                Полосы владений — те же, что на странице человека, и в том
                же порядке, что в макете: сначала люди, потом то, что
                организация предлагает, потом её замыслы и нужды.
              -->
              <div class="o_coop_band" invisible="not coop_has_members"
                   groups="coop_base.group_coop_member,coop_base.group_coop_board,coop_base.group_coop_audit">
                <div class="o_coop_band_head">
                  <span><field name="coop_member_label" nolabel="1" readonly="1"/></span>
                  <button name="action_coop_members" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_member_ids" readonly="1" nolabel="1"
                         domain="[('state', '=', 'active')]">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_person" type="object">
                      <field name="partner_id"/>
                      <field name="role_id"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/res.partner/' + record.partner_id.raw_value + '/avatar_256'"
                                   t-att-alt="record.partner_id.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="partner_id"/>
                            </div>
                            <div class="o_coop_mini_note">
                              <field name="role_id"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="not coop_org_resource_ids">
                <div class="o_coop_band_head">
                  <span>Ресурсы</span>
                  <button name="action_coop_org_resources" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_org_resource_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.resource/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="not coop_org_project_ids">
                <div class="o_coop_band_head">
                  <span>Проекты</span>
                  <button name="action_coop_org_projects" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_org_project_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.project/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <!--
                Услуги. Появляется, когда организация завела хоть одну, —
                владелец 15 сентября 2026: «услуги (появляется при
                добавлении услуги)». Услуга на платформе это предложение
                навыка: тот же каталог и та же карточка, и заводить
                рядом вторую сущность незачем.
              -->
              <div class="o_coop_band" invisible="not coop_org_service_ids">
                <div class="o_coop_band_head">
                  <span>Услуги</span>
                  <button name="action_coop_org_services" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_org_service_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.skill.offer/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <!--
                Организационная структура. В макете она есть у всех трёх
                видов организаций: кто в каком органе состоит. Строится
                из того же членства, что и состав, — роль участия и есть
                орган: правление, ревизия, учредители, пайщики.

                Отдельной модели под органы нет намеренно: орган — это не
                справочник, а свойство членства, и заводить рядом второй
                перечень значило бы разойтись с составом при первой же
                правке.
              -->
              <div class="o_coop_band" invisible="not coop_member_count"
                   groups="coop_base.group_coop_member,coop_base.group_coop_board,coop_base.group_coop_audit">
                <div class="o_coop_band_head">
                  <span>Организационная структура</span>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_member_ids" readonly="1" nolabel="1"
                         domain="[('state', '=', 'active')]">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_person" type="object">
                      <field name="role_id"/>
                      <field name="job_title"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/res.partner/' + record.partner_id.raw_value + '/avatar_256'"
                                   t-att-alt="record.partner_id.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="partner_id"/>
                            </div>
                            <div class="o_coop_mini_note">
                              <t t-esc="record.job_title.value or record.role.value"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <!--
                Связанные организации: с кем работаем. Союз, в который
                входим, учредитель, дочернее хозяйство, поставщик.

                Показываются только подтверждённые второй стороной:
                связь, объявленная одной стороной, — её заявление, а не
                факт, и без подтверждения кто угодно объявил бы себя
                учредителем чужого кооператива.
              -->
              <div class="o_coop_band" invisible="not coop_related_org_ids">
                <div class="o_coop_band_head">
                  <span>Связанные организации</span>
                  <button name="action_coop_org_related" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_related_org_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/res.partner/' + record.id.raw_value + '/avatar_256'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="not coop_org_vacancy_ids">
                <div class="o_coop_band_head">
                  <span>Вакансии</span>
                  <button name="action_coop_org_vacancies" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_org_vacancy_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <templates>
                        <t t-name="card">
                          <!-- Со снимком, как в полках человека и как в
                               макете: полка из голых подписей на сером
                               читается как список, а не как витрина, и
                               рядом с полкой ресурсов выглядит
                               недогрузившейся. -->
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.vacancy/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>

              <div class="o_coop_band" invisible="not coop_org_need_ids">
                <div class="o_coop_band_head">
                  <span>Потребности</span>
                  <button name="action_coop_org_needs" type="object"
                          class="o_coop_band_all">смотреть все</button>
                </div>
                <div class="o_coop_band_body">
                  <field name="coop_org_need_ids" readonly="1" nolabel="1">
                    <kanban class="o_coop_band_kanban" records_draggable="false"
                            action="action_coop_open_page" type="object">
                      <field name="state"/>
                      <templates>
                        <t t-name="card">
                          <div class="o_coop_mini">
                            <div class="o_coop_mini_img">
                              <img t-att-src="'/web/image/coop.resource/' + record.id.raw_value + '/image_512'"
                                   t-att-alt="record.name.value" loading="lazy"/>
                            </div>
                            <div class="o_coop_mini_label">
                              <field name="name"/>
                            </div>
                            <div class="o_coop_mini_note"
                                 t-att-class="record.state.raw_value === 'published' ? 'o_coop_open' : 'o_coop_closed'">
                              <t t-if="record.state.raw_value === 'published'">● открыта</t>
                              <t t-else="">● закрыта</t>
                            </div>
                          </div>
                        </t>
                      </templates>
                    </kanban>
                  </field>
                </div>
              </div>
            </div>
          </div>
        </sheet>
        <!--
          Лента организации — своя у каждой, как и у человека. Под
          карточкой, а не сбоку: сторону задаёт `coop_theme/.../wall.js`.
        -->
        <chatter reload_on_post="True"/>
      </form>
    </field>
  </record>

  <record id="action_coop_orgs" model="ir.actions.act_window">
    <field name="name">Организации</field>
    <field name="res_model">res.partner</field>
    <field name="path">orgs</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('coop_is_participant', '=', True), ('is_company', '=', True)]</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'default_coop_is_participant': True, 'default_is_company': True, 'coop_create_label': 'Добавить организацию', 'coop_shelf_field': 'coop_okved_section_id'}</field>
    <field name="search_view_id" ref="view_coop_orgs_search"/>
    <field name="view_ids" eval="[(5, 0, 0),
           (0, 0, {'sequence': 10, 'view_mode': 'kanban', 'view_id': ref('view_coop_orgs_kanban')}),
           (0, 0, {'sequence': 20, 'view_mode': 'list', 'view_id': ref('view_coop_orgs_list')}),
           (0, 0, {'sequence': 30, 'view_mode': 'form', 'view_id': ref('view_coop_orgs_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">В каталоге пока нет организаций</p>
      <p>Сюда попадают кооперативы, товарищества, фонды и компании —
         участники платформы. Обычный контакт-организация в каталог не
         попадает: для этого у него должен стоять признак участника.</p>
    </field>
  </record>

  <!-- Справочники — общие, поэтому живут в разделе организаций рядом с
       формами, а не в разделе людей, где были заведены. -->
  <record id="view_coop_legal_form_list" model="ir.ui.view">
    <field name="name">coop.legal.form.list</field>
    <field name="model">coop.legal.form</field>
    <field name="arch" type="xml">
      <list string="Правовые формы">
        <field name="sequence" widget="handle"/>
        <field name="group_id"/>
        <field name="short_name" string="Сокращение"/>
        <field name="name"/>
        <field name="law" string="Основание"/>
        <field name="has_members" string="Членство"/>
        <field name="is_cooperative" string="Кооперативная"/>
        <field name="is_russian" string="Форма по праву РФ"/>
        <field name="partner_count" string="Организаций"/>
      </list>
    </field>
  </record>

  <record id="view_coop_specialization_list" model="ir.ui.view">
    <field name="name">coop.specialization.list</field>
    <field name="model">coop.specialization</field>
    <field name="arch" type="xml">
      <list string="Специализации">
        <field name="category_id"/>
        <field name="name"/>
        <field name="partner_count" string="Записей"/>
      </list>
    </field>
  </record>

  <record id="view_coop_specialization_category_list" model="ir.ui.view">
    <field name="name">coop.specialization.category.list</field>
    <field name="model">coop.specialization.category</field>
    <field name="arch" type="xml">
      <list string="Сферы деятельности">
        <field name="name"/>
        <field name="specialization_count" string="Специализаций"/>
        <field name="partner_count" string="Записей"/>
      </list>
    </field>
  </record>

  <record id="action_coop_legal_form" model="ir.actions.act_window">
    <field name="name">Правовые формы</field>
    <field name="res_model">coop.legal.form</field>
    <field name="view_mode">list,form</field>
    <!-- Признак «экран раздела платформы»: по нему появляется строка
         вкладок, и пять справочников читаются одним разделом. -->
    <field name="context">{'coop_section': True}</field>
  </record>

  <record id="action_coop_specialization" model="ir.actions.act_window">
    <field name="name">Специализации</field>
    <field name="res_model">coop.specialization</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'coop_section': True}</field>
  </record>

  <record id="action_coop_specialization_category" model="ir.actions.act_window">
    <field name="name">Сферы деятельности</field>
    <field name="res_model">coop.specialization.category</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'coop_section': True}</field>
  </record>

  <!--
    «Мои организации» — те, где человек состоит: учредитель, совладелец,
    подрядчик. Отбор по членству, а не по тому, кто завёл карточку:
    организацию мог завести кто угодно, а работают в ней все.
  -->
  <record id="action_coop_my_orgs" model="ir.actions.act_window">
    <field name="name">Мои организации</field>
    <field name="res_model">res.partner</field>
    <field name="path">my-orgs</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('coop_is_participant', '=', True), ('is_company', '=', True), ('coop_member_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('state', '=', 'active')])]</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'default_coop_is_participant': True, 'default_is_company': True, 'coop_create_label': 'Добавить организацию'}</field>
    <field name="search_view_id" ref="view_coop_orgs_search"/>
    <field name="view_ids" eval="[(5, 0, 0),
           (0, 0, {'sequence': 10, 'view_mode': 'kanban', 'view_id': ref('view_coop_orgs_kanban')}),
           (0, 0, {'sequence': 20, 'view_mode': 'list', 'view_id': ref('view_coop_orgs_list')}),
           (0, 0, {'sequence': 30, 'view_mode': 'form', 'view_id': ref('view_coop_orgs_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока нигде не состоите</p>
      <p>Заведите свою организацию или попросите принять вас в существующую.</p>
    </field>
  </record>

  <menuitem id="menu_coop_orgs_root" name="Организации" sequence="80"/>
  <menuitem id="menu_coop_orgs" name="Каталог организаций"
            parent="menu_coop_orgs_root" action="action_coop_orgs" sequence="10"/>
  <menuitem id="menu_coop_my_orgs" name="Мои организации"
            parent="menu_coop_orgs_root" action="action_coop_my_orgs"
            sequence="15"/>
  <!--
    Справочники переехали в общий раздел `coop_base.menu_coop_reference_root`
    (решение владельца 16 сентября 2026). Прежний пункт «Справочники»
    внутри раздела организаций убран совсем, а не погашен: детей у него не
    осталось, и пустая запись в меню — это то, что потом ищут глазами и не
    находят.
  -->
  <menuitem id="menu_coop_legal_form" name="Правовые формы"
            parent="coop_base.menu_coop_reference_root"
            action="action_coop_legal_form" sequence="10"/>
  <menuitem id="menu_coop_specialization" name="Специализации"
            parent="coop_base.menu_coop_reference_root"
            action="action_coop_specialization" sequence="20"/>
  <menuitem id="menu_coop_specialization_category" name="Сферы деятельности"
            parent="coop_base.menu_coop_reference_root"
            action="action_coop_specialization_category" sequence="30"/>

</odoo>
