<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Кооперативный участок (решение 428; ст. 1, 17 Закона № 3085-1):
       состав, уполномоченные, собрания. Сделок и имущества у участка нет,
       поэтому и полей для них нет. -->
  <record id="view_coop_org_section_form" model="ir.ui.view">
    <field name="name">coop.org.section.form</field>
    <field name="model">coop.org.section</field>
    <field name="arch" type="xml">
      <form string="Кооперативный участок">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Название участка"/></h1>
          </div>
          <group>
            <group>
              <field name="organization_id" options="{'no_create': True}"/>
              <field name="city"/>
              <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
              <field name="member_count"/>
            </group>
            <group>
              <field name="delegate_ids" widget="many2many_tags"
                     options="{'no_create': True}"/>
            </group>
          </group>
          <div class="text-muted mb-3"><field name="note" nolabel="1" readonly="1"/></div>
          <notebook>
            <page string="Собрания участка" name="meetings">
              <field name="meeting_ids" nolabel="1">
                <list editable="bottom">
                  <field name="date"/>
                  <field name="mode"/>
                  <field name="agenda"/>
                  <field name="decision"/>
                  <field name="votes_for"/>
                  <field name="votes_against"/>
                  <field name="votes_abstain"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'held'" decoration-info="state == 'planned'"/>
                </list>
              </field>
            </page>
            <page string="Пайщики участка" name="members">
              <field name="membership_ids" nolabel="1" readonly="1">
                <list>
                  <field name="partner_id"/>
                  <field name="role_id"/>
                  <field name="joined_on"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_coop_org_section_list" model="ir.ui.view">
    <field name="name">coop.org.section.list</field>
    <field name="model">coop.org.section</field>
    <field name="arch" type="xml">
      <list string="Кооперативные участки">
        <field name="name"/>
        <field name="organization_id"/>
        <field name="city"/>
        <field name="country_id"/>
        <field name="member_count"/>
      </list>
    </field>
  </record>
</odoo>
