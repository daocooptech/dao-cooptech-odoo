<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Раз в час: событие, которое уже кончилось, — «Состоялось» (№ 489).
      Без этого прошедшие встречи висели «Идёт запись» и звали
      записываться на вчерашнее. Черновики не трогаем: что с ними
      делать, решает владелец.
    -->
    <record id="cron_hold_past_events" model="ir.cron">
      <field name="name">События: отметить прошедшие состоявшимися</field>
      <field name="model_id" ref="model_coop_event"/>
      <field name="state">code</field>
      <field name="code">model._cron_hold_past()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
