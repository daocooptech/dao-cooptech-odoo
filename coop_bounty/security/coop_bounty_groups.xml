<?xml version="1.0" encoding="utf-8"?>
<!--
  Без `noupdate`. Правила доступа — это код, а не данные пользователя:
  правку правила нужно доставить на узел обновлением модуля. С пометкой
  «не обновлять» исправления молча не доезжали до базы, и правило
  продолжало работать в прежнем, ошибочном виде — так и вышло с правкой
  объявлений от имени организации.

  Если администратор узла подстроит правило под себя, обновление модуля
  вернёт нашу редакцию. Это осознанно: правила доступа задаёт платформа.
-->
<odoo>
  <data>


    <!--
      Менеджер сообщества — роль рабочей группы, а не кооператива. Он
      размещает задачи, утверждает исполнителей и принимает работу, но
      никаких прав в кооперативах при этом не получает: платформа не
      сторона отношений участников, и роль в ней членством не является.
    -->
    <record id="group_coop_community_manager" model="res.groups">
      <field name="name">Менеджер сообщества</field>
      <field name="privilege_id" ref="coop_base.privilege_coop_role"/>
      <field name="comment">Размещает задачи рабочей группы, утверждает исполнителей и принимает работу. Прав в кооперативах не даёт.</field>
    </record>

  </data>
</odoo>
