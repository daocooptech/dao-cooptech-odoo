<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Конкурс (№ 465): после срока — к итогу или закрыть без работ. -->
  <record id="cron_coop_bounty_contest_deadline" model="ir.cron">
    <field name="name">Задачи: закрыть приём работ на конкурс после срока</field>
    <field name="model_id" ref="model_coop_bounty_task"/>
    <field name="state">code</field>
    <field name="code">model._cron_contest_deadline()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
