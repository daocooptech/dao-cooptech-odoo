<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coop_bounty_task_form" model="ir.ui.view">
    <field name="name">coop.bounty.task.form</field>
    <field name="model">coop.bounty.task</field>
    <field name="arch" type="xml">
      <form string="Задача">
        <header>
          <!-- Действия автора — того, кто вправе вести задачу: рабочей
               группы платформы или организации проекта. Кнопки — по
               состоянию: набор «опубликовать / принять / вернуть» на
               черновике только сбивал бы с толку. -->
          <button name="action_publish" type="object" string="Опубликовать"
                  class="btn-primary" invisible="(state != 'draft') or not coop_can_edit"/>
          <button name="action_accept" type="object" string="Принять результат"
                  class="btn-primary" invisible="(state not in ('submitted', 'dispute')) or not coop_can_edit"/>
          <button name="action_return_for_revision" type="object"
                  string="Вернуть на доработку" invisible="(state not in ('submitted', 'dispute')) or not coop_can_edit"/>
          <button name="action_cancel" type="object" string="Отменить задачу"
                  invisible="(state in ('accepted', 'cancelled')) or not coop_can_edit"
                  confirm="Отменить задачу? У задачи платформы резерв вернётся в фонд."/>
          <button name="action_reset_to_draft" type="object" string="В черновик"
                  invisible="(state != 'cancelled') or not coop_can_edit"/>

          <!-- Спор разбирает администратор платформы (решение 194). -->
          <button name="action_open_dispute_decision" type="object" string="Решить спор"
                  class="btn-primary" invisible="state != 'dispute' or not is_arbiter"/>

          <!-- Действия участника. -->
          <button name="action_apply" type="object" string="Взять задачу"
                  class="btn-primary"
                  invisible="state != 'published' or my_application_state != 'none' or coop_can_edit"/>
          <button name="action_submit" type="object" string="Сдать на проверку"
                  class="btn-primary"
                  invisible="state != 'assigned' or not is_mine"/>

          <button name="action_open_review" type="object" string="Оставить отзыв"
                  class="btn-primary" invisible="not can_review"/>

          <field name="state" widget="statusbar"
                 statusbar_visible="draft,published,assigned,submitted,accepted"/>
        </header>
        <sheet>
          <field name="coop_can_edit" invisible="1"/>
          <field name="payer_kind" invisible="1"/>
          <field name="allows_share" invisible="1"/>
          <field name="allows_money" invisible="1"/>
          <field name="my_application_state" invisible="1"/>
          <field name="is_mine" invisible="1"/>
          <field name="is_arbiter" invisible="1"/>
          <field name="can_review" invisible="1"/>
          <field name="reminded_on" invisible="1"/>

          <div class="alert alert-info" role="status" invisible="state != 'submitted'">
            Результат сдан на проверку. Дней на ответ автору до спора:
            <field name="days_to_dispute" class="d-inline"/>.
          </div>
          <div class="alert alert-danger" role="status" invisible="state != 'dispute'">
            Автор не ответил за 7 дней после сдачи — открыт спор. Его разбирает
            администратор платформы и записывает объяснение решения.
          </div>
          <div class="alert alert-secondary" role="status"
               invisible="state != 'cancelled' or payer_kind != 'platform'">
            Задача отменена. Резерв возвращён в фонд.
          </div>
          <div class="alert alert-warning" role="status" invisible="state != 'assigned' or not reminded_on">
            Срок прошёл, результата нет. Через неделю после срока задача снова
            откроется для других, исполнитель будет снят.
          </div>
          <div class="alert alert-info" role="status" invisible="not can_review">
            Результат принят. Оставьте отзыв — он идёт в уровень доверия.
          </div>
          <div class="alert alert-info" role="status" invisible="my_application_state != 'applied'">
            Ваша заявка подана — автор утвердит исполнителя.
          </div>

          <!-- Фото и видео — две карусели (`coop_media`, задача 424). -->
          <div class="coop-gallery coop-media_block">
            <field name="coop_media_data" widget="coop_media" nolabel="1" readonly="1"/>
          </div>
          <div class="oe_title">
            <h1><field name="name" placeholder="Что нужно сделать" widget="coop_inline" options="{'wrap': True}" readonly="not coop_can_edit"/></h1>
          </div>
          <group>
            <group string="Кто платит">
              <field name="payer_id" options="{'no_create': True}" widget="coop_inline"
                     readonly="not coop_can_edit or state != 'draft'"/>
              <field name="project_id" options="{'no_create': True}" widget="coop_inline"
                     invisible="payer_kind == 'platform' and not project_id"
                     readonly="not coop_can_edit or state != 'draft'"/>
              <field name="city" invisible="payer_kind == 'platform'"/>
              <field name="fund_id" invisible="payer_kind != 'platform' or not fund_id"/>
              <field name="fund_free" invisible="payer_kind != 'platform' or not fund_id"/>
            </group>
            <group string="Условия оплаты">
              <!-- Решение 671 п. 7: у автора — набор галочек, у
                   исполнителя — один выбор в заявке. Способы другого
                   вида автора не показываются (решение 672). -->
              <!-- Решение 690: только токены своего проекта — способ
                   ставится сам при публикации. -->
              <field name="payment_label"/>
              <field name="allowed_method_ids" invisible="1"/>
              <!-- Для чтения — метками: галочки показывают и неотмеченные
                   способы, и по тексту не понять, какие допустимы. -->

              <field name="reward_tokens" widget="coop_inline" invisible="not allows_money and state != 'draft'"
                     readonly="not coop_can_edit or state != 'draft'"/>
              <field name="payment_mode" invisible="1"/>
            </group>
            <group string="Сроки">
              <field name="coop_specialization_id" options="{'no_create': True}" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="deadline" widget="coop_inline" readonly="not coop_can_edit"/>
              <field name="submitted_on" invisible="not submitted_on"/>
              <field name="dispute_on" invisible="not dispute_on"/>
              <field name="accepted_on" invisible="state != 'accepted'"/>
            </group>
            <group string="Участники">
              <field name="manager_id" readonly="1"/>
              <field name="assignee_id" readonly="1" invisible="not assignee_id"/>
              <field name="reward_transaction_id" readonly="1"
                     invisible="not reward_transaction_id"/>
            </group>
          </group>
          <notebook>
            <page string="Описание" name="description">
              <field name="description" placeholder="Опишите результат, а не процесс: по этому тексту исполнитель поймёт, когда задача считается выполненной." widget="coop_block" readonly="not coop_can_edit"/>
            </page>
            <!-- Критерии приёмки (№ 464): пишет автор до публикации, при
                 приёмке отмечает выполненные; спор разбирают по ним. -->
            <page string="Критерии приёмки" name="criteria">
              <field name="criterion_ids" nolabel="1"
                     readonly="not coop_can_edit or state not in ('draft', 'submitted', 'dispute')">
                <list editable="bottom" create="state == 'draft'" delete="state == 'draft'">
                  <field name="sequence" widget="handle"/>
                  <field name="name" readonly="parent.state != 'draft'"/>
                  <field name="done" widget="boolean_toggle"
                         readonly="parent.state not in ('submitted', 'dispute')"/>
                </list>
              </field>
            </page>
            <page string="Вопросы к заявке" name="questions"
                  invisible="not coop_can_edit and not question_ids">
              <field name="question_ids" nolabel="1"
                     readonly="not coop_can_edit or state != 'draft'">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="required"/>
                </list>
              </field>
            </page>
            <page string="Сдачи" name="submissions"
                  invisible="not submission_ids or (not coop_can_edit and not is_mine and not is_arbiter)">
              <field name="submission_ids" nolabel="1" readonly="1">
                <list>
                  <field name="version"/>
                  <field name="create_date" string="Когда"/>
                  <field name="link" widget="url"/>
                  <field name="note"/>
                  <field name="attachment_ids" widget="many2many_binary" string="Файлы"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'accepted'"
                         decoration-warning="state == 'returned'"
                         decoration-info="state == 'review'"/>
                  <field name="review_note"/>
                </list>
              </field>
            </page>
            <page string="Отзывы" name="reviews" invisible="not review_ids">
              <field name="review_ids" nolabel="1" readonly="1">
                <list>
                  <field name="side"/>
                  <field name="author_id"/>
                  <field name="rating" widget="badge"/>
                  <field name="body"/>
                </list>
              </field>
            </page>
            <page string="Заявки" name="applications" invisible="not coop_can_edit">
              <field name="application_ids" nolabel="1" readonly="1">
                <list>
                  <field name="create_date" string="Когда"/>
                  <field name="partner_id"/>
                  <field name="method_id"/>
                  <field name="proposed_deadline"/>
                  <field name="message"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'approved'"
                         decoration-muted="state == 'rejected'"/>
                  <button name="action_approve" type="object" string="Утвердить"
                          icon="check" invisible="state != 'applied'"/>
                  <button name="action_reject" type="object" string="Отклонить"
                          icon="close" invisible="state == 'rejected'"/>
                </list>
              </field>
            </page>
            <page string="Решение по спору" name="dispute" invisible="not dispute_decision">
              <field name="dispute_decision" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_bounty_task_list" model="ir.ui.view">
    <field name="name">coop.bounty.task.list</field>
    <field name="model">coop.bounty.task</field>
    <field name="arch" type="xml">
      <list string="Задачи">
        <field name="name"/>
        <field name="payer_id" string="Кто платит" optional="show"/>
        <field name="project_id" optional="hide"/>
        <field name="coop_specialization_id" optional="show"/>
        <field name="payment_label" optional="show"/>
        <field name="reward_tokens"/>
        <field name="deadline"/>
        <field name="assignee_id"/>
        <field name="application_count" string="Заявок"/>
        <field name="state" widget="badge"
               decoration-success="state == 'accepted'"
               decoration-info="state == 'published'"
               decoration-warning="state == 'submitted'"
               decoration-danger="state == 'dispute'"
               decoration-muted="state in ('draft', 'cancelled')"/>
      </list>
    </field>
  </record>

  <record id="view_coop_bounty_task_kanban" model="ir.ui.view">
    <field name="name">coop.bounty.task.kanban</field>
    <field name="model">coop.bounty.task</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" quick_create="false">
        <field name="state"/>
        <field name="reward_tokens"/>
        <field name="share_percent"/>
        <field name="payer_kind"/>
        <field name="image_512"/>
        <templates>
          <t t-name="card">
            <!-- Общая карточка каталога. В квадрате — снимок задачи, без
                 него исполнитель, если задача уже за кем-то закреплена:
                 по лицу видно, свободна она или нет. -->
            <div class="o_coop_listing o_coop_bounty_card">
              <div class="o_coop_media">
                <!-- Снимок задания по смыслу (решение 341) — первым. -->
                <img t-if="record.image_512.raw_value" loading="lazy"
                     t-attf-src="/web/image/coop.bounty.task/#{record.id.raw_value}/image_512"
                     t-att-alt="record.name.value"/>
                <img class="o_coop_media_logo" t-elif="record.assignee_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.users/#{record.assignee_id.raw_value}/image_512"
                     t-att-alt="record.assignee_id.value"/>
                <span t-else="" class="o_coop_media_sign"><field name="id" widget="coop_sign" options="{'icon': 'tools'}"/></span>
              </div>
              <div class="o_coop_listing_body">
              <div class="o_coop_listing_title"><field name="name"/></div>
              <div class="o_coop_listing_meta">
                <span t-if="record.payer_kind.raw_value == 'platform'">Платформа</span>
                <span t-elif="record.project_id.raw_value"><field name="project_id"/></span>
                <span t-else=""><field name="payer_id"/></span>
                <span t-if="record.coop_specialization_id.raw_value"> · <field name="coop_specialization_id"/></span>
                <span t-if="record.city.raw_value"> · <field name="city"/></span>
              </div>

              <div class="mt-2 d-flex justify-content-between align-items-center">
                <span class="o_coop_bounty_reward">
                  <field name="reward_tokens"/> <field name="token_unit"/>
                </span>
                <field name="assignee_id" widget="many2one_avatar_user"/>
              </div>
              <div class="text-muted small mt-1" t-if="record.deadline.raw_value">
                до <field name="deadline"/>
              </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_bounty_task_search" model="ir.ui.view">
    <field name="name">coop.bounty.task.search</field>
    <field name="model">coop.bounty.task</field>
    <field name="arch" type="xml">
      <search string="Задачи">
        <field name="name"/>
        <field name="coop_specialization_id"/>
        <field name="payer_id" string="Кто платит"/>
        <field name="project_id"/>
        <field name="assignee_id"/>
        <filter name="open" string="Открытые" domain="[('state', '=', 'published')]"/>
        <filter name="in_progress" string="В работе"
                domain="[('state', 'in', ('assigned', 'submitted'))]"/>
        <filter name="dispute" string="Спор" domain="[('state', '=', 'dispute')]"/>
        <filter name="mine" string="Мои задачи"
                domain="[('assignee_id.user_ids', 'in', [uid])]"/>
        <separator/>
        <filter name="platform" string="Наш проект" domain="[('payer_kind', '=', 'platform')]"/>
        <filter name="projects" string="Проекты" domain="[('payer_kind', '=', 'project')]"/>
        <separator/>
        <filter name="overdue" string="Просроченные"
                domain="[('deadline', '&lt;', context_today().strftime('%Y-%m-%d')),
                         ('state', 'in', ('published', 'assigned', 'submitted'))]"/>
        <group>
          <filter name="by_state" string="По состоянию" context="{'group_by': 'state'}"/>
          <filter name="by_payer" string="По автору" context="{'group_by': 'payer_id'}"/>
          <filter name="by_specialization" string="По специализации"
                  context="{'group_by': 'coop_specialization_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_bounty_task" model="ir.actions.act_window">
    <field name="name">Задачи краудсорсинга</field>
    <field name="res_model">coop.bounty.task</field>
    <field name="path">bounty</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_coop_bounty_task_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Задач пока нет</p>
      <p>Здесь проекты размещают задачи и платят за них токенами своего
         проекта. Экономику токена проект описывает сам. Загляните позже.</p>
    </field>
  </record>

  <!-- ── Окно заявки ────────────────────────────────────────────────── -->

  <record id="view_coop_bounty_apply_form" model="ir.ui.view">
    <field name="name">coop.bounty.apply.form</field>
    <field name="model">coop.bounty.apply</field>
    <field name="arch" type="xml">
      <form string="Заявка на задачу">
        <field name="allowed_method_ids" invisible="1"/>
        <field name="task_id" invisible="1"/>
        <p class="text-muted">Автор допустил эти способы. Выберите один — он
           закрепится за вами, когда автор вас утвердит.</p>
        <group>
          <field name="method_id" invisible="1"/>
          <field name="reward_tokens" string="Сумма, ₽" invisible="not method_code or method_code == 'share'"/>
          <field name="share_percent" invisible="method_code != 'share'"/>
          <field name="proposed_deadline"/>
          <field name="message" placeholder="Что у вас есть для этой задачи и когда сможете сдать"/>
        </group>
        <field name="answer_line_ids" nolabel="1" invisible="not answer_line_ids">
          <list editable="bottom" create="0" delete="0">
            <field name="question_id" column_invisible="1"/>
            <field name="required" column_invisible="1"/>
            <field name="question" readonly="1"/>
            <field name="answer" required="required"/>
          </list>
        </field>
        <div class="alert alert-info" role="status" invisible="method_code != 'share'">
          Форму доли определяет организация по закону своей страны; конкретную
          форму мы не обещаем.
        </div>
        <footer>
          <button name="action_confirm" type="object" string="Подать заявку" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ── Решение по спору ───────────────────────────────────────────── -->

  <record id="view_coop_bounty_dispute_form" model="ir.ui.view">
    <field name="name">coop.bounty.dispute.form</field>
    <field name="model">coop.bounty.dispute</field>
    <field name="arch" type="xml">
      <form string="Решение по спору">
        <field name="task_id" invisible="1"/>
        <p class="text-muted">Решение — по критериям приёмки и последней сдаче.</p>
        <field name="criterion_ids" nolabel="1" readonly="1">
          <list>
            <field name="name"/>
            <field name="done" string="Автор отметил"/>
          </list>
        </field>
        <field name="submission_ids" nolabel="1" readonly="1">
          <list>
            <field name="version"/>
            <field name="link" widget="url"/>
            <field name="note"/>
            <field name="state"/>
          </list>
        </field>
        <group>
          <field name="outcome" widget="radio"/>
          <field name="decision" placeholder="Почему принято такое решение — его увидят обе стороны"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Записать решение" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ── Сдача, доработка, отзыв (№ 464) ────────────────────────────── -->

  <record id="view_coop_bounty_submit_form" model="ir.ui.view">
    <field name="name">coop.bounty.submit.form</field>
    <field name="model">coop.bounty.submit</field>
    <field name="arch" type="xml">
      <form string="Сдать на проверку">
        <field name="task_id" invisible="1"/>
        <p class="text-muted">Приложите результат: ссылку, файлы или описание. После
           сдачи у автора семь дней на ответ — потом откроется спор.</p>
        <group>
          <field name="link" widget="url" placeholder="https://…"/>
          <field name="note" placeholder="Что сделано и где смотреть"/>
          <field name="attachment_ids" widget="many2many_binary"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Сдать на проверку" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_bounty_return_form" model="ir.ui.view">
    <field name="name">coop.bounty.return.form</field>
    <field name="model">coop.bounty.return</field>
    <field name="arch" type="xml">
      <form string="Вернуть на доработку">
        <field name="task_id" invisible="1"/>
        <field name="criterion_ids" nolabel="1" readonly="1">
          <list>
            <field name="name"/>
            <field name="done" string="Выполнено"/>
          </list>
        </field>
        <group>
          <field name="note" placeholder="Какие пункты не выполнены и что доработать"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Вернуть на доработку" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_bounty_review_wizard_form" model="ir.ui.view">
    <field name="name">coop.bounty.review.wizard.form</field>
    <field name="model">coop.bounty.review.wizard</field>
    <field name="arch" type="xml">
      <form string="Отзыв по задаче">
        <field name="task_id" invisible="1"/>
        <group>
          <field name="target_id" readonly="1"/>
          <field name="rating" widget="radio"/>
          <field name="body" placeholder="Что получилось и что стоило бы сделать иначе. Необязательно."/>
        </group>
        <footer>
          <button name="action_send" type="object" string="Отправить отзыв" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_bounty_application_form" model="ir.ui.view">
    <field name="name">coop.bounty.application.form</field>
    <field name="model">coop.bounty.application</field>
    <field name="arch" type="xml">
      <form string="Заявка на задачу" create="0">
        <sheet>
          <group>
            <group>
              <field name="task_id" readonly="1"/>
              <field name="partner_id" readonly="1"/>
              <field name="state" readonly="1"/>
            </group>
            <group>
              <field name="method_id" readonly="1"/>
              <field name="proposed_deadline" readonly="1"/>
            </group>
          </group>
          <field name="message" readonly="1"/>
          <field name="answer_ids" readonly="1">
            <list>
              <field name="question"/>
              <field name="answer"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ── Подписка на задачи (№ 464) ─────────────────────────────────── -->

  <record id="view_coop_bounty_subscription_form" model="ir.ui.view">
    <field name="name">coop.bounty.subscription.form</field>
    <field name="model">coop.bounty.subscription</field>
    <field name="arch" type="xml">
      <form string="Подписка на задачи">
        <sheet>
          <div class="oe_title"><h1>Подписка на новые задачи</h1></div>
          <p class="text-muted">Когда публикуется задача по вашим специализациям и городу,
             приходит уведомление в колокольчик. Задачи без города — удалённые — приходят
             при любом городе.</p>
          <group>
            <field name="partner_id" invisible="1"/>
            <field name="specialization_ids" widget="many2many_tags" options="{'no_create': True}"
                   placeholder="все специализации"/>
            <field name="city" widget="coop_city" placeholder="любой город — начните вводить"/>
            <field name="by_email"/>
            <field name="active" string="Подписка включена" widget="boolean_toggle"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_bounty_my_subscription" model="ir.actions.server">
    <field name="name">Подписка на задачи</field>
    <field name="model_id" ref="model_coop_bounty_subscription"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_my_subscription()</field>
  </record>

  <!-- ── Выполненные задачи в профиле человека (№ 464) ─────────────── -->

  <record id="view_coop_profile_form_bounty_done" model="ir.ui.view">
    <field name="name">res.partner.profile.coop.bounty.done</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="coop_profile.view_coop_profile_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='coop_edu_courses']/../../.." position="after">
        <div class="o_coop_infobox" invisible="not coop_bounty_done_count">
          <div class="o_coop_infobox_head">Выполненные задачи</div>
          <div class="o_coop_infobox_body">
            <field name="coop_bounty_done_html" nolabel="1" readonly="1"/>
            <div class="o_coop_infobox_add">
              <button name="action_coop_bounty_done" type="object" class="btn btn-link p-0">
                все — <field name="coop_bounty_done_count" class="d-inline"/>
              </button>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>

  <!-- ── Токен проекта (решение 690) ─────────────────────────────────── -->

  <record id="view_coop_project_form_crowd_token" model="ir.ui.view">
    <field name="name">coop.project.form.crowd.token</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_projects.view_coop_project_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='description']" position="after">
        <page string="Токен проекта" name="crowd_token" invisible="not coop_has_token">
          <p class="text-muted">Задачи проекта в краудсорсинге оплачиваются только его
             токенами. Экономику своего токена проект раскрывает сам — в рамках законов
             своей страны.</p>
          <group>
            <field name="coop_token_name" placeholder="Например: токен на продукцию проекта"/>
            <field name="coop_token_symbol" placeholder="Например: BREAD"/>
            <field name="coop_token_issued"/>
          </group>
          <field name="coop_token_economy"
                 placeholder="Что даёт токен, чем обеспечен, как и когда погашается"/>
        </page>
      </xpath>
      <!-- Включает токен инициатор; остальным видна только сама вкладка. -->
      <xpath expr="//page[@name='description']//field[@name='need_count']" position="before">
        <field name="coop_has_token" widget="boolean_toggle" invisible="not coop_can_edit"/>
      </xpath>
    </field>
  </record>

  <!-- То же на странице «Добавить проект» (`ProjectAddPage`). -->
  <record id="view_coop_project_add_crowd_token" model="ir.ui.view">
    <field name="name">coop.project.add.crowd.token</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_projects.view_coop_project_add"/>
    <field name="arch" type="xml">
      <xpath expr="//section[@name='add_money']//div[hasclass('coop-add_sec_body')]" position="inside">
        <div class="d-flex align-items-center gap-2">
          <field name="coop_has_token" widget="boolean_toggle" nolabel="1"/>
          <label for="coop_has_token" string="Проект выпускает токен"/>
        </div>
        <p class="coop-add_help" invisible="coop_has_token">
          Необязательно. Токеном проект оплачивает задачи в краудсорсинге.
        </p>
        <div class="coop-add_row" invisible="not coop_has_token">
          <div class="coop-add_field">
            <label for="coop_token_name" string="Название токена"/>
            <field name="coop_token_name" nolabel="1"
                   placeholder="Например: токен на продукцию проекта"/>
          </div>
          <div class="coop-add_field">
            <label for="coop_token_symbol" string="Тикер"/>
            <field name="coop_token_symbol" nolabel="1" placeholder="Например: BREAD"/>
          </div>
        </div>
      </xpath>
    </field>
  </record>

  <!-- ── Фонд задач платформы ───────────────────────────────────────── -->

  <record id="view_coop_bounty_fund_list" model="ir.ui.view">
    <field name="name">coop.bounty.fund.list</field>
    <field name="model">coop.bounty.fund</field>
    <field name="arch" type="xml">
      <list string="Фонд задач платформы">
        <field name="name"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="amount"/>
        <field name="reserved"/>
        <field name="paid"/>
        <field name="free"/>
        <field name="task_count"/>
      </list>
    </field>
  </record>

  <record id="view_coop_bounty_fund_form" model="ir.ui.view">
    <field name="name">coop.bounty.fund.form</field>
    <field name="model">coop.bounty.fund</field>
    <field name="arch" type="xml">
      <form string="Фонд задач платформы">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <p class="text-muted">Задачу платформы можно опубликовать, только
             когда вся её сумма отложена в резерв. Отменили задачу — резерв
             возвращается в фонд.</p>
          <group>
            <group string="Срок">
              <field name="date_start"/>
              <field name="date_end"/>
            </group>
            <group string="Токены">
              <field name="amount"/>
              <field name="reserved"/>
              <field name="paid"/>
              <field name="free"/>
            </group>
          </group>
          <field name="task_ids" readonly="1">
            <list>
              <field name="name"/>
              <field name="reward_tokens" sum="Всего"/>
              <field name="assignee_id"/>
              <field name="state" widget="badge"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_bounty_fund" model="ir.actions.act_window">
    <field name="name">Фонд задач платформы</field>
    <field name="res_model">coop.bounty.fund</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_coop_bounty_application" model="ir.actions.act_window">
    <field name="name">Заявки на задачи</field>
    <field name="res_model">coop.bounty.application</field>
    <field name="view_mode">list,form</field>
  </record>


  <!-- ── Краудсорсинг: каталог проектов и карточка проекта (№ 466) ───────
       Владелец 17.11.2026: «сделать новый пункт меню краудсорсинг, там
       разместить все проекты, в том числе наш с задачами, такую карточку
       проекта по краудсорсингу надо разместить в помощь проекту»; пункт —
       подразделом «Проектов» после «Каталога проектов». -->

  <record id="view_coop_project_crowd_kanban" model="ir.ui.view">
    <field name="name">coop.project.kanban.crowd</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_projects.view_coop_project_kanban"/>
    <field name="mode">primary</field>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="/kanban" position="attributes">
        <attribute name="create">0</attribute>
        <attribute name="class">o_coop_projects o_coop_crowd_projects</attribute>
      </xpath>
      <xpath expr="/kanban" position="inside">
        <!-- Подписка на новые задачи — кнопкой над плитками (решение 691,
             уточнение 18.11): своей вкладки в меню у неё больше нет. -->
        <header>
          <button name="%(action_coop_bounty_my_subscription)d" type="action"
                  string="Подписка на задачи" display="always"/>
        </header>
        <field name="coop_token_symbol"/>
        <field name="coop_token_unit"/>
        <field name="coop_crowd_open_count"/>
        <field name="coop_crowd_work_count"/>
        <field name="coop_crowd_done_count"/>
        <field name="coop_crowd_open_tokens"/>
      </xpath>
      <!-- Вместо шкалы сбора и «Участвовать» — то, ради чего сюда
           приходят: сколько задач открыто и чем за них платят. -->
      <xpath expr="//div[hasclass('o_coop_readiness')]" position="replace">
        <div class="o_coop_crowd_token">
          <field name="coop_token_name"/>
        </div>
        <ul class="o_coop_crowd_stats">
          <li><b><t t-out="record.coop_crowd_open_count.value"/></b> открыто</li>
          <li><b><t t-out="record.coop_crowd_work_count.value"/></b> в работе</li>
          <li><b><t t-out="record.coop_crowd_done_count.value"/></b> принято</li>
        </ul>
      </xpath>
      <xpath expr="//div[hasclass('o_coop_tile_act')]" position="replace">
        <div class="o_coop_tile_act">
          <span class="o_coop_bounty_reward" t-if="record.coop_crowd_open_tokens.raw_value">
            <t t-out="record.coop_crowd_open_tokens.value + ' ' + record.coop_token_unit.value + ' за открытые задачи'"/>
          </span>
        </div>
      </xpath>
    </field>
  </record>

  <record id="view_coop_project_crowd_form" model="ir.ui.view">
    <field name="name">coop.project.form.crowd</field>
    <field name="model">coop.project</field>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <form string="Краудсорсинг" class="o_coop_show o_coop_crowd_card"
            create="0" edit="0" delete="0" duplicate="0">
        <field name="coop_is_cooptech" invisible="1"/>
        <sheet>
          <!-- Шапка — та же витрина, что у страницы проекта (`ProjectPage`):
               снимки, вид, название, строка каталога, город, инициатор. -->
          <section class="coop-show_hero">
            <div class="coop-gallery">
              <field name="coop_media_data" widget="coop_media" nolabel="1" readonly="1"/>
              <span class="coop-gallery_badge">
                <field name="state" readonly="1" nolabel="1"/>
              </span>
            </div>
            <div class="coop-show_info">
              <div class="coop-show_kicker">
                <span>Краудсорсинг</span>
                <field name="kind" readonly="1" nolabel="1" class="coop-pj_kind"/>
              </div>
              <div class="oe_title">
                <h1 class="coop-show_title"><field name="name" readonly="1" nolabel="1"/></h1>
              </div>
              <field name="summary" class="coop-pj_lead" readonly="1" nolabel="1"
                     invisible="not summary"/>
              <ul class="coop-show_meta">
                <li class="coop-meta_city" invisible="not city">
                  <field name="city" readonly="1" nolabel="1"/>
                </li>
              </ul>
              <hr class="coop-show_rule"/>
              <div class="coop-price">
                <span class="coop-price_label">Оплата задач</span>
                <span class="coop-price_value">
                  <field name="coop_token_name" readonly="1" nolabel="1"/>
                </span>
                <span class="coop-price_note" invisible="not coop_token_symbol">
                  <field name="coop_token_symbol" readonly="1" nolabel="1"/>
                </span>
              </div>
              <ul class="o_coop_crowd_stats o_coop_crowd_stats_big">
                <li><b><field name="coop_crowd_open_count" readonly="1" nolabel="1"/></b> открыто</li>
                <li><b><field name="coop_crowd_work_count" readonly="1" nolabel="1"/></b> в работе</li>
                <li><b><field name="coop_crowd_done_count" readonly="1" nolabel="1"/></b> принято</li>
                <li><b><field name="coop_token_issued" readonly="1" nolabel="1"/></b> <field name="coop_token_unit" nolabel="1"/> начислено</li>
              </ul>
              <div class="coop-pj_owner">
                <div class="coop-pj_who">
                  <field name="partner_id" widget="many2one_avatar" nolabel="1" readonly="1"/>
                  <span class="coop-pj_owner_note">инициатор</span>
                </div>
              </div>
              <div class="coop-show_acts">
                <button name="action_coop_crowd_tasks" type="object" string="Все задачи проекта"
                        class="btn-primary"/>
                <button name="action_coop_open_project_page" type="object"
                        string="Страница проекта" class="btn-secondary"
                        invisible="coop_is_cooptech"/>
                <!-- Фонд задач платформы — из карточки нашего проекта,
                     только менеджерам (решение 691, уточнение 18.11). -->
                <button name="%(action_coop_bounty_fund)d" type="action"
                        string="Фонд задач" class="btn-secondary"
                        invisible="not coop_is_cooptech"
                        groups="coop_bounty.group_coop_community_manager,coop_base.group_coop_platform"/>
              </div>
            </div>
          </section>

          <div class="o_coop_crowd_block">
            <h2 class="o_coop_crowd_head">Экономика токена</h2>
            <p class="text-muted">Проект раскрывает её сам — в рамках законов своей страны.</p>
            <field name="coop_token_economy" readonly="1" nolabel="1"/>
          </div>

          <div class="o_coop_crowd_block">
            <h2 class="o_coop_crowd_head">Задачи проекта</h2>
            <!-- Плитка открывает полную карточку задачи в кабинете, а не
                 окно поверх карточки проекта: там заявка, критерии, сдачи. -->
            <field name="coop_bounty_task_ids" mode="kanban" readonly="1" nolabel="1">
              <kanban action="action_coop_open_card" type="object" class="o_coop_crowd_tasks">
                <field name="state"/>
                <field name="reward_tokens"/>
                <field name="token_unit"/>
                <field name="coop_specialization_id"/>
                <field name="deadline"/>
                <field name="application_count"/>
                <templates>
                  <t t-name="card">
                    <div class="o_coop_listing o_coop_bounty_card">
                      <div class="o_coop_listing_body">
                        <div class="o_coop_listing_title"><field name="name"/></div>
                        <div class="o_coop_listing_meta">
                          <span><field name="state"/></span>
                          <span t-if="record.coop_specialization_id.raw_value"> · <field name="coop_specialization_id"/></span>
                          <span t-if="record.application_count.raw_value"> · заявок: <t t-out="record.application_count.value"/></span>
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                          <span class="o_coop_bounty_reward">
                            <t t-out="record.reward_tokens.value"/> <t t-out="record.token_unit.value"/>
                          </span>
                          <span class="text-muted small" t-if="record.deadline.raw_value">
                            до <field name="deadline"/>
                          </span>
                        </div>
                      </div>
                    </div>
                  </t>
                </templates>
              </kanban>
            </field>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_coop_crowd_projects" model="ir.actions.act_window">
    <field name="name">Краудсорсинг</field>
    <field name="res_model">coop.project</field>
    <field name="path">crowdsourcing</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('coop_bounty_task_ids', '!=', False)]</field>
    <field name="context">{'bin_size': True, 'coop_catalog': True, 'coop_shelf_field': 'category_id', 'coop_pm_section': 'crowdsourcing'}</field>
    <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_coop_project_crowd_kanban')}),
        (0, 0, {'view_mode': 'list', 'view_id': ref('coop_projects.view_coop_project_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_coop_project_crowd_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Задач у проектов пока нет</p>
      <p>Проекты ставят здесь задачи и платят за них своими токенами.</p>
    </field>
  </record>

  <!-- «Помощь проекту» в подвале кабинета — карточка нашего проекта. -->
  <record id="action_coop_help_project" model="ir.actions.server">
    <field name="name">Помощь проекту</field>
    <field name="model_id" ref="coop_projects.model_coop_project"/>
    <field name="path">help-project</field>
    <field name="state">code</field>
    <field name="code">action = model._coop_action_help_project()</field>
  </record>

  <menuitem id="menu_coop_crowd_projects" name="Краудсорсинг"
            parent="coop_projects.menu_coop_projects_root"
            action="action_coop_crowd_projects" sequence="15"/>

  <!-- Своей вкладки в меню у краудсорсинга нет (решение 691): плоский
       список всех задач всех проектов (`/bounty`) убран, подписка —
       кнопкой над каталогом, фонд — в карточке нашего проекта, заявки —
       в карточке задачи. Пункты удаляет обновление модуля: записей
       меню больше нет в данных. -->

</odoo>
