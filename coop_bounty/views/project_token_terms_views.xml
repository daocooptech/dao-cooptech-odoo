<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Разблокировка по сроку и партии — на вкладке «Токен проекта»
       (№ 485, решение 703). -->
  <record id="view_coop_project_form_token_terms" model="ir.ui.view">
    <field name="name">coop.project.form.token.terms</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_bounty.view_coop_project_form_crowd_token"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='crowd_token']" position="inside">
        <field name="coop_my_tokens" invisible="1"/>
        <group string="У вас" invisible="not coop_my_tokens">
          <field name="coop_my_tokens"/>
          <field name="coop_my_available"/>
          <field name="coop_my_locked" invisible="not coop_my_locked"/>
        </group>
        <group string="Разблокировка по сроку"
               invisible="coop_token_kind not in ('share', 'certificate', 'profit') or (not coop_vest and not coop_can_edit)">
          <field name="coop_vest" widget="boolean_toggle" readonly="not coop_can_edit"/>
          <field name="coop_vest_cliff" invisible="not coop_vest"/>
          <field name="coop_vest_months" invisible="not coop_vest"/>
        </group>
        <div invisible="coop_token_kind != 'claim' or (not coop_batch_ids and not coop_can_edit)">
          <div class="o_horizontal_separator text-uppercase fw-bolder small">Партии</div>
          <p class="text-muted">Одинаковые единицы с общим номером и сроком. Держатель меняет
             токены на единицу и получает именной талон.</p>
          <field name="coop_batch_ids" nolabel="1" readonly="not coop_can_edit">
            <list editable="bottom">
              <field name="number" optional="show"/>
              <field name="name"/>
              <field name="price" string="Цена, токенов"/>
              <field name="quantity"/>
              <field name="left"/>
              <field name="used" optional="show"/>
              <field name="date_from" optional="show"/>
              <field name="date_to"/>
              <field name="can_take" column_invisible="True"/>
              <button name="action_take" type="object" string="Взять" class="btn-secondary"
                      invisible="not can_take"
                      confirm="Обменять токены на талон?"/>
            </list>
          </field>
        </div>
        <div invisible="not coop_ticket_ids">
          <div class="o_horizontal_separator text-uppercase fw-bolder small">Талоны</div>
          <field name="coop_ticket_ids" nolabel="1" readonly="1">
            <list create="0" edit="0" delete="0" decoration-muted="status in ('used', 'cancelled', 'expired')">
              <field name="number"/>
              <field name="batch_name"/>
              <field name="partner_id"/>
              <field name="taken_on" optional="show"/>
              <field name="date_to"/>
              <field name="status" widget="badge" decoration-success="status == 'active'"
                     decoration-danger="status == 'expired'"/>
              <field name="can_manage" column_invisible="True"/>
              <button name="action_use" type="object" string="Погасить"
                      invisible="not can_manage or status != 'active'"/>
              <button name="action_cancel" type="object" string="Отменить"
                      invisible="not can_manage or status not in ('active', 'expired')"
                      confirm="Отменить талон? Токены вернутся держателю."/>
            </list>
          </field>
        </div>
      </xpath>
    </field>
  </record>

</odoo>
