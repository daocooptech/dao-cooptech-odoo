<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Улучшения П2 (№ 465): шкала частичной оплаты, команда, постоянная
       задача, спор от исполнителя, медиана суммы и время ответа автора. -->

  <record id="view_coop_bounty_task_form_p2" model="ir.ui.view">
    <field name="name">coop.bounty.task.form.p2</field>
    <field name="model">coop.bounty.task</field>
    <field name="inherit_id" ref="coop_bounty.view_coop_bounty_task_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_accept']" position="after">
        <button name="action_accept_partial" type="object" string="Принять частично"
                invisible="state not in ('submitted', 'dispute') or not coop_can_edit or not partial_percent"
                confirm="Принять результат частично? Будет выплачена часть суммы по шкале задачи."/>
        <button name="action_start_team" type="object" string="Начать неполной командой"
                invisible="state != 'published' or not member_count or not coop_can_edit"/>
      </xpath>
      <xpath expr="//button[@name='action_apply']" position="attributes">
        <attribute name="invisible">state != 'published' or my_application_state != 'none' or coop_can_edit or is_recurring</attribute>
      </xpath>
      <xpath expr="//button[@name='action_submit']" position="after">
        <button name="action_submit_recurring" type="object" string="Сдать результат"
                class="btn-primary" invisible="not can_submit_recurring"/>
        <button name="action_open_executor_dispute" type="object" string="Открыть спор"
                invisible="not can_open_dispute"/>
      </xpath>

      <xpath expr="//field[@name='reminded_on']" position="after">
        <field name="is_recurring" invisible="1"/>
        <field name="can_submit_recurring" invisible="1"/>
        <field name="can_open_dispute" invisible="1"/>
        <field name="member_count" invisible="1"/>
        <field name="dispute_by" invisible="1"/>
      </xpath>

      <!-- Спор открыл исполнитель — у него своё объяснение. -->
      <xpath expr="//div[hasclass('alert-danger')]" position="attributes">
        <attribute name="invisible">state != 'dispute' or dispute_by == 'executor'</attribute>
      </xpath>
      <xpath expr="//div[hasclass('alert-danger')]" position="after">
        <div class="alert alert-danger" role="status" invisible="state != 'dispute' or dispute_by != 'executor'">
          Исполнитель открыл спор: <field name="dispute_reason" class="d-inline"/>
          Его разбирает администратор платформы и записывает объяснение решения.
        </div>
        <div class="alert alert-info" role="status" invisible="not can_open_dispute">
          Результат возвращали на доработку больше двух раз или задачу отменили после сдачи —
          вы можете открыть спор, его разберёт администратор платформы.
        </div>
        <div class="alert alert-info" role="status"
             invisible="not is_recurring or state != 'published'">
          Постоянная задача: результат сдаёт любой участник без заявки, каждый принятый
          оплачивается. Оплачено <field name="repeat_done" class="d-inline"/> из
          <field name="repeat_limit" class="d-inline" readonly="1"/>.
        </div>
        <div class="alert alert-info" role="status"
             invisible="executor_limit &lt; 2 or state != 'published' or not member_count">
          Команда собирается: утверждено <field name="member_count" class="d-inline"/> из
          <field name="executor_limit" class="d-inline" readonly="1"/>. Задача открыта для заявок,
          пока команда не собрана.
        </div>
      </xpath>
      <xpath expr="//field[@name='days_to_dispute']/.." position="inside">
        Ответ автора — до <field name="answer_due" class="d-inline"/>.
      </xpath>

      <xpath expr="//field[@name='fund_free']" position="after">
        <field name="payer_answer_label" invisible="not payer_answer_label"/>
      </xpath>
      <xpath expr="//field[@name='reward_tokens'][@widget='coop_inline']" position="after">
        <field name="median_hint" invisible="not median_hint or state != 'draft' or not coop_can_edit"/>
        <field name="partial_percent" widget="coop_inline"
               invisible="state != 'draft' and not partial_percent"
               readonly="not coop_can_edit or state != 'draft'"/>
        <field name="is_recurring" widget="boolean_toggle"
               invisible="state != 'draft' and not is_recurring"
               readonly="not coop_can_edit or state != 'draft'"/>
        <field name="repeat_limit" widget="coop_inline" invisible="not is_recurring"
               readonly="not coop_can_edit or state != 'draft'"/>
        <field name="executor_limit" widget="coop_inline"
               invisible="is_recurring or (state != 'draft' and executor_limit &lt; 2)"
               readonly="not coop_can_edit or state != 'draft'"/>
        <field name="paid_amount" invisible="not paid_amount"/>
        <field name="accepted_partially" invisible="not accepted_partially"/>
      </xpath>

      <!-- Сдачи постоянной задачи принимают и возвращают по одной; свои
           сдачи видит каждый сдавший. -->
      <xpath expr="//page[@name='submissions']" position="attributes">
        <attribute name="invisible">not submission_ids or (not coop_can_edit and not is_mine and not is_arbiter and not is_recurring)</attribute>
      </xpath>
      <xpath expr="//page[@name='submissions']//field[@name='version']" position="before">
        <field name="partner_id" column_invisible="not parent.is_recurring"/>
        <field name="date"/>
      </xpath>
      <xpath expr="//page[@name='submissions']//field[@name='create_date']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='submissions']//field[@name='review_note']" position="after">
        <button name="action_accept_result" type="object" string="Принять и оплатить" icon="check"
                invisible="state != 'review' or not parent.is_recurring or not parent.coop_can_edit"/>
        <button name="action_return_result" type="object" string="Вернуть" icon="undo"
                invisible="state != 'review' or not parent.is_recurring or not parent.coop_can_edit"/>
      </xpath>

      <xpath expr="//page[@name='submissions']" position="after">
        <page string="Команда" name="team" invisible="not member_ids">
          <p class="text-muted">Доли пусты — сумма делится поровну. Результат за команду сдаёт
            тот, у кого отмечено «Сдаёт».</p>
          <field name="member_ids" nolabel="1"
                 readonly="not coop_can_edit or state in ('accepted', 'cancelled')">
            <list editable="bottom" create="0" delete="0">
              <field name="partner_id" readonly="1"/>
              <field name="share_percent" string="Доля, %" width="90px"/>
              <field name="is_lead" string="Сдаёт" widget="boolean" readonly="1" width="70px"/>
            </list>
          </field>
        </page>
        <page string="Выплаты" name="payouts" invisible="not payout_ids">
          <field name="payout_ids" nolabel="1" readonly="1">
            <list>
              <field name="date"/>
              <field name="partner_id"/>
              <field name="amount" sum="Всего"/>
              <field name="token_unit" string=""/>
              <field name="partial" widget="boolean"/>
              <field name="submission_id" optional="hide"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

  <record id="view_coop_bounty_task_list_p2" model="ir.ui.view">
    <field name="name">coop.bounty.task.list.p2</field>
    <field name="model">coop.bounty.task</field>
    <field name="inherit_id" ref="coop_bounty.view_coop_bounty_task_list"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='reward_tokens']" position="after">
        <field name="paid_amount" optional="hide"/>
        <field name="is_recurring" optional="hide"/>
        <field name="executor_limit" optional="hide"/>
      </xpath>
    </field>
  </record>

  <record id="view_coop_bounty_task_search_p2" model="ir.ui.view">
    <field name="name">coop.bounty.task.search.p2</field>
    <field name="model">coop.bounty.task</field>
    <field name="inherit_id" ref="coop_bounty.view_coop_bounty_task_search"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='assignee_id']" position="after">
        <filter name="recurring" string="Постоянные" domain="[('is_recurring', '=', True)]"/>
        <filter name="team" string="Командой" domain="[('executor_limit', '&gt;', 1)]"/>
        <filter name="partial_scale" string="С частичной оплатой" domain="[('partial_percent', '&gt;', 0)]"/>
      </xpath>
    </field>
  </record>

  <record id="view_coop_bounty_dispute_form_p2" model="ir.ui.view">
    <field name="name">coop.bounty.dispute.form.p2</field>
    <field name="model">coop.bounty.dispute</field>
    <field name="inherit_id" ref="coop_bounty.view_coop_bounty_dispute_form"/>
    <field name="arch" type="xml">
      <xpath expr="//p[hasclass('text-muted')]" position="after">
        <field name="dispute_by" invisible="1"/>
        <div class="alert alert-warning" role="status" invisible="dispute_by != 'executor'">
          Спор открыл исполнитель: <field name="dispute_reason" class="d-inline" readonly="1"/>
        </div>
      </xpath>
      <xpath expr="//field[@name='outcome']" position="after">
        <field name="partial_percent" string="Частично — % суммы" readonly="1"
               invisible="not partial_percent"/>
      </xpath>
    </field>
  </record>

  <record id="view_coop_bounty_dispute_open_form" model="ir.ui.view">
    <field name="name">coop.bounty.dispute.open.form</field>
    <field name="model">coop.bounty.dispute.open</field>
    <field name="arch" type="xml">
      <form string="Открыть спор">
        <field name="task_id" invisible="1"/>
        <p class="text-muted">Спор разбирает администратор платформы — по критериям приёмки и
          вашим сдачам. Его решение с объяснением увидят обе стороны.</p>
        <group>
          <field name="reason" placeholder="Что сделано, почему результат должен быть принят"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Открыть спор" class="btn-primary"/>
          <button string="Отмена" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
