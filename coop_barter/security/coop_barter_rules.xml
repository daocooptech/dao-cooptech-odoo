<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Объявления видят все вошедшие, правит — тот, чьё объявление. -->
    <record id="rule_barter_offer_read" model="ir.rule">
      <field name="name">Бартер — объявления читают участники</field>
      <field name="model_id" ref="model_coop_barter_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_barter_offer_own" model="ir.rule">
      <field name="name">Бартер — объявление правит автор</field>
      <field name="model_id" ref="model_coop_barter_offer"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
    </record>
    <!-- Обмен видят и ведут только его участники: это переговоры. -->
    <record id="rule_barter_exchange_party" model="ir.rule">
      <field name="name">Бартер — обмен видят участники</field>
      <field name="model_id" ref="model_coop_barter_exchange"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('participant_ids', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>
    <record id="rule_barter_leg_party" model="ir.rule">
      <field name="name">Бартер — передачи видят участники обмена</field>
      <field name="model_id" ref="model_coop_barter_leg"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('exchange_id.participant_ids', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>
    <record id="rule_barter_match_own" model="ir.rule">
      <field name="name">Бартер — подбор видит тот, кто подбирал</field>
      <field name="model_id" ref="model_coop_barter_match"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_barter_offer_admin" model="ir.rule">
      <field name="name">Бартер — объявления, администратор</field>
      <field name="model_id" ref="model_coop_barter_offer"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_barter_exchange_admin" model="ir.rule">
      <field name="name">Бартер — обмены, администратор</field>
      <field name="model_id" ref="model_coop_barter_exchange"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_barter_leg_admin" model="ir.rule">
      <field name="name">Бартер — передачи, администратор</field>
      <field name="model_id" ref="model_coop_barter_leg"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
  </data>
</odoo>
