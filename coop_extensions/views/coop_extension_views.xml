<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Каталог карточками. Штатный список приложений Odoo говорит на языке
    разработчика: технические имена, зависимости, версии. Кооператору нужно
    другое — что он получит и во сколько это обойдётся, поэтому на карточке
    сначала польза и условия, а технический модуль спрятан в форму.
  -->
  <record id="view_coop_extension_kanban" model="ir.ui.view">
    <field name="name">coop.extension.kanban</field>
    <field name="model">coop.extension</field>
    <field name="arch" type="xml">
      <!--
        Без группировки по разделу. Колонки канбана растут вправо, и
        каталог из шести разделов уезжал за правый край: чтобы увидеть
        «Интеграции», надо было прокручивать экран вбок. Плитки в один
        поток переносятся по ширине области и листаются только вниз, а
        раздел у карточки написан над названием. Порядок при этом
        держит расширения одного раздела рядом.
      -->
      <kanban class="o_coop_ext" quick_create="false"
              js_class="coop_extension_kanban"
              default_order="category, sequence, name">
        <!-- Поля, которые участвуют только в условиях шаблона, всё равно
             надо объявить: иначе Odoo их не подгрузит, и карточка упадёт
             на чтении undefined. -->
        <field name="is_installed"/>
        <field name="coop_connect_state"/>
        <field name="module_id"/>
        <field name="module_state"/>
        <field name="is_official"/>
        <field name="pricing"/>
        <field name="icon"/>
        <field name="source"/>
        <field name="store_url"/>
        <field name="kind"/>
        <templates>
          <t t-name="card">
            <!-- Общая карточка каталога: слева квадрат, справа тело.
                 Фотографии у модуля нет и быть не может, поэтому в
                 квадрате символ раздела — но геометрия та же, что у
                 карточек с настоящими снимками. -->
            <div class="o_coop_listing o_coop_ext_card">
              <div class="o_coop_listing_ico o_coop_ext_ico">
                <!-- Контур по разделу (виджет `coop_sign`), а не эмодзи
                     из поля `icon`: эталон `ExtensionsPage`. -->
                <field name="category" widget="coop_sign" options="{'size': 22, 'icon': 'puzzle', 'map': {'accounting': 'receipt', 'process': 'settings', 'sales': 'shopping-cart', 'finance': 'credit-card', 'community': 'building-community', 'integration': 'plug-connected', 'localization': 'world'}}"/>
              </div>
              <div class="o_coop_listing_body">
              <div class="o_coop_ext_cat">
                <field name="kind"/> · <field name="category"/> · <field name="source"/>
              </div>
              <div class="o_coop_ext_title">
                <field name="name"/>
              </div>
              <div class="o_coop_ext_summary">
                <field name="summary"/>
              </div>
              <div class="o_coop_ext_foot">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <!-- «Подключено» — в меню того лица, от имени которого
                       человек действует (решение 468), а не «стоит на
                       платформе»: модуль ставится один раз на всех. -->
                  <span t-if="record.coop_connect_state.raw_value == 'base'"
                        class="o_coop_badge o_coop_on">✓ Есть у всех</span>
                  <span t-if="record.coop_connect_state.raw_value == 'on'"
                        class="o_coop_badge o_coop_on">✓ Подключено</span>
                  <span t-if="record.coop_connect_state.raw_value == 'installing'"
                        class="o_coop_badge o_coop_wait">Устанавливается</span>
                  <!-- Плагин в меню не ставится (как в Odoo, владелец
                       19.10.2026): у него только «включён на платформе» или
                       нет. -->
                  <span t-if="record.kind.raw_value == 'plugin' and record.module_state.raw_value == 'installed'"
                        class="o_coop_badge o_coop_on">✓ Включён на платформе</span>
                  <span t-if="record.kind.raw_value == 'plugin' and record.module_id.raw_value and record.module_state.raw_value != 'installed'"
                        class="o_coop_badge o_coop_off">Не установлен</span>
                  <span t-if="record.kind.raw_value == 'app' and record.coop_connect_state.raw_value == 'off' and record.module_id.raw_value"
                        class="o_coop_badge o_coop_off">Не подключено</span>
                  <span t-if="!record.module_id.raw_value and record.source.raw_value != 'third'"
                        class="o_coop_badge o_coop_off">Заявлено</span>
                  <span t-if="record.source.raw_value == 'third'"
                        class="o_coop_badge o_coop_third">Магазин Odoo</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="o_coop_ext_price"
                        t-attf-class="o_coop_ext_price {{ record.pricing.raw_value == 'free' ? 'o_coop_free' : '' }}">
                    <field name="price_label"/>
                  </span>
                  <!-- Подключает лицу: человеку — в его меню, организации
                       — в общее (решение 468). Модуля на платформе нет —
                       пункт встаёт «устанавливается», это заявка рабочей
                       группе (решение 463). -->
                  <button t-if="record.kind.raw_value == 'app' and record.coop_connect_state.raw_value == 'off' and record.module_id.raw_value"
                          name="action_coop_connect" type="object"
                          class="btn o_coop_action">
                    Подключить
                  </button>
                  <!-- Убрать из своего меню — здесь же, на карточке
                       (владелец 19.10.2026: «нет возможности удалить модуль
                       у пользователя, чтобы он исчез из левого меню»).
                       Модуль на платформе остаётся. -->
                  <button t-if="record.coop_connect_state.raw_value == 'on' or record.coop_connect_state.raw_value == 'installing'"
                          name="action_coop_disconnect" type="object"
                          class="btn o_coop_action o_coop_action_off">
                    Убрать из меню
                  </button>
                  <!-- Стороннее — витрина и ссылка (решение 463): кода
                       на платформе нет, подключать нечего. -->
                  <button t-if="record.source.raw_value == 'third' and record.store_url.raw_value"
                          name="action_open_store" type="object"
                          class="btn o_coop_action">
                    В магазине Odoo
                  </button>
                </div>
              </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_extension_list" model="ir.ui.view">
    <field name="name">coop.extension.list</field>
    <field name="model">coop.extension</field>
    <field name="arch" type="xml">
      <list string="Расширения">
        <field name="name"/>
        <field name="category"/>
        <field name="summary" optional="show"/>
        <field name="author_id" optional="hide"/>
        <field name="price_label" string="Стоимость"/>
        <field name="is_installed" widget="boolean_toggle" readonly="1"
               string="Подключено"/>
        <field name="publication_state" widget="badge"
               decoration-success="publication_state == 'published'"
               decoration-warning="publication_state == 'review'"/>
      </list>
    </field>
  </record>

  <record id="view_coop_extension_form" model="ir.ui.view">
    <field name="name">coop.extension.form</field>
    <field name="model">coop.extension</field>
    <field name="arch" type="xml">
      <form string="Расширение" js_class="coop_extension_form">
        <header>
          <field name="coop_connect_state" invisible="1"/>
          <button name="action_coop_connect" type="object" string="Подключить"
                  class="btn-primary"
                  invisible="coop_connect_state != 'off' or not module_id or kind == 'plugin'"/>
          <button name="action_coop_disconnect" type="object" string="Убрать из меню"
                  invisible="coop_connect_state in ('off', 'base')"/>
          <button name="action_install" type="object" string="Установить на платформу"
                  invisible="is_installed or not module_id"
                  groups="base.group_system,coop_base.group_coop_platform"
                  confirm="Установить модуль на платформу? Он ставится в общую базу, для всех участников."/>
          <button name="action_publish" type="object" string="Опубликовать в каталоге"
                  invisible="publication_state == 'published'"/>
          <button name="action_archive_listing" type="object" string="Снять с публикации"
                  invisible="publication_state != 'published'"/>
          <field name="publication_state" widget="statusbar"
                 statusbar_visible="draft,review,published"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Название расширения"/></h1>
            <h3><field name="summary"
                       placeholder="Одна фраза: что это даёт участнику"/></h3>
          </div>
          <group>
            <group string="Что это">
              <field name="kind"/>
              <field name="category"/>
              <field name="author_id"/>
              <field name="is_official"/>
            </group>
            <group string="Условия">
              <field name="pricing"/>
              <field name="price" invisible="pricing == 'free'"/>
              <field name="currency_id" invisible="pricing == 'free'"/>
              <field name="price_label" readonly="1"/>
            </group>
          </group>
          <group string="Технический модуль">
            <field name="module_name"
                   placeholder="stock, dms, base_tier_validation…"/>
            <field name="module_id" readonly="1"/>
            <field name="module_state" readonly="1"/>
            <field name="is_installed" readonly="1"/>
          </group>
          <div class="alert alert-info" role="status">
            Расширение — это обычный модуль Odoo. «Подключить» ставит его в меню
            того, от чьего имени вы действуете: в ваше или в общее меню организации.
            Модуля на платформе ещё нет — пункт встаёт с пометкой «устанавливается»,
            модуль ставит рабочая группа после проверки кода. Витрина нужна затем, что штатный список приложений говорит на языке
            разработчика, а участнику надо понимать, что он получит и во сколько
            это обойдётся. Условия назначает автор: плата за расширение — это его
            отношения с участником, платформа стороной не становится.
          </div>
          <notebook>
            <page string="Описание">
              <field name="description" placeholder="Подробно: что делает, кому нужно, чего не делает"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_extension_search" model="ir.ui.view">
    <field name="name">coop.extension.search</field>
    <field name="model">coop.extension</field>
    <field name="arch" type="xml">
      <search string="Расширения">
        <field name="name"/>
        <field name="summary"/>
        <field name="author_id"/>
        <filter name="apps" string="Расширения" domain="[('kind', '=', 'app')]"/>
        <filter name="plugins" string="Плагины" domain="[('kind', '=', 'plugin')]"/>
        <separator/>
        <filter name="installed" string="Подключённые" domain="[('coop_connected', '=', True)]"/>
        <filter name="available" string="Доступные" domain="[('coop_connected', '=', False)]"/>
        <separator/>
        <filter name="free" string="Бесплатные" domain="[('pricing', '=', 'free')]"/>
        <filter name="official" string="Расширения платформы" domain="[('is_official', '=', True)]"/>
        <filter name="third" string="Сторонние" domain="[('is_official', '=', False)]"/>
        <group>
          <filter name="by_kind" string="По виду" context="{'group_by': 'kind'}"/>
          <filter name="by_cat" string="По разделу" context="{'group_by': 'category'}"/>
          <filter name="by_price" string="По условиям" context="{'group_by': 'pricing'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Два раздела каталога — это два действия с разным набором по умолчанию,
       а не один список с фильтром: «что у меня стоит» и «что вообще есть» —
       разные вопросы, и человек задаёт их в разные моменты. -->
  <record id="action_coop_extension_installed" model="ir.actions.act_window">
    <field name="name">Установленные</field>
    <field name="path">extensions-installed</field>
    <field name="res_model">coop.extension</field>
    <field name="context">{'coop_filters': True}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('coop_connected', '=', True)]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Пока ничего не подключено</p>
      <p>Загляните в общий каталог: там расширения платформы и сторонние
         разработки — склад, документооборот, согласования, обмен с 1С.</p>
    </field>
  </record>

  <record id="action_coop_extension_catalog" model="ir.actions.act_window">
    <field name="name">Общий каталог</field>
    <field name="res_model">coop.extension</field>
    <field name="path">extensions</field>
    <field name="context">{'coop_filters': True}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('publication_state', '=', 'published'), ('kind', '=', 'app')]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">В каталоге пока пусто</p>
      <p>Своё расширение может опубликовать любой участник и сам назначить
         условия: бесплатно, помесячно, за год или единовременно навсегда.</p>
    </field>
  </record>

  <!-- Плагины — отдельно от расширений, как в Odoo (владелец 19.10.2026):
       своего раздела у них нет, в меню они не ставятся. Включает их на
       платформе рабочая группа. -->
  <record id="action_coop_extension_plugins" model="ir.actions.act_window">
    <field name="name">Плагины</field>
    <field name="res_model">coop.extension</field>
    <field name="path">plugins</field>
    <field name="context">{'coop_filters': True}</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('publication_state', '=', 'published'), ('kind', '=', 'plugin')]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Плагинов пока нет</p>
      <p>Плагин работает внутри других разделов — добавляет поле, печатную
         форму, способ оплаты. Своего пункта в меню у него нет.</p>
    </field>
  </record>

  <record id="action_coop_extension_mine" model="ir.actions.act_window">
    <field name="name">Мои публикации</field>
    <field name="res_model">coop.extension</field>
    <field name="path">my-extensions</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('author_id.user_ids', 'in', [uid])]</field>
    <field name="context">{'default_publication_state': 'draft', 'coop_filters': True}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы ещё ничего не публиковали</p>
      <p>Расширение — обычный модуль Odoo. Опишите, что он даёт участнику,
         назначьте условия и отправьте в каталог.</p>
    </field>
  </record>

</odoo>
