<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="coop_documents.PdfThumb">
    <img t-if="this.state.src" class="o_coop_doc_thumb_img" t-att-src="this.state.src" alt="Первая страница"/>
    <div t-elif="!this.state.failed" class="o_coop_doc_thumb_wait"><i class="fa fa-file-pdf-o"/></div>
  </t>

  <t t-name="coop_documents.Upload">
    <div class="o_action o_coop_doc_upload">
      <div class="o_coop_doc_upload_inner">
        <h2>Загрузить документы</h2>

        <label class="form-label" for="coop_upload_folder">В папку</label>
        <select id="coop_upload_folder" class="form-select mb-3" t-model.proxy="this.state.folderId">
          <option value="">Без папки</option>
          <option t-foreach="this.state.folders" t-as="folder" t-key="folder.id"
                  t-att-value="folder.id" t-out="folder.display_name"/>
        </select>

        <!-- Перетащить файлы или целую папку: вложенные папки заводятся
             сами, по пути внутри неё. -->
        <div class="o_coop_doc_drop" t-att-class="{ 'o_coop_doc_drop_over': this.state.over }"
             t-on-dragover.prevent="() => this.state.over = true"
             t-on-dragleave="() => this.state.over = false"
             t-on-drop="this.onDrop">
          <i class="fa fa-cloud-upload"/>
          <div>Перетащите сюда файлы или папку целиком</div>
          <div class="o_coop_doc_drop_btns">
            <button type="button" class="btn btn-secondary" t-on-click="() => this.filesRef().click()">
              <i class="fa fa-file-o"/> Выбрать файлы
            </button>
            <button type="button" class="btn btn-secondary" t-on-click="() => this.folderRef().click()">
              <i class="fa fa-folder-o"/> Выбрать папку
            </button>
          </div>
          <input type="file" multiple="multiple" class="d-none" t-ref="this.filesRef" t-on-change="this.onPickFiles"/>
          <input type="file" multiple="multiple" webkitdirectory="" class="d-none" t-ref="this.folderRef"
                 t-on-change="this.onPickFiles"/>
        </div>

        <t t-if="this.state.queue.length">
          <ul class="o_coop_doc_queue">
            <li t-foreach="this.state.queue" t-as="item" t-key="item_index">
              <i class="fa fa-file-o"/>
              <span class="o_coop_doc_queue_path" t-out="item.path"/>
              <span class="text-muted" t-out="this.sizeLabel(item.size)"/>
              <button type="button" class="btn btn-link btn-sm" t-att-disabled="this.state.busy"
                      t-on-click="() => this.remove(item_index)" title="Убрать">×</button>
            </li>
          </ul>
          <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="this.upload">
            <t t-if="this.state.busy">Загружаю… <t t-out="this.state.done"/> из <t t-out="this.state.queue.length"/></t>
            <t t-else="">Загрузить (<t t-out="this.state.queue.length"/>)</t>
          </button>
        </t>

        <h3>Скан камерой</h3>
        <p class="text-muted">
          Сфотографируйте страницы бумажного документа по одной — они сложатся в
          один PDF. На телефоне откроется камера.
        </p>
        <button type="button" class="btn btn-secondary mb-2" t-on-click="() => this.cameraRef().click()">
          <i class="fa fa-camera"/> Снять страницу
        </button>
        <input type="file" accept="image/*" capture="environment" multiple="multiple"
               class="d-none" t-ref="this.cameraRef" t-on-change="this.onCamera"/>
        <t t-if="this.state.scans.length">
          <div class="o_coop_doc_scans">
            <div class="o_coop_doc_scan" t-foreach="this.state.scans" t-as="scan" t-key="scan.url">
              <img t-att-src="scan.url" t-att-alt="'Страница ' + (scan_index + 1)"/>
              <span>стр. <t t-out="scan_index + 1"/></span>
              <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.removeScan(scan_index)">×</button>
            </div>
          </div>
          <input class="form-control mb-2" placeholder="Название, например «Акт № 14 от 25.09»"
                 t-model.proxy="this.state.scanName"/>
          <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="this.saveScan">
            Сохранить PDF (<t t-out="this.state.scans.length"/> стр.)
          </button>
        </t>

        <div class="mt-4">
          <button type="button" class="btn btn-link px-0" t-on-click="this.openAll">← Все документы</button>
        </div>
      </div>
    </div>
  </t>
</templates>
