<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Плиткой, чтобы переключатель вида был как в каталогах — владелец
    23 сентября: «можно менять вид, так же как у каталогов».

    Карточка документа не такая, как карточка ресурса, и это намеренно.
    В каталоге главное — снимок: по нему узнают вещь. У документа снимка
    нет и быть не может, а узнают его по виду, предмету и второй
    стороне. Значок вида заменяет снимок ровно в этой роли: по нему
    отличают акт от договора, не читая.
  -->
  <record id="view_coop_document_kanban" model="ir.ui.view">
    <field name="name">coop.document.kanban</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_documents" quick_create="false">
        <field name="id"/>
        <field name="is_pdf"/>
        <field name="file_name"/>
        <field name="kind"/>
        <field name="state"/>
        <field name="party_b_id"/>
        <field name="signed_on"/>
        <field name="number"/>
        <field name="folder_id"/>
        <field name="fingerprint"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_doc_card">
              <!-- Первая страница PDF — плиткой (разбор дисков, п. 2):
                   рисует браузер, сервер снимков не хранит. -->
              <div class="o_coop_doc_thumb" t-if="record.is_pdf.raw_value">
                <field name="id" widget="coop_pdf_thumb" nolabel="1"/>
              </div>
              <div class="o_coop_doc_fav"><field name="id" widget="coop_favorite_heart" nolabel="1"/></div>
              <div class="o_coop_doc_head">
                <i class="fa fa-file-text-o o_coop_doc_icon"
                   t-if="record.kind.raw_value == 'contract'"/>
                <i class="fa fa-handshake-o o_coop_doc_icon"
                   t-elif="record.kind.raw_value == 'act'"/>
                <i class="fa fa-check-square-o o_coop_doc_icon"
                   t-elif="record.kind.raw_value == 'closing'"/>
                <i class="fa fa-gavel o_coop_doc_icon"
                   t-elif="record.kind.raw_value == 'protocol'"/>
                <i class="fa fa-file-o o_coop_doc_icon" t-else=""/>
                <span class="o_coop_doc_kind"><field name="kind"/></span>
                <field name="state" widget="badge"
                       class="o_coop_doc_state"/>
              </div>

              <div class="o_coop_doc_name"><field name="name"/></div>

              <div class="o_coop_doc_meta">
                <span t-if="record.party_b_id.value">
                  <field name="party_b_id"/>
                </span>
                <span class="o_coop_doc_date"><field name="signed_on"/></span>
              </div>

              <div class="o_coop_doc_foot">
                <span t-if="record.folder_id.value" class="o_coop_doc_folder">
                  <i class="fa fa-folder-o"/> <field name="folder_id"/>
                </span>
                <!-- Отпечаток на карточке коротко: полностью его не
                     читают, а вот «он есть» — видно сразу, и это
                     главное, что карточка обязана сказать. -->
                <span t-if="record.fingerprint.value" class="o_coop_doc_print"
                      title="Отпечаток посчитан — документ можно сверить">
                  <i class="fa fa-lock"/> сверяемый
                </span>
                <span t-else="" class="o_coop_doc_nofile">
                  <i class="fa fa-exclamation-triangle"/> без файла
                </span>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_document_list" model="ir.ui.view">
    <field name="name">coop.document.list</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <list string="Документы"
            decoration-muted="state == 'cancelled'"
            decoration-success="state == 'signed'">
        <!--
          Пять колонок по умолчанию, остальные за «оптиональными».
          Девять не помещались: область у платформы ограничена по ширине,
          и каждое название обрезалось до «Договор по сделке СД-20…» —
          то есть до той части, которая у всех одинакова.

          Убраны из умолчания: «Номер» (он и так в названии), «Сторона»
          (это почти всегда вы), «К чему» (длинная строка, ради которой
          сжималось всё остальное), «Папка» (по ней и так группировка).
        -->
        <field name="signed_on" string="Дата" width="110"/>
        <field name="name" string="Документ"/>
        <field name="kind" string="Вид" width="150"/>
        <field name="party_b_id" string="Вторая сторона" width="200"/>
        <field name="state" widget="badge" width="120"/>
        <field name="number" string="Номер" optional="hide"/>
        <field name="party_a_id" string="Сторона" optional="hide"/>
        <field name="folder_id" string="Папка" optional="hide"/>
        <field name="res_label" string="К чему" optional="hide"/>
        <field name="fingerprint" string="Отпечаток" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_coop_document_form" model="ir.ui.view">
    <field name="name">coop.document.form</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <form string="Документ">
        <header>
          <button name="action_sign" type="object" string="Подписан"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_check" type="object" string="Сверить свой экземпляр"
                  invisible="not fingerprint"/>
          <button name="action_download" type="object" string="Скачать"
                  invisible="not file" icon="fa-download"/>
          <button name="action_share" type="object" string="Ссылка для внешней стороны"
                  invisible="not file or not active" icon="fa-link"/>
          <button name="action_cancel" type="object" string="Отменить"
                  invisible="state == 'cancelled'"/>
          <button name="action_trash" type="object" string="В корзину"
                  invisible="not active or state == 'signed'" icon="fa-trash-o"/>
          <button name="action_restore" type="object" string="Восстановить"
                  class="btn-primary" invisible="active"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,signed"/>
        </header>
        <sheet>
          <field name="active" invisible="1"/>
          <field name="is_pdf" invisible="1"/>
          <div class="alert alert-warning" invisible="active">
            Документ в корзине с <field name="trashed_on" readonly="1" class="d-inline"/> —
            удалится насовсем <field name="purge_on" readonly="1" class="d-inline"/>, если не восстановить.
          </div>
          <div class="oe_title">
            <h1><field name="name" placeholder="Акт приёма-передачи"/></h1>
          </div>
          <group>
            <group string="Что это">
              <field name="kind"/>
              <field name="number" placeholder="№ 14"/>
              <field name="signed_on"/>
            </group>
            <group string="Между кем">
              <field name="party_a_id"/>
              <field name="party_b_id"/>
              <field name="res_label" placeholder="Сделка, закупка, проект"/>
              <field name="folder_id"
                     options="{'no_quick_create': False}"
                     placeholder="Ваша полка: «Стройка 2026», «Налоговая»"/>
              <field name="year" invisible="1"/>
              <field name="res_model" invisible="1"/>
              <field name="res_id" invisible="1"/>
            </group>
          </group>
          <group string="Файл и отпечаток">
            <field name="file" filename="file_name"/>
            <field name="file_name" invisible="1"/>
            <!--
              Отпечаток показывается всегда, а не прячется в служебные
              поля: он и есть то, ради чего раздел затевался. Человек
              должен видеть его рядом с файлом, а не искать.
            -->
            <field name="fingerprint" readonly="1" widget="CopyClipboardChar"
                   invisible="not fingerprint"/>
          </group>
          <div class="text-muted" invisible="not fingerprint">
            Отпечаток посчитан от содержимого файла по SHA-256. Он не
            зависит от имени файла и меняется при любой правке содержимого
            — даже при пересохранении в другой программе.
          </div>
          <group string="Пояснение">
            <field name="note" nolabel="1" colspan="2"
                   placeholder="Что важно знать об этом документе"/>
          </group>
          <notebook>
            <page string="Просмотр" name="preview" invisible="not file">
              <field name="preview_html" nolabel="1" readonly="1"/>
            </page>
            <page string="Редакции" name="versions">
              <div class="text-muted mb-2">
                Новая редакция не затирает прежнюю: у каждой свой отпечаток, и
                сверка узнаёт любую. Подписанная редакция закреплена — её не удалить.
              </div>
              <field name="version_ids" readonly="1" nolabel="1">
                <list create="0" delete="0">
                  <field name="number" string="№" width="50"/>
                  <field name="date"/>
                  <field name="author_id" widget="many2one_avatar"/>
                  <field name="file_name"/>
                  <field name="fingerprint" class="font-monospace text-muted"/>
                  <field name="pinned" width="90"/>
                  <field name="note"/>
                </list>
              </field>
            </page>
            <page string="Журнал" name="log">
              <field name="log_ids" readonly="1" nolabel="1">
                <list create="0" delete="0">
                  <field name="date"/>
                  <field name="partner_id" widget="many2one_avatar"/>
                  <field name="action"/>
                  <field name="note"/>
                </list>
              </field>
            </page>
            <page string="Ссылки" name="shares">
              <field name="share_ids" nolabel="1" readonly="1">
                <list create="0" delete="0">
                  <field name="create_date" string="Выдана"/>
                  <field name="url" widget="CopyClipboardChar"/>
                  <field name="expires_on"/>
                  <field name="has_password" string="Пароль"/>
                  <field name="allow_download"/>
                  <field name="views"/>
                  <field name="state" widget="badge"/>
                  <button name="action_revoke" type="object" string="Отозвать"
                          invisible="state != 'active'"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_document_search" model="ir.ui.view">
    <field name="name">coop.document.search</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <search string="Документы">
        <!--
          Отпечаток ищется наравне с названием и номером. Это не
          украшение: к вам приходят с файлом и спрашивают «что это у
          нас» — по отпечатку документ находится за один шаг, по
          названию его пришлось бы угадывать.
        -->
        <field name="name" string="Название или номер"
               filter_domain="['|', '|', ('name', 'ilike', self), ('number', 'ilike', self), ('res_label', 'ilike', self)]"/>
        <field name="party_b_id" string="Вторая сторона"/>
        <field name="folder_id" string="Папка"/>
        <field name="fingerprint" string="Отпечаток"/>

        <!--
          Папки слева деревом — владелец 23 сентября: «я думал будет как
          в виндовс папки и вложенные документы».

          Это не то же самое, что группировка. Группировка складывает
          список в стопки и заставляет их раскрывать; панель показывает
          **дерево** и оставляет список списком. Вложенные папки видны
          сразу, и по ним ходят, а не разворачивают.

          `hierarchize` строит дерево по `parent_id`, `enable_counters`
          ставит число рядом с папкой: пустая полка видна до того, как в
          неё зайдёшь.
        -->
        <searchpanel view_types="list,kanban">
          <field name="folder_id" string="Папки" icon="fa-folder"
                 enable_counters="1" hierarchize="1" expand="1"/>
          <field name="kind" string="Вид" icon="fa-file-text-o"
                 select="multi" enable_counters="1"/>
          <field name="state" string="Состояние" icon="fa-check-circle-o"
                 select="multi" enable_counters="1"/>
        </searchpanel>

        <filter name="signed" string="Подписанные"
                domain="[('state', '=', 'signed')]"/>
        <filter name="draft" string="Черновики"
                domain="[('state', '=', 'draft')]"/>
        <filter name="cancelled" string="Отменённые"
                domain="[('state', '=', 'cancelled')]"/>
        <separator/>
        <filter name="kind_contract" string="Договоры"
                domain="[('kind', '=', 'contract')]"/>
        <filter name="kind_act" string="Акты"
                domain="[('kind', '=', 'act')]"/>
        <filter name="kind_closing" string="Закрывающие"
                domain="[('kind', '=', 'closing')]"/>
        <separator/>
        <!--
          «Без файла» и «без папки» — не придирка, а рабочий отбор:
          первое находит записи, которые нечем проверить, второе —
          то, что ещё не разложено.
        -->
        <filter name="favorite" string="☆ Избранное" domain="[('coop_is_favorite', '=', True)]"/>
        <filter name="awaits" string="Жду подписи" domain="[('awaits_me', '=', True)]"/>
        <filter name="shared" string="Доступные мне" domain="[('shared_with_me', '=', True)]"/>
        <filter name="trash" string="Корзина" domain="[('active', '=', False)]"/>
        <separator/>
        <filter name="no_file" string="Без файла"
                domain="[('file', '=', False)]"/>
        <filter name="no_folder" string="Не разложено"
                domain="[('folder_id', '=', False)]"/>
        <separator/>
        <!--
          Отбор по дате — штатным средством движка, а не своими
          доменами. Оно само даёт «этот месяц», «этот квартал», «этот
          год» и «прошлый год», умеет складывать периоды и переживает
          смену года без правок. Мои самодельные фильтры сюда же и не
          встали: поисковый вид отказался их разбирать.
        -->
        <filter name="by_date" date="signed_on" string="Дата"/>

        <!--
          Группировки без обёртки `<group>`: у движка она описана общей
          схемой, где ни `string`, ни `expand` не допускаются, и
          поисковый вид с ними не проходит проверку. Разделы
          «Группировать по» движок собирает сам, по наличию `group_by` в
          контексте.
        -->
        <separator/>
          <filter name="by_folder" string="По папкам"
                  context="{'group_by': 'folder_id'}"/>
          <filter name="by_kind" string="По виду"
                  context="{'group_by': 'kind'}"/>
          <filter name="by_party" string="По второй стороне"
                  context="{'group_by': 'party_b_id'}"/>
          <filter name="by_year" string="По годам"
                  context="{'group_by': 'year'}"/>
          <filter name="by_state" string="По состоянию"
                  context="{'group_by': 'state'}"/>
          <filter name="by_month" string="По месяцам"
                  context="{'group_by': 'signed_on:month'}"/>
      </search>
    </field>
  </record>

  <record id="view_coop_document_check_form" model="ir.ui.view">
    <field name="name">coop.document.check.form</field>
    <field name="model">coop.document.check</field>
    <field name="arch" type="xml">
      <form string="Сверить свой экземпляр">
        <group>
          <field name="document_id" readonly="1"/>
          <field name="file" filename="file_name"
                 string="Файл, который у вас на руках"/>
          <field name="file_name" invisible="1"/>
        </group>
        <field name="verdict" nolabel="1" readonly="1"/>
        <group string="Отпечатки" invisible="not file">
          <field name="known_fingerprint" string="На платформе" readonly="1"/>
          <field name="mine_fingerprint" string="Ваш файл" readonly="1"/>
          <field name="matches" invisible="1"/>
        </group>
        <footer>
          <button name="action_done" type="object" string="Готово" class="btn-primary"/>
          <button string="Закрыть" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_coop_documents" model="ir.actions.act_window">
    <field name="name">Документы</field>
    <field name="path">documents</field>
    <field name="res_model">coop.document</field>
    <field name="view_mode">kanban,list,form</field>
    <!--
      Группировку по папкам по умолчанию не включаем: слева и так стоит
      дерево папок. Две вещи об одном сразу — это не вдвое понятнее, а
      вдвое теснее.

      Контекст выставлен пустым **явно**. Убрать поле из разметки
      недостаточно: движок обновляет то, что в файле есть, и не трогает
      то, чего в нём не стало. Прежнее значение так и осталось бы в
      базе — проверено 23 сентября 2026.
    -->
    <!-- `coop_section` — вкладки раздела над списком (`coop_theme`,
         `coopHasTabs`): «Недавние», «Жду подписи», «Корзина» и остальные. -->
    <field name="context">{'coop_section': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiley_face">Документов пока нет</p>
      <p>Акты, договоры и закрывающие. У каждого считается отпечаток, и
         любую сторону можно попросить сверить свой экземпляр.</p>
    </field>
  </record>

  <!-- Папки: свой экран, чтобы их можно было завести и переименовать
       заранее, не открывая документ. -->
  <record id="view_coop_document_folder_list" model="ir.ui.view">
    <field name="name">coop.document.folder.list</field>
    <field name="model">coop.document.folder</field>
    <field name="arch" type="xml">
      <list string="Папки" editable="bottom">
        <field name="complete_name" string="Папка" readonly="1"/>
        <field name="name" string="Название"/>
        <field name="parent_id" string="Внутри папки"/>
        <field name="document_count" string="Документов" readonly="1"/>
        <field name="partner_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="action_coop_document_folders" model="ir.actions.act_window">
    <field name="name">Папки документов</field>
    <field name="res_model">coop.document.folder</field>
    <field name="view_mode">list</field>
    <field name="context">{'coop_section': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiley_face">Папок пока нет</p>
      <p>Папка — ваш порядок, а не свойство документа. Платформа сама
         раскладывает по виду, году и второй стороне; папка нужна там,
         где связь знаете только вы: «Стройка 2026», «Налоговая»,
         «Спорные».</p>
    </field>
  </record>

  <menuitem id="menu_coop_documents_root" name="Документы"
            action="action_coop_documents" sequence="78"/>

  <menuitem id="menu_coop_documents_all" name="Все документы"
            parent="menu_coop_documents_root"
            action="action_coop_documents" sequence="10"/>

  <menuitem id="menu_coop_documents_recent" name="Недавние" parent="menu_coop_documents_root"
            action="action_coop_documents_recent" sequence="12"/>
  <menuitem id="menu_coop_documents_favorite" name="Избранное" parent="menu_coop_documents_root"
            action="action_coop_documents_favorite" sequence="13"/>
  <menuitem id="menu_coop_documents_awaits" name="Жду подписи" parent="menu_coop_documents_root"
            action="action_coop_documents_awaits" sequence="14"/>
  <menuitem id="menu_coop_documents_shared" name="Доступные мне" parent="menu_coop_documents_root"
            action="action_coop_documents_shared" sequence="15"/>
  <menuitem id="menu_coop_document_folders" name="Папки"
            parent="menu_coop_documents_root"
            action="action_coop_document_folders" sequence="20"/>
  <menuitem id="menu_coop_documents_upload" name="Загрузить" parent="menu_coop_documents_root"
            action="action_coop_documents_upload" sequence="25"/>
  <menuitem id="menu_coop_documents_trash" name="Корзина" parent="menu_coop_documents_root"
            action="action_coop_documents_trash" sequence="30"/>

</odoo>
