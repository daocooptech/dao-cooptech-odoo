<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coop_document_list" model="ir.ui.view">
    <field name="name">coop.document.list</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <list string="Документы"
            decoration-muted="state == 'cancelled'"
            decoration-success="state == 'signed'">
        <field name="signed_on" string="Дата"/>
        <field name="number" string="Номер"/>
        <field name="name"/>
        <field name="kind" string="Вид"/>
        <field name="party_a_id" string="Сторона"/>
        <field name="party_b_id" string="Вторая сторона"/>
        <field name="folder_id" string="Папка" optional="show"/>
        <field name="res_label" string="К чему" optional="show"/>
        <field name="fingerprint" string="Отпечаток" optional="hide"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_coop_document_form" model="ir.ui.view">
    <field name="name">coop.document.form</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <form string="Документ">
        <header>
          <button name="action_sign" type="object" string="Подписан"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_check" type="object" string="Сверить свой экземпляр"
                  invisible="not fingerprint"/>
          <button name="action_cancel" type="object" string="Отменить"
                  invisible="state == 'cancelled'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,signed"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Акт приёма-передачи"/></h1>
          </div>
          <group>
            <group string="Что это">
              <field name="kind"/>
              <field name="number" placeholder="№ 14"/>
              <field name="signed_on"/>
            </group>
            <group string="Между кем">
              <field name="party_a_id"/>
              <field name="party_b_id"/>
              <field name="res_label" placeholder="Сделка, закупка, проект"/>
              <field name="folder_id"
                     options="{'no_quick_create': False}"
                     placeholder="Ваша полка: «Стройка 2026», «Налоговая»"/>
              <field name="year" invisible="1"/>
              <field name="res_model" invisible="1"/>
              <field name="res_id" invisible="1"/>
            </group>
          </group>
          <group string="Файл и отпечаток">
            <field name="file" filename="file_name"/>
            <field name="file_name" invisible="1"/>
            <!--
              Отпечаток показывается всегда, а не прячется в служебные
              поля: он и есть то, ради чего раздел затевался. Человек
              должен видеть его рядом с файлом, а не искать.
            -->
            <field name="fingerprint" readonly="1" widget="CopyClipboardChar"
                   invisible="not fingerprint"/>
          </group>
          <div class="text-muted" invisible="not fingerprint">
            Отпечаток посчитан от содержимого файла по SHA-256. Он не
            зависит от имени файла и меняется при любой правке содержимого
            — даже при пересохранении в другой программе.
          </div>
          <group string="Пояснение">
            <field name="note" nolabel="1" colspan="2"
                   placeholder="Что важно знать об этом документе"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_coop_document_search" model="ir.ui.view">
    <field name="name">coop.document.search</field>
    <field name="model">coop.document</field>
    <field name="arch" type="xml">
      <search string="Документы">
        <!--
          Отпечаток ищется наравне с названием и номером. Это не
          украшение: к вам приходят с файлом и спрашивают «что это у
          нас» — по отпечатку документ находится за один шаг, по
          названию его пришлось бы угадывать.
        -->
        <field name="name" string="Название или номер"
               filter_domain="['|', '|', ('name', 'ilike', self), ('number', 'ilike', self), ('res_label', 'ilike', self)]"/>
        <field name="party_b_id" string="Вторая сторона"/>
        <field name="folder_id" string="Папка"/>
        <field name="fingerprint" string="Отпечаток"/>

        <filter name="signed" string="Подписанные"
                domain="[('state', '=', 'signed')]"/>
        <filter name="draft" string="Черновики"
                domain="[('state', '=', 'draft')]"/>
        <filter name="cancelled" string="Отменённые"
                domain="[('state', '=', 'cancelled')]"/>
        <separator/>
        <filter name="kind_contract" string="Договоры"
                domain="[('kind', '=', 'contract')]"/>
        <filter name="kind_act" string="Акты"
                domain="[('kind', '=', 'act')]"/>
        <filter name="kind_closing" string="Закрывающие"
                domain="[('kind', '=', 'closing')]"/>
        <separator/>
        <!--
          «Без файла» и «без папки» — не придирка, а рабочий отбор:
          первое находит записи, которые нечем проверить, второе —
          то, что ещё не разложено.
        -->
        <filter name="no_file" string="Без файла"
                domain="[('file', '=', False)]"/>
        <filter name="no_folder" string="Не разложено"
                domain="[('folder_id', '=', False)]"/>
        <separator/>
        <filter name="this_year" string="В этом году"
                domain="[('signed_on', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
        <filter name="last_year" string="В прошлом году"
                domain="[('signed_on', '&gt;=', (context_today() + relativedelta(years=-1, month=1, day=1)).strftime('%Y-%m-%d')), ('signed_on', '&lt;', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>

        <group expand="0" string="Сгруппировать">
          <filter name="by_folder" string="По папкам"
                  context="{'group_by': 'folder_id'}"/>
          <filter name="by_kind" string="По виду"
                  context="{'group_by': 'kind'}"/>
          <filter name="by_party" string="По второй стороне"
                  context="{'group_by': 'party_b_id'}"/>
          <filter name="by_year" string="По годам"
                  context="{'group_by': 'year'}"/>
          <filter name="by_state" string="По состоянию"
                  context="{'group_by': 'state'}"/>
          <filter name="by_month" string="По месяцам"
                  context="{'group_by': 'signed_on:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_coop_document_check_form" model="ir.ui.view">
    <field name="name">coop.document.check.form</field>
    <field name="model">coop.document.check</field>
    <field name="arch" type="xml">
      <form string="Сверить свой экземпляр">
        <group>
          <field name="document_id" readonly="1"/>
          <field name="file" filename="file_name"
                 string="Файл, который у вас на руках"/>
          <field name="file_name" invisible="1"/>
        </group>
        <field name="verdict" nolabel="1" readonly="1"/>
        <group string="Отпечатки" invisible="not file">
          <field name="known_fingerprint" string="На платформе" readonly="1"/>
          <field name="mine_fingerprint" string="Ваш файл" readonly="1"/>
          <field name="matches" invisible="1"/>
        </group>
        <footer>
          <button string="Закрыть" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_coop_documents" model="ir.actions.act_window">
    <field name="name">Документы</field>
    <field name="path">documents</field>
    <field name="res_model">coop.document</field>
    <field name="view_mode">list,form</field>
    <!--
      Сразу сгруппировано по папкам: документ без папки виден в группе
      «Не разложено» и не теряется, а разложенные сразу лежат по полкам.
      Порядок группировки человек меняет одним нажатием.
    -->
    <field name="context">{'search_default_by_folder': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiley_face">Документов пока нет</p>
      <p>Акты, договоры и закрывающие. У каждого считается отпечаток, и
         любую сторону можно попросить сверить свой экземпляр.</p>
    </field>
  </record>

  <!-- Папки: свой экран, чтобы их можно было завести и переименовать
       заранее, не открывая документ. -->
  <record id="view_coop_document_folder_list" model="ir.ui.view">
    <field name="name">coop.document.folder.list</field>
    <field name="model">coop.document.folder</field>
    <field name="arch" type="xml">
      <list string="Папки" editable="bottom">
        <field name="complete_name" string="Папка" readonly="1"/>
        <field name="name" string="Название"/>
        <field name="parent_id" string="Внутри папки"/>
        <field name="document_count" string="Документов" readonly="1"/>
        <field name="partner_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="action_coop_document_folders" model="ir.actions.act_window">
    <field name="name">Папки документов</field>
    <field name="res_model">coop.document.folder</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiley_face">Папок пока нет</p>
      <p>Папка — ваш порядок, а не свойство документа. Платформа сама
         раскладывает по виду, году и второй стороне; папка нужна там,
         где связь знаете только вы: «Стройка 2026», «Налоговая»,
         «Спорные».</p>
    </field>
  </record>

  <menuitem id="menu_coop_documents_root" name="Документы"
            action="action_coop_documents" sequence="78"/>

  <menuitem id="menu_coop_documents_all" name="Все документы"
            parent="menu_coop_documents_root"
            action="action_coop_documents" sequence="10"/>

  <menuitem id="menu_coop_document_folders" name="Папки"
            parent="menu_coop_documents_root"
            action="action_coop_document_folders" sequence="20"/>

</odoo>
