<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!--
      Документ видят только его стороны.

      Не «все участники платформы»: акт приёма-передачи между двумя
      кооперативами — не публичное чтение. Рабочая группа платформы видит
      всё, потому что спор разбирает администратор (решение 194).
    -->
    <record id="rule_coop_document_parties" model="ir.rule">
      <field name="name">Документы: только свои стороны</field>
      <field name="model_id" ref="model_coop_document"/>
      <field name="domain_force">['|', ('party_a_id', 'in', user.coop_actor_partner_ids.ids), ('party_b_id', 'in', user.coop_actor_partner_ids.ids)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_coop_document_platform" model="ir.rule">
      <field name="name">Документы: рабочая группа видит всё</field>
      <field name="model_id" ref="model_coop_document"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('coop_base.group_coop_platform'))]"/>
    </record>
    <!--
      Папка личная: своя полка не показывается никому, даже стороне того
      же документа. Порядок у каждого свой, и чужой порядок не только
      бесполезен, но и рассказывает о делах больше, чем стоило бы.
    -->
    <record id="rule_coop_document_folder_own" model="ir.rule">
      <field name="name">Папки документов: только свои</field>
      <field name="model_id" ref="model_coop_document_folder"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>

    <!-- Редакции, журнал и ссылки — у тех, кто видит сам документ. -->
    <record id="rule_coop_document_version_parties" model="ir.rule">
      <field name="name">Редакции: стороны документа</field>
      <field name="model_id" ref="model_coop_document_version"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('document_id.party_a_id', 'in', user.coop_actor_partner_ids.ids), ('document_id.party_b_id', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>
    <record id="rule_coop_document_log_parties" model="ir.rule">
      <field name="name">Журнал: стороны документа</field>
      <field name="model_id" ref="model_coop_document_log"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('document_id.party_a_id', 'in', user.coop_actor_partner_ids.ids), ('document_id.party_b_id', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>
    <record id="rule_coop_document_share_parties" model="ir.rule">
      <field name="name">Ссылки: стороны документа</field>
      <field name="model_id" ref="model_coop_document_share"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">['|', ('document_id.party_a_id', 'in', user.coop_actor_partner_ids.ids), ('document_id.party_b_id', 'in', user.coop_actor_partner_ids.ids)]</field>
    </record>

    <record id="rule_coop_document_version_platform" model="ir.rule">
      <field name="name">Редакции: рабочая группа видит всё</field>
      <field name="model_id" ref="model_coop_document_version"/>
      <field name="groups" eval="[(4, ref('coop_base.group_coop_platform'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_coop_document_log_platform" model="ir.rule">
      <field name="name">Журнал: рабочая группа видит всё</field>
      <field name="model_id" ref="model_coop_document_log"/>
      <field name="groups" eval="[(4, ref('coop_base.group_coop_platform'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_coop_document_share_platform" model="ir.rule">
      <field name="name">Ссылки: рабочая группа видит всё</field>
      <field name="model_id" ref="model_coop_document_share"/>
      <field name="groups" eval="[(4, ref('coop_base.group_coop_platform'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

  </data>
</odoo>
