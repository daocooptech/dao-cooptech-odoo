<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="coop_projects.OffersReview">
    <div class="o_coop_rev" t-if="this.needs.length">
      <div class="o_coop_rev_needs">
        <button t-foreach="this.needs" t-as="need" t-key="need.id" type="button"
                class="o_coop_rev_need"
                t-att-class="{'active': this.currentNeed and this.currentNeed.id === need.id, 'closed': need.closed}"
                t-on-click="() => this.pick(need.id)">
          <span class="o_coop_rev_need_ic"><CoopIcon name="need.icon" size="15"/></span>
          <span class="o_coop_rev_need_body">
            <span class="o_coop_rev_need_name" t-out="need.name"/>
            <span class="o_coop_rev_need_sub text-muted">
              <t t-if="need.closed">закрыто · <t t-out="need.closed_by"/></t>
              <t t-else="" t-out="need.price"/>
            </span>
          </span>
          <span class="o_coop_rev_done" t-if="need.closed"><CoopIcon name="'circle-check'" size="16"/></span>
          <span class="o_coop_rev_count new" t-elif="need.new" t-out="need.new"/>
          <span class="o_coop_rev_count" t-elif="need.total" t-out="need.total"/>
        </button>
      </div>
      <div class="o_coop_rev_main" t-if="this.currentNeed">
        <div class="o_coop_rev_head">
          <span class="o_coop_rev_kind" t-if="this.currentNeed.kind" t-out="this.currentNeed.kind"/>
          <div class="o_coop_rev_title" t-out="this.currentNeed.name"/>
          <div class="o_coop_rev_meta" t-if="this.currentNeed.price">
            стоимость <b t-out="this.currentNeed.price"/>
            <t t-if="this.currentNeed.line_share"> · пай за строку <b><t t-out="this.pct(this.currentNeed.line_share)"/> %</b></t>
          </div>
        </div>
        <div class="o_coop_rev_bar">
          <div class="o_coop_rev_filters">
            <button type="button" t-att-class="{'on': this.state.filter === 'all'}"
                    t-on-click="() => this.state.filter = 'all'">Все <t t-out="this.counts.all"/></button>
            <button type="button" t-att-class="{'on': this.state.filter === 'new'}"
                    t-on-click="() => this.state.filter = 'new'">Новые <t t-out="this.counts.new"/></button>
            <button type="button" t-att-class="{'on': this.state.filter === 'declined'}"
                    t-on-click="() => this.state.filter = 'declined'">Отклонённые</button>
          </div>
          <Dropdown position="'bottom-end'" menuClass="'o_coop_rev_sort_menu'">
            <button type="button" class="o_coop_rev_sort" t-att-aria-label="'Сортировка: ' + this.sortLabel">
              <CoopIcon name="'arrows-sort'" size="16"/>
              <span t-out="this.sortLabel"/>
              <CoopIcon name="'chevron-down'" size="16"/>
            </button>
            <t t-set-slot="content">
              <DropdownItem t-foreach="this.sortOptions" t-as="opt" t-key="opt.id"
                            class="'o-dropdown-item-unstyled-button o_coop_rev_sort_item' + (opt.id === this.state.sort ? ' on' : '')"
                            onSelected="() => this.state.sort = opt.id">
                <span class="o_coop_rev_sort_text">
                  <span class="o_coop_rev_sort_name" t-out="opt.label"/>
                  <span class="o_coop_rev_sort_hint" t-out="opt.hint"/>
                </span>
                <CoopIcon t-if="opt.id === this.state.sort" name="'check'" size="16"/>
              </DropdownItem>
            </t>
          </Dropdown>
        </div>
        <div class="o_coop_rev_cards o_coop_offers">
          <div t-foreach="this.offers" t-as="offer" t-key="offer.id"
               class="o_coop_offer o_coop_rev_card"
               t-att-class="'o_coop_offer_' + offer.state">
            <div class="o_coop_offer_head">
              <img class="o_coop_offer_ava" loading="lazy"
                   t-att-src="'/web/image/res.partner/' + offer.partner_id + '/avatar_128'"
                   t-att-alt="offer.partner"/>
              <div class="o_coop_offer_who">
                <a href="#" class="o_coop_offer_name"
                   t-on-click.prevent="() => this.openPartner(offer)">
                  <t t-out="offer.partner"/>
                  <CoopIcon t-if="offer.verified" name="'shield-check'" size="14"/>
                </a>
                <span class="o_coop_offer_role" t-if="offer.role" t-out="offer.role"/>
                <span class="o_coop_offer_rep">
                  <t t-if="offer.reviews">
                    <span class="o_coop_stars" t-att-aria-label="'Оценка ' + this.pct(offer.rating)">
                      <i t-foreach="this.stars(offer.rating)" t-as="on" t-key="on_index" t-att-class="{'on': on}"/>
                    </span>
                    <b t-out="this.pct(offer.rating)"/> (<t t-out="offer.reviews"/>) ·
                  </t>
                  доверие <t t-out="offer.trust"/> % · сделок <t t-out="offer.deals"/>
                </span>
              </div>
              <div class="o_coop_offer_value">
                <b t-out="this.money(offer.value, offer.currency)"/>
                <span class="o_coop_offer_diff" t-att-class="this.diffClass(offer)" t-out="this.diffText(offer)"/>
              </div>
            </div>
            <div class="o_coop_offer_body">
              <t t-set="res" t-value="this.state.resources[offer.id]"/>
              <button t-if="res" type="button" class="o_coop_rev_res link"
                      t-on-click="() => this.openResource(res.id)">
                <img class="o_coop_rev_res_img" loading="lazy" t-att-alt="res.name"
                     t-att-src="'/web/image/coop.resource/' + res.id + '/image_512'"/>
                <span class="o_coop_rev_res_name" t-out="res.name"/>
              </button>
              <p class="o_coop_offer_what"><b t-out="offer.name"/><t t-if="offer.labour_form"> · <t t-out="offer.labour_form"/></t></p>
              <p class="o_coop_offer_note" t-if="offer.note" t-out="offer.note"/>
            </div>
            <div class="o_coop_offer_foot">
              <span class="o_coop_offer_when">
                <i class="o_coop_offer_dot" t-if="this.fresh(offer)"/>
                предложено <t t-out="this.ago(offer.offered_on)"/>
                <t t-if="offer.state === 'offered' and offer.share_if"> · пай при принятии ≈ <t t-out="this.pct(offer.share_if)"/> %</t>
              </span>
              <div class="o_coop_offer_actions" t-if="offer.state === 'offered'">
                <button type="button" class="btn btn-secondary btn-sm"
                        t-on-click="() => this.write(offer)">
                  <CoopIcon name="'message-circle'" size="14"/> Написать
                </button>
                <button type="button" class="btn btn-secondary btn-sm"
                        t-on-click="() => this.decline(offer)">Отклонить</button>
                <button type="button" class="btn btn-primary btn-sm"
                        t-on-click="() => this.accept(offer)">Принять</button>
              </div>
              <span class="o_coop_offer_badge ok" t-elif="offer.state === 'accepted'">
                <CoopIcon name="'circle-check'" size="14"/>
                Принят — пай <t t-out="this.pct(offer.share)"/> %, отозвать можно 7 дней
              </span>
              <span class="o_coop_offer_badge" t-elif="offer.state === 'declined'">
                Отклонён · извещение отправлено
              </span>
            </div>
          </div>
          <div class="text-muted" t-if="!this.offers.length">Заявок нет.</div>
        </div>
      </div>
    </div>
    <div class="text-muted" t-else="">На потребности пока никто не откликнулся.</div>
  </t>

</templates>
