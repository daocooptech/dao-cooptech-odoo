<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Добор связи с управлением проектами.

    Связь заполняется при запуске проекта, но запущенные проекты попали
    на платформу мимо этой кнопки — их завёл загрузчик наполнения сразу
    в нужном состоянии. Поле объявлено, механика написана, а в базе
    пусто у всех записей.

    Через <function>, а не через хук установки: хук выполняется только
    при первой установке, а добрать нужно и на уже поставленном узле.
    Повторение безопасно — тем, у кого связь есть, ничего не делается.
  -->
  <function model="coop.project" name="backfill_managed_projects"/>
</odoo>
