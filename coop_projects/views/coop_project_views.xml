<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Каталог проектов ──────────────────────────────────────────── -->
  <record id="view_coop_project_kanban" model="ir.ui.view">
    <field name="name">coop.project.kanban</field>
    <field name="model">coop.project</field>
    <field name="arch" type="xml">
      <kanban js_class="coop_catalog_kanban" class="o_coop_projects"
              default_order="id desc">
        <field name="partner_id"/>
        <field name="image_512"/>
        <field name="city"/>
        <field name="readiness"/>
        <!-- Объявлено ради выражения в разметке: ниже поле
             читается как `record.can_contribute.raw_value`, а
             разбор представления видит только `<field>`. -->
        <field name="can_contribute"/>
        <field name="kind"/>
        <field name="summary"/>
        <field name="state"/>
        <field name="last_update_status"/>
        <field name="funding_threshold"/>
        <templates>
          <t t-name="card">
            <div class="o_coop_tile">
              <div class="o_coop_tile_image o_coop_media">
                <!--
                  Адрес собирается сложением строк. Питоновское
                  форматирование через «%» здесь не работает: шаблон
                  карточки компилируется в JavaScript, где «%» — остаток
                  от деления, и адрес выходил равным NaN. Картинки при
                  этом не ломались с ошибкой, а просто не появлялись.
                -->
                <!-- Цепочка одна на все каталоги: свой снимок, иначе лицо
                     инициатора, иначе значок раздела. Безусловный адрес
                     показывал заглушку «добавить фото» у всех, кто снимка
                     не имеет, — и карточка выглядела незагрузившейся. -->
                <img t-if="record.image_512.raw_value"
                     t-att-src="'/web/image/coop.project/' + record.id.raw_value + '/image_512'"
                     t-att-alt="record.name.value" loading="lazy"/>
                <img class="o_coop_media_logo" t-elif="record.partner_id.raw_value" loading="lazy"
                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/image_512"
                     t-att-alt="record.partner_id.value"/>
                <span t-else="" class="o_coop_media_sign">🎯</span>
                <span class="o_coop_badge o_coop_kind"
                      t-att-class="'o_coop_kind_' + record.kind.raw_value">
                  <t t-esc="record.kind.value"/>
                </span>
                <span class="o_coop_stop"
                      t-if="record.state.raw_value == 'frozen' or record.state.raw_value == 'cancelled' or record.state.raw_value == 'failed'">
                  <t t-esc="record.state.value"/>
                </span>
                <span class="o_coop_loc" t-if="record.city.raw_value">
                  <i class="fa fa-map-marker" aria-hidden="true"/>
                  <t t-esc="record.city.value"/>
                </span>
              </div>
              <div class="o_coop_tile_body">
                <div class="o_coop_tile_name">
                  <!--
                    Точка хода проекта — штатные состояния `project.update`:
                    идёт по плану, есть риск, отстаёт, приостановлен,
                    завершён. Пункт 14 разбора архитектора. Показывается
                    только там, где работы начались: до запуска вести
                    нечего, и серая точка на сборе врала бы.
                  -->
                  <span class="o_coop_run" t-if="record.last_update_status.raw_value and record.last_update_status.raw_value != 'to_define'"
                        t-att-class="'o_coop_run_' + record.last_update_status.raw_value"
                        t-att-title="record.last_update_status.value"/>
                  <field name="name"/>
                </div>
                <div class="o_coop_tile_desc"><field name="summary"/></div>
                <div class="o_coop_readiness">
                  <div class="o_coop_readiness_bar">
                    <!-- Ширина полосы ограничена сотней, само число — нет:
                         «собрано 312 %» это правда, а полоса длиннее
                         своей дорожки — просто сломанная вёрстка. -->
                    <div class="o_coop_readiness_fill"
                         t-attf-style="width: #{Math.min(100, record.readiness.raw_value)}%"/>
                    <!--
                      Засечка порога запуска. Полоса показывает, сколько
                      собрано, но не отвечает на главный вопрос
                      вкладчика: хватит ли этого, чтобы проект начался.
                      Порог у каждого проекта свой — от половины до ста
                      процентов. При стопроцентном засечки нет: она
                      совпала бы с концом полосы и читалась бы как
                      украшение. Пункт 16 разбора архитектора.
                    -->
                    <div class="o_coop_readiness_mark"
                         t-if="record.funding_threshold.raw_value and record.funding_threshold.raw_value &lt; 100"
                         t-attf-style="left: #{record.funding_threshold.raw_value}%"
                         t-attf-title="Порог запуска — #{record.funding_threshold.value}%"/>
                  </div>
                  <div class="o_coop_readiness_pct">
                    <t t-esc="record.readiness.value"/>%
                  </div>
                </div>
                <!-- Вложиться прямо с витрины: у проекта в сборе
                     это единственное, ради чего его открывают.
                     Полоса есть всегда, даже когда вкладывать
                     некуда, — иначе карточки расходятся по высоте
                     на строку, как вышло у торгов. -->
                <div class="o_coop_tile_act">
                  <button name="action_contribute" type="object"
                          class="btn o_coop_btn o_coop_tile_contribute"
                          t-if="record.can_contribute.raw_value">Участвовать</button>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_coop_project_list" model="ir.ui.view">
    <field name="name">coop.project.list</field>
    <field name="model">coop.project</field>
    <field name="arch" type="xml">
      <list string="Проекты" decoration-muted="state == 'cancelled'"
            decoration-warning="state in ('frozen', 'failed')">
        <field name="name"/>
        <field name="kind"/>
        <field name="category_id" optional="show"/>
        <field name="subcategory_id" optional="hide"/>
        <field name="city"/>
        <field name="partner_id"/>
        <field name="required_total" sum="Нужно"/>
        <field name="contribution_total" sum="Собрано"/>
        <field name="readiness" widget="progressbar"/>
        <field name="contributor_count" optional="hide"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="state" widget="badge"
               decoration-success="state == 'running'"
               decoration-info="state == 'gathering'"
               decoration-warning="state in ('frozen', 'failed')"
               decoration-muted="state in ('done', 'cancelled')"/>
      </list>
    </field>
  </record>

  <!--
    Окно вклада: чем, что именно, во сколько оценивается. Оценка нужна
    не ради цены, а ради доли: только через неё труд и деньги сводятся в
    одну величину.
  -->
  <record id="view_coop_contribute_form" model="ir.ui.view">
    <field name="name">coop.project.contribute.form</field>
    <field name="model">coop.project.contribute</field>
    <field name="arch" type="xml">
      <form string="Вклад в проект">
        <field name="project_id" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <field name="project_kind" invisible="1"/>
        <!-- Пришли из строки потребности — показываем, из какой:
             человек выбрал «Двигатель асинхронный», и окно должно это
             подтвердить, а не спрашивать заново. -->
        <group invisible="not need_id">
          <field name="need_id" readonly="1"/>
        </group>
        <group>
          <field name="kind" widget="radio"/>
          <field name="name" placeholder="Смена экскаваторщика, месяц аренды склада, комплект досок"/>
          <field name="value"/>
          <field name="note" placeholder="Необязательно"/>
        </group>
        <!-- Чем считается принятый вклад — зависит от вида проекта.
             Решение владельца 15 сентября 2026. -->
        <div class="alert alert-info" role="status"
             invisible="project_kind != 'cooperative'">
          Инициатор проекта увидит предложение и решит, принять ли его.
          Принятый вклад считается паем: ваша оценка к сумме всех вкладов.
        </div>
        <div class="alert alert-info" role="status"
             invisible="project_kind not in ('commercial', 'dao')">
          Инициатор проекта увидит предложение и решит, принять ли его.
          Принятый вклад считается долей: ваша оценка к сумме всех вкладов.
        </div>
        <div class="alert alert-info" role="status"
             invisible="project_kind != 'nonprofit'">
          Инициатор проекта увидит предложение и решит, принять ли его.
          Долей и паёв в некоммерческом проекте нет: вклад сюда — помощь
          делу, а не участие в собственности.
        </div>
        <footer>
          <button name="action_offer" type="object" string="Предложить вклад"
                  class="btn-primary"/>
          <button string="Отмена" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_coop_project_form" model="ir.ui.view">
    <field name="name">coop.project.form</field>
    <field name="model">coop.project</field>
    <field name="arch" type="xml">
      <form string="Проект" class="o_coop_wall_form">
        <header>
          <!-- Единственное действие участника. Кнопки не было вовсе:
               проект собирал деньги и вещи, а внести их было нечем. -->
          <button name="action_contribute" type="object" string="Участвовать"
                  class="btn-primary" invisible="not can_contribute"/>
          <button name="action_open_gathering" type="object" string="Открыть сбор"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_launch" type="object" string="Запустить"
                  class="btn-primary" invisible="state != 'gathering'"/>
          <button name="action_finish" type="object" string="Завершить"
                  invisible="state != 'running'"/>
          <button name="action_resume" type="object" string="Возобновить"
                  class="btn-primary" invisible="state != 'frozen'"/>
          <button name="action_fail" type="object" string="Сбор не удался"
                  invisible="state != 'gathering'"/>
          <button name="action_freeze" type="object" string="Заморозить"
                  invisible="state not in ('gathering', 'running')"/>
          <button name="action_cancel" type="object" string="Отменить"
                  invisible="state in ('done', 'cancelled')"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,gathering,running,done"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="status"
               invisible="state != 'frozen'">
            <strong>Проект заморожен.</strong>
            Объявления сняты с публикации, новых откликов не будет.
            Вклады и участники сохранены — после возобновления объявления
            нужно опубликовать заново.
            <div class="mt-1">
              Вернётся в состояние «<field name="resume_state" readonly="1"
                                          nolabel="1" class="oe_inline"/>».
            </div>
          </div>
          <div class="alert alert-secondary" role="status"
               invisible="state != 'failed'">
            <strong>Сбор не удался.</strong>
            К сроку собрано меньше, чем требовало правило закрытия. Это не
            отмена: проект никто не закрывал, просто не хватило вкладов.
            Денежные вклады подлежат возврату, обещанное трудом и вещами —
            снятию.
          </div>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_project" type="object" class="oe_stat_button"
                    icon="fa-tasks" invisible="not project_id">
              <div class="o_stat_info">
                <!-- Этап ведения прямо на кнопке: человек видит, где
                     идут работы, не открывая управление. Пока этапа нет
                     — подпись прежняя. -->
                <span class="o_stat_value" invisible="not project_stage_id">
                  <field name="project_stage_id" nolabel="1"/>
                </span>
                <span class="o_stat_text">Управление</span>
                <span class="o_stat_text">проектом</span>
              </div>
            </button>
            <!--
              Отчёты о ходе — штатные `project.update`. Пункт 14 разбора
              архитектора: «новости проекта» из макета это отчёт о ходе,
              а не переписка, и он в движке уже есть — с рассылкой
              подписчикам и показом в управлении.
            -->
            <button name="action_open_updates" type="object" class="oe_stat_button"
                    icon="fa-line-chart" invisible="not project_id">
              <div class="o_stat_info">
                <span class="o_stat_value">
                  <field name="update_count" nolabel="1"/>
                </span>
                <span class="o_stat_text">Ход</span>
                <span class="o_stat_text">проекта</span>
              </div>
            </button>
          </div>
          <!--
            Шапка карточки по макету: снимок слева крупно, справа
            название, вид проекта, инициатор с лицом и кольцо готовности.

            Штатная `oe_avatar` ставит снимок квадратиком в угол — в
            каталоге проект показан большой фотографией, и открыв его,
            человек видел ту же фотографию величиной с почтовую марку.
            Готовность стояла строкой в группе «Ресурсы», ниже трёх
            экранов полей: главное число страницы читалось последним.
          -->
          <div class="o_coop_project_hero">
            <div class="o_coop_hero_photo">
              <field name="image_1920" widget="image" nolabel="1"
                     options="{'preview_image': 'image_512'}"/>
            </div>
            <div class="o_coop_hero_main">
              <h1><field name="name" placeholder="Название проекта"/></h1>
              <field name="summary" class="o_coop_hero_summary"
                     placeholder="Одна строка, которую видно в каталоге"/>
              <div class="o_coop_hero_tags">
                <field name="kind" widget="badge"
                       decoration-info="kind == 'cooperative'"
                       decoration-warning="kind == 'commercial'"
                       decoration-muted="kind == 'nonprofit'"/>
                <span class="o_coop_hero_city" invisible="not city">
                  <field name="city" nolabel="1" readonly="1"/>
                </span>
              </div>
              <div class="o_coop_hero_owner">
                <field name="partner_id" widget="many2one_avatar" nolabel="1"
                       readonly="1"/>
              </div>
              <div class="o_coop_hero_ring" invisible="state == 'draft'">
                <field name="readiness" widget="coop_readiness_ring"
                       nolabel="1"/>
              </div>
            </div>
          </div>
          <!--
            Блок сбора идёт во всю ширину листа, а не половиной. У
            половины поле выбора выходило 156 точек при нужных 159, и
            «Номинальный счёт в банке» читался как «Номинальный счёт в».
          -->
          <group string="Сбор" class="o_coop_funding" invisible="state == 'draft'">
            <group>
              <field name="date_start" readonly="1"
                     invisible="not date_start"/>
              <field name="date_deadline"/>
              <field name="days_left" invisible="state != 'gathering'"/>
              <field name="funding_rule"/>
              <field name="funding_threshold"
                     invisible="funding_rule != 'threshold'"/>
            </group>
            <group>
              <field name="contribution_basis"/>
              <field name="payment_route"
                     invisible="not contribution_basis"/>
            </group>
          </group>
          <group string="Если соберём не всё" class="o_coop_fallback"
                 invisible="funding_rule == 'all_or_nothing' or state == 'draft'">
            <field name="fallback_plan" nolabel="1"
                   placeholder="Что именно будет сделано на неполном сборе"/>
          </group>
          <group>
            <group string="О проекте">
              <field name="kind"/>
              <field name="category_id"/>
              <field name="subcategory_id"/>
              <field name="city"/>
            </group>
            <group string="Кто собирает">
              <field name="partner_id"/>
              <field name="author_id"/>
              <field name="project_id" readonly="1"/>
            </group>
          </group>
          <group>
            <group string="Ресурсы">
              <field name="required_total"/>
              <field name="contribution_total"/>
              <field name="readiness" widget="progressbar"/>
              <field name="contributor_count"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>

          <!--
            Участие в проекте — главный экран для того, кто пришёл со
            стороны. До него на странице проекта были только действия
            инициатора: посмотреть, чего проекту не хватает и что за это
            полагается, было негде.

            Разбито по видам, как в макете: сварщик ищет глазами труд, а
            не цемент. Пай — доля за закрытие строки; она важнее
            стоимости, потому что 150 000 ₽ значат разное в проекте на
            полтора миллиона и в проекте на пятнадцать.
          -->
          <div class="o_coop_needs" invisible="state in ('draft', 'cancelled')">
            <div class="o_coop_needs_head">Участие в проекте</div>
            <div class="o_coop_needs_lead"
                 invisible="kind == 'nonprofit'">Вносите долю не только деньгами</div>
            <div class="o_coop_needs_lead"
                 invisible="kind != 'nonprofit'">Помочь можно не только деньгами</div>
            <!--
              Слово меняется по виду проекта. Пай — имущественное участие
              в кооперативе, доля в коммерческом — часть в капитале, а в
              некоммерческом нет ни того ни другого: вклад туда не даёт
              прав на результат, и обещать их нельзя даже вскользь.
            -->
            <p class="o_coop_needs_note" invisible="kind != 'cooperative'">
              В проект можно войти разными формами вклада — деньгами,
              физическим или умственным трудом, материальными и
              нематериальными активами и другими ресурсами, какие у вас
              есть. Какой пай полагается за конкретный вклад — указано в
              списках ниже.
            </p>
            <p class="o_coop_needs_note"
               invisible="kind not in ('commercial', 'dao')">
              В проект можно войти разными формами вклада — деньгами,
              физическим или умственным трудом, материальными и
              нематериальными активами и другими ресурсами, какие у вас
              есть. Какая доля полагается за конкретный вклад — указано в
              списках ниже.
            </p>
            <p class="o_coop_needs_note" invisible="kind != 'nonprofit'">
              Проекту можно помочь разными формами вклада — деньгами,
              физическим или умственным трудом, материалами и другими
              ресурсами, какие у вас есть. Долей и паёв в некоммерческом
              проекте нет: вклад сюда — помощь делу, а не участие в
              собственности.
            </p>
            <!-- Все потребности закрыты — раздел не прячем, а говорим об
                 этом словами. Исчезнувший раздел читается как поломка
                 страницы, а не как «участвовать сейчас не в чем». -->
            <div class="o_coop_needs_empty"
                 invisible="need_material_ids or need_equipment_ids or need_labour_ids or need_financial_ids">
              Все потребности проекта закрыты — участвовать сейчас не в чем.
              Инициатор объявит новые, когда они появятся.
            </div>
            <div class="o_coop_needs_group" invisible="not need_material_ids">
              <div class="o_coop_needs_title">Необходимые материальные ресурсы</div>
              <field name="need_material_ids" nolabel="1" readonly="1">
                <list class="o_coop_needs_list" create="false" delete="false">
                  <field name="need_can_join" column_invisible="1"/>
                  <field name="name" string="Ресурс"/>
                  <field name="price" string="Стоимость"/>
                  <!-- Пай, доля или ничего — по виду проекта. Решение
                       владельца 15 сентября 2026. Поле-двойник, потому
                       что подпись колонки задаётся разметкой, а одно и
                       то же поле дважды в списке движок не берёт. -->
                  <field name="need_share_percent" string="Пай, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind != 'cooperative'"/>
                  <field name="need_share_ratio" string="Доля, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind not in ('commercial', 'dao')"/>
                  <field name="need_offer_count" string="Откликов"/>
                  <button name="action_join_need" type="object"
                          string="Участвовать" class="btn btn-secondary btn-sm"
                          invisible="not need_can_join"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </div>
            <div class="o_coop_needs_group" invisible="not need_equipment_ids">
              <div class="o_coop_needs_title">Необходимое оборудование</div>
              <field name="need_equipment_ids" nolabel="1" readonly="1">
                <list class="o_coop_needs_list" create="false" delete="false">
                  <field name="need_can_join" column_invisible="1"/>
                  <field name="name" string="Ресурс"/>
                  <field name="price" string="Стоимость"/>
                  <!-- Пай, доля или ничего — по виду проекта. Решение
                       владельца 15 сентября 2026. Поле-двойник, потому
                       что подпись колонки задаётся разметкой, а одно и
                       то же поле дважды в списке движок не берёт. -->
                  <field name="need_share_percent" string="Пай, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind != 'cooperative'"/>
                  <field name="need_share_ratio" string="Доля, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind not in ('commercial', 'dao')"/>
                  <field name="need_offer_count" string="Откликов"/>
                  <button name="action_join_need" type="object"
                          string="Участвовать" class="btn btn-secondary btn-sm"
                          invisible="not need_can_join"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </div>
            <div class="o_coop_needs_group" invisible="not need_labour_ids">
              <div class="o_coop_needs_title">Необходимые трудовые ресурсы</div>
              <field name="need_labour_ids" nolabel="1" readonly="1">
                <list class="o_coop_needs_list" create="false" delete="false">
                  <field name="need_can_join" column_invisible="1"/>
                  <field name="name" string="Ресурс"/>
                  <field name="price" string="Стоимость"/>
                  <!-- Пай, доля или ничего — по виду проекта. Решение
                       владельца 15 сентября 2026. Поле-двойник, потому
                       что подпись колонки задаётся разметкой, а одно и
                       то же поле дважды в списке движок не берёт. -->
                  <field name="need_share_percent" string="Пай, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind != 'cooperative'"/>
                  <field name="need_share_ratio" string="Доля, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind not in ('commercial', 'dao')"/>
                  <field name="need_offer_count" string="Откликов"/>
                  <button name="action_join_need" type="object"
                          string="Участвовать" class="btn btn-secondary btn-sm"
                          invisible="not need_can_join"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </div>
            <div class="o_coop_needs_group" invisible="not need_financial_ids">
              <div class="o_coop_needs_title">Необходимые финансовые ресурсы</div>
              <field name="need_financial_ids" nolabel="1" readonly="1">
                <list class="o_coop_needs_list" create="false" delete="false">
                  <field name="need_can_join" column_invisible="1"/>
                  <field name="name" string="Ресурс"/>
                  <field name="price" string="Стоимость"/>
                  <!-- Пай, доля или ничего — по виду проекта. Решение
                       владельца 15 сентября 2026. Поле-двойник, потому
                       что подпись колонки задаётся разметкой, а одно и
                       то же поле дважды в списке движок не берёт. -->
                  <field name="need_share_percent" string="Пай, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind != 'cooperative'"/>
                  <field name="need_share_ratio" string="Доля, %"
                         widget="float" digits="[5,2]"
                         column_invisible="parent.kind not in ('commercial', 'dao')"/>
                  <field name="need_offer_count" string="Откликов"/>
                  <button name="action_join_need" type="object"
                          string="Участвовать" class="btn btn-secondary btn-sm"
                          invisible="not need_can_join"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </div>
          </div>
          <notebook>
            <page string="Описание" name="description">
              <field name="description"/>
            </page>
            <page string="Вклады" name="contributions">
              <div class="alert alert-info" role="status">
                Краудресурсинг: скидываются не только деньгами. Смена
                экскаваторщика, месяц аренды склада и перевод на счёт сводятся
                в одну величину только через денежную оценку — она и
                записывается, по соглашению сторон.
              </div>
              <field name="contribution_ids">
                <list editable="bottom">
                  <field name="partner_id"/>
                  <field name="kind"/>
                  <field name="name"/>
                  <field name="value" sum="Собрано"/>
                  <field name="share_percent" widget="percentage" readonly="1"
                         string="Пай"
                         column_invisible="parent.kind != 'cooperative'"/>
                  <field name="share_ratio" widget="percentage" readonly="1"
                         string="Доля"
                         column_invisible="parent.kind not in ('commercial', 'dao')"/>
                  <field name="offered_on"/>
                  <field name="withdraw_until" optional="hide"/>
                  <field name="delivered_on" optional="hide"/>
                  <field name="return_mode" optional="hide"/>
                  <field name="refund_amount" optional="hide"/>
                  <field name="unrecovered_amount" optional="hide"/>
                  <field name="labour_form" optional="hide"
                         column_invisible="1"/>
                  <field name="currency_id" column_invisible="True"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'accepted'"
                         decoration-info="state in ('returned', 'compensated', 'waived')"
                         decoration-muted="state in ('declined', 'expired',
                                                     'withdrawn', 'released',
                                                     'consumed')"/>
                  <button name="action_accept" type="object" string="Принять"
                          icon="fa-check" invisible="state != 'offered'"/>
                  <button name="action_decline" type="object" string="Отклонить"
                          icon="fa-times" invisible="state != 'offered'"/>
                  <button name="action_mark_delivered" type="object"
                          string="Передано" icon="fa-truck"
                          invisible="state != 'accepted' or delivered_on
                                     or parent.state != 'running'"/>
                  <button name="action_consume" type="object"
                          string="Израсходован" icon="fa-fire"
                          invisible="state != 'accepted'
                                     or kind not in ('material', 'knowledge')"/>
                  <button name="action_return" type="object" string="Вернуть"
                          icon="fa-undo"
                          invisible="state not in ('accepted', 'consumed')
                                     or kind != 'money'"/>
                  <button name="action_release" type="object"
                          string="Снять обязательство" icon="fa-unlink"
                          invisible="state != 'accepted' or kind == 'money'"/>
                  <button name="action_compensate" type="object"
                          string="Возместить" icon="fa-money"
                          invisible="state != 'consumed'"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <!--
          Лента записи — своя у каждого проекта и каждого сообщества, как
          и у человека с организацией. Это одна и та же лента движка у
          своей записи; отдельной «своей» сущности для неё нет.

          Под карточкой, а не сбоку: сторону задаёт
          `coop_theme/static/src/js/wall.js`.
        -->
        <chatter reload_on_post="True"/>
</form>
    </field>
  </record>

  <record id="view_coop_project_search" model="ir.ui.view">
    <field name="name">coop.project.search</field>
    <field name="model">coop.project</field>
    <field name="arch" type="xml">
      <search string="Проекты">
        <field name="name"/>
        <field name="city"/>
        <field name="category_id"/>
        <field name="partner_id"/>
        <filter name="gathering" string="Идёт сбор" domain="[('state', '=', 'gathering')]"/>
        <filter name="running" string="Запущенные" domain="[('state', '=', 'running')]"/>
        <filter name="frozen" string="Заморожены" domain="[('state', '=', 'frozen')]"/>
        <filter name="failed" string="Сбор не удался" domain="[('state', '=', 'failed')]"/>
        <separator/>
        <!-- По дате, а не по «осталось дней»: вычисляемое нехранимое поле
             в домене фильтра Odoo отвергает целиком, с «Unsearchable
             field», и представление не грузится вовсе. -->
        <filter name="deadline_soon" string="Срок на исходе"
                domain="[('state', '=', 'gathering'),
                         ('date_deadline', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
        <separator/>
        <filter name="alive" string="Не остановлены"
                domain="[('state', 'not in', ('frozen', 'cancelled', 'failed'))]"/>
        <separator/>
        <filter name="almost" string="Собраны больше чем наполовину"
                domain="[('readiness', '>=', 50)]"/>
        <filter name="starting" string="Только начали"
                domain="[('readiness', '&lt;', 25)]"/>
        <separator/>
        <filter name="cooperative" string="Кооперативные" domain="[('kind', '=', 'cooperative')]"/>
        <filter name="dao" string="ДАО" domain="[('kind', '=', 'dao')]"/>
        <group>
          <filter name="by_kind" string="По виду" context="{'group_by': 'kind'}"/>
          <filter name="by_category" string="По теме" context="{'group_by': 'category_id'}"/>
          <filter name="by_city" string="По городу" context="{'group_by': 'city'}"/>
          <filter name="by_state" string="По состоянию" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_coop_projects" model="ir.actions.act_window">
    <field name="name">Проекты</field>
    <field name="res_model">coop.project</field>
    <field name="path">projects</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить проект', 'coop_shelf_field': 'category_id'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Проектов пока нет</p>
      <p>
        Краудресурсинг: проект собирает не только деньги, но труд, технику,
        материалы и знания. Пай в кооперативном проекте и доля в
        коммерческом складываются из стоимости вклада, а не вписываются
        руками.
      </p>
    </field>
  </record>

  <record id="action_coop_my_projects" model="ir.actions.act_window">
    <field name="name">Мои проекты</field>
    <field name="res_model">coop.project</field>
    <field name="path">my-projects</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('partner_id.user_ids', 'in', [uid])]</field>
    <field name="context">{'search_default_by_state': 1, 'coop_create_label': 'Добавить проект'}</field>
  </record>

  <record id="action_coop_project_category" model="ir.actions.act_window">
    <field name="name">Темы проектов</field>
    <field name="res_model">coop.project.category</field>
    <field name="view_mode">list,form</field>
      <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Тем пока нет</p>
      <p>Тема собирает проекты одного рода — переработка, техника, обучение. По ней ищут проект те, кто готов вложить труд или ресурс, но ещё не знает, во что именно.</p>
    </field>
</record>

  <!--
    «Мои проекты» — и заведённые самим человеком, и те, куда он вложился.
    Вторая половина не менее важна первой: краудресурсинг тем и живёт,
    что участник принимает участие в чужом проекте трудом и техникой, и
    найти, где именно, он должен здесь, а не перебирая каталог.
  -->
  <record id="action_coop_my_projects" model="ir.actions.act_window">
    <field name="name">Мои проекты</field>
    <field name="res_model">coop.project</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'bin_size': True,'coop_catalog': True, 'coop_create_label': 'Добавить проект'}</field>
    <field name="domain">['|', ('partner_id.user_ids', 'in', [uid]), ('contribution_ids.partner_id.user_ids', 'in', [uid])]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вы пока ни в чём не участвуете</p>
      <p>Заведите свой проект или примите участие в чужом — вкладом
         считается не только деньги, но труд, техника, материалы и
         знания.</p>
    </field>
  </record>

  <menuitem id="menu_coop_projects_root" name="Проекты" sequence="18"
            web_icon="coop_projects,static/description/icon.png"/>
  <menuitem id="menu_coop_projects" name="Каталог проектов"
            parent="menu_coop_projects_root" action="action_coop_projects" sequence="10"/>
  <menuitem id="menu_coop_my_projects" name="Мои проекты"
            parent="menu_coop_projects_root" action="action_coop_my_projects"
            sequence="15"/>
  <menuitem id="menu_coop_project_category" name="Темы"
            parent="menu_coop_projects_root" action="action_coop_project_category"
            sequence="90" groups="coop_base.group_coop_platform"/>

</odoo>
