<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Заметки — на штатных To-Do (задача 426, владелец 12.11.2026):
    «Моя страница → Заметки» и «Задачи» (решение 705, пункты меню — в
    `coop_profile`) и вкладка «Заметки» на странице проекта. Действие своё: переименовать движковое «To-dos» нельзя — его
    перевод лежит поверх имени.
  -->
  <!--
    Заметки на доске (владелец 26.11.2026: «не как доска канбан, а как
    заметки на доске»). Образец плитки — «Заметки организации».
  -->
  <record id="view_note_board" model="ir.ui.view">
    <field name="name">project.task.note.board</field>
    <field name="model">project.task</field>
    <field name="priority">900</field>
    <field name="arch" type="xml">
      <kanban class="o_coop_notes_board" records_draggable="false"
              group_create="0" default_order="coop_pinned desc, write_date desc, id desc">
        <field name="color"/>
        <field name="coop_pinned"/>
        <templates>
          <t t-name="menu">
            <a role="menuitem" type="object" name="action_coop_pin" class="dropdown-item">
              <t t-if="record.coop_pinned.raw_value">Открепить</t>
              <t t-else="">Закрепить</t>
            </a>
            <a role="menuitem" type="object" name="action_coop_to_task" class="dropdown-item">Сделать задачей</a>
            <a role="menuitem" type="archive" class="dropdown-item">В архив</a>
            <a role="menuitem" t-if="widget.deletable" type="delete" class="dropdown-item">Удалить</a>
            <field name="color" widget="kanban_color_picker"/>
          </t>
          <t t-name="card">
            <div t-att-class="'o_coop_note o_coop_note_c' + (record.color.raw_value || 0)">
              <div class="o_coop_note_title">
                <i t-if="record.coop_pinned.raw_value" class="fa fa-thumb-tack me-1" title="Закреплена"/>
                <field name="name"/>
              </div>
              <div class="o_coop_note_text"><field name="coop_excerpt"/></div>
              <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              <div class="o_coop_note_foot">
                <field name="coop_space_label" class="o_coop_note_space"/>
                <field name="user_ids" widget="many2many_avatar_user" readonly="True"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="view_note_list" model="ir.ui.view">
    <field name="name">project.task.note.list</field>
    <field name="model">project.task</field>
    <field name="priority">900</field>
    <field name="arch" type="xml">
      <list default_order="coop_pinned desc, write_date desc, id desc">
        <field name="name" string="Заметка"/>
        <field name="coop_space_label"/>
        <field name="tag_ids" widget="many2many_tags" optional="show"/>
        <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
        <field name="write_date" string="Изменена" optional="show"/>
      </list>
    </field>
  </record>
  <record id="action_coop_notes" model="ir.actions.act_window">
    <field name="name">Заметки</field>
    <field name="res_model">project.task</field>
    <field name="path">notes</field>
    <field name="domain">[('coop_kind', '=', 'note'), '|', ('user_ids', 'in', [uid]), ('coop_space', '!=', 'personal'), ('project_id', '=', False), ('parent_id', '=', False), ('is_template', '=', False)]</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="project_todo.project_task_view_todo_search"/>
    <field name="context">{
      'default_project_id': False,
      'default_coop_kind': 'note',
      'coop_search': 1,
      'coop_create_label': 'Добавить заметку',
      'show_todo_mail_helper': True,
      'show_task_options': False,
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Заметок пока нет</p>
      <p>Личную заметку видите только вы и те, кого вы в неё добавили.
        Заметку проекта, организации или группы видят их участники.</p>
    </field>
  </record>
  <record id="action_coop_notes_kanban" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_note_board"/>
    <field name="act_window_id" ref="action_coop_notes"/>
  </record>
  <record id="action_coop_notes_list" model="ir.actions.act_window.view">
    <field name="sequence">2</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_note_list"/>
    <field name="act_window_id" ref="action_coop_notes"/>
  </record>
  <record id="action_coop_notes_form" model="ir.actions.act_window.view">
    <field name="sequence">3</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="project_todo.project_task_view_todo_form"/>
    <field name="act_window_id" ref="action_coop_notes"/>
  </record>

  <record id="action_coop_tasks" model="ir.actions.act_window">
    <field name="name">Задачи</field>
    <field name="res_model">project.task</field>
    <field name="path">todo</field>
    <field name="domain">[('coop_kind', '=', 'task'), '|', ('user_ids', 'in', [uid]), ('coop_space', '!=', 'personal'), ('project_id', '=', False), ('parent_id', '=', False), ('is_template', '=', False)]</field>
    <field name="view_mode">kanban,list,form,calendar</field>
    <field name="search_view_id" ref="project_todo.project_task_view_todo_search"/>
    <field name="context">{
      'search_default_open_tasks': 1,
      'list_view_ref': 'project_todo.project_task_view_todo_tree',
      'default_project_id': False,
      'default_coop_kind': 'task',
      'coop_create_label': 'Добавить задачу',
      'show_todo_mail_helper': True,
      'show_task_options': False,
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Задач пока нет</p>
      <p>Личную задачу видите только вы и её исполнители.
        Задачу проекта, организации или группы видят их участники.</p>
    </field>
  </record>
  <record id="action_coop_tasks_kanban" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="project_todo.project_task_view_todo_kanban"/>
    <field name="act_window_id" ref="action_coop_tasks"/>
  </record>
  <record id="action_coop_tasks_list" model="ir.actions.act_window.view">
    <field name="sequence">2</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="project_todo.project_task_view_todo_tree"/>
    <field name="act_window_id" ref="action_coop_tasks"/>
  </record>
  <record id="action_coop_tasks_form" model="ir.actions.act_window.view">
    <field name="sequence">3</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="project_todo.project_task_view_todo_form"/>
    <field name="act_window_id" ref="action_coop_tasks"/>
  </record>
  <record id="action_coop_tasks_calendar" model="ir.actions.act_window.view">
    <field name="sequence">4</field>
    <field name="view_mode">calendar</field>
    <field name="view_id" ref="project_todo.project_task_view_todo_calendar"/>
    <field name="act_window_id" ref="action_coop_tasks"/>
  </record>


  <!-- В форме заметки — к какому проекту платформы она относится. -->
  <record id="view_todo_form_coop_project" model="ir.ui.view">
    <field name="name">project.task.todo.form.coop.project</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project_todo.project_task_view_todo_form"/>
    <field name="arch" type="xml">
      <!-- Заметке — без этапов, срока, важности и отметки «выполнено»: это
           у задачи. Заметке — цвет и закрепление. -->
      <xpath expr="//header" position="attributes">
        <attribute name="invisible">coop_kind == 'note'</attribute>
      </xpath>
      <xpath expr="//div[@invisible='not active']" position="attributes">
        <attribute name="invisible">not active or coop_kind == 'note'</attribute>
      </xpath>
      <xpath expr="//div[@invisible='active']" position="attributes">
        <attribute name="invisible">active or coop_kind == 'note'</attribute>
      </xpath>
      <xpath expr="//field[@name='date_deadline']" position="attributes">
        <attribute name="invisible">coop_kind == 'note'</attribute>
      </xpath>
      <xpath expr="//field[@name='tag_ids']" position="after">
        <field name="color" string="Цвет" widget="color_picker" invisible="coop_kind != 'note'"/>
        <field name="coop_pinned" invisible="coop_kind != 'note'"/>
      </xpath>
      <xpath expr="//h1/field[@name='name']" position="attributes">
        <attribute name="placeholder">Название</attribute>
      </xpath>
      <xpath expr="//field[@name='user_ids']" position="after">
        <field name="coop_kind"/>
        <field name="coop_space"/>
      </xpath>
      <xpath expr="//field[@name='date_deadline']" position="after">
        <field name="coop_project_id" options="{'no_create': True}"
               placeholder="Без проекта" invisible="coop_space == 'project'"/>
        <!-- Тот же проект, но выбор — только из тех, где человек в команде. -->
        <field name="coop_project_id" options="{'no_create': True}"
               invisible="coop_space != 'project'" required="coop_space == 'project'"
               domain="['|', ('partner_id.user_ids', 'in', [uid]), ('contribution_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('state', '=', 'accepted')])]"/>
      </xpath>
    </field>
  </record>
  <record id="view_todo_list_coop_project" model="ir.ui.view">
    <field name="name">project.task.todo.list.coop.project</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project_todo.project_task_view_todo_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="coop_space" optional="show"/>
        <field name="coop_project_id" optional="show"/>
      </xpath>
    </field>
  </record>
  <record id="view_todo_search_coop_project" model="ir.ui.view">
    <field name="name">project.task.todo.search.coop.project</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project_todo.project_task_view_todo_search"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="coop_project_id"/>
      </xpath>
      <xpath expr="//filter[@name='open_tasks']" position="before">
        <filter name="space_personal" string="Личное" domain="[('coop_space', '=', 'personal')]"/>
        <filter name="space_project" string="Проекты" domain="[('coop_space', '=', 'project')]"/>
        <separator/>
      </xpath>
      <xpath expr="//search" position="inside">
        <group>
          <filter name="by_coop_space" string="Пространство"
                  context="{'group_by': 'coop_space'}"/>
          <filter name="by_coop_project" string="Проект платформы"
                  context="{'group_by': 'coop_project_id'}"/>
        </group>
      </xpath>
    </field>
  </record>

  <!-- Вкладка «Заметки» на странице проекта — свои и общие команды. -->
  <record id="view_coop_project_form_notes" model="ir.ui.view">
    <field name="name">coop.project.form.notes</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_projects.view_coop_project_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook[hasclass('coop-show_tabs')]" position="inside">
        <page string="Заметки" name="notes">
          <field name="coop_note_count" invisible="1"/>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <button name="action_coop_new_note" type="object"
                    class="btn btn-primary btn-sm" string="+ Заметка"/>
            <button name="action_coop_notes" type="object"
                    class="btn btn-secondary btn-sm" string="Все заметки по проекту"
                    invisible="not coop_note_count"/>
          </div>
          <p class="text-muted" invisible="coop_note_count">
            Заметок по проекту пока нет. Личную видите только вы, заметку с
            пространством «Проект» — вся команда.
          </p>
          <field name="coop_note_ids" nolabel="1" readonly="1"
                 invisible="not coop_note_count"
                 context="{'form_view_ref': 'project_todo.project_task_view_todo_form'}">
            <list open_form_view="1" create="0" delete="0">
              <field name="name" string="Заметка"/>
              <field name="state" widget="todo_done_checkmark" nolabel="1"/>
              <field name="date_deadline" optional="show"/>
              <field name="write_date" string="Изменена" optional="show"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
