<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Разбор заявок из управления проектом (владелец 14.11.2026: «он
       должен быть в управлении проектом»). Кнопка среди кнопок-счётчиков
       формы проекта, только команде сбора, из которого вырос проект; ведёт
       на тот же канбан заявок, что и страница сбора. -->
  <record id="view_project_project_form_offers" model="ir.ui.view">
    <field name="name">project.project.form.coop.offers</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      <!-- Первой в ряду: остальные кнопки уходят под «Ещё», а разбор
           заявок должен быть на виду. -->
      <xpath expr="//div[@name='button_box']/button[@name='action_view_tasks']"
             position="before">
        <field name="coop_offer_can" invisible="1"/>
        <button name="action_coop_open_offers" type="object"
                class="oe_stat_button" icon="fa-inbox"
                invisible="not coop_offer_can">
          <div class="o_stat_info">
            <span class="o_stat_value">
              <field name="coop_offer_new" nolabel="1"/>
            </span>
            <span class="o_stat_text">Заявки на вклады</span>
          </div>
        </button>
      </xpath>

      <!-- Рабочее поле «Управления проектом» по образцу 395: заявки на
           потребности карточками, ниже — аналитика. Команде сбора. -->
      <xpath expr="//notebook/page[@name='map']" position="before">
        <page name="coop_offers" string="Заявки на потребности"
              invisible="not coop_offer_can">
          <p class="text-muted mb-2">
            Утверждаете вы — инициатор. У потребности может быть свой
            ответственный. Принятая заявка закрывает потребность, остальные
            отклоняются сразу, откликнувшиеся получают извещение.
          </p>
          <field name="coop_offer_ids" nolabel="1" mode="kanban"
                 readonly="1" context="{'kanban_view_ref': 'coop_projects.view_coop_contribution_offers_kanban_embedded'}"/>
        </page>
        <page name="coop_analytics" string="Аналитика проекта"
              invisible="not coop_offer_can">
          <field name="coop_analytics" nolabel="1"/>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
