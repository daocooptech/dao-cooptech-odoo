<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Рабочая область «Управления проектом» по образцам дизайн-системы
       WorkHeaderD (выбран владельцем 28.10.2026) и OffersReviewPage,
       задача 449. Кусок 1 (14.11.2026): шапка минимальная, кнопок-счётчиков
       нет (показатели — в «Сводке»), вкладок нет — отдельные блоки.

       Приоритет 99: вид применяется последним. Он переносит содержимое
       вкладок в блоки, и вид, применённый после него, не нашёл бы своих
       целей внутри вкладок и уронил бы форму. -->
  <record id="view_project_project_form_offers" model="ir.ui.view">
    <field name="name">project.project.form.coop.workspace</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">

      <!-- Кнопки-счётчики движка переносились в четыре строки и занимали
           пол-экрана; в образце их нет — задачи, вехи, статус, табели
           собраны в «Сводке» справа. -->
      <xpath expr="//div[@name='button_box']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Шапка: название, «В избранное», «Настройки проекта», главная
           «Задача»; под названием — строка «заказчик · менеджер · сроки». -->
      <xpath expr="//field[@name='is_favorite']" position="after">
        <!-- Настройки скрыты и открываются только колёсиком (владелец
             14.11.2026: «настройки проекта открываются только при нажатии
             на иконку колесика, а так надо убрать из карточки»).
             Открывает `static/src/js/pm_settings_toggle.js`. -->
        <!-- Только менеджеру проекта (владелец 15.11.2026: «только
             менеджер проекта мог редактировать сведения»). -->
        <field name="coop_is_manager" invisible="1"/>
        <a role="button" tabindex="0" class="btn btn-secondary o_coop_pm_gear ms-2"
           title="Настройки проекта" aria-label="Настройки проекта"
           aria-controls="coop_pm_settings" aria-expanded="false"
           invisible="not coop_is_manager">
          <i class="oi" data-icon="settings"/>
        </a>
        <!-- Подпись как на экране задач; значок «+» движок рисовал
             чёрточкой — он не нужен (14.11.2026). -->
        <button name="action_coop_new_task" type="object" class="btn btn-primary ms-2"
                string="Добавить задачу"/>
      </xpath>
      <!-- Строка «заказчик · менеджер · сроки» под названием снята:
           то же самое стоит в «Сведениях» справа (владелец 15.11.2026:
           «сведения перенеси в правую колонку под карту … тогда надо
           убрать дублирующую информацию под названием проекта»). -->

      <!-- Блоки на месте вкладок. -->
      <xpath expr="//sheet/notebook" position="before">
        <div class="o_coop_pm">
          <div class="o_coop_pm_main">
            <div class="o_coop_pm_block">
              <h3 class="o_coop_pm_title">Описание</h3>
              <!-- Фото и видео карточки сбора — как на ней (№ 455). -->
              <div class="o_coop_pm_desc">
                <div class="coop-gallery o_coop_pm_media" invisible="not coop_media_data">
                  <field name="coop_media_data" widget="coop_media" nolabel="1" readonly="1"/>
                </div>
                <div id="coop_pm_description"/>
              </div>
            </div>
            <!-- Видны всем, кто открыл проект, выросший из сбора (№ 455);
                 «Принять» и «Отклонить» — только менеджеру проекта
                 (владелец 15.11.2026). -->
            <div class="o_coop_pm_block" invisible="not coop_card_id">
              <field name="coop_offer_can" invisible="1"/>
              <field name="coop_card_id" invisible="1"/>
              <h3 class="o_coop_pm_title">Заявки на потребности</h3>
              <p class="text-muted mb-2" invisible="not coop_offer_can">
                Утверждаете вы — инициатор и менеджер проекта. Принятая
                заявка закрывает потребность, остальные отклоняются сразу,
                откликнувшиеся получают извещение.
              </p>
              <p class="text-muted mb-2" invisible="coop_offer_can">
                Утверждает инициатор — менеджер проекта. Принятая заявка
                закрывает потребность, остальные отклоняются сразу.
              </p>
              <field name="coop_offers_json" nolabel="1" widget="coop_offers_review"/>
            </div>
            <div class="o_coop_pm_block o_coop_pm_an" invisible="not coop_card_id">
              <h3 class="o_coop_pm_title">Аналитика проекта</h3>
              <notebook>
                <page name="coop_an_money" string="Финансовые вклады"
                      invisible="not coop_an_money">
                  <field name="coop_an_money" nolabel="1"/>
                </page>
                <page name="coop_an_intangibles" string="НМА"
                      invisible="not coop_an_intangibles">
                  <field name="coop_an_intangibles" nolabel="1"/>
                </page>
                <page name="coop_an_cfa" string="ЦФА"
                      invisible="not coop_an_cfa">
                  <field name="coop_an_cfa" nolabel="1"/>
                </page>
                <page name="coop_an_deals" string="Контракты"
                      invisible="not coop_an_deals">
                  <field name="coop_an_deals" nolabel="1"/>
                </page>
              </notebook>
            </div>
            <div class="o_coop_pm_block" id="coop_pm_settings">
              <h3 class="o_coop_pm_title">Настройки проекта</h3>
              <div id="coop_pm_settings_body"/>
            </div>
          </div>
          <div class="o_coop_pm_side">
            <div class="o_coop_pm_block">
              <h3 class="o_coop_pm_cap">Сводка</h3>
              <field name="coop_summary" nolabel="1" widget="coop_project_summary"/>
            </div>
            <!-- Мини-карта — небольшой справа, под «Сводкой», как во всех
                 карточках с местом (задача 420, владелец 14.11.2026:
                 «карту мы договорились размещать небольшую в правой колонке»). -->
            <div class="o_coop_pm_block o_coop_pm_map" invisible="not google_map_iframe">
              <h3 class="o_coop_pm_cap">Карта</h3>
              <div id="coop_pm_map"/>
            </div>
            <!-- «Сведения» — справа под картой (владелец 15.11.2026). -->
            <div class="o_coop_pm_block o_coop_pm_facts">
              <h3 class="o_coop_pm_cap">Сведения</h3>
              <div id="coop_pm_facts">
                <!-- Заказчик — с лого и ссылкой (владелец 14.11.2026); раньше
                     стоял в строке под названием. -->
                <field name="coop_partner_is_manager" invisible="1"/>
                <group invisible="not partner_id or coop_partner_is_manager">
                  <field name="partner_id" string="Заказчик" readonly="1"
                         widget="many2one_avatar"/>
                </group>
              </div>
            </div>
          </div>
        </div>
      </xpath>

      <xpath expr="//div[@id='coop_pm_description']" position="inside">
        <xpath expr="//page[@name='description']/field[@name='description']" position="move"/>
      </xpath>
      <xpath expr="//div[@id='coop_pm_facts']" position="inside">
        <xpath expr="//sheet/group" position="move"/>
      </xpath>
      <xpath expr="//div[@id='coop_pm_settings_body']" position="inside">
        <xpath expr="//page[@name='settings']/group" position="move"/>
      </xpath>
      <xpath expr="//div[@id='coop_pm_settings_body']" position="inside">
        <xpath expr="//page[@name='settings']/group" position="move"/>
      </xpath>
      <xpath expr="//div[@id='coop_pm_settings_body']" position="inside">
        <xpath expr="//page[@name='settings']/group" position="move"/>
      </xpath>
      <!-- «Сведения» — только смотреть (владелец 15.11.2026: «есть выбор
           человека, он тут нужен?»): менеджер и теги без выбора, пустые
           теги не показываем. Менять их — в «Настройках проекта». -->
      <xpath expr="//div[@id='coop_pm_facts']//field[@name='tag_ids']" position="attributes">
        <attribute name="invisible">not tag_ids</attribute>
        <attribute name="readonly">1</attribute>
      </xpath>
      <xpath expr="//div[@id='coop_pm_facts']//field[@name='user_id']" position="attributes">
        <attribute name="readonly">1</attribute>
      </xpath>
      <!-- Заказчик движка — поле выбора со значком человека — повторял
           наш «Заказчик» с лого второй строкой (владелец 15.11.2026,
           № 455: «у заказчика поплыла верстка с лого и их 2»). Менять
           заказчика — в «Настройках проекта». -->
      <xpath expr="//div[@id='coop_pm_facts']//field[@name='partner_id'][@widget='res_partner_many2one']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//div[@id='coop_pm_settings_body']" position="inside">
        <group string="Менеджер и теги">
          <field name="user_id" string="Менеджер проекта" widget="many2one_avatar_user"/>
          <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        </group>
      </xpath>
      <!-- Избранное — закладкой платформы (`coop.favorite`, страница
           «Избранное»), а не звездой движка: звезда у нас — оценки
           (владелец 15.11.2026: «вместо звездочки у нас есть иконка
           избранного»). -->
      <xpath expr="//field[@name='is_favorite']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='is_favorite']" position="after">
        <field name="id" widget="coop_favorite_heart" nolabel="1" class="o_coop_pm_fav"/>
      </xpath>
      <!-- Вид проекта — капсулой справа от названия, та же, что в строке
           рубрики на карточке сбора (владелец 16.11.2026, № 455). -->
      <xpath expr="//div[hasclass('oe_title')]" position="after">
        <field name="coop_kind" readonly="1" nolabel="1" class="coop-pj_kind"
               invisible="not coop_kind"/>
      </xpath>
      <xpath expr="//div[@id='coop_pm_map']" position="inside">
        <xpath expr="//page[@name='map']/field[@name='google_map_iframe']" position="move"/>
      </xpath>

      <!-- Вкладки опустели; «Выставление счетов» убрано — счета будут в
           «Сводке» (кусок 2). -->
      <xpath expr="//sheet/notebook" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

</odoo>
