<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Разбор заявок из управления проектом (владелец 14.11.2026: «он
       должен быть в управлении проектом»). Кнопка среди кнопок-счётчиков
       формы проекта, только команде сбора, из которого вырос проект; ведёт
       на тот же канбан заявок, что и страница сбора. -->
  <record id="view_project_project_form_offers" model="ir.ui.view">
    <field name="name">project.project.form.coop.offers</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      <!-- Первой в ряду: остальные кнопки уходят под «Ещё», а разбор
           заявок должен быть на виду. -->
      <xpath expr="//div[@name='button_box']/button[@name='action_view_tasks']"
             position="before">
        <field name="coop_offer_can" invisible="1"/>
        <button name="action_coop_open_offers" type="object"
                class="oe_stat_button" icon="fa-inbox"
                invisible="not coop_offer_can">
          <div class="o_stat_info">
            <span class="o_stat_value">
              <field name="coop_offer_new" nolabel="1"/>
            </span>
            <span class="o_stat_text">Заявки на вклады</span>
          </div>
        </button>
      </xpath>

      <!-- Рабочее поле «Управления проектом» по образцу 395: блоки на
           одной странице, как на кадре, — заявки на потребности, под ними
           аналитика проекта с четырьмя переключателями. Команде сбора. -->
      <xpath expr="//notebook" position="before">
        <div class="o_coop_pm" invisible="not coop_offer_can">
          <div class="o_coop_pm_main">
            <div class="o_coop_pm_block">
              <h3 class="o_coop_pm_title">Заявки на потребности</h3>
              <p class="text-muted mb-2">
                Утверждаете вы — инициатор. У потребности может быть свой
                ответственный. Принятая заявка закрывает потребность,
                остальные отклоняются сразу, откликнувшиеся получают
                извещение.
              </p>
              <field name="coop_offers_json" nolabel="1" widget="coop_offers_review"/>
            </div>
            <div class="o_coop_pm_block">
              <h3 class="o_coop_pm_title">Аналитика проекта</h3>
              <notebook>
                <page name="coop_an_money" string="Финансовые вклады"
                      invisible="not coop_an_money">
                  <field name="coop_an_money" nolabel="1"/>
                </page>
                <page name="coop_an_intangibles" string="НМА"
                      invisible="not coop_an_intangibles">
                  <field name="coop_an_intangibles" nolabel="1"/>
                </page>
                <page name="coop_an_cfa" string="ЦФА"
                      invisible="not coop_an_cfa">
                  <field name="coop_an_cfa" nolabel="1"/>
                </page>
                <page name="coop_an_deals" string="Контракты"
                      invisible="not coop_an_deals">
                  <field name="coop_an_deals" nolabel="1"/>
                </page>
              </notebook>
            </div>
          </div>
          <div class="o_coop_pm_side">
            <div class="o_coop_pm_block">
              <h3 class="o_coop_pm_cap">Сводка</h3>
              <field name="coop_summary" nolabel="1"/>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>

</odoo>
