<?xml version="1.0" encoding="utf-8"?>
<odoo>


  <!-- Вкладки страницы проекта (владелец 12.11.2026): весь блок вкладок —
       над «Участием в проекте», «Аналитика» — последней. Вкладки
       добавляют и другие модули, поэтому переносим поздним видом:
       приоритет 99 применяется после их наследований. Своей вкладки и
       своего блока у потребностей нет — ниже расписана смета. -->
  <record id="view_coop_project_form_analytics_last" model="ir.ui.view">
    <field name="name">coop.project.form.tabs.order</field>
    <field name="model">coop.project</field>
    <field name="inherit_id" ref="coop_projects.view_coop_project_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook[hasclass('coop-show_tabs')]" position="inside">
        <xpath expr="//page[@name='analytics']" position="move"/>
      </xpath>
      <xpath expr="//div[hasclass('o_coop_needs')]" position="before">
        <xpath expr="//notebook[hasclass('coop-show_tabs')]" position="move"/>
      </xpath>
    </field>
  </record>

  <!-- Со стороны объявления: чья это потребность и что с предложениями. -->
  <record id="view_coop_resource_form_need" model="ir.ui.view">
    <field name="name">coop.resource.form.need</field>
    <field name="model">coop.resource</field>
    <field name="inherit_id" ref="coop_resources.view_coop_resource_form"/>
    <field name="arch" type="xml">
      <sheet position="inside">
        <group string="Потребность проекта" invisible="not project_id">
          <group>
            <field name="project_id" readonly="1"/>
            <field name="need_manager_id" readonly="not coop_can_edit"/>
          </group>
          <group>
            <field name="need_offer_count" readonly="1"/>
            <field name="need_accepted_id" readonly="1"/>
          </group>
        </group>
      </sheet>
    </field>
  </record>

  <!-- Пометка на карточке каталога. Решение владельца от 2026-09-14:
       потребности стоят в общем спросе, но видно, что это проект.
       Иначе откликнувшийся не понимает, во что входит: частное «ищу
       сварщика» и потребность кооперативного проекта — разные истории. -->
  <record id="view_coop_resource_kanban_need" model="ir.ui.view">
    <field name="name">coop.resource.kanban.need</field>
    <field name="model">coop.resource</field>
    <field name="inherit_id" ref="coop_resources.view_coop_resource_kanban"/>
    <field name="arch" type="xml">
      <field name="listing_type" position="after">
        <field name="is_project_need"/>
        <field name="project_id"/>
      </field>
      <xpath expr="//span[hasclass('o_coop_res_promo')]" position="before">
        <span class="o_coop_res_need" t-if="record.is_project_need.raw_value"
              title="Потребность проекта: отклик становится вкладом, а вкладчик — участником">
          Проект
        </span>
      </xpath>
    </field>
  </record>

  <!-- И в отборе: пометка, что объявление принадлежит проекту.
       Решение владельца от 2026-09-14: потребности стоят в общем спросе,
       но видно, что это проект, и есть переход в него. -->
  <record id="view_coop_resource_search_need" model="ir.ui.view">
    <field name="name">coop.resource.search.need</field>
    <field name="model">coop.resource</field>
    <field name="inherit_id" ref="coop_resources.view_coop_resource_search"/>
    <field name="arch" type="xml">
      <search position="inside">
        <filter name="project_needs" string="Потребности проектов"
                domain="[('project_id', '!=', False)]"/>
        <field name="project_id"/>
      </search>
    </field>
  </record>

</odoo>
