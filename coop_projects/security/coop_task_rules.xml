<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!--
      Кто какие задачи видит.

      Решение владельца от 2026-09-14, дословно: «в своем проекте
      инициатор видит все задачи, а если его утвердили в другом проекте то
      только задачи где он является ответственным».

      Правило глобальное — у него просто нет групп; признак `global` у
      `ir.rule` вычисляемый, задавать его записью нельзя, и попытка
      роняет разбор файла. Это принципиально: правила одной
      группы складываются по «или», и правило, повешенное на группу
      пользователей проектов, не сузило бы видимость, а расширило её,
      добавившись к штатным правилам Odoo. Сужает только глобальное: оно
      складывается со всеми остальными по «и».

      Раз правило глобальное, оно задело бы и руководителя проектов,
      которому положено видеть всё. Отсюда условие в самом домене: для
      руководителя правило вырождается в «всё разрешено».
    -->
    <record id="rule_coop_task_own" model="ir.rule">
      <field name="name">Задачи: свои и своего проекта</field>
      <field name="model_id" ref="project.model_project_task"/>
      <field name="domain_force">[(1, '=', 1)] if user.has_group('project.group_project_manager') else ['|', ('project_id.user_id', '=', user.id), ('user_ids', 'in', [user.id])]</field>
    </record>

  </data>
</odoo>
