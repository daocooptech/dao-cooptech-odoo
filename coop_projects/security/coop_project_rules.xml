<?xml version="1.0" encoding="utf-8"?>
<!--
  Без `noupdate` — правила доступа доставляются обновлением модуля.
-->
<odoo>
  <data>

    <record id="rule_project_read" model="ir.rule">
      <field name="name">Участник видит проекты в сборе и свои</field>
      <field name="model_id" ref="model_coop_project"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', ('state', 'in', ('gathering', 'running', 'frozen', 'failed', 'done')),
         ('partner_id', 'in', user.coop_actor_partner_ids.ids)]
      </field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_own" model="ir.rule">
      <field name="name">Править можно только свой проект</field>
      <field name="model_id" ref="model_coop_project"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[('partner_id', 'in', user.coop_publisher_partner_ids.ids)]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_project_admin" model="ir.rule">
      <field name="name">Администратор узла ведёт все проекты</field>
      <field name="model_id" ref="model_coop_project"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!--
      Вклад видят трое: вкладчик, инициатор проекта и ответственный за ту
      потребность, на которую этот вклад предложен. Чужой вклад говорит о
      человеке немало — сколько он вложил и куда, — и открывать это всему
      каталогу незачем. Общая сумма при этом видна всем: без неё не
      понять, собран проект или нет.

      Ответственный за потребность попал сюда не для удобства: владелец
      14 сентября 2026 поручил утверждение ему наравне с инициатором, а
      выбрать одно предложение из пяти, не видя их, нельзя. Без этой
      строки ответственный получал пустой список и отказ в доступе при
      нажатии кнопки.
    -->
    <record id="rule_contribution_own" model="ir.rule">
      <field name="name">Свои вклады, вклады в свой проект и по своей потребности</field>
      <field name="model_id" ref="model_coop_project_contribution"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">
        ['|', ('partner_id', 'in', user.coop_actor_partner_ids.ids),
         '|', ('project_id.partner_id', 'in', user.coop_actor_partner_ids.ids),
         ('need_id.need_manager_id', 'in', user.coop_actor_partner_ids.ids)]
      </field>
      <!--
        Чтение отсюда убрано и вынесено в правило ниже: вклады видны
        всем. Здесь остаётся только право менять — своё и в своём
        проекте. Правило действует лишь на те действия, которые само
        объявляет, поэтому разделение работает без оговорок.
      -->
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!--
      Вклады в проект видны всем участникам платформы: кто и сколько.

      Решение владельца 22 сентября 2026. Он открыл проект, собранный на
      72%, и увидел пустую вкладку вкладов: «нет ни одного вклада, а
      проект собран на 72% это не реально». Данные были на месте —
      четырнадцать вкладов, девять принятых, девять участников, — их
      закрывало правило доступа. То есть база говорила правду, а экран
      врал: полоса обещала собранные проценты, а список под ней говорил,
      что вкладов нет.

      Из четырёх путей владелец выбрал полную открытость — «все: кто и
      сколько». Так устроены площадки сбора средств, и так же устроена
      кооперативная открытость: общее дело — общие цифры. Тот, кто решает
      вложиться, видит, кто вложился до него; без этого «собрано 72%» —
      число без подтверждения.

      Цена решения названа прямо: сумма вклада говорит о достатке
      человека, и эта открытость необратима — увиденное не забывается.
      Правило можно сузить позже, но уже увиденное останется увиденным.

      Только чтение. Менять чужой вклад по-прежнему нельзя: за это
      отвечает правило выше.
    -->
    <record id="rule_contribution_read_all" model="ir.rule">
      <field name="name">Вклады в проект видны всем</field>
      <field name="model_id" ref="model_coop_project_contribution"/>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_contribution_admin" model="ir.rule">
      <field name="name">Вклады — администратор</field>
      <field name="model_id" ref="model_coop_project_contribution"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

  </data>
</odoo>
