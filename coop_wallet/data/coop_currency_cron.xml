<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Раз в сутки — курсы ЦБ РФ для сводки «Все» в кошельке (решение 640).
      ЦБ публикует курс на следующий день во второй половине дня, поэтому
      запуск вечером.
    -->
    <record id="cron_fetch_cbr_rates" model="ir.cron">
      <field name="name">Кошелёк: курсы ЦБ РФ</field>
      <field name="model_id" ref="model_coop_currency_rate"/>
      <field name="state">code</field>
      <field name="code">model.coop_fetch_cbr_rates()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 17:30:00')"/>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
