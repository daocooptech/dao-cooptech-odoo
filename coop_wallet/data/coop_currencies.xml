<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Валюты, в которых платформа умеет считать цену.

    Решение 392: расчёты между резидентом и нерезидентом обязательны —
    без них не бывает ни международной сделки, ни расчёта внутри БРИКС.
    Юрист подтвердил: между резидентом и нерезидентом валютные операции
    разрешены без ограничений (ст. 6 ФЗ-173), и валюта платежа тут
    свободна.

    Включаем валюты стран БРИКС и ближайших торговых партнёров. Они есть
    в справочнике движка, но выключены: Odoo из коробки держит включёнными
    доллар и валюту установки.

    **Курс не подставляем.** Платформа не биржа валют и не банк: курс на
    дату платежа определяет банк, и обещать свой значило бы обещать то,
    чего мы не исполняем. Цена в валюте — это цена по п. 2 ст. 317 ГК,
    выраженная в валюте; платёж идёт по курсу банка.
  -->
  <!-- юань -->
  <record id="base.CNY" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- рупия -->
  <record id="base.INR" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- реал -->
  <record id="base.BRL" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- ранд -->
  <record id="base.ZAR" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- дирхам -->
  <record id="base.AED" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- лира -->
  <record id="base.TRY" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- тенге -->
  <record id="base.KZT" model="res.currency">
    <field name="active" eval="True"/>
  </record>

  <!-- белорусский рубль -->
  <record id="base.BYN" model="res.currency">
    <field name="active" eval="True"/>
  </record>
</odoo>
