<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Раз в пять минут — отвечают ли сети, у которых указан узел
      (решение 658 п. 1). Не ответила — кошелёк и биржа показывают
      последние данные с плашкой, переводы и заявки выключены.
    -->
    <record id="cron_check_networks" model="ir.cron">
      <field name="name">Кошелёк: доступность сетей</field>
      <field name="model_id" ref="model_coop_wallet_network"/>
      <field name="state">code</field>
      <field name="code">model._cron_check_reachability()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
