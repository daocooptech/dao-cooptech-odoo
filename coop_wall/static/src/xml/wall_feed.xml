<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <!-- Под текстом записи в ленте подписок — `js/wall_feed.js`. Щелчок
       внутри не открывает запись: иначе нажатие 👍 уводило бы на стену. -->
  <t t-name="coop_wall.FeedExtras">
    <div class="o_coop_feed_extras" t-if="this.state.ready and this.message" t-on-click.stop="">
      <CoopRepostCard t-if="this.message.coop_repost" repost="this.message.coop_repost"/>
      <CoopWallPoll t-if="this.message.coop_poll" message="this.message"/>
      <AttachmentList t-if="this.attachments.length" attachmentGroups="this.attachmentGroups"
                      unlinkAttachments.bind="this.noUnlink"/>
      <CoopWallPostFooter message="this.message" thread="this.message.thread"/>
    </div>
  </t>
</templates>
